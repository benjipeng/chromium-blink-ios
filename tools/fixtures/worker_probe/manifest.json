{
  "manifest_version": 3,
  "name": "Chromium iOS Worker Probe",
  "version": "1.0.0",
  "description": "On-demand unpacked fixture verifying MV3 module service worker, storage.local, runtime messaging, options page, and chrome.commands.",
  "permissions": [
    "storage"
  ],
  "background": {
    "service_worker": "sw.js",
    "type": "module"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "content_scripts": [
    {
      "matches": [
        "http://127.0.0.1/*",
        "http://localhost/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_end"
    }
  ],
  "commands": {
    "probe-command": {
      "suggested_key": {
        "default": "Ctrl+Shift+Y"
      },
      "description": "Trigger worker probe command"
    }
  }
}
