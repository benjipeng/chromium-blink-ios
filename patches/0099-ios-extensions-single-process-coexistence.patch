+          frame->GetLastCommittedOrigin() == extension->origin() &&
+          !frame->IsErrorDocument() && frame->HasPolicyContainerHost() &&
+          !frame->IsSandboxed(network::mojom::WebSandboxFlags::kOrigin) &&
+          !frame->GetSiteInstance()->GetSecurityPrincipal().IsSandboxed() &&
+          !frame->GetSiteInstance()->GetSecurityPrincipal().IsGuest()) {
+        return true;
+      }
+    } else if (source_context.is_for_service_worker()) {
+      const PortContext::WorkerContext& worker = source_context.worker.value();
+      if (worker.extension_id == extension_id) {
+        WorkerId worker_id{extension_id, process.GetID(), worker.version_id,
+                           worker.thread_id};
+        auto* process_manager = ProcessManager::Get(process.GetBrowserContext());
+        if (process_manager && process_manager->HasServiceWorker(worker_id)) {
+          return true;
+        }
+        auto* task_queue =
+            ServiceWorkerTaskQueue::Get(process.GetBrowserContext());
+        if (task_queue &&
+            task_queue->GetCurrentActivationToken(extension_id).has_value()) {
+          return true;
+        }
+      }
+      return false;
+    } else {
+      return false;
+    }
+  } else if (process_map->Contains(extension_id, process.GetID())) {
     // A trusted extension process is always valid for messaging.
     return true;
   }
