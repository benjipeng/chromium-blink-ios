+// Context-scoped equivalent of ProcessMap::CanProcessHostContextType() for
+// single-process mode, where multiple extensions and web pages share one
+// RenderProcessHost ID. Authorizes each call strictly from the browser-owned
+// RenderFrameHost or tracked Service Worker rather than ProcessMap's single
+// process-level slot.
+bool CanSingleProcessHostContextType(
+    content::BrowserContext* browser_context,
+    ProcessMap* process_map,
+    const Extension* extension,
+    content::RenderFrameHost* render_frame_host,
+    const content::RenderProcessHost& render_process_host,
+    const mojom::RequestParams& params) {
+  switch (params.context_type) {
+    case mojom::ContextType::kOffscreenExtension:
+    case mojom::ContextType::kPrivilegedExtension: {
+      if (!extension ||
+          (extension->is_hosted_app() &&
+           extension->location() != mojom::ManifestLocation::kComponent)) {
+        return false;
+      }
+      if (IsRequestFromServiceWorker(params)) {
+        if (render_frame_host) {
+          return false;
+        }
+        WorkerId worker_id{extension->id(), render_process_host.GetID(),
+                           params.service_worker_version_id,
+                           params.worker_thread_id};
+        auto* process_manager = ProcessManager::Get(browser_context);
+        return process_manager && process_manager->HasServiceWorker(worker_id);
+      }
+      if (!render_frame_host ||
+          render_frame_host->GetLastCommittedURL().is_empty() ||
+          render_frame_host->GetLastCommittedOrigin() != extension->origin() ||
+          render_frame_host->IsErrorDocument() ||
+          !render_frame_host->HasPolicyContainerHost() ||
+          render_frame_host->IsSandboxed(
+              network::mojom::WebSandboxFlags::kOrigin)) {
+        return false;
+      }
+      const content::SecurityPrincipal& principal =
+          render_frame_host->GetSiteInstance()->GetSecurityPrincipal();
+      return !principal.IsSandboxed() && !principal.IsGuest();
+    }
+    case mojom::ContextType::kPrivilegedWebPage: {
+      if (!extension || !extension->is_hosted_app() ||
+          extension->location() == mojom::ManifestLocation::kComponent ||
+          !render_frame_host || render_frame_host->IsErrorDocument()) {
+        return false;
+      }
+      auto* registry = ExtensionRegistry::Get(browser_context);
+      return registry &&
+             registry->enabled_extensions().GetHostedAppByURL(
+                 render_frame_host->GetLastCommittedURL()) == extension;
+    }
+    case mojom::ContextType::kUntrustedWebUi: {
+      return !extension && render_frame_host &&
+             render_frame_host->GetLastCommittedURL().SchemeIs(
+                 content::kChromeUIUntrustedScheme);
+    }
+    case mojom::ContextType::kWebPage: {
+      if (extension || !render_frame_host) {
+        return false;
+      }
+      const GURL& url = render_frame_host->GetLastCommittedURL();
+      return !url.SchemeIs(kExtensionScheme) &&
+             !url.SchemeIs(content::kChromeUIScheme) &&
+             !url.SchemeIs(content::kChromeUIUntrustedScheme);
+    }
+    case mojom::ContextType::kWebUi: {
+      return !extension && render_frame_host &&
+             render_frame_host->GetLastCommittedURL().SchemeIs(
+                 content::kChromeUIScheme) &&
+             content::ChildProcessSecurityPolicy::GetInstance()
+                 ->HasWebUIBindings(render_process_host.GetID());
+    }
+    case mojom::ContextType::kUnspecified:
+    case mojom::ContextType::kUnprivilegedExtension:
+    case mojom::ContextType::kContentScript:
+    case mojom::ContextType::kUserScript:
+      return process_map->CanProcessHostContextType(
+          extension, render_process_host, params.context_type);
+  }
+}
