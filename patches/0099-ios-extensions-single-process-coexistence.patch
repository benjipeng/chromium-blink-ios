+bool ProcessMap::IsSingleProcessExtensionContextInProcess(
+    const ExtensionId& extension_id,
+    content::ChildProcessId process_id) const {
+  if (!browser_context_ ||
+      !content::RenderProcessHost::run_renderer_in_process()) {
+    return false;
+  }
+  auto* registry = ExtensionRegistry::Get(browser_context_);
+  const Extension* extension =
+      registry ? registry->enabled_extensions().GetByID(extension_id) : nullptr;
+  if (!extension) {
+    return false;
+  }
+
+  if (auto* process_manager = ProcessManager::Get(browser_context_)) {
+    for (const WorkerId& worker :
+         process_manager->GetServiceWorkersForExtension(extension_id)) {
+      if (worker.render_process_id == process_id) {
+        return true;
+      }
+    }
+    if (ExtensionHost* background_host =
+            process_manager->GetBackgroundHostForExtension(extension_id)) {
+      if (background_host->render_process_host() &&
+          background_host->render_process_host()->GetID() == process_id) {
+        return true;
+      }
+    }
+    for (content::RenderFrameHost* rfh :
+         process_manager->GetRenderFrameHostsForExtension(extension_id)) {
+      if (IsVerifiedCommittedExtensionFrameInProcess(rfh, *extension,
+                                                     process_id)) {
+        return true;
+      }
+    }
+  }
+
+  if (auto* task_queue = ServiceWorkerTaskQueue::Get(browser_context_)) {
+    if (task_queue->GetCurrentActivationToken(extension_id).has_value()) {
+      return true;
+    }
+  }
+
+  return false;
