   ProcessMap* process_map = ProcessMap::Get(process.GetBrowserContext());
-  if (process_map->Contains(extension_id, process.GetID())) {
+  if (content::RenderProcessHost::run_renderer_in_process()) {
+    // In single-process mode, all documents and workers share one renderer
+    // process ID while ProcessMap holds at most one extension per process.
+    // Authorize extension messaging strictly from the browser-verified source
+    // frame or service worker identity.
+    auto* registry = ExtensionRegistry::Get(process.GetBrowserContext());
+    const Extension* extension =
