+@interface CrIOSExtensionPopupHost : NSObject <CrIOSExtensionPopupHostingV1>
+- (instancetype)initWithExtensionID:(NSString*)extensionID
+                              tabID:(int32_t)tabID
+                           webState:(std::unique_ptr<web::WebState>)webState;
+@end
+
+@implementation CrIOSExtensionPopupHost {
+  NSString* _extensionID;
+  int32_t _tabID;
+  std::unique_ptr<web::WebState> _webState;
+  std::unique_ptr<CrIOSExtensionPopupWebStateDelegate> _delegate;
+  UIView* _fallbackView;
+  BOOL _closed;
+}
+
+@synthesize onRequestClose = _onRequestClose;
+
+- (instancetype)initWithExtensionID:(NSString*)extensionID
+                              tabID:(int32_t)tabID
+                           webState:(std::unique_ptr<web::WebState>)webState {
+  self = [super init];
+  if (self) {
+    _extensionID = [extensionID copy];
+    _tabID = tabID;
+    _webState = std::move(webState);
+    __weak CrIOSExtensionPopupHost* weakSelf = self;
+    _delegate = std::make_unique<CrIOSExtensionPopupWebStateDelegate>(^{
+      CrIOSExtensionPopupHost* strongSelf = weakSelf;
+      if (!strongSelf || strongSelf->_closed) {
+        return;
+      }
+      void (^handler)(void) = strongSelf.onRequestClose;
+      if (handler) {
+        handler();
+      }
+    });
+    _webState->SetDelegate(_delegate.get());
+  }
+  return self;
+}
+
+- (void)dealloc {
+  [self close];
+}
+
+- (NSString*)extensionID {
+  return _extensionID;
+}
+
+- (int32_t)tabID {
+  return _tabID;
+}
+
+- (UIView*)view {
+  if (_webState) {
+    return _webState->GetView();
+  }
+  if (!_fallbackView) {
+    _fallbackView = [[UIView alloc] init];
+  }
+  return _fallbackView;
+}
+
+- (CGSize)preferredContentSize {
+  return CGSizeMake(360.0, 480.0);
+}
+
+- (void)close {
+  if (_closed) {
+    return;
+  }
+  _closed = YES;
+  _onRequestClose = nil;
+  if (_webState) {
+    _webState->SetDelegate(nullptr);
+    _webState->WasHidden();
+    _webState.reset();
+  }
+  _delegate.reset();
+}
+
+@end
