diff --git a/ios/chrome/browser/curium/curium_download_task.mm b/ios/chrome/browser/curium/curium_download_task.mm
new file mode 100644
index 0000000..6865b18
--- /dev/null
+++ b/ios/chrome/browser/curium/curium_download_task.mm
@@ -0,0 +1,232 @@
+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#import "ios/chrome/browser/curium/curium_download_task.h"
+
+#import <utility>
+
+#import "base/apple/foundation_util.h"
+#import "base/check.h"
+#import "base/files/file_path.h"
+#import "base/strings/sys_string_conversions.h"
+#import "ios/web/public/download/download_task.h"
+#import "ios/web/public/download/download_task_observer.h"
+#import "net/base/apple/url_conversions.h"
+
+namespace {
+
+NSString* const kCuriumDownloadErrorDomain = @"CuriumDownloadErrorDomain";
+
+CrIOSDownloadState MapDownloadState(web::DownloadTask::State state) {
+  switch (state) {
+    case web::DownloadTask::State::kNotStarted:
+      return CrIOSDownloadStatePending;
+    case web::DownloadTask::State::kInProgress:
+      return CrIOSDownloadStateInProgress;
+    case web::DownloadTask::State::kComplete:
+      return CrIOSDownloadStateCompleted;
+    case web::DownloadTask::State::kCancelled:
+      return CrIOSDownloadStateCancelled;
+    case web::DownloadTask::State::kFailed:
+    case web::DownloadTask::State::kFailedNotResumable:
+      return CrIOSDownloadStateFailed;
+  }
+}
+
+class DownloadTaskObserverAdapter final : public web::DownloadTaskObserver {
+ public:
+  explicit DownloadTaskObserverAdapter(CuriumDownloadTask* owner)
+      : owner_(owner) {}
+
+  void OnDownloadUpdated(web::DownloadTask* task) override;
+  void OnDownloadDestroyed(web::DownloadTask* task) override;
+
+ private:
+  __weak CuriumDownloadTask* owner_;
+};
+
+}  // namespace
+
+@implementation CuriumDownloadTask {
+  std::unique_ptr<web::DownloadTask> _task;
+  std::unique_ptr<DownloadTaskObserverAdapter> _observer;
+  NSString* _downloadID;
+  NSString* _sourceTabID;
+  NSURL* _originalURL;
+  NSString* _suggestedFilename;
+  NSString* _mimeType;
+  void (^_completion)(NSURL* _Nullable, NSError* _Nullable);
+}
+
+- (instancetype)initWithDownloadTask:(std::unique_ptr<web::DownloadTask>)task
+                         sourceTabID:(nullable NSString*)sourceTabID {
+  self = [super init];
+  if (self) {
+    _task = std::move(task);
+    _downloadID = [_task->GetIdentifier() copy] ?: [[NSUUID UUID] UUIDString];
+    _sourceTabID = [sourceTabID copy];
+    _originalURL = net::NSURLWithGURL(_task->GetOriginalUrl());
+    base::FilePath generated = _task->GenerateFileName();
+    _suggestedFilename =
+        base::SysUTF8ToNSString(generated.value()) ?: @"Download";
+    const std::string mime = _task->GetMimeType();
+    _mimeType = mime.empty() ? nil : base::SysUTF8ToNSString(mime);
+    _observer = std::make_unique<DownloadTaskObserverAdapter>(self);
+    _task->AddObserver(_observer.get());
+  }
+  return self;
+}
+
+- (void)dealloc {
+  [self invalidate];
+}
+
+- (void)invalidate {
+  if (_task && _observer) {
+    _task->RemoveObserver(_observer.get());
+  }
+  _observer.reset();
+  _task.reset();
+  [self finishWithURL:nil
+                error:[NSError errorWithDomain:kCuriumDownloadErrorDomain
+                                          code:-1
+                                      userInfo:@{
+                                        NSLocalizedDescriptionKey :
+                                            @"Download task was invalidated."
+                                      }]];
+}
+
+- (NSString*)downloadID {
+  return _downloadID;
+}
+
+- (nullable NSString*)sourceTabID {
+  return _sourceTabID;
+}
+
+- (nullable NSURL*)originalURL {
+  return _originalURL;
+}
+
+- (NSString*)suggestedFilename {
+  return _suggestedFilename;
+}
+
+- (nullable NSString*)mimeType {
+  return _mimeType;
+}
+
+- (int64_t)totalBytes {
+  return _task ? _task->GetTotalBytes() : -1;
+}
+
+- (int64_t)receivedBytes {
+  return _task ? _task->GetReceivedBytes() : 0;
+}
+
+- (CrIOSDownloadState)state {
+  return _task ? MapDownloadState(_task->GetState())
+               : CrIOSDownloadStateCancelled;
+}
+
+- (void)startWithDestinationURL:(NSURL*)destinationURL
+                     completion:(void (^)(NSURL* _Nullable,
+                                          NSError* _Nullable))completion {
+  CHECK([NSThread isMainThread]);
+  if (!_task || _task->GetState() != web::DownloadTask::State::kNotStarted ||
+      !destinationURL.fileURL) {
+    NSError* err = [NSError
+        errorWithDomain:kCuriumDownloadErrorDomain
+                   code:-2
+               userInfo:@{
+                 NSLocalizedDescriptionKey :
+                     @"Download task cannot start at destination URL."
+               }];
+    completion(nil, err);
+    return;
+  }
+  _completion = [completion copy];
+  _task->Start(base::apple::NSURLToFilePath(destinationURL));
+}
+
+- (void)cancel {
+  CHECK([NSThread isMainThread]);
+  if (_task && !_task->IsDone()) {
+    _task->Cancel();
+  }
+}
+
+- (void)handleTaskUpdated {
+  if (!_task || !_task->IsDone()) {
+    return;
+  }
+  switch (_task->GetState()) {
+    case web::DownloadTask::State::kComplete: {
+      NSURL* savedURL = base::apple::FilePathToNSURL(_task->GetResponsePath());
+      [self finishWithURL:savedURL error:nil];
+      break;
+    }
+    case web::DownloadTask::State::kCancelled: {
+      NSError* err =
+          [NSError errorWithDomain:NSCocoaErrorDomain
+                              code:NSUserCancelledError
+                          userInfo:@{
+                            NSLocalizedDescriptionKey : @"Download cancelled."
+                          }];
+      [self finishWithURL:nil error:err];
+      break;
+    }
+    case web::DownloadTask::State::kFailed:
+    case web::DownloadTask::State::kFailedNotResumable: {
+      NSError* err = [NSError
+          errorWithDomain:kCuriumDownloadErrorDomain
+                     code:_task->GetErrorCode()
+                 userInfo:@{
+                   NSLocalizedDescriptionKey : [NSString
+                       stringWithFormat:@"Download failed (net error %d).",
+                                        _task->GetErrorCode()]
+                 }];
+      [self finishWithURL:nil error:err];
+      break;
+    }
+    case web::DownloadTask::State::kNotStarted:
+    case web::DownloadTask::State::kInProgress:
+      break;
+  }
+}
+
+- (void)handleTaskDestroyed {
+  _task.release();
+  NSError* err =
+      [NSError errorWithDomain:kCuriumDownloadErrorDomain
+                          code:-3
+                      userInfo:@{
+                        NSLocalizedDescriptionKey : @"Download destroyed."
+                      }];
+  [self finishWithURL:nil error:err];
+}
+
+- (void)finishWithURL:(nullable NSURL*)url error:(nullable NSError*)error {
+  if (!_completion) {
+    return;
+  }
+  void (^block)(NSURL* _Nullable, NSError* _Nullable) = _completion;
+  _completion = nil;
+  block(url, error);
+}
+
+@end
+
+namespace {
+
+void DownloadTaskObserverAdapter::OnDownloadUpdated(web::DownloadTask* task) {
+  [owner_ handleTaskUpdated];
+}
+
+void DownloadTaskObserverAdapter::OnDownloadDestroyed(web::DownloadTask* task) {
+  task->RemoveObserver(this);
+  [owner_ handleTaskDestroyed];
+}
+
+}  // namespace
