+@implementation CrIOSExtensionManagerV1 (CuriumV2)
+
+- (NSDictionary<NSString*, id>*)actionPresentationForExtensionWithID:
+                                    (NSString*)extensionID
+                                                               tabID:
+                                                                   (int32_t)tabID
+                                                               error:
+                                                                   (NSError* __autoreleasing*)
+                                                                       error {
+  if (![extensionID isKindOfClass:[NSString class]] ||
+      extensionID.length == 0) {
+    SetBridgeError(error, kCrIOSExtensionManagerErrorInvalidArgument,
+                   @"Extension ID must be a non-empty string.");
+    return nil;
+  }
+  content::BrowserContext* context = nullptr;
+  extensions::ExtensionSystem* system = nullptr;
+  extensions::ExtensionRegistry* registry = nullptr;
+  extensions::ExtensionRegistrar* registrar = nullptr;
+  if (!ResolveExtensionServices(&context, &system, &registry, &registrar,
+                                error)) {
+    return nil;
+  }
+  const std::string ext_id = base::SysNSStringToUTF8(extensionID);
+  const extensions::Extension* ext = registry->GetInstalledExtension(ext_id);
+  if (!ext) {
+    SetBridgeError(error, kCrIOSExtensionManagerErrorNotFound,
+                   @"Extension is not installed in the active context.");
+    return nil;
+  }
+  auto* action_manager = extensions::ExtensionActionManager::Get(context);
+  extensions::ExtensionAction* action =
+      action_manager ? action_manager->GetExtensionAction(*ext) : nullptr;
+  const int effective_tab = tabID >= 0
+                                ? static_cast<int>(tabID)
+                                : extensions::ExtensionAction::kDefaultTabId;
+
+  const bool is_enabled = registrar->IsExtensionEnabled(ext_id) && action &&
+                          action->GetIsVisible(effective_tab);
+  const GURL popup_url = action ? action->GetPopupUrl(effective_tab) : GURL();
+  const bool has_popup =
+      popup_url.is_valid() &&
+      popup_url.SchemeIs(extensions::kExtensionScheme) &&
+      popup_url.host() == ext_id;
+
+  NSMutableDictionary<NSString*, id>* snapshot =
+      [NSMutableDictionary dictionaryWithDictionary:@{
+        @"isEnabled" : @(is_enabled),
+        @"hasPopup" : @(has_popup),
+      }];
+
+  std::string title = action ? action->GetTitle(effective_tab) : std::string();
+  if (title.empty()) {
+    title = ext->name();
+  }
+  if (!title.empty()) {
+    snapshot[@"title"] = base::SysUTF8ToNSString(title);
+  }
+
+  if (action) {
+    const std::string badge = action->GetDisplayBadgeText(effective_tab);
+    if (!badge.empty()) {
+      snapshot[@"badgeText"] = base::SysUTF8ToNSString(badge);
+    }
+    const SkColor bg = action->GetBadgeBackgroundColor(effective_tab);
+    if (SkColorGetA(bg) != 0) {
+      snapshot[@"badgeBackgroundColor"] =
+          [UIColor colorWithRed:SkColorGetR(bg) / 255.0
+                          green:SkColorGetG(bg) / 255.0
+                           blue:SkColorGetB(bg) / 255.0
+                          alpha:SkColorGetA(bg) / 255.0];
+    }
+    const gfx::Image icon = action->GetExplicitlySetIcon(effective_tab);
+    if (!icon.IsEmpty()) {
+      if (UIImage* ui_icon = icon.ToUIImage()) {
+        snapshot[@"icon"] = ui_icon;
+      }
+    }
+  }
+  return [snapshot copy];
+}
+
+- (id<NSObject>)observeActionPresentationChangesWithHandler:
+    (void (^)(NSString* extensionID))handler {
+  if (!handler) {
+    return nil;
+  }
+  return [[CrIOSActionPresentationObserverToken alloc] initWithHandler:handler];
+}
+
+- (NSNumber*)blockedRequestCountForExtensionWithID:(NSString*)extensionID
+                                             tabID:(int32_t)tabID
+                                             error:(NSError* __autoreleasing*)error {
+  if (![extensionID isKindOfClass:[NSString class]] ||
+      extensionID.length == 0) {
+    SetBridgeError(error, kCrIOSExtensionManagerErrorInvalidArgument,
+                   @"Extension ID must be a non-empty string.");
+    return nil;
+  }
+  content::BrowserContext* context = nullptr;
+  extensions::ExtensionSystem* system = nullptr;
+  extensions::ExtensionRegistry* registry = nullptr;
+  extensions::ExtensionRegistrar* registrar = nullptr;
+  if (!ResolveExtensionServices(&context, &system, &registry, &registrar,
+                                error)) {
+    return nil;
+  }
+  const std::string ext_id = base::SysNSStringToUTF8(extensionID);
+  if (!registry->GetInstalledExtension(ext_id)) {
+    SetBridgeError(error, kCrIOSExtensionManagerErrorNotFound,
+                   @"Extension is not installed in the active context.");
+    return nil;
+  }
+  if (tabID < 0) {
+    return @(0);
+  }
+  auto* rules_monitor =
+      extensions::declarative_net_request::RulesMonitorService::Get(context);
+  const size_t count =
+      rules_monitor
+          ? rules_monitor->action_tracker().GetBlockedRequestCountForTab(
+                ext_id, static_cast<int>(tabID))
+          : 0u;
+  return @(static_cast<NSUInteger>(count));
+}
+
+- (id<CrIOSExtensionPopupHostingV1>)
+    popupForExtensionWithID:(NSString*)extensionID
+                      tabID:(int32_t)tabID
+                      error:(NSError* __autoreleasing*)error {
+  if (![extensionID isKindOfClass:[NSString class]] ||
+      extensionID.length == 0) {
+    SetBridgeError(error, kCrIOSExtensionManagerErrorInvalidArgument,
+                   @"Extension ID must be a non-empty string.");
+    return nil;
+  }
+  content::BrowserContext* context = nullptr;
+  extensions::ExtensionSystem* system = nullptr;
+  extensions::ExtensionRegistry* registry = nullptr;
+  extensions::ExtensionRegistrar* registrar = nullptr;
+  if (!ResolveExtensionServices(&context, &system, &registry, &registrar,
+                                error)) {
+    return nil;
+  }
+  const std::string ext_id = base::SysNSStringToUTF8(extensionID);
+  const extensions::Extension* ext = registry->GetInstalledExtension(ext_id);
+  if (!ext) {
+    SetBridgeError(error, kCrIOSExtensionManagerErrorNotFound,
+                   @"Extension is not installed in the active context.");
+    return nil;
+  }
+  if (!registrar->IsExtensionEnabled(ext_id)) {
+    SetBridgeError(error, kCrIOSExtensionManagerErrorStateChangeFailed,
+                   @"Extension must be enabled to open a popup.");
+    return nil;
+  }
+  auto* action_manager = extensions::ExtensionActionManager::Get(context);
+  extensions::ExtensionAction* action =
+      action_manager ? action_manager->GetExtensionAction(*ext) : nullptr;
+  const int effective_tab = tabID >= 0
+                                ? static_cast<int>(tabID)
+                                : extensions::ExtensionAction::kDefaultTabId;
+  const GURL popup_url = action ? action->GetPopupUrl(effective_tab) : GURL();
+  if (!popup_url.is_valid() ||
+      !popup_url.SchemeIs(extensions::kExtensionScheme) ||
+      popup_url.host() != ext_id) {
+    SetBridgeError(error, kCrIOSExtensionManagerErrorNotFound,
+                   @"Extension does not declare a popup for this tab.");
+    return nil;
+  }
+
+  auto* content_context = static_cast<web::ContentBrowserContext*>(context);
+  web::BrowserState* browser_state =
+      content_context ? content_context->GetBrowserState() : nullptr;
+  if (!browser_state) {
+    SetBridgeError(error, kCrIOSExtensionManagerErrorSystemNotReady,
+                   @"Browser state is unavailable for extension popup.");
+    return nil;
+  }
+
+  web::WebState::CreateParams params(browser_state);
+  std::unique_ptr<web::WebState> popup_web_state =
+      web::WebState::Create(params);
+  if (!popup_web_state) {
+    SetBridgeError(error, kCrIOSExtensionManagerErrorSystemNotReady,
+                   @"Failed to create popup WebState.");
+    return nil;
+  }
+  popup_web_state->ForceRealized();
+  popup_web_state->WasShown();
+  web::NavigationManager::WebLoadParams load_params(popup_url);
+  load_params.transition_type = ui::PAGE_TRANSITION_AUTO_TOPLEVEL;
+  popup_web_state->GetNavigationManager()->LoadURLWithParams(load_params);
+
+  return [[CrIOSExtensionPopupHost alloc]
+      initWithExtensionID:extensionID
+                    tabID:tabID
+                 webState:std::move(popup_web_state)];
+}
+
+- (NSArray<NSDictionary<NSString*, NSString*>*>*)
+    commandsForExtensionWithID:(NSString*)extensionID
+                         error:(NSError* __autoreleasing*)error {
+  if (![extensionID isKindOfClass:[NSString class]] ||
+      extensionID.length == 0) {
+    SetBridgeError(error, kCrIOSExtensionManagerErrorInvalidArgument,
+                   @"Extension ID must be a non-empty string.");
+    return nil;
+  }
+  content::BrowserContext* context = nullptr;
+  extensions::ExtensionSystem* system = nullptr;
+  extensions::ExtensionRegistry* registry = nullptr;
+  extensions::ExtensionRegistrar* registrar = nullptr;
+  if (!ResolveExtensionServices(&context, &system, &registry, &registrar,
+                                error)) {
+    return nil;
+  }
+  const std::string ext_id = base::SysNSStringToUTF8(extensionID);
+  const extensions::Extension* ext = registry->GetInstalledExtension(ext_id);
+  if (!ext) {
+    SetBridgeError(error, kCrIOSExtensionManagerErrorNotFound,
+                   @"Extension is not installed in the active context.");
+    return nil;
+  }
+
+  NSMutableArray<NSDictionary<NSString*, NSString*>*>* result =
+      [NSMutableArray array];
+  auto append_command = ^(const ui::Command& command) {
+    [result addObject:@{
+      @"name" : base::SysUTF8ToNSString(command.command_name()) ?: @"",
+      @"description" : base::SysUTF16ToNSString(command.description()) ?: @"",
+      @"shortcut" : @"",
+    }];
+  };
+  if (const extensions::Command* browser_action =
+          extensions::CommandsInfo::GetBrowserActionCommand(ext)) {
+    append_command(*browser_action);
+  }
+  if (const extensions::Command* action =
+          extensions::CommandsInfo::GetActionCommand(ext)) {
+    append_command(*action);
+  }
+  if (const extensions::Command* page_action =
+          extensions::CommandsInfo::GetPageActionCommand(ext)) {
+    append_command(*page_action);
+  }
+  if (const ui::CommandMap* named =
+          extensions::CommandsInfo::GetNamedCommands(ext)) {
+    for (const auto& [_, command] : *named) {
+      append_command(command);
+    }
+  }
+  return [result copy];
+}
+
+@end
