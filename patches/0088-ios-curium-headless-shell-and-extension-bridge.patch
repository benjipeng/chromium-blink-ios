diff --git a/ios/chrome/browser/curium/curium_web_state_delegate.mm b/ios/chrome/browser/curium/curium_web_state_delegate.mm
new file mode 100644
index 0000000..58aeeb1
--- /dev/null
+++ b/ios/chrome/browser/curium/curium_web_state_delegate.mm
@@ -0,0 +1,277 @@
+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#import "ios/chrome/browser/curium/curium_web_state_delegate.h"
+
+#import <memory>
+#import <utility>
+
+#import "base/functional/callback_helpers.h"
+#import "build/blink_buildflags.h"
+#import "ios/chrome/browser/curium/curium_browser_host.h"
+#import "ios/chrome/browser/curium/curium_tab_host.h"
+#import "ios/chrome/browser/shared/model/browser/browser.h"
+#import "ios/chrome/browser/shared/model/profile/profile_ios.h"
+#import "ios/chrome/browser/shared/model/web_state_list/web_state_list.h"
+#import "ios/chrome/browser/shared/model/web_state_list/web_state_opener.h"
+#import "ios/web/public/navigation/navigation_manager.h"
+#import "ios/web/public/permissions/permissions.h"
+#import "ios/web/public/ui/context_menu_params.h"
+#import "ios/web/public/ui/crw_web_view_proxy.h"
+#import "ios/web/public/web_state.h"
+#import "net/base/apple/url_conversions.h"
+#import "ui/base/mojom/window_open_disposition.mojom-shared.h"
+
+@interface CuriumBrowserHost (DelegateRouting)
+- (nullable CuriumTabHost*)tabHostForWebState:(web::WebState*)webState;
+@end
+
+namespace {
+
+UIViewController* TopPresenterForWebState(web::WebState* web_state) {
+  UIViewController* vc =
+      web_state ? web_state->GetView().window.rootViewController : nil;
+  while (vc.presentedViewController &&
+         !vc.presentedViewController.beingDismissed) {
+    vc = vc.presentedViewController;
+  }
+  return vc;
+}
+
+}  // namespace
+
+CuriumWebStateDelegate::CuriumWebStateDelegate(Browser* browser,
+                                               CuriumBrowserHost* host)
+    : browser_(browser), host_(host) {}
+
+CuriumWebStateDelegate::~CuriumWebStateDelegate() = default;
+
+web::WebState* CuriumWebStateDelegate::CreateNewWebState(
+    web::WebState* source,
+    const GURL& url,
+    const GURL& opener_url,
+    bool initiated_by_user) {
+  WebStateList* list = browser_->GetWebStateList();
+  if (list->IsMutating() ||
+      list->GetIndexOfWebState(source) == WebStateList::kInvalidIndex) {
+    return nullptr;
+  }
+  web::WebState::CreateParams params(browser_->GetProfile());
+  params.created_with_opener = true;
+#if BUILDFLAG(USE_BLINK)
+  params.opener_web_state = source;
+#endif
+  std::unique_ptr<web::WebState> child = web::WebState::Create(params);
+  web::WebState* raw_child = child.get();
+  list->InsertWebState(
+      std::move(child),
+      WebStateList::InsertionParams::AtIndex(list->count())
+          .Activate(initiated_by_user)
+          .WithOpener(WebStateOpener(source)));
+  return raw_child;
+}
+
+void CuriumWebStateDelegate::CloseWebState(web::WebState* source) {
+  WebStateList* list = browser_->GetWebStateList();
+  const int index = list->GetIndexOfWebState(source);
+  if (index != WebStateList::kInvalidIndex) {
+    list->CloseWebStateAt(index, WebStateList::ClosingReason::kUserAction);
+  }
+}
+
+web::WebState* CuriumWebStateDelegate::OpenURLFromWebState(
+    web::WebState* source,
+    const web::WebState::OpenURLParams& params) {
+  web::NavigationManager::WebLoadParams load_params(params.url);
+  load_params.referrer = params.referrer;
+  load_params.transition_type = params.transition;
+  load_params.is_renderer_initiated = params.is_renderer_initiated;
+  load_params.virtual_url = params.virtual_url;
+  load_params.internal_scroll_to_text_fragment =
+      params.internal_scroll_to_text_fragment;
+
+  switch (params.disposition) {
+    case ui::mojom::WindowOpenDisposition::kCurrentTab:
+      source->GetNavigationManager()->LoadURLWithParams(load_params);
+      return source;
+    case ui::mojom::WindowOpenDisposition::kNewForegroundTab:
+    case ui::mojom::WindowOpenDisposition::kNewBackgroundTab:
+    case ui::mojom::WindowOpenDisposition::kNewPopup: {
+      WebStateList* list = browser_->GetWebStateList();
+      if (list->IsMutating() ||
+          list->GetIndexOfWebState(source) == WebStateList::kInvalidIndex) {
+        return nullptr;
+      }
+      web::WebState::CreateParams create_params(browser_->GetProfile());
+      create_params.created_with_opener = false;
+      std::unique_ptr<web::WebState> child =
+          web::WebState::Create(create_params);
+      web::WebState* raw_child = child.get();
+      raw_child->GetNavigationManager()->LoadURLWithParams(load_params);
+      const bool activate =
+          params.disposition !=
+          ui::mojom::WindowOpenDisposition::kNewBackgroundTab;
+      list->InsertWebState(
+          std::move(child),
+          WebStateList::InsertionParams::AtIndex(list->count())
+              .Activate(activate)
+              .WithOpener(WebStateOpener(source)));
+      return raw_child;
+    }
+    default:
+      return nullptr;
+  }
+}
+
+void CuriumWebStateDelegate::ShowRepostFormWarningDialog(
+    web::WebState* source,
+    web::FormWarningType warning_type,
+    base::OnceCallback<void(bool)> callback) {
+  UIViewController* presenter = TopPresenterForWebState(source);
+  if (!presenter) {
+    std::move(callback).Run(false);
+    return;
+  }
+  __block base::OnceCallback<void(bool)> shared_cb = std::move(callback);
+  UIAlertController* alert = [UIAlertController
+      alertControllerWithTitle:@"Confirm Form Resubmission"
+                       message:@"The page you are trying to view contains data "
+                               @"that you already submitted."
+                preferredStyle:UIAlertControllerStyleAlert];
+  [alert addAction:[UIAlertAction actionWithTitle:@"Cancel"
+                                            style:UIAlertActionStyleCancel
+                                          handler:^(UIAlertAction*) {
+                                            if (shared_cb) {
+                                              std::move(shared_cb).Run(false);
+                                            }
+                                          }]];
+  [alert addAction:[UIAlertAction actionWithTitle:@"Continue"
+                                            style:UIAlertActionStyleDefault
+                                          handler:^(UIAlertAction*) {
+                                            if (shared_cb) {
+                                              std::move(shared_cb).Run(true);
+                                            }
+                                          }]];
+  [presenter presentViewController:alert animated:YES completion:nil];
+}
+
+web::JavaScriptDialogPresenter*
+CuriumWebStateDelegate::GetJavaScriptDialogPresenter(web::WebState* source) {
+  return nullptr;
+}
+
+void CuriumWebStateDelegate::HandlePermissionsDecisionRequest(
+    web::WebState* source,
+    NSArray<NSNumber*>* permissions,
+    web::WebStatePermissionDecisionHandler handler) {
+  id<CrIOSBrowserHostDelegateV1> delegate = host_.delegate;
+  CuriumTabHost* tab = [host_ tabHostForWebState:source];
+  if (!tab ||
+      ![delegate respondsToSelector:@selector
+                 (browserHost:requestMediaPermissions:origin:forTab:completion:)]) {
+    handler(web::PermissionDecisionDeny);
+    return;
+  }
+
+  CrIOSMediaPermissionTypes requested = 0;
+  for (NSNumber* num in permissions) {
+    switch (static_cast<web::Permission>(num.unsignedIntegerValue)) {
+      case web::PermissionCamera:
+        requested |= CrIOSMediaPermissionTypesCamera;
+        break;
+      case web::PermissionMicrophone:
+        requested |= CrIOSMediaPermissionTypesMicrophone;
+        break;
+      default:
+        break;
+    }
+  }
+  if (requested == 0) {
+    handler(web::PermissionDecisionDeny);
+    return;
+  }
+
+  NSURL* origin = net::NSURLWithGURL(
+      source->GetLastCommittedURL().DeprecatedGetOriginAsURL());
+  if (!origin) {
+    handler(web::PermissionDecisionDeny);
+    return;
+  }
+
+  __block BOOL completed = NO;
+  [delegate browserHost:host_
+      requestMediaPermissions:requested
+                       origin:origin
+                       forTab:tab
+                   completion:^(CrIOSMediaPermissionTypes granted) {
+                     if (completed) {
+                       return;
+                     }
+                     completed = YES;
+                     const BOOL allow = (granted & requested) == requested;
+                     handler(allow ? web::PermissionDecisionGrant
+                                   : web::PermissionDecisionDeny);
+                   }];
+}
+
+void CuriumWebStateDelegate::OnAuthRequired(
+    web::WebState* source,
+    NSURLProtectionSpace* protection_space,
+    NSURLCredential* proposed_credential,
+    HTTPAuthCallback callback) {
+  std::move(callback).Run(nil, nil);
+}
+
+void CuriumWebStateDelegate::OnAuthRequired(
+    web::WebState* source,
+    NSURLProtectionSpace* protection_space,
+    ClientCertAuthCallback callback) {
+  std::move(callback).Run(nullptr);
+}
+
+UIView* CuriumWebStateDelegate::GetWebViewContainer(web::WebState* source) {
+  return source ? source->GetView() : nil;
+}
+
+void CuriumWebStateDelegate::ContextMenuConfiguration(
+    web::WebState* source,
+    const web::ContextMenuParams& params,
+    void (^completion_handler)(UIContextMenuConfiguration*)) {
+  id<CrIOSBrowserHostDelegateV1> delegate = host_.delegate;
+  CuriumTabHost* tab = [host_ tabHostForWebState:source];
+  if (!tab || !source ||
+      ![delegate respondsToSelector:@selector
+                 (browserHost:contextMenuConfigurationForTab:linkURL:imageURL:sourcePoint:completion:)]) {
+    completion_handler(nil);
+    return;
+  }
+
+  NSURL* linkURL =
+      params.link_url.is_valid() ? net::NSURLWithGURL(params.link_url) : nil;
+  NSURL* imageURL =
+      params.src_url.is_valid() ? net::NSURLWithGURL(params.src_url) : nil;
+  UIView* tabView = source->GetView();
+  CGPoint point = params.view
+                      ? [params.view convertPoint:params.location toView:tabView]
+                      : params.location;
+
+  __block UIContextMenuConfiguration* syncConfig = nil;
+  __block BOOL invoked = NO;
+  [delegate browserHost:host_
+      contextMenuConfigurationForTab:tab
+                             linkURL:linkURL
+                            imageURL:imageURL
+                         sourcePoint:point
+                          completion:^(UIContextMenuConfiguration* config) {
+                            if (!invoked) {
+                              invoked = YES;
+                              syncConfig = config;
+                            }
+                          }];
+  completion_handler(syncConfig);
+}
+
+void CuriumWebStateDelegate::OnNewWebViewCreated(web::WebState* source) {
+  [source->GetWebViewProxy() becomeFirstResponder];
+}
