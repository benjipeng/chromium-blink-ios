+@implementation CrIOSActionPresentationObserverToken {
+  void (^_handler)(NSString*);
+}
+
+- (instancetype)initWithHandler:(void (^)(NSString*))handler {
+  self = [super init];
+  if (self) {
+    _handler = [handler copy];
+    [GetActionPresentationObservers() addObject:self];
+  }
+  return self;
+}
+
+- (void)dealloc {
+  [GetActionPresentationObservers() removeObject:self];
+}
+
+- (void)notifyExtensionID:(NSString*)extensionID {
+  if (_handler) {
+    _handler(extensionID);
+  }
+}
