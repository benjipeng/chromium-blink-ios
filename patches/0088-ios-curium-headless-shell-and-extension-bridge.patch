+      : owner_(owner) {
+    web_state_observation_.Observe(web_state);
+    auto* content_web_state = static_cast<web::ContentWebState*>(web_state);
+    if (content::WebContents* wc = content_web_state->GetWebContents()) {
+      web_contents_observer_ =
+          std::make_unique<CuriumWebContentsObserver>(owner, wc);
+    }
+  }
+
+  ~CuriumWebStateObserver() override = default;
+
+  void DidStartNavigation(web::WebState*, web::NavigationContext*) override {
+    [owner_ notifyUpdated];
+  }
+  void DidFinishNavigation(web::WebState*, web::NavigationContext*) override {
+    [owner_ handleNavigationCommitted];
+    [owner_ notifyUpdated];
+  }
+  void DidStartLoading(web::WebState*) override { [owner_ notifyUpdated]; }
+  void DidStopLoading(web::WebState*) override { [owner_ notifyUpdated]; }
+  void LoadProgressChanged(web::WebState*, double) override {
+    [owner_ notifyUpdated];
+  }
+  void DidChangeBackForwardState(web::WebState*) override {
+    [owner_ notifyUpdated];
+  }
+  void TitleWasSet(web::WebState*) override { [owner_ notifyUpdated]; }
+  void WebStateRealized(web::WebState*) override { [owner_ notifyUpdated]; }
+  void WebStateDestroyed(web::WebState* web_state) override {
+    web_state_observation_.Reset();
+    web_contents_observer_.reset();
+    [owner_ handleWebStateDestroyed];
+  }
+
+ private:
+  __weak CuriumTabHost* owner_;
+  base::ScopedObservation<web::WebState, web::WebStateObserver>
+      web_state_observation_{this};
+  std::unique_ptr<CuriumWebContentsObserver> web_contents_observer_;
+};
+
+}  // namespace
+
+@implementation CuriumTabHost {
+  raw_ptr<web::WebState> _webState;
+  __weak CuriumBrowserHost* _browserHost;
+  std::unique_ptr<CuriumWebStateObserver> _observer;
+  BOOL _pendingUpdateNotification;
+  NSString* _tabID;
+  BOOL _prefersDesktopUserAgent;
+  std::optional<double> _zoomScale;
+}
+
+- (instancetype)initWithWebState:(web::WebState*)webState
+                     browserHost:(CuriumBrowserHost*)browserHost {
+  self = [super init];
+  if (self) {
+    CHECK(webState);
+    _webState = webState;
+    _browserHost = browserHost;
+    _tabID = [NSString
+        stringWithFormat:@"%d", webState->GetUniqueIdentifier().identifier()];
+    _observer = std::make_unique<CuriumWebStateObserver>(self, webState);
+    if (ChooseFileTabHelper* chooseFile =
+            ChooseFileTabHelper::FromWebState(webState)) {
+      chooseFile->SetFileUploadPanelHandler(self);
+    }
+  }
+  return self;
+}
+
+- (void)dealloc {
+  [self detach];
+}
+
+- (void)detach {
+  if (_webState) {
+    if (ChooseFileTabHelper* chooseFile =
+            ChooseFileTabHelper::FromWebState(_webState)) {
+      chooseFile->SetFileUploadPanelHandler(nil);
+    }
+  }
+  _observer.reset();
+  _webState = nullptr;
+}
+
+- (nullable web::WebState*)webState {
+  return _webState;
+}
+
+#pragma mark - CrIOSTabHostingV1
+
+- (NSString*)tabID {
+  return _tabID;
+}
+
+- (int32_t)extensionTabID {
+  if (!_webState) {
+    return -1;
+  }
+  const web::WebStateID ident = _webState->GetUniqueIdentifier();
+  return ident.valid() ? ident.identifier() : -1;
+}
+
+- (UIView*)webView {
+  return _webState ? _webState->GetView() : [[UIView alloc] init];
+}
+
+- (nullable UIScrollView*)scrollView {
+  if (!_webState) {
+    return nil;
+  }
+  auto* content_ws = static_cast<web::ContentWebState*>(_webState);
+  if (content::WebContents* wc = content_ws->GetWebContents()) {
+    if (UIScrollView* sv =
+            base::apple::ObjCCast<UIScrollView>(wc->GetNativeView().Get())) {
+      return sv;
+    }
+  }
+  return base::apple::ObjCCast<UIScrollView>(
+      _webState->GetView().subviews.firstObject);
+}
+
+- (nullable NSURL*)currentURL {
+  if (!_webState) {
+    return nil;
+  }
+  const GURL& visible = _webState->GetVisibleURL();
+  return visible.is_valid() ? net::NSURLWithGURL(visible) : nil;
+}
+
+- (NSString*)title {
+  if (!_webState) {
+    return @"";
+  }
+  return base::SysUTF16ToNSString(_webState->GetTitle()) ?: @"";
+}
+
+- (BOOL)isLoading {
+  return _webState ? _webState->IsLoading() : NO;
+}
+
+- (double)estimatedProgress {
+  return _webState ? _webState->GetLoadingProgress() : 0.0;
+}
+
+- (BOOL)canGoBack {
+  return _webState && _webState->GetNavigationManager()->CanGoBack();
+}
+
+- (BOOL)canGoForward {
+  return _webState && _webState->GetNavigationManager()->CanGoForward();
+}
+
+- (BOOL)usesDesktopUserAgent {
+  if (!_webState) {
+    return _prefersDesktopUserAgent;
+  }
+  if (web::NavigationItem* item =
+          _webState->GetNavigationManager()->GetVisibleItem()) {
+    return item->GetUserAgentType() == web::UserAgentType::DESKTOP;
+  }
+  return _prefersDesktopUserAgent;
+}
+
+- (nullable UIColor*)pageCanvasColor {
+  if (!_webState) {
+    return nil;
+  }
+  return _webState->GetThemeColor() ?: _webState->GetUnderPageBackgroundColor();
+}
+
+- (BOOL)isWebFullscreen {
+  return _webState ? _webState->IsWebPageInFullscreenMode() : NO;
+}
+
+- (void)loadURL:(NSURL*)url {
+  if (!_webState || !url) {
+    return;
+  }
+  const GURL gurl = net::GURLWithNSURL(url);
+  if (!gurl.is_valid()) {
+    return;
+  }
+  if (_prefersDesktopUserAgent) {
+    content::WebContents* wc =
+        static_cast<web::ContentWebState*>(_webState)->GetWebContents();
+    if (wc) {
+      web::SetDesktopUserAgentOverride(wc);
+      content::NavigationController::LoadURLParams params(gurl);
+      params.transition_type = ui::PAGE_TRANSITION_TYPED;
+      params.override_user_agent =
+          content::NavigationController::UA_OVERRIDE_TRUE;
+      wc->GetController().LoadURLWithParams(params);
+      return;
+    }
+  }
+  web::NavigationManager::WebLoadParams params(gurl);
+  params.transition_type = ui::PAGE_TRANSITION_TYPED;
+  _webState->GetNavigationManager()->LoadURLWithParams(params);
+}
+
+- (void)goBack {
+  if (_webState && _webState->GetNavigationManager()->CanGoBack()) {
+    _webState->GetNavigationManager()->GoBack();
+  }
+}
+
+- (void)goForward {
+  if (_webState && _webState->GetNavigationManager()->CanGoForward()) {
+    _webState->GetNavigationManager()->GoForward();
+  }
+}
+
+- (void)reload {
+  if (_webState) {
+    _webState->GetNavigationManager()->Reload(web::ReloadType::NORMAL,
+                                              /*check_for_repost=*/true);
+  }
+}
+
+- (void)stopLoading {
+  if (_webState) {
+    _webState->Stop();
+  }
+}
+
+- (void)setUsesDesktopUserAgent:(BOOL)desktop {
+  _prefersDesktopUserAgent = desktop;
+  if (!_webState) {
+    return;
+  }
+  web::NavigationManager* nav = _webState->GetNavigationManager();
+  if (nav->GetLastCommittedItem()) {
+    nav->ReloadWithUserAgentType(desktop ? web::UserAgentType::DESKTOP
+                                         : web::UserAgentType::MOBILE);
+  }
+  [self notifyUpdated];
+}
+
+- (void)presentFindInPage {
+  if (!_webState || !_webState->IsFindInteractionSupported()) {
+    return;
+  }
+  if (!_webState->IsFindInteractionEnabled()) {
+    _webState->SetFindInteractionEnabled(true);
+  }
+  id<CRWFindInteraction> find = _webState->GetFindInteraction();
+  if (find && _webState->GetView().window) {
+    [find presentFindNavigatorShowingReplace:NO];
+  }
+}
+
+- (void)setPageZoomScale:(CGFloat)scale {
+  if (!_webState || scale <= 0.0 || !std::isfinite(scale)) {
+    return;
+  }
+  _zoomScale = static_cast<double>(scale);
+  [self applyZoomIfNeeded];
+}
+
+- (void)takeSnapshotWithCompletion:(void (^)(UIImage* _Nullable))completion {
+  CHECK([NSThread isMainThread]);
+  if (!_webState) {
+    completion(nil);
+    return;
+  }
+  UIView* view = _webState->GetView();
+  if (!view || CGRectIsEmpty(view.bounds)) {
+    completion(nil);
+    return;
+  }
+  UIGraphicsImageRendererFormat* format =
+      [UIGraphicsImageRendererFormat preferredFormat];
+  format.opaque = YES;
+  UIGraphicsImageRenderer* renderer =
+      [[UIGraphicsImageRenderer alloc] initWithBounds:view.bounds
+                                               format:format];
+  UIImage* image = [renderer
+      imageWithActions:^(UIGraphicsImageRendererContext* context) {
+        if (view.window) {
+          [view drawViewHierarchyInRect:view.bounds afterScreenUpdates:NO];
+        } else {
+          [view.layer renderInContext:context.CGContext];
+        }
+      }];
+  completion(image);
+}
+
+#pragma mark - FileUploadPanelCommands
+
+- (void)showFileUploadPanel {
+  if (!_webState) {
+    return;
+  }
+  ChooseFileTabHelper* helper = ChooseFileTabHelper::FromWebState(_webState);
+  if (!helper || !helper->IsChoosingFiles()) {
+    return;
+  }
+  helper->SetIsPresentingFilePicker(true);
+  ChooseFileController* expectedController = helper->GetChooseFileController();
+  const ChooseFileEvent event = helper->GetChooseFileEvent();
+  __weak CuriumTabHost* weakSelf = self;
+  [_browserHost tabHost:self
+      runFileChooserWithEvent:event
+                   completion:^(NSArray<NSURL*>* _Nullable fileURLs) {
+                     CuriumTabHost* strongSelf = weakSelf;
+                     if (!strongSelf || !strongSelf->_webState) {
+                       return;
+                     }
+                     ChooseFileTabHelper* currentHelper =
+                         ChooseFileTabHelper::FromWebState(
+                             strongSelf->_webState);
+                     if (!currentHelper || !currentHelper->IsChoosingFiles() ||
+                         currentHelper->GetChooseFileController() !=
+                             expectedController) {
+                       return;
+                     }
+                     NSArray<NSURL*>* resolvedURLs = fileURLs ?: @[];
+                     for (NSURL* fileURL in resolvedURLs) {
+                       currentHelper->AddFileUrlReadyForSelection(
+                           fileURL, [NSNull null]);
+                     }
+                     currentHelper->StopChoosingFiles(resolvedURLs, nil, nil);
+                   }];
+}
+
+- (void)hideFileUploadPanel {
+  if (!_webState) {
+    return;
+  }
+  ChooseFileTabHelper* helper = ChooseFileTabHelper::FromWebState(_webState);
+  if (helper && helper->IsChoosingFiles()) {
+    helper->StopChoosingFiles(@[], nil, nil);
+  }
+}
+
+#pragma mark - Private
+
+- (void)applyZoomIfNeeded {
+  if (!_webState || !_zoomScale.has_value()) {
+    return;
+  }
+  content::WebContents* wc =
+      static_cast<web::ContentWebState*>(_webState)->GetWebContents();
+  if (!wc || !wc->GetPrimaryMainFrame()) {
+    return;
+  }
+  content::HostZoomMap* zoom_map = content::HostZoomMap::GetForWebContents(wc);
+  if (!zoom_map) {
+    return;
+  }
+  zoom_map->SetTemporaryZoomLevel(wc->GetPrimaryMainFrame()->GetGlobalId(),
+                                  blink::ZoomFactorToZoomLevel(*_zoomScale));
+}
+
+- (void)notifyUpdated {
+  if (!_webState || _pendingUpdateNotification) {
+    return;
+  }
+  _pendingUpdateNotification = YES;
+  __weak CuriumTabHost* weakSelf = self;
+  dispatch_async(dispatch_get_main_queue(), ^{
+    CuriumTabHost* strongSelf = weakSelf;
+    if (!strongSelf) {
+      return;
+    }
+    strongSelf->_pendingUpdateNotification = NO;
+    if (!strongSelf->_webState) {
+      return;
+    }
+    [strongSelf->_browserHost tabHostDidUpdate:strongSelf];
+  });
+}
+
+- (void)handleNavigationCommitted {
+  [self applyZoomIfNeeded];
+}
+
+- (void)handleWebStateDestroyed {
+  [self detach];
+}
+
+- (void)handleResourceLoad:(const blink::mojom::ResourceLoadInfo&)info {
+  NSURL* ns_url = net::NSURLWithGURL(info.final_url.is_valid()
+                                         ? info.final_url
+                                         : info.original_url);
+  if (!ns_url) {
+    return;
+  }
+  NSString* mime_type =
+      info.mime_type.empty() ? nil : base::SysUTF8ToNSString(info.mime_type);
+  const NSInteger status =
+      info.http_status_code > 0 ? info.http_status_code : 0;
+  const int64_t raw_bytes = static_cast<int64_t>(info.raw_body_bytes.InBytes());
+  const int64_t content_length = raw_bytes > 0 ? raw_bytes : -1;
+  __weak CuriumTabHost* weakSelf = self;
+  dispatch_async(dispatch_get_main_queue(), ^{
+    CuriumTabHost* strongSelf = weakSelf;
+    if (!strongSelf || !strongSelf->_webState) {
+      return;
+    }
+    [strongSelf->_browserHost tabHost:strongSelf
+                   didLoadResourceURL:ns_url
+                             mimeType:mime_type
+                       httpStatusCode:status
+                        contentLength:content_length];
+  });
+}
+
+@end
