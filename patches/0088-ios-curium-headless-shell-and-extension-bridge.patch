+class CrIOSExtensionPopupWebStateDelegate final : public web::WebStateDelegate {
+ public:
+  explicit CrIOSExtensionPopupWebStateDelegate(void (^on_close)(void))
+      : on_close_([on_close copy]) {}
+  ~CrIOSExtensionPopupWebStateDelegate() override = default;
+
+  void CloseWebState(web::WebState* source) override {
+    if (on_close_) {
