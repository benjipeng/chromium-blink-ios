+class CuriumWebStateListObserver final : public WebStateListObserver {
+ public:
+  CuriumWebStateListObserver(CuriumBrowserHost* owner, WebStateList* list)
+      : owner_(owner) {
+    observation_.Observe(list);
+  }
+
+  void WebStateListDidChange(WebStateList* web_state_list,
+                             const WebStateListChange& change,
+                             const WebStateListStatus& status) override {
+    switch (change.type()) {
+      case WebStateListChange::Type::kInsert:
+        [owner_
+            handleWebStateInserted:change.As<WebStateListChangeInsert>()
+                                       .inserted_web_state()];
+        break;
+      case WebStateListChange::Type::kDetach:
+        [owner_
+            handleWebStateDetached:change.As<WebStateListChangeDetach>()
+                                       .detached_web_state()];
+        break;
+      case WebStateListChange::Type::kReplace: {
+        const auto& replace = change.As<WebStateListChangeReplace>();
+        [owner_ handleWebStateDetached:replace.replaced_web_state()];
+        [owner_ handleWebStateInserted:replace.inserted_web_state()];
+        break;
+      }
+      case WebStateListChange::Type::kMove:
+      case WebStateListChange::Type::kStatusOnly:
+      case WebStateListChange::Type::kGroupCreate:
+      case WebStateListChange::Type::kGroupVisualDataUpdate:
+      case WebStateListChange::Type::kGroupMove:
+      case WebStateListChange::Type::kGroupDelete:
+        break;
+    }
+    if (status.active_web_state_change()) {
+      [owner_ handleActiveWebStateChanged:status.old_active_web_state
+                                newActive:status.new_active_web_state];
+    }
+    if (change.type() != WebStateListChange::Type::kStatusOnly ||
+        status.active_web_state_change()) {
+      [owner_ scheduleNotifyTabsUpdated];
+    }
+  }
+
+ private:
+  __weak CuriumBrowserHost* owner_;
+  base::ScopedObservation<WebStateList, WebStateListObserver> observation_{this};
+};
+
+void OnCookieListFetched(
+    void (^completion)(NSString* _Nullable),
+    const net::CookieAccessResultList& cookies,
+    const net::CookieAccessResultList& excluded_cookies) {
+  if (cookies.empty()) {
+    completion(nil);
+    return;
+  }
+  const std::string line = net::CanonicalCookie::BuildCookieLine(cookies);
+  completion(line.empty() ? nil : base::SysUTF8ToNSString(line));
+}
+
+}  // namespace
+
+@implementation CuriumBrowserHost {
+  raw_ptr<Browser> _browser;
+  std::unique_ptr<CuriumWebStateDelegate> _webStateDelegate;
+  std::unique_ptr<CuriumWebStateListObserver> _listObserver;
+  std::map<web::WebState*, __strong CuriumTabHost*> _tabHosts;
+  NSMutableArray<CuriumDownloadTask*>* _downloads;
+  BOOL _pendingTabsNotification;
+  BOOL _isShutdown;
+}
+
+@synthesize delegate = _delegate;
+
+- (instancetype)initWithBrowser:(Browser*)browser
+                     sceneState:(SceneState*)sceneState {
+  self = [super init];
+  if (self) {
+    CHECK(browser);
+    _browser = browser;
+    _downloads = [[NSMutableArray alloc] init];
+    _webStateDelegate = std::make_unique<CuriumWebStateDelegate>(browser, self);
+    WebStateList* list = browser->GetWebStateList();
+    _listObserver = std::make_unique<CuriumWebStateListObserver>(self, list);
+
+    for (int i = 0; i < list->count(); ++i) {
+      [self handleWebStateInserted:list->GetWebStateAt(i)];
+    }
+  }
+  return self;
+}
+
+- (void)dealloc {
+  [self shutdown];
+}
+
+- (void)shutdown {
+  if (_isShutdown) {
+    return;
+  }
+  _isShutdown = YES;
+
+  for (CuriumDownloadTask* task in _downloads) {
+    [task invalidate];
+  }
+  [_downloads removeAllObjects];
+
+  _listObserver.reset();
+
+  CuriumDownloadRouter* downloadRouter = CuriumDownloadRouter::GetInstance();
+  for (auto& [ws, tabHost] : _tabHosts) {
+    downloadRouter->UnregisterWebState(ws);
+    if (ws && ws->GetDelegate() == _webStateDelegate.get()) {
+      ws->SetDelegate(nullptr);
+    }
+    [tabHost detach];
+  }
+  _tabHosts.clear();
+  _webStateDelegate.reset();
+  _browser = nullptr;
+}
+
+#pragma mark - CrIOSBrowserHostV1
+
+- (NSArray<id<CrIOSTabHostingV1>>*)tabs {
+  if (_isShutdown || !_browser) {
+    return @[];
+  }
+  WebStateList* list = _browser->GetWebStateList();
+  NSMutableArray<id<CrIOSTabHostingV1>>* result =
+      [NSMutableArray arrayWithCapacity:list->count()];
+  for (int i = 0; i < list->count(); ++i) {
+    if (CuriumTabHost* tab = [self tabHostForWebState:list->GetWebStateAt(i)]) {
+      [result addObject:tab];
+    }
+  }
+  return [result copy];
+}
+
+- (nullable id<CrIOSTabHostingV1>)activeTab {
+  if (_isShutdown || !_browser) {
+    return nil;
+  }
+  return [self
+      tabHostForWebState:_browser->GetWebStateList()->GetActiveWebState()];
+}
+
+- (nullable id<CrIOSTabHostingV1>)createTabWithURL:(nullable NSURL*)url
+                                          activate:(BOOL)activate {
+  CHECK([NSThread isMainThread]);
+  if (_isShutdown || !_browser) {
+    return nil;
+  }
+  WebStateList* list = _browser->GetWebStateList();
+  if (list->IsMutating()) {
+    return nil;
+  }
+  web::WebState::CreateParams create_params(_browser->GetProfile());
+  std::unique_ptr<web::WebState> web_state =
+      web::WebState::Create(create_params);
+  if (!web_state) {
+    return nil;
+  }
+  web::WebState* raw_ws = web_state.get();
+  if (url) {
+    const GURL gurl = net::GURLWithNSURL(url);
+    if (gurl.is_valid()) {
+      web::NavigationManager::WebLoadParams load_params(gurl);
+      load_params.transition_type = ui::PAGE_TRANSITION_TYPED;
+      raw_ws->GetNavigationManager()->LoadURLWithParams(load_params);
+    }
+  }
+  list->InsertWebState(std::move(web_state),
+                       WebStateList::InsertionParams::AtIndex(list->count())
+                           .Activate(activate || list->empty()));
+  return [self tabHostForWebState:raw_ws];
+}
+
+- (BOOL)activateTabWithID:(NSString*)tabID {
+  CHECK([NSThread isMainThread]);
+  if (_isShutdown || !_browser || tabID.length == 0) {
+    return NO;
+  }
+  WebStateList* list = _browser->GetWebStateList();
+  for (int i = 0; i < list->count(); ++i) {
+    if (CuriumTabHost* tab = [self tabHostForWebState:list->GetWebStateAt(i)]) {
+      if ([tab.tabID isEqualToString:tabID]) {
+        list->ActivateWebStateAt(i);
+        return YES;
+      }
+    }
+  }
+  return NO;
+}
+
+- (BOOL)closeTabWithID:(NSString*)tabID {
+  CHECK([NSThread isMainThread]);
+  if (_isShutdown || !_browser || tabID.length == 0) {
+    return NO;
+  }
+  WebStateList* list = _browser->GetWebStateList();
+  for (int i = 0; i < list->count(); ++i) {
+    if (CuriumTabHost* tab = [self tabHostForWebState:list->GetWebStateAt(i)]) {
+      if ([tab.tabID isEqualToString:tabID]) {
+        list->CloseWebStateAt(i, WebStateList::ClosingReason::kUserAction);
+        return YES;
+      }
+    }
+  }
+  return NO;
+}
+
+- (void)clearBrowsingDataOfTypes:(CrIOSBrowsingDataTypes)types
+                   modifiedSince:(NSDate*)date
+                      completion:(void (^)(NSError* _Nullable))completion {
+  CHECK([NSThread isMainThread]);
+  if (_isShutdown || !_browser || types == 0) {
+    completion(nil);
+    return;
+  }
+  content::BrowserContext* context =
+      web::ContentBrowserContext::FromBrowserState(_browser->GetProfile());
+  content::StoragePartition* partition =
+      context ? context->GetDefaultStoragePartition() : nullptr;
+  if (!partition) {
+    completion(nil);
+    return;
+  }
+
+  const base::Time begin = date ? base::Time::FromNSDate(date) : base::Time();
+  const base::Time end = base::Time::Max();
+
+  uint32_t partition_mask = 0;
+  if (types & CrIOSBrowsingDataTypesCookies) {
+    partition_mask |= content::StoragePartition::REMOVE_DATA_MASK_COOKIES;
+  }
+  if (types & CrIOSBrowsingDataTypesSiteStorage) {
+    partition_mask |=
+        content::StoragePartition::REMOVE_DATA_MASK_FILE_SYSTEMS |
+        content::StoragePartition::REMOVE_DATA_MASK_INDEXEDDB |
+        content::StoragePartition::REMOVE_DATA_MASK_LOCAL_STORAGE |
+        content::StoragePartition::REMOVE_DATA_MASK_WEBSQL_DEPRECATED |
+        content::StoragePartition::REMOVE_DATA_MASK_SERVICE_WORKERS |
+        content::StoragePartition::REMOVE_DATA_MASK_CACHE_STORAGE |
+        content::StoragePartition::REMOVE_DATA_MASK_MEDIA_LICENSES |
+        content::StoragePartition::REMOVE_DATA_MASK_BACKGROUND_FETCH |
+        content::StoragePartition::REMOVE_DATA_MASK_DEVICE_BOUND_SESSIONS;
+  }
+  if (types & CrIOSBrowsingDataTypesCache) {
+    partition_mask |= content::StoragePartition::REMOVE_DATA_MASK_SHADER_CACHE;
+  }
+
+  const bool clear_cache = (types & CrIOSBrowsingDataTypesCache) != 0;
+  const bool clear_downloads =
+      (types & CrIOSBrowsingDataTypesDownloads) != 0 &&
+      context->GetDownloadManager() != nullptr;
+
+  int pending_ops = (partition_mask != 0 ? 1 : 0) + (clear_cache ? 2 : 0) +
+                    (clear_downloads ? 1 : 0);
+  if (pending_ops == 0) {
+    completion(nil);
+    return;
+  }
+
+  void (^copiedCompletion)(NSError* _Nullable) = [completion copy];
+  base::RepeatingClosure barrier = base::BarrierClosure(
+      pending_ops, base::BindOnce(^(void) {
+        copiedCompletion(nil);
+      }));
+
+  if (partition_mask != 0) {
+    network::mojom::CookieDeletionFilterPtr cookie_filter;
+    if (partition_mask & content::StoragePartition::REMOVE_DATA_MASK_COOKIES) {
+      cookie_filter = network::mojom::CookieDeletionFilter::New();
+    }
+    partition->ClearData(
+        partition_mask, /*filter_builder=*/nullptr,
+        content::StoragePartition::StorageKeyPolicyMatcherFunction(),
+        std::move(cookie_filter),
+        /*perform_storage_cleanup=*/false, begin, end, barrier);
+  }
+  if (clear_cache) {
+    partition->GetNetworkContext()->ClearHttpCache(begin, end, nullptr,
+                                                   barrier);
+    partition->ClearCodeCaches(begin, end,
+                               base::RepeatingCallback<bool(const GURL&)>(),
+                               barrier);
+  }
+  if (clear_downloads) {
+    context->GetDownloadManager()->RemoveDownloadsByURLAndTime(
+        base::BindRepeating([](const GURL&) { return true; }), begin, end,
+        barrier);
+  }
+}
+
+- (void)cookieHeaderForURL:(NSURL*)url
+               inTabWithID:(NSString*)tabID
+                completion:(void (^)(NSString* _Nullable))completion {
+  CHECK([NSThread isMainThread]);
+  if (_isShutdown || !_browser || !url) {
+    completion(nil);
+    return;
+  }
+  const GURL gurl = net::GURLWithNSURL(url);
+  if (!gurl.is_valid()) {
+    completion(nil);
+    return;
+  }
+
+  CuriumTabHost* tab = [self tabHostForTabID:tabID];
+  web::WebState* ws = tab ? tab.webState : nullptr;
+  content::BrowserContext* context =
+      web::ContentBrowserContext::FromBrowserState(_browser->GetProfile());
+  content::StoragePartition* partition = nullptr;
+  net::CookiePartitionKeyCollection key_collection;
+
+  if (ws) {
+    auto* cws = static_cast<web::ContentWebState*>(ws);
+    if (content::WebContents* wc = cws->GetWebContents()) {
+      partition = wc->GetBrowserContext()->GetStoragePartition(
+          wc->GetSiteInstance());
+      const GURL& top_url = ws->GetLastCommittedURL();
+      if (top_url.is_valid() && !net::SchemefulSite(top_url).opaque()) {
+        key_collection = net::CookiePartitionKeyCollection::MatchesSite(
+            net::SchemefulSite(top_url));
+      }
+    }
+  }
+  if (!partition && context) {
+    partition = context->GetDefaultStoragePartition();
+  }
+  if (!partition || !partition->GetCookieManagerForBrowserProcess()) {
+    completion(nil);
+    return;
+  }
+
+  void (^copiedCompletion)(NSString* _Nullable) = [completion copy];
+  partition->GetCookieManagerForBrowserProcess()->GetCookieList(
+      gurl, net::CookieOptions::MakeAllInclusive(), key_collection,
+      base::BindOnce(&OnCookieListFetched, copiedCompletion));
+}
+
+#pragma mark - Internal / Observer routing
+
+- (nullable CuriumTabHost*)tabHostForWebState:(web::WebState*)webState {
+  if (!webState) {
+    return nil;
+  }
+  auto it = _tabHosts.find(webState);
+  return it != _tabHosts.end() ? it->second : nil;
+}
+
+- (nullable CuriumTabHost*)tabHostForTabID:(NSString*)tabID {
+  if (tabID.length == 0) {
+    return nil;
+  }
+  for (const auto& [ws, tabHost] : _tabHosts) {
+    if ([tabHost.tabID isEqualToString:tabID]) {
+      return tabHost;
+    }
+  }
+  return nil;
+}
+
+- (void)scheduleNotifyTabsUpdated {
+  if (_isShutdown || _pendingTabsNotification) {
+    return;
+  }
+  _pendingTabsNotification = YES;
+  __weak CuriumBrowserHost* weakSelf = self;
+  dispatch_async(dispatch_get_main_queue(), ^{
+    CuriumBrowserHost* strongSelf = weakSelf;
+    if (!strongSelf) {
+      return;
+    }
+    strongSelf->_pendingTabsNotification = NO;
+    if (strongSelf->_isShutdown) {
+      return;
+    }
+    [strongSelf->_delegate browserHostDidUpdateTabs:strongSelf];
+  });
+}
+
+- (void)handleWebStateInserted:(web::WebState*)webState {
+  if (!webState || _isShutdown) {
+    return;
+  }
+  webState->ForceRealized();
+  webState->SetDelegate(_webStateDelegate.get());
+  __weak CuriumBrowserHost* weakSelf = self;
+  CuriumDownloadRouter::GetInstance()->RegisterWebState(
+      webState,
+      base::BindRepeating(^(web::WebState* source_ws,
+                            std::unique_ptr<web::DownloadTask> task) {
+        [weakSelf handleDownloadCreated:std::move(task) webState:source_ws];
+      }));
+  if (!_tabHosts.contains(webState)) {
+    _tabHosts.emplace(
+        webState, [[CuriumTabHost alloc] initWithWebState:webState
+                                              browserHost:self]);
+  }
+}
+
+- (void)handleWebStateDetached:(web::WebState*)webState {
+  if (!webState) {
+    return;
+  }
+  CuriumDownloadRouter::GetInstance()->UnregisterWebState(webState);
+  if (webState->GetDelegate() == _webStateDelegate.get()) {
+    webState->SetDelegate(nullptr);
+  }
+  auto it = _tabHosts.find(webState);
+  if (it != _tabHosts.end()) {
+    [it->second detach];
+    _tabHosts.erase(it);
+  }
+}
+
+- (void)handleActiveWebStateChanged:(web::WebState*)oldActive
+                          newActive:(web::WebState*)newActive {
+  if (oldActive && oldActive->IsRealized()) {
+    oldActive->WasHidden();
+  }
+  if (newActive) {
+    newActive->WasShown();
+  }
+}
+
+- (void)tabHostDidUpdate:(CuriumTabHost*)tabHost {
+  if (!_isShutdown) {
+    [_delegate browserHost:self didUpdateTab:tabHost];
+  }
+}
+
+- (void)tabHost:(CuriumTabHost*)tabHost
+    didLoadResourceURL:(NSURL*)url
+              mimeType:(nullable NSString*)mimeType
+        httpStatusCode:(NSInteger)httpStatusCode
+         contentLength:(int64_t)contentLength {
+  if (_isShutdown) {
+    return;
+  }
+  if ([_delegate respondsToSelector:@selector
+                 (browserHost:tab:didLoadResourceURL:mimeType:httpStatusCode:contentLength:)]) {
+    [_delegate browserHost:self
+                       tab:tabHost
+        didLoadResourceURL:url
+                  mimeType:mimeType
+            httpStatusCode:httpStatusCode
+             contentLength:contentLength];
+  }
+}
+
+- (void)tabHost:(CuriumTabHost*)tabHost
+    runFileChooserWithEvent:(const ChooseFileEvent&)event
+                 completion:(void (^)(NSArray<NSURL*>* _Nullable))completion {
+  if (_isShutdown ||
+      ![_delegate respondsToSelector:@selector
+                  (browserHost:runFileChooserForTab:acceptTypes:allowsMultipleSelection:captureHint:completion:)]) {
+    completion(nil);
+    return;
+  }
+
+  NSMutableArray<NSString*>* acceptTypes = [NSMutableArray array];
+  for (const std::string& mime : event.accept_mime_types) {
+    if (NSString* s = base::SysUTF8ToNSString(mime)) {
+      [acceptTypes addObject:s];
+    }
+  }
+  for (const std::string& ext : event.accept_file_extensions) {
+    if (NSString* s = base::SysUTF8ToNSString(ext)) {
+      [acceptTypes addObject:s];
+    }
+  }
+  NSString* captureHint = nil;
+  switch (event.capture) {
+    case ChooseFileCaptureType::kUser:
+      captureHint = @"user";
+      break;
+    case ChooseFileCaptureType::kEnvironment:
+      captureHint = @"environment";
+      break;
+    case ChooseFileCaptureType::kNone:
+      captureHint = nil;
+      break;
+  }
+
+  __block BOOL completed = NO;
+  [_delegate browserHost:self
+         runFileChooserForTab:tabHost
+                  acceptTypes:[acceptTypes copy]
+      allowsMultipleSelection:event.allow_multiple_files
+                  captureHint:captureHint
+                   completion:^(NSArray<NSURL*>* _Nullable fileURLs) {
+                     if (completed) {
+                       return;
+                     }
+                     completed = YES;
+                     completion(fileURLs);
+                   }];
+}
+
+- (void)handleDownloadCreated:(std::unique_ptr<web::DownloadTask>)task
+                     webState:(web::WebState*)webState {
+  if (_isShutdown || !task) {
+    return;
+  }
+  CuriumTabHost* sourceTab = [self tabHostForWebState:webState];
+  if (![_delegate respondsToSelector:@selector(browserHost:didCreateDownload:)]) {
+    task->Cancel();
+    return;
+  }
+  CuriumDownloadTask* wrapper =
+      [[CuriumDownloadTask alloc] initWithDownloadTask:std::move(task)
+                                           sourceTabID:sourceTab.tabID];
+  [_downloads addObject:wrapper];
+  [_delegate browserHost:self didCreateDownload:wrapper];
+}
+
+
+
+@end
