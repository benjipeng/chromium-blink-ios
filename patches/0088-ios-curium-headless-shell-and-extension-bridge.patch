+class WebState;
+}  // namespace web
+
+// Routes web::DownloadTask instances created for WebStates owned by a headless
+// CuriumBrowserHost before BrowserDownloadService falls back to Chrome's UI.
+class CuriumDownloadRouter {
+ public:
+  using DownloadHandler =
+      base::RepeatingCallback<void(web::WebState*,
+                                   std::unique_ptr<web::DownloadTask>)>;
+
+  static CuriumDownloadRouter* GetInstance();
+
+  CuriumDownloadRouter(const CuriumDownloadRouter&) = delete;
+  CuriumDownloadRouter& operator=(const CuriumDownloadRouter&) = delete;
+
+  void RegisterWebState(web::WebState* web_state, DownloadHandler handler);
+  void UnregisterWebState(web::WebState* web_state);
+
+  // If `web_state` is registered, takes ownership of `task`, forwards it to
+  // the owning CuriumBrowserHost, and returns true. Otherwise leaves `task`
+  // untouched and returns false.
+  bool RouteDownload(web::WebState* web_state,
+                     std::unique_ptr<web::DownloadTask>& task);
+
+ private:
+  friend class base::NoDestructor<CuriumDownloadRouter>;
+
+  CuriumDownloadRouter();
+  ~CuriumDownloadRouter();
+
+  std::map<web::WebState*, DownloadHandler> handlers_;
+};
+
+#endif  // IOS_CHROME_BROWSER_CURIUM_CURIUM_DOWNLOAD_ROUTER_H_
