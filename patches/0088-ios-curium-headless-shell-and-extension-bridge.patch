+void NotifyIOSExtensionActionPresentationChanged(
+    const std::string& extension_id) {
+  if (![NSThread isMainThread]) {
+    std::string copy = extension_id;
+    dispatch_async(dispatch_get_main_queue(), ^{
+      NotifyIOSExtensionActionPresentationChanged(copy);
+    });
+    return;
+  }
+  NSString* ns_id =
+      extension_id.empty() ? nil : base::SysUTF8ToNSString(extension_id);
+  NSArray<CrIOSActionPresentationObserverToken*>* snapshot =
+      [GetActionPresentationObservers() allObjects];
+  for (CrIOSActionPresentationObserverToken* token in snapshot) {
+    [token notifyExtensionID:ns_id];
+  }
+}
