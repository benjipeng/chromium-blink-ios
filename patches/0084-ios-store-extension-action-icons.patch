@@ -0,0 +1,126 @@
+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "ios/chrome/browser/extensions/model/ios_action_api.h"
+
+#include <limits>
+#include <string>
+
+#include "base/files/file_path.h"
+#include "base/functional/bind.h"
+#include "base/strings/string_number_conversions.h"
+#include "base/values.h"
+#include "extensions/browser/extension_action.h"
+#include "extensions/browser/extension_action_manager.h"
+#include "extensions/browser/extension_registry.h"
+#include "extensions/browser/extensions_browser_client.h"
+#include "extensions/browser/image_loader.h"
+#include "extensions/common/constants.h"
+#include "extensions/common/extension.h"
+#include "extensions/common/file_util.h"
+#include "ui/gfx/geometry/size.h"
+#include "ui/gfx/image/image.h"
+#include "url/gurl.h"
+
+namespace extensions {
+namespace {
+
+constexpr int kIconPixels = 64;
+
+std::string ChooseIcon(const base::Value& path) {
+  if (path.is_string()) {
+    return path.GetString();
+  }
+  if (!path.is_dict()) {
+    return {};
+  }
+  // Prefer the smallest image at or above the display size.
+  std::string best;
+  int best_rank = std::numeric_limits<int>::max();
+  for (const auto [dimension, value] : path.GetDict()) {
+    int pixels = 0;
+    if (!value.is_string() || !base::StringToInt(dimension, &pixels) ||
+        pixels <= 0 || pixels > 1024) {
+      continue;
+    }
+    const int rank = pixels >= kIconPixels ? pixels - kIconPixels
+                                          : 1024 + kIconPixels - pixels;
+    if (rank < best_rank) {
+      best_rank = rank;
+      best = value.GetString();
+    }
+  }
+  return best;
+}
+
+bool IsLiveTab(content::BrowserContext* context, int tab_id) {
+  return tab_id == ExtensionAction::kDefaultTabId ||
+         ExtensionsBrowserClient::Get()->IsValidTabId(
+             context, tab_id, /*include_incognito=*/false, nullptr);
+}
+
+}  // namespace
+
+ExtensionFunction::ResponseAction IOSActionSetIconFunction::Run() {
+  EXTENSION_FUNCTION_VALIDATE(args().size() == 1u && args()[0].is_dict());
+  const auto& details = args()[0].GetDict();
+  const auto* path = details.Find("path");
+  const std::string selected = path ? ChooseIcon(*path) : std::string();
+  if (!extension() || selected.empty()) {
+    return RespondNow(Error("A packaged icon path is required."));
+  }
+  // Resolve relative to the worker or extension page, just as Chrome does.
+  const GURL& sender = source_url();
+  const GURL& base_url =
+      sender.SchemeIs(kExtensionScheme) && sender.host() == extension()->id()
+          ? sender
+          : extension()->url();
+  const GURL icon_url = base_url.Resolve(selected);
+  if (!icon_url.SchemeIs(kExtensionScheme) ||
+      icon_url.host() != extension()->id()) {
+    return RespondNow(Error("The icon must be inside the extension package."));
+  }
+  const auto file = file_util::ExtensionURLToRelativeFilePath(icon_url);
+  if (file.empty() || file.IsAbsolute() || file.ReferencesParent()) {
+    return RespondNow(Error("The icon must be inside the extension package."));
+  }
+  const int tab_id =
+      details.FindInt("tabId").value_or(ExtensionAction::kDefaultTabId);
+  if (!IsLiveTab(browser_context(), tab_id)) {
+    return RespondNow(Error("No tab with that ID."));
+  }
+  auto* loader = ImageLoader::Get(browser_context());
+  if (!loader) {
+    return RespondNow(Error("The extension image loader is unavailable."));
+  }
+  loader->LoadImageAsync(
+      extension(), extension()->GetResource(file),
+      gfx::Size(kIconPixels, kIconPixels),
+      base::BindOnce(&IOSActionSetIconFunction::SetLoadedIcon, this, tab_id));
+  return did_respond() ? AlreadyResponded() : RespondLater();
+}
+
+void IOSActionSetIconFunction::SetLoadedIcon(int tab_id, const gfx::Image& image) {
+  if (image.IsEmpty() || !browser_context() || !extension()) {
+    Respond(Error("The extension icon could not be loaded."));
+    return;
+  }
+  auto* registry = ExtensionRegistry::Get(browser_context());
+  if (!registry ||
+      registry->enabled_extensions().GetByID(extension()->id()) != extension() ||
+      !IsLiveTab(browser_context(), tab_id)) {
+    Respond(Error("The extension or tab is no longer available."));
+    return;
+  }
+  auto* manager = ExtensionActionManager::Get(browser_context());
+  auto* action = manager ? manager->GetExtensionAction(*extension()) : nullptr;
+  if (!action) {
+    Respond(Error("The extension has no action."));
+    return;
+  }
+  action->SetIcon(tab_id, image);
+  Respond(NoArguments());
+}
+
+}  // namespace extensions
