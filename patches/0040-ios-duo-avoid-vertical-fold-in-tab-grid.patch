+// Report a vertical reserved region in resting viewport coordinates. A page in
+// the tab grid's paging scroll view shares the scroll view's resting viewport.
+CGRect ActiveVerticalDivision(UICollectionView* collection_view) {
+  if (@available(iOS 27.1, *)) {
+    UIWindow* window = collection_view.window;
+    if (!window) {
+      return CGRectZero;
+    }
+    UIView* viewport = collection_view;
+    for (UIView* ancestor = collection_view.superview; ancestor;
+         ancestor = ancestor.superview) {
+      UIScrollView* scroll_view = [ancestor isKindOfClass:UIScrollView.class]
+                                      ? (UIScrollView*)ancestor
+                                      : nil;
+      if (scroll_view.isPagingEnabled &&
+          CGRectGetWidth(scroll_view.bounds) ==
+              CGRectGetWidth(collection_view.bounds)) {
+        viewport = scroll_view;
+        break;
+      }
+    }
+    const CGRect viewport_rect = [viewport convertRect:viewport.bounds
+                                                toView:window];
+    for (UIViewReservedRegion* division in [window
+             reservedRegionsOfKind:UIViewReservedRegionKind.divisionRegionKind]) {
+      const CGRect frame = division.frame;
+      if (!division.isActive || CGRectGetHeight(frame) <= CGRectGetWidth(frame)) {
+        continue;
+      }
+      const CGRect overlap = CGRectIntersection(frame, viewport_rect);
+      if (!CGRectIsEmpty(overlap)) {
+        return CGRectOffset(overlap, -CGRectGetMinX(viewport_rect), 0);
+      }
+    }
+  }
+  return CGRectZero;
+}
