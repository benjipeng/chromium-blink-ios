new file mode 100644
index 0000000..fbac921
--- /dev/null
+++ b/v8/src/base/platform/ios-jit-memory.cc
@@ -0,0 +1,373 @@
+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "src/base/platform/ios-jit-memory.h"
+
+#if defined(V8_OS_IOS)
+
+#include <TargetConditionals.h>
+#include <dlfcn.h>
+#include <libkern/OSCacheControl.h>
+#include <mach/mach.h>
+#include <mach/vm_map.h>
+#include <setjmp.h>
+#include <signal.h>
+#include <stdint.h>
+#include <string.h>
+#include <sys/mman.h>
+#include <sys/sysctl.h>
+#include <sys/types.h>
+#include <unistd.h>
+
+#include <mutex>
+
+extern "C" int csops(pid_t pid,
+                     unsigned int ops,
+                     void* useraddr,
+                     size_t usersize);
+
+namespace v8 {
+namespace base {
+
+std::atomic<int> IOSJitMemory::mode_{static_cast<int>(IOSJitMode::kDisabled)};
+std::atomic<uintptr_t> IOSJitMemory::txm_rx_base_{0};
+std::atomic<size_t> IOSJitMemory::txm_rx_size_{0};
+std::atomic<intptr_t> IOSJitMemory::txm_rw_delta_{0};
+
+namespace {
+
+constexpr unsigned int kCsOpsStatus = 0;
+constexpr uint32_t kCsDebugged = 0x10000000u;
+constexpr size_t kTxmPageAlign = 256 * 1024;  // Matches V8 NormalPage::kPageSize
+constexpr size_t kMinTxmPoolSize = 64 * 1024 * 1024;
+constexpr size_t kMaxTxmPoolSize = 256 * 1024 * 1024;
+constexpr uintptr_t kStikDebugStubReturn = 0xE0000069ULL;
+
+std::mutex g_init_mutex;
+bool g_initialized = false;
+bool g_txm_pool_leased = false;
+
+using PthreadJitWriteProtectFn = void (*)(int);
+using BeMemoryWitnessSupportedFn = int (*)();
+
+std::atomic<PthreadJitWriteProtectFn> g_pthread_jit_write_protect{nullptr};
+
+thread_local volatile sig_atomic_t g_jit_probe_active = 0;
+thread_local sigjmp_buf g_jit_probe_jmp;
+
+void JitProbeSignalHandler(int sig) {
+  if (g_jit_probe_active) {
+    g_jit_probe_active = 0;
+    siglongjmp(g_jit_probe_jmp, sig ? sig : 1);
+  }
+  signal(sig, SIG_DFL);
+  raise(sig);
+}
+
+struct ScopedSignalGuard {
+  static constexpr int kSignals[4] = {SIGTRAP, SIGBUS, SIGSEGV, SIGILL};
+  struct sigaction prev[4];
+  bool installed = false;
+
+  ScopedSignalGuard() {
+    struct sigaction sa;
+    memset(&sa, 0, sizeof(sa));
+    sa.sa_handler = JitProbeSignalHandler;
+    sigemptyset(&sa.sa_mask);
+    sa.sa_flags = 0;
+    for (size_t i = 0; i < 4; ++i) {
+      sigaction(kSignals[i], &sa, &prev[i]);
+    }
+    installed = true;
+  }
+
+  ~ScopedSignalGuard() {
+    g_jit_probe_active = 0;
+    if (!installed) return;
+    for (size_t i = 0; i < 4; ++i) {
+      sigaction(kSignals[i], &prev[i], nullptr);
+    }
+  }
+};
+
+constexpr int ScopedSignalGuard::kSignals[4];
+
+bool IsProcessDebugged() {
+  uint32_t flags = 0;
+  if (csops(getpid(), kCsOpsStatus, &flags, sizeof(flags)) != 0) {
+    return false;
+  }
+  return (flags & kCsDebugged) != 0;
+}
+
+bool IsProcessTraced() {
+  int mib[4] = {CTL_KERN, KERN_PROC, KERN_PROC_PID, getpid()};
+  struct kinfo_proc info;
+  memset(&info, 0, sizeof(info));
+  size_t size = sizeof(info);
+  if (sysctl(mib, 4, &info, &size, nullptr, 0) != 0 || size < sizeof(info)) {
+    return false;
+  }
+  return (info.kp_proc.p_flag & P_TRACED) != 0;
+}
+
+bool IsTracedAndDebugged() { return IsProcessDebugged() && IsProcessTraced(); }
+
+#if defined(__arm64__) || defined(__aarch64__)
+__attribute__((noinline, optnone, naked)) void JIT26Detach() {
+  __asm__ volatile(
+      "mov x16, #0\n"
+      "brk #0xf00d\n"
+      "ret\n");
+}
+
+__attribute__((noinline, optnone, naked)) void* JIT26PrepareRegion(
+    void* /*address*/,
+    size_t /*length*/) {
+  __asm__ volatile(
+      "mov x16, #1\n"
+      "brk #0xf00d\n"
+      "ret\n");
+}
+
+// Writes `mov w0, #42; ret` via |rw_addr|, invalidates icache on |rx_addr|,
+// executes |rx_addr| under ScopedSignalGuard, and zeroes the scratch bytes.
+bool RunArm64ExecutionSelfTest(void* rx_addr, void* rw_addr) {
+  constexpr uint32_t kTestCode[2] = {0x52800540u, 0xd65f03c0u};
+  ScopedSignalGuard guard;
+  if (sigsetjmp(g_jit_probe_jmp, 1) != 0) {
+    return false;
+  }
+  g_jit_probe_active = 1;
+  memcpy(rw_addr, kTestCode, sizeof(kTestCode));
+  sys_icache_invalidate(rx_addr, sizeof(kTestCode));
+  using TestFn = int (*)();
+  int result = reinterpret_cast<TestFn>(rx_addr)();
+  memset(rw_addr, 0, sizeof(kTestCode));
+  sys_icache_invalidate(rx_addr, sizeof(kTestCode));
+  g_jit_probe_active = 0;
+  return result == 42;
+}
+#endif  // defined(__arm64__) || defined(__aarch64__)
+
+void ResolveNativeWriteProtect() {
+  void* sym = dlsym(RTLD_DEFAULT, "pthread_jit_write_protect_np");
+  g_pthread_jit_write_protect.store(
+      reinterpret_cast<PthreadJitWriteProtectFn>(sym),
+      std::memory_order_release);
+}
+
+IOSJitMode ProbeNativeMapJit() {
+  const size_t page_size = static_cast<size_t>(sysconf(_SC_PAGESIZE));
+  void* mem = mmap(nullptr, page_size, PROT_READ | PROT_WRITE | PROT_EXEC,
+                   MAP_PRIVATE | MAP_ANONYMOUS | MAP_JIT, VM_MAKE_TAG(255), 0);
+  if (mem == MAP_FAILED) {
+    return IOSJitMode::kDisabled;
+  }
+
+#if !TARGET_OS_SIMULATOR
+  auto be_supported = reinterpret_cast<BeMemoryWitnessSupportedFn>(
+      dlsym(RTLD_DEFAULT,
+            "be_memory_inline_jit_restrict_with_witness_supported"));
+  if (be_supported && be_supported() != 0) {
+    munmap(mem, page_size);
+    return IOSJitMode::kBrowserEngineCore;
+  }
+#endif
+
+  ResolveNativeWriteProtect();
+  volatile bool ok = false;
+#if defined(__arm64__) || defined(__aarch64__)
+  {
+    ScopedSignalGuard guard;
+    if (sigsetjmp(g_jit_probe_jmp, 1) == 0) {
+      g_jit_probe_active = 1;
+      IOSJitMemory::SetNativeJitWriteProtected(0);
+      constexpr uint32_t kTestCode[2] = {0x52800540u, 0xd65f03c0u};
+      memcpy(mem, kTestCode, sizeof(kTestCode));
+      IOSJitMemory::SetNativeJitWriteProtected(1);
+      sys_icache_invalidate(mem, sizeof(kTestCode));
+      using TestFn = int (*)();
+      ok = (reinterpret_cast<TestFn>(mem)() == 42);
+      g_jit_probe_active = 0;
+    }
+  }
+#endif
+  munmap(mem, page_size);
+  return ok ? IOSJitMode::kNativeMapJit : IOSJitMode::kDisabled;
+}
+
+bool ProbeTxmDualMap(size_t requested_pool_size,
+                     uintptr_t* out_rx_base,
+                     size_t* out_rx_size,
+                     intptr_t* out_rw_delta) {
+#if !TARGET_OS_SIMULATOR && (defined(__arm64__) || defined(__aarch64__))
+  if (!IsTracedAndDebugged()) {
+    return false;
+  }
+
+  size_t pool_size = requested_pool_size;
+  if (pool_size < kMinTxmPoolSize) pool_size = kMinTxmPoolSize;
+  if (pool_size > kMaxTxmPoolSize) pool_size = kMaxTxmPoolSize;
+  pool_size = (pool_size + kTxmPageAlign - 1) & ~(kTxmPageAlign - 1);
+
+  const size_t alloc_size = pool_size + kTxmPageAlign;
+  void* rx_raw = nullptr;
+  {
+    ScopedSignalGuard guard;
+    if (sigsetjmp(g_jit_probe_jmp, 1) != 0) {
+      return false;
+    }
+    g_jit_probe_active = 1;
+    rx_raw = JIT26PrepareRegion(nullptr, alloc_size);
+    g_jit_probe_active = 0;
+  }
+
+  const uintptr_t rx_raw_addr = reinterpret_cast<uintptr_t>(rx_raw);
+  if (rx_raw == nullptr || rx_raw_addr == kStikDebugStubReturn ||
+      (rx_raw_addr & 0x3FFFULL) != 0) {
+    return false;
+  }
+
+  vm_address_t rw_raw_addr = 0;
+  vm_prot_t cur_prot = 0;
+  vm_prot_t max_prot = 0;
+  kern_return_t kr = vm_remap(
+      mach_task_self(), &rw_raw_addr, alloc_size, 0, VM_FLAGS_ANYWHERE,
+      mach_task_self(), static_cast<vm_address_t>(rx_raw_addr), FALSE,
+      &cur_prot, &max_prot, VM_INHERIT_NONE);
+  if (kr != KERN_SUCCESS || rw_raw_addr == 0) {
+    return false;
+  }
+
+  kr = vm_protect(mach_task_self(), rw_raw_addr, alloc_size, FALSE,
+                  VM_PROT_READ | VM_PROT_WRITE);
+  if (kr != KERN_SUCCESS) {
+    vm_deallocate(mach_task_self(), rw_raw_addr, alloc_size);
+    return false;
+  }
+
+  if (IsTracedAndDebugged()) {
+    ScopedSignalGuard guard;
+    if (sigsetjmp(g_jit_probe_jmp, 1) == 0) {
+      g_jit_probe_active = 1;
+      JIT26Detach();
+      g_jit_probe_active = 0;
+    }
+  }
+
+  const uintptr_t rx_aligned =
+      (rx_raw_addr + kTxmPageAlign - 1) & ~(kTxmPageAlign - 1);
+  const intptr_t rw_delta =
+      static_cast<intptr_t>(rw_raw_addr) - static_cast<intptr_t>(rx_raw_addr);
+  void* rw_aligned =
+      reinterpret_cast<void*>(static_cast<intptr_t>(rx_aligned) + rw_delta);
+
+  if (!RunArm64ExecutionSelfTest(reinterpret_cast<void*>(rx_aligned),
+                                 rw_aligned)) {
+    vm_deallocate(mach_task_self(), rw_raw_addr, alloc_size);
+    return false;
+  }
+
+  *out_rx_base = rx_aligned;
+  *out_rx_size = pool_size;
+  *out_rw_delta = rw_delta;
+  return true;
+#else
+  (void)requested_pool_size;
+  (void)out_rx_base;
+  (void)out_rx_size;
+  (void)out_rw_delta;
+  return false;
+#endif
+}
+
+}  // namespace
+
+// static
+IOSJitMode IOSJitMemory::Initialize(size_t pool_size_bytes,
+                                    bool allow_txm_brk) {
+  std::lock_guard<std::mutex> lock(g_init_mutex);
+  if (g_initialized) {
+    return GetMode();
+  }
+  g_initialized = true;
+
+  IOSJitMode native_mode = ProbeNativeMapJit();
+  if (native_mode != IOSJitMode::kDisabled) {
+    mode_.store(static_cast<int>(native_mode), std::memory_order_release);
+    return native_mode;
+  }
+
+  if (allow_txm_brk) {
+    uintptr_t rx_base = 0;
+    size_t rx_size = 0;
+    intptr_t rw_delta = 0;
+    if (ProbeTxmDualMap(pool_size_bytes, &rx_base, &rx_size, &rw_delta)) {
+      txm_rw_delta_.store(rw_delta, std::memory_order_relaxed);
+      txm_rx_size_.store(rx_size, std::memory_order_relaxed);
+      txm_rx_base_.store(rx_base, std::memory_order_release);
+      mode_.store(static_cast<int>(IOSJitMode::kTxmDualMap),
+                  std::memory_order_release);
+      return IOSJitMode::kTxmDualMap;
+    }
+  }
+
+  mode_.store(static_cast<int>(IOSJitMode::kDisabled),
+              std::memory_order_release);
+  return IOSJitMode::kDisabled;
+}
+
+// static
+void* IOSJitMemory::TryAcquireTxmPool(size_t length, size_t alignment) {
+  std::lock_guard<std::mutex> lock(g_init_mutex);
+  if (!IsTxmDualMap() || g_txm_pool_leased) {
+    return nullptr;
+  }
+  const uintptr_t base = txm_rx_base_.load(std::memory_order_relaxed);
+  const size_t size = txm_rx_size_.load(std::memory_order_relaxed);
+  if (base == 0 || length == 0 || length > size) {
+    return nullptr;
+  }
+  if (alignment > 1 && (base % alignment) != 0) {
+    return nullptr;
+  }
+  g_txm_pool_leased = true;
+  return reinterpret_cast<void*>(base);
+}
+
+// static
+bool IOSJitMemory::ReleaseTxmPool(void* address) {
+  std::lock_guard<std::mutex> lock(g_init_mutex);
+  if (reinterpret_cast<uintptr_t>(address) !=
+      txm_rx_base_.load(std::memory_order_relaxed)) {
+    return false;
+  }
+  g_txm_pool_leased = false;
+  return true;
+}
+
+// static
+void IOSJitMemory::SetNativeJitWriteProtected(int enable) {
+  auto fn = g_pthread_jit_write_protect.load(std::memory_order_acquire);
+  if (fn != nullptr) {
+    fn(enable);
+  }
+}
+
+}  // namespace base
+}  // namespace v8
+
+extern "C" __attribute__((visibility("default"), used)) int
+V8IOSJitPrepareForProcess(size_t pool_size_bytes, int allow_txm_brk) {
+  return static_cast<int>(v8::base::IOSJitMemory::Initialize(
+      pool_size_bytes, allow_txm_brk != 0));
+}
+
+extern "C" __attribute__((visibility("default"), used)) int
+V8IOSJitGetActiveMode(void) {
+  return static_cast<int>(v8::base::IOSJitMemory::GetMode());
+}
+
+#endif  // defined(V8_OS_IOS)
diff --git a/v8/src/base/platform/ios-jit-memory.h b/v8/src/base/platform/ios-jit-memory.h
new file mode 100644
index 0000000..e9b86a8
--- /dev/null
+++ b/v8/src/base/platform/ios-jit-memory.h
@@ -0,0 +1,122 @@
+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#ifndef V8_BASE_PLATFORM_IOS_JIT_MEMORY_H_
+#define V8_BASE_PLATFORM_IOS_JIT_MEMORY_H_
+
+#include <stddef.h>
+#include <stdint.h>
+
+#include <atomic>
+
+#include "src/base/base-export.h"
+#include "src/base/build_config.h"
+#include "src/base/macros.h"
+
+#if defined(V8_OS_IOS)
+extern "C" {
+__attribute__((visibility("default"))) int V8IOSJitPrepareForProcess(
+    size_t pool_size_bytes,
+    int allow_txm_brk);
+__attribute__((visibility("default"))) int V8IOSJitGetActiveMode(void);
+}
+#endif  // defined(V8_OS_IOS)
+
+namespace v8 {
+namespace base {
+
+// Runtime JIT execution mode on iOS. Values match V8IOSJitGetActiveMode().
+enum class IOSJitMode : int {
+  kDisabled = 0,
+  kBrowserEngineCore = 1,
+  kNativeMapJit = 2,
+  kTxmDualMap = 3,
+};
+
+#if defined(V8_OS_IOS)
+
+class V8_BASE_EXPORT IOSJitMemory final {
+ public:
+  // Probe and initialize the best available JIT substrate for this process.
+  // Safe to call once before V8 starts; subsequent calls return the active
+  // mode. Fails closed to IOSJitMode::kDisabled on any error.
+  static IOSJitMode Initialize(size_t pool_size_bytes, bool allow_txm_brk);
+
+  static V8_INLINE IOSJitMode GetMode() {
+    return static_cast<IOSJitMode>(mode_.load(std::memory_order_acquire));
+  }
+
+  static V8_INLINE bool IsTxmDualMap() {
+    return GetMode() == IOSJitMode::kTxmDualMap;
+  }
+
+  static V8_INLINE uintptr_t TxmPoolBase() {
+    return txm_rx_base_.load(std::memory_order_relaxed);
+  }
+
+  static V8_INLINE size_t TxmPoolSize() {
+    return txm_rx_size_.load(std::memory_order_relaxed);
+  }
+
+  static V8_INLINE intptr_t TxmRwDelta() {
+    return txm_rw_delta_.load(std::memory_order_relaxed);
+  }
+
+  // O(1) lock-free translation from an executable address inside the TXM RX
+  // pool to its vm_remap'd RW alias. Returns |addr| unchanged when TXM dual-
+  // mapping is inactive or |addr| lies outside the RX pool.
+  static V8_INLINE uintptr_t ToWritable(uintptr_t addr) {
+    const uintptr_t base = txm_rx_base_.load(std::memory_order_relaxed);
+    const size_t size = txm_rx_size_.load(std::memory_order_relaxed);
+    if (V8_UNLIKELY(base != 0 && (addr - base) < size)) {
+      return static_cast<uintptr_t>(
+          static_cast<intptr_t>(addr) +
+          txm_rw_delta_.load(std::memory_order_relaxed));
+    }
+    return addr;
+  }
+
+  template <typename T>
+  static V8_INLINE T* ToWritablePtr(T* ptr) {
+    return reinterpret_cast<T*>(ToWritable(reinterpret_cast<uintptr_t>(ptr)));
+  }
+
+  // Leases the single pre-blessed TXM RX pool for V8's process-wide CodeRange.
+  static void* TryAcquireTxmPool(size_t length, size_t alignment);
+  static bool ReleaseTxmPool(void* address);
+
+  // Weakly-resolved pthread_jit_write_protect_np for kNativeMapJit mode
+  // (Simulator / pre-TXM devices).
+  static void SetNativeJitWriteProtected(int enable);
+
+ private:
+  static std::atomic<int> mode_;
+  static std::atomic<uintptr_t> txm_rx_base_;
+  static std::atomic<size_t> txm_rx_size_;
+  static std::atomic<intptr_t> txm_rw_delta_;
+};
+
+#else  // !defined(V8_OS_IOS)
+
+class IOSJitMemory final {
+ public:
+  static V8_INLINE IOSJitMode GetMode() { return IOSJitMode::kDisabled; }
+  static V8_INLINE bool IsTxmDualMap() { return false; }
+  static V8_INLINE uintptr_t TxmPoolBase() { return 0; }
+  static V8_INLINE size_t TxmPoolSize() { return 0; }
+  static V8_INLINE intptr_t TxmRwDelta() { return 0; }
+  static V8_INLINE uintptr_t ToWritable(uintptr_t addr) { return addr; }
+  template <typename T>
+  static V8_INLINE T* ToWritablePtr(T* ptr) {
+    return ptr;
+  }
+  static V8_INLINE void SetNativeJitWriteProtected(int) {}
+};
+
+#endif  // defined(V8_OS_IOS)
+
+}  // namespace base
+}  // namespace v8
+
+#endif  // V8_BASE_PLATFORM_IOS_JIT_MEMORY_H_
diff --git a/v8/src/codegen/arm64/assembler-arm64-inl.h b/v8/src/codegen/arm64/assembler-arm64-inl.h
