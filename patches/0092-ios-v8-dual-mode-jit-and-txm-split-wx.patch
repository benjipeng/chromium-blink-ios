+++ b/v8/src/codegen/arm64/assembler-arm64-inl.h
@@ -11,6 +11,7 @@
 #include <type_traits>
 
 #include "src/base/memory.h"
+#include "src/base/platform/ios-jit-memory.h"
 #include "src/codegen/assembler.h"
 #include "src/codegen/flush-instruction-cache.h"
 #include "src/debug/debug.h"
@@ -599,7 +600,9 @@ void Assembler::set_target_address_at(Address pc, Address constant_pool,
       jit_allocation->WriteUnalignedValue<Address>(
           target_pointer_address_at(pc), target);
     } else {
-      WriteUnalignedValue(target_pointer_address_at(pc), target);
+      WriteUnalignedValue(
+          base::IOSJitMemory::ToWritable(target_pointer_address_at(pc)),
+          target);
     }
     // Intuitively, we would think it is necessary to always flush the
     // instruction cache after patching a target address in the code. However,
@@ -629,7 +632,8 @@ void Assembler::set_target_compressed_address_at(
   if (jit_allocation) {
     jit_allocation->WriteValue(target_pointer_address_at(pc), target);
   } else {
-    Memory<Tagged_t>(target_pointer_address_at(pc)) = target;
+    Memory<Tagged_t>(
+        base::IOSJitMemory::ToWritable(target_pointer_address_at(pc))) = target;
   }
 }
 
diff --git a/v8/src/codegen/arm64/instructions-arm64.cc b/v8/src/codegen/arm64/instructions-arm64.cc
index baa6d64..40146e4 100644
--- a/v8/src/codegen/arm64/instructions-arm64.cc
+++ b/v8/src/codegen/arm64/instructions-arm64.cc
@@ -5,6 +5,7 @@
 #if V8_TARGET_ARCH_ARM64
 
 #include "src/codegen/arm64/instructions-arm64.h"
+#include "src/base/platform/ios-jit-memory.h"
 
 #include "src/codegen/arm64/assembler-arm64-inl.h"
 #include "src/common/code-memory-access-inl.h"
@@ -19,7 +20,9 @@ void Instruction::SetInstructionBits(Instr new_instr,
