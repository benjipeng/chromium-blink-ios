+#ifndef IOS_CHROME_BROWSER_EXTENSIONS_MODEL_IOS_SIGNED_EXTENSION_PACKAGE_H_
+#define IOS_CHROME_BROWSER_EXTENSIONS_MODEL_IOS_SIGNED_EXTENSION_PACKAGE_H_
+
+#include <string>
+
+#include "base/files/file_path.h"
+#include "extensions/buildflags/buildflags.h"
+
+static_assert(BUILDFLAG(ENABLE_EXTENSIONS_CORE));
+
+namespace extensions {
+
+// Verifies a publisher-signed CRX3 package at `input_crx`, safely extracts its
+// payload into `staging_dir`, validates that it is Manifest V3, and enforces
+// manifest `"key"` binding (injecting the verified public key if absent, or
+// requiring an exact match if present).
+//
+// Must be called on a background sequence that allows blocking file I/O.
+// `staging_dir` must be an existing, empty, non-symlink private directory owned
+// by the caller; on failure, the caller is responsible for cleaning it up.
+//
+// On success, returns true, sets `verified_id` (if non-null) to the verified
+// 32-character extension ID, and leaves `staging_dir` ready for
+// `UnpackedInstaller`. On failure, returns false and populates `error` (if
+// non-null).
+bool PrepareSignedExtensionPackage(const base::FilePath& input_crx,
+                                   const base::FilePath& staging_dir,
+                                   std::string* verified_id,
+                                   std::string* error);
+
+}  // namespace extensions
+
+#endif  // IOS_CHROME_BROWSER_EXTENSIONS_MODEL_IOS_SIGNED_EXTENSION_PACKAGE_H_
