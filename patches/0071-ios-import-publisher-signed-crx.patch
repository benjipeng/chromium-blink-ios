+namespace extensions {
+
+namespace {
+
+constexpr int64_t kMaxCrxFileSizeBytes = 64LL * 1024 * 1024;
+constexpr uint64_t kMaxUnpackedTotalBytes = 128ULL * 1024 * 1024;
+constexpr uint64_t kMaxSingleFileBytes = 64ULL * 1024 * 1024;
+constexpr size_t kMaxZipEntries = 4096;
+constexpr size_t kMaxPathDepth = 32;
+constexpr size_t kMaxEntryPathBytes = 512;
+constexpr size_t kMaxManifestFileSizeBytes = 1024 * 1024;
+constexpr size_t kCopyBufferSizeBytes = 64 * 1024;
+
+void SetError(std::string* error, std::string_view message) {
+  if (error) {
+    *error = std::string(message);
+  }
+}
+
+std::string VerifierResultToErrorString(crx_file::VerifierResult result) {
+  switch (result) {
+    case crx_file::VerifierResult::OK_FULL:
+      return std::string();
+    case crx_file::VerifierResult::OK_DELTA:
+      return "Delta CRX packages are not supported.";
+    case crx_file::VerifierResult::ERROR_FILE_NOT_READABLE:
+      return "CRX file could not be read.";
+    case crx_file::VerifierResult::ERROR_HEADER_INVALID:
+      return "CRX3 header is invalid.";
+    case crx_file::VerifierResult::ERROR_EXPECTED_HASH_INVALID:
+      return "CRX expected hash is invalid.";
+    case crx_file::VerifierResult::ERROR_FILE_HASH_FAILED:
+      return "CRX file hash verification failed.";
+    case crx_file::VerifierResult::ERROR_SIGNATURE_INITIALIZATION_FAILED:
+      return "CRX signature initialization failed.";
+    case crx_file::VerifierResult::ERROR_SIGNATURE_VERIFICATION_FAILED:
+      return "CRX signature verification failed.";
+    case crx_file::VerifierResult::ERROR_REQUIRED_PROOF_MISSING:
+      return "CRX package is missing a required publisher signature.";
+  }
+  return "CRX verification failed.";
+}
+
+bool CopyBoundedRegularFile(const base::FilePath& source_path,
+                            const base::FilePath& dest_path,
+                            std::string* error) {
+  if (base::IsLink(source_path)) {
+    SetError(error, "Input CRX path must not be a symbolic link.");
+    return false;
+  }
+
+  base::File src_file(source_path,
+                      base::File::FLAG_OPEN | base::File::FLAG_READ);
+  if (!src_file.IsValid()) {
+    SetError(error, "Unable to open input CRX file.");
+    return false;
+  }
+
+#if BUILDFLAG(IS_POSIX)
+  base::stat_wrapper_t st = {};
+  if (base::File::Fstat(src_file.GetPlatformFile(), &st) != 0 ||
+      !S_ISREG(st.st_mode)) {
+    SetError(error, "Input CRX path must refer to a regular file.");
+    return false;
+  }
+#endif
+
+  base::File::Info info;
+  if (!src_file.GetInfo(&info) || info.is_directory) {
+    SetError(error, "Input CRX path must not be a directory.");
+    return false;
+  }
+  if (info.size <= 0 || info.size > kMaxCrxFileSizeBytes) {
+    SetError(error, "Input CRX file is empty or exceeds the maximum size.");
+    return false;
+  }
+
+  base::File dst_file(dest_path,
+                      base::File::FLAG_CREATE | base::File::FLAG_WRITE);
+  if (!dst_file.IsValid()) {
+    SetError(error, "Failed to create temporary CRX working copy.");
+    return false;
+  }
+
+  std::array<uint8_t, kCopyBufferSizeBytes> buffer = {};
+  int64_t total_copied = 0;
+  while (true) {
+    std::optional<size_t> bytes_read = src_file.ReadAtCurrentPos(buffer);
+    if (!bytes_read.has_value()) {
+      SetError(error, "Failed while reading input CRX file.");
+      return false;
+    }
+    if (*bytes_read == 0) {
+      break;
+    }
+    const int64_t chunk_bytes = base::checked_cast<int64_t>(*bytes_read);
+    if (chunk_bytes > kMaxCrxFileSizeBytes - total_copied) {
+      SetError(error, "Input CRX file exceeds the maximum allowed size.");
+      return false;
+    }
+    if (!dst_file.WriteAtCurrentPosAndCheck(
+            base::span<const uint8_t>(buffer).first(*bytes_read))) {
+      SetError(error, "Failed while writing temporary CRX working copy.");
+      return false;
+    }
+    total_copied += chunk_bytes;
+  }
+
+  if (total_copied <= 0) {
+    SetError(error, "Input CRX file is empty.");
+    return false;
+  }
+
+  dst_file.Close();
+  src_file.Close();
+  return true;
+}
+
+bool HasDisallowedRawPathChar(char ch) {
+  const unsigned char uch = static_cast<unsigned char>(ch);
+  if (uch < 0x20 || uch == 0x7F) {
+    return true;
+  }
+  switch (ch) {
+    case '\\':
+    case ':':
+    case '<':
+    case '>':
+    case '"':
+    case '|':
+    case '?':
+    case '*':
+      return true;
+    default:
+      return false;
+  }
+}
+
+bool ValidateAndSplitOriginalEntryPath(
+    const zip::ZipReader::Entry& entry,
+    std::string* out_clean_rel_path,
+    std::vector<std::string>* out_segments,
+    std::vector<std::string>* out_lower_prefixes) {
+  if (entry.is_unsafe || entry.is_symbolic_link || entry.is_encrypted ||
+      entry.uses_aes_encryption) {
+    return false;
+  }
+  if (entry.path != entry.physical_path) {
+    return false;
+  }
+  if (entry.path.empty() || entry.path.IsAbsolute() ||
+      entry.path.ReferencesParent()) {
+    return false;
+  }
+  if (!entry.is_directory && entry.path.EndsWithSeparator()) {
+    return false;
+  }
+
+  std::string_view raw_path(entry.path_in_original_encoding);
+  if (raw_path.empty() || raw_path.size() > kMaxEntryPathBytes ||
+      !base::IsStringUTF8(raw_path)) {
+    return false;
+  }
+  if (raw_path.front() == '/') {
+    return false;
+  }
+  for (char ch : raw_path) {
+    if (HasDisallowedRawPathChar(ch)) {
+      return false;
+    }
+  }
+
+  if (entry.is_directory) {
+    if (raw_path.back() != '/') {
+      return false;
+    }
+    raw_path.remove_suffix(1);
+    if (raw_path.empty() || raw_path.back() == '/') {
+      return false;
+    }
+  } else if (raw_path.back() == '/') {
+    return false;
+  }
+
+  std::vector<std::string> segments;
+  size_t pos = 0;
+  while (pos <= raw_path.size()) {
+    const size_t slash = raw_path.find('/', pos);
+    const std::string_view seg = (slash == std::string_view::npos)
+                                     ? raw_path.substr(pos)
+                                     : raw_path.substr(pos, slash - pos);
+    if (seg.empty() || seg == "." || seg == "..") {
+      return false;
+    }
+    segments.emplace_back(seg);
+    if (segments.size() > kMaxPathDepth) {
+      return false;
+    }
+    if (slash == std::string_view::npos) {
+      break;
+    }
+    pos = slash + 1;
+  }
+
+  if (segments.empty()) {
+    return false;
+  }
+
+  // Ensure ZipReader's normalized FilePath matches the validated raw segments
+  // without silent rewriting (such as DOT/UP/ROOT/0xFFFD substitution).
+  const std::vector<base::FilePath::StringType> normalized_components =
+      entry.path.StripTrailingSeparators().GetComponents();
+  if (normalized_components.size() != segments.size()) {
+    return false;
+  }
+  for (size_t i = 0; i < segments.size(); ++i) {
+    if (normalized_components[i] !=
+        base::FilePath::FromUTF8Unsafe(segments[i]).value()) {
+      return false;
+    }
+  }
+
+  std::vector<std::string> lower_prefixes;
+  lower_prefixes.reserve(segments.size());
+  std::string cumulative;
+  for (size_t i = 0; i < segments.size(); ++i) {
+    if (i > 0) {
+      cumulative.push_back('/');
+    }
+    cumulative += base::ToLowerASCII(segments[i]);
+    lower_prefixes.push_back(cumulative);
+  }
+
+  *out_clean_rel_path = std::string(raw_path);
+  *out_segments = std::move(segments);
+  *out_lower_prefixes = std::move(lower_prefixes);
+  return true;
+}
+
+class BoundedFileWriterDelegate final : public zip::WriterDelegate {
+ public:
+  BoundedFileWriterDelegate(base::FilePath output_file_path,
+                            uint64_t max_bytes)
+      : output_file_path_(std::move(output_file_path)),
+        max_bytes_(max_bytes) {}
+
+  BoundedFileWriterDelegate(const BoundedFileWriterDelegate&) = delete;
+  BoundedFileWriterDelegate& operator=(const BoundedFileWriterDelegate&) =
+      delete;
+  ~BoundedFileWriterDelegate() override = default;
+
+  bool PrepareOutput() override {
+    const base::FilePath parent_dir = output_file_path_.DirName();
+    if (!parent_dir.empty() && !base::CreateDirectory(parent_dir)) {
+      return false;
+    }
+    if (base::IsLink(output_file_path_)) {
+      return false;
+    }
+    file_.Initialize(output_file_path_,
+                     base::File::FLAG_CREATE | base::File::FLAG_WRITE);
+    return file_.IsValid();
+  }
+
+  bool WriteBytes(base::span<const uint8_t> data) override {
+    const uint64_t chunk_size = base::checked_cast<uint64_t>(data.size());
+    if (chunk_size > max_bytes_ - bytes_written_) {
+      return false;
+    }
+    if (!file_.WriteAtCurrentPosAndCheck(data)) {
+      return false;
+    }
+    bytes_written_ += chunk_size;
+    return true;
+  }
+
+  void OnError() override {
+    file_.Close();
+    base::DeleteFile(output_file_path_);
+    bytes_written_ = 0;
+  }
+
+  uint64_t bytes_written() const { return bytes_written_; }
+
+ private:
+  const base::FilePath output_file_path_;
+  const uint64_t max_bytes_;
+  base::File file_;
+  uint64_t bytes_written_ = 0;
+};
+
+bool ExtractVerifiedCrxArchive(const base::FilePath& crx_path,
+                               const base::FilePath& staging_dir,
+                               std::string* error) {
+  base::File crx_file(crx_path, base::File::FLAG_OPEN | base::File::FLAG_READ);
+  if (!crx_file.IsValid()) {
+    SetError(error, "Unable to open verified CRX archive for extraction.");
+    return false;
+  }
+
+  zip::ZipReader reader;
+  if (!reader.OpenFromPlatformFile(crx_file.GetPlatformFile())) {
+    SetError(error, "CRX payload is not a valid ZIP archive.");
+    return false;
+  }
+
+  size_t entry_count = 0;
+  uint64_t total_extracted_bytes = 0;
+  std::set<std::string> seen_files;
+  std::set<std::string> explicit_dirs;
+  std::set<std::string> all_dirs;
+  bool has_manifest_json = false;
+
+  while (const zip::ZipReader::Entry* const entry = reader.Next()) {
+    ++entry_count;
+    if (entry_count > kMaxZipEntries) {
+      SetError(error, "CRX ZIP payload exceeds maximum entry count.");
+      return false;
+    }
+
+    if (entry->is_symbolic_link) {
+      SetError(error, "CRX ZIP payload must not contain symbolic links.");
+      return false;
+    }
+    if (entry->is_encrypted || entry->uses_aes_encryption) {
+      SetError(error, "CRX ZIP payload must not contain encrypted entries.");
+      return false;
+    }
+
+    std::string clean_rel_path;
+    std::vector<std::string> segments;
+    std::vector<std::string> lower_prefixes;
+    if (!ValidateAndSplitOriginalEntryPath(*entry, &clean_rel_path, &segments,
+                                           &lower_prefixes)) {
+      SetError(error, "CRX ZIP payload contains an unsafe or invalid path.");
+      return false;
+    }
+
+    // Verify ancestor directories do not collide with any previously seen file.
+    for (size_t i = 0; i + 1 < lower_prefixes.size(); ++i) {
+      if (seen_files.contains(lower_prefixes[i])) {
+        SetError(error,
+                 "CRX ZIP payload has a path conflict between file and "
+                 "directory.");
+        return false;
+      }
+      all_dirs.insert(lower_prefixes[i]);
+    }
+
+    const std::string& lower_full_path = lower_prefixes.back();
+    if (entry->is_directory) {
+      if (entry->original_size != 0) {
+        SetError(error,
+                 "CRX ZIP directory entry must not contain file payload.");
+        return false;
+      }
+      if (seen_files.contains(lower_full_path)) {
+        SetError(error,
+                 "CRX ZIP directory entry conflicts with an existing file.");
+        return false;
+      }
+      if (explicit_dirs.contains(lower_full_path)) {
+        SetError(error, "CRX ZIP payload contains a duplicate directory.");
+        return false;
+      }
+      explicit_dirs.insert(lower_full_path);
+      all_dirs.insert(lower_full_path);
+
+      const base::FilePath target_dir =
+          staging_dir.Append(entry->path.StripTrailingSeparators());
+      if (base::IsLink(target_dir) || !base::CreateDirectory(target_dir)) {
+        SetError(error, "Failed to create directory during CRX extraction.");
+        return false;
+      }
+      continue;
+    }
+
+    if (seen_files.contains(lower_full_path)) {
+      SetError(error, "CRX ZIP payload contains a duplicate file entry.");
+      return false;
+    }
+    if (all_dirs.contains(lower_full_path)) {
+      SetError(error,
+               "CRX ZIP file entry conflicts with an existing directory.");
+      return false;
+    }
+    seen_files.insert(lower_full_path);
+
+    if (entry->original_size < 0) {
+      SetError(error, "CRX ZIP entry reports an invalid uncompressed size.");
+      return false;
+    }
+
+    const uint64_t remaining_total_budget =
+        kMaxUnpackedTotalBytes - total_extracted_bytes;
+    const uint64_t entry_max_bytes =
+        std::min<uint64_t>(kMaxSingleFileBytes, remaining_total_budget);
+    if (static_cast<uint64_t>(entry->original_size) > entry_max_bytes) {
+      SetError(error, "CRX ZIP payload exceeds unpacked size limit.");
+      return false;
+    }
+
+    const base::FilePath target_file = staging_dir.Append(entry->path);
+    BoundedFileWriterDelegate writer(target_file, entry_max_bytes);
+    // ZipReader::ExtractCurrentEntry requires num_bytes_to_extract >= 1 to
+    // run its read loop (even for 0-byte files). BoundedFileWriterDelegate
+    // strictly enforces `entry_max_bytes`.
+    if (!reader.ExtractCurrentEntry(&writer, entry_max_bytes + 1)) {
+      SetError(error, "Failed to extract CRX ZIP entry within size limits.");
+      return false;
+    }
+
+    total_extracted_bytes += writer.bytes_written();
+    if (total_extracted_bytes > kMaxUnpackedTotalBytes) {
+      SetError(error, "CRX ZIP payload exceeds total unpacked size limit.");
+      return false;
+    }
+
+    if (clean_rel_path == "manifest.json" &&
+        entry->path == base::FilePath(kManifestFilename)) {
+      has_manifest_json = true;
+    }
+  }
+
+  if (!reader.ok()) {
+    SetError(error, "CRX ZIP payload is corrupt or unreadable.");
+    return false;
+  }
+
+  reader.Close();
+  crx_file.Close();
+
+  if (entry_count == 0 || !has_manifest_json) {
+    SetError(error, "CRX package is missing manifest.json.");
+    return false;
+  }
+
+  return true;
+}
+
+bool ValidateAndBindManifest(const base::FilePath& staging_dir,
+                             const std::string& verified_public_key_b64,
+                             const std::string& verified_public_key_bytes,
+                             const std::string& verified_crx_id,
+                             std::string* error) {
+  const base::FilePath manifest_path = staging_dir.Append(kManifestFilename);
+  if (base::IsLink(manifest_path) || !base::PathExists(manifest_path)) {
+    SetError(error, "Extracted extension is missing manifest.json.");
+    return false;
+  }
+
+  std::string manifest_contents;
+  if (!base::ReadFileToStringWithMaxSize(manifest_path, &manifest_contents,
+                                         kMaxManifestFileSizeBytes)) {
+    SetError(error,
+             "Unable to read manifest.json or manifest exceeds size limit.");
+    return false;
+  }
+
+  base::JSONReader::Result parsed_manifest =
+      base::JSONReader::ReadAndReturnValueWithError(
+          manifest_contents, base::JSON_PARSE_CHROMIUM_EXTENSIONS);
+  if (!parsed_manifest.has_value() || !parsed_manifest->is_dict()) {
+    SetError(error, "Extension manifest.json is not a valid JSON object.");
+    return false;
+  }
+
+  base::DictValue manifest_dict = std::move(*parsed_manifest).TakeDict();
+
+  const std::optional<int> manifest_version =
+      manifest_dict.FindInt(manifest_keys::kManifestVersion);
+  if (!manifest_version.has_value() || *manifest_version != 3) {
+    SetError(error, "Only Manifest V3 extensions are supported.");
+    return false;
+  }
+
+  if (const base::Value* existing_key_value =
+          manifest_dict.Find(manifest_keys::kPublicKey)) {
+    const std::string* existing_key = existing_key_value->GetIfString();
+    if (!existing_key || existing_key->empty()) {
+      SetError(error, "Manifest 'key' must be a non-empty string.");
+      return false;
+    }
+
+    std::string existing_key_bytes;
+    if (!Extension::ParsePEMKeyBytes(*existing_key, &existing_key_bytes) ||
+        existing_key_bytes.empty()) {
+      SetError(error, "Manifest 'key' is not a valid public key.");
+      return false;
+    }
+
+    if (existing_key_bytes != verified_public_key_bytes ||
+        crx_file::id_util::GenerateId(existing_key_bytes) != verified_crx_id) {
+      SetError(error,
+               "Manifest 'key' does not match the verified CRX publisher key.");
+      return false;
+    }
+  }
+
+  manifest_dict.Set(manifest_keys::kPublicKey, verified_public_key_b64);
+
+  std::optional<std::string> rewritten_manifest = base::WriteJsonWithOptions(
+      manifest_dict, base::JSONWriter::OPTIONS_PRETTY_PRINT);
+  if (!rewritten_manifest.has_value()) {
+    SetError(error, "Failed to serialize updated manifest.json.");
+    return false;
+  }
+
+  if (!base::DeleteFile(manifest_path) ||
+      !base::WriteFile(manifest_path, *rewritten_manifest)) {
+    SetError(error, "Failed to write updated manifest.json.");
+    return false;
+  }
+
+  return true;
+}
+
+}  // namespace
+
+bool PrepareSignedExtensionPackage(const base::FilePath& input_crx,
+                                   const base::FilePath& staging_dir,
+                                   std::string* verified_id,
+                                   std::string* error) {
+  base::ScopedBlockingCall scoped_blocking_call(FROM_HERE,
+                                                base::BlockingType::MAY_BLOCK);
+
+  if (verified_id) {
+    verified_id->clear();
+  }
+  if (error) {
+    error->clear();
+  }
+
+  if (input_crx.empty()) {
+    SetError(error, "Input CRX path must not be empty.");
+    return false;
+  }
+  if (staging_dir.empty()) {
+    SetError(error, "Staging directory path must not be empty.");
+    return false;
+  }
+  if (base::IsLink(staging_dir) || !base::DirectoryExists(staging_dir) ||
+      !base::IsDirectoryEmpty(staging_dir)) {
+    SetError(error,
+             "Staging directory must be an existing empty non-symlink "
+             "directory.");
+    return false;
+  }
+
+  base::ScopedTempDir working_temp_dir;
+  if (!working_temp_dir.CreateUniqueTempDir()) {
+    SetError(error, "Failed to create temporary working directory.");
+    return false;
+  }
+
+  const base::FilePath working_crx_path =
+      working_temp_dir.GetPath().AppendASCII("package.crx");
+  if (!CopyBoundedRegularFile(input_crx, working_crx_path, error)) {
+    return false;
+  }
+
+  std::string verified_public_key_b64;
+  std::string verified_crx_id;
+  const crx_file::VerifierResult verify_result = crx_file::Verify(
+      working_crx_path, crx_file::VerifierFormat::CRX3_WITH_PUBLISHER_PROOF,
+      /*required_key_hashes=*/{}, /*required_file_hash=*/{},
+      &verified_public_key_b64, &verified_crx_id,
+      /*compressed_verified_contents=*/nullptr);
+  if (verify_result != crx_file::VerifierResult::OK_FULL) {
+    SetError(error, VerifierResultToErrorString(verify_result));
+    return false;
+  }
+
+  if (verified_public_key_b64.empty() ||
+      !crx_file::id_util::IdIsValid(verified_crx_id)) {
+    SetError(error, "Verified CRX did not produce a valid extension identity.");
+    return false;
+  }
+
+  std::string verified_public_key_bytes;
+  if (!Extension::ParsePEMKeyBytes(verified_public_key_b64,
+                                    &verified_public_key_bytes) ||
+      verified_public_key_bytes.empty() ||
+      crx_file::id_util::GenerateId(verified_public_key_bytes) !=
+          verified_crx_id) {
+    SetError(error, "Verified CRX public key could not be validated.");
+    return false;
+  }
+
+  if (!ExtractVerifiedCrxArchive(working_crx_path, staging_dir, error)) {
+    return false;
+  }
+
+  if (!ValidateAndBindManifest(staging_dir, verified_public_key_b64,
+                               verified_public_key_bytes, verified_crx_id,
+                               error)) {
+    return false;
+  }
+
+  if (verified_id) {
+    *verified_id = std::move(verified_crx_id);
+  }
+  return true;
+}
