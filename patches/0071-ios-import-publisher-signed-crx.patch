+struct PreparedSignedImport {
+  base::FilePath profile_path;
+  base::FilePath staging_path;
+  std::string token;
+  std::string id;
+  std::string name;
+  std::string version;
+  std::vector<std::string> permissions;
+  std::vector<std::string> host_permissions;
+  std::string error;
+};
+
+struct SignedImportState {
+  bool busy = false;
+  std::optional<PreparedSignedImport> prepared;
+};
+
+SignedImportState& SignedImportOnUIThread() {
+  DCHECK_CURRENTLY_ON(content::BrowserThread::UI);
+  static base::NoDestructor<SignedImportState> state;
+  return *state;
+}
+
+NSError* SignedImportError(NSString* message) {
+  return MakeBridgeError(kCrIOSExtensionManagerErrorStateChangeFailed, message);
+}
+
+void DeleteImportDirectory(base::FilePath directory) {
+  if (!directory.empty()) {
+    extensions::GetExtensionFileTaskRunner()->PostTask(
+        FROM_HERE, base::BindOnce(base::IgnoreResult(&base::DeletePathRecursively),
+                                 std::move(directory)));
+  }
+}
+
+bool ResolveSignedImportProfile(base::FilePath* profile_path,
+                                extensions::ExtensionRegistry** registry,
+                                NSError* __autoreleasing* error) {
+  content::BrowserContext* context = nullptr;
+  extensions::ExtensionSystem* system = nullptr;
+  extensions::ExtensionRegistrar* registrar = nullptr;
+  if (!ResolveExtensionServices(&context, &system, registry, &registrar,
+                                error)) {
+    return false;
+  }
+  *profile_path = context->GetPath();
+  if (profile_path->empty()) {
+    SetBridgeError(error, kCrIOSExtensionManagerErrorSystemNotReady,
+                   @"The active profile has no directory.");
+    return false;
+  }
+  return true;
+}
+
+std::vector<std::string> ManifestStrings(const base::DictValue& manifest,
+                                         std::string_view field) {
+  std::vector<std::string> result;
+  if (const auto* values = manifest.FindList(field)) {
+    for (const auto& value : *values) {
+      if (const auto* text = value.GetIfString()) {
+        result.push_back(*text);
+      }
+    }
+  }
+  return result;
+}
+
+std::vector<std::string> DeclaredHostPatterns(const base::DictValue& manifest) {
+  const auto declared = ManifestStrings(manifest, "host_permissions");
+  std::set<std::string> hosts(declared.begin(), declared.end());
+  if (const auto* scripts = manifest.FindList("content_scripts")) {
+    for (const auto& script : *scripts) {
+      if (const auto* dict = script.GetIfDict()) {
+        const auto matches = ManifestStrings(*dict, "matches");
+        hosts.insert(matches.begin(), matches.end());
+      }
+    }
+  }
+  return {hosts.begin(), hosts.end()};
+}
+
+NSArray<NSString*>* BridgeStrings(const std::vector<std::string>& values) {
+  NSMutableArray<NSString*>* result = [NSMutableArray array];
+  for (const auto& value : values) {
+    if (NSString* text = base::SysUTF8ToNSString(value)) {
+      [result addObject:text];
+    }
+  }
+  return [result copy];
+}
+
+PreparedSignedImport PrepareSignedImportOnFileThread(
+    base::FilePath profile_path,
+    base::FilePath input_path) {
+  PreparedSignedImport result;
+  const base::FilePath import_root =
+      profile_path.AppendASCII("PendingSignedExtension");
+  base::ScopedTempDir workspace;
+  // There is at most one live preparation. Discard any prior session's draft.
+  if (!base::DeletePathRecursively(import_root) ||
+      !base::CreateDirectory(import_root) ||
+      !workspace.CreateUniqueTempDirUnderPath(import_root)) {
+    result.error = "Could not create a private extension staging directory.";
+    return result;
+  }
+
+  const auto payload = workspace.GetPath().AppendASCII("extension");
+  if (!base::CreateDirectory(payload) ||
+      !extensions::PrepareSignedExtensionPackage(input_path, payload, &result.id,
+                                                 &result.error)) {
+    if (result.error.empty()) {
+      result.error = "Could not stage the verified extension.";
+    }
+    return result;
+  }
+  if (result.id == extensions::kIOSBundledExtensionId) {
+    result.error = "The package conflicts with a bundled extension.";
+    return result;
+  }
+  std::u16string parse_error;
+  auto extension = extensions::file_util::LoadExtension(
+      payload, extensions::mojom::ManifestLocation::kUnpacked,
+      extensions::Extension::REQUIRE_MODERN_MANIFEST_VERSION, &parse_error);
+  if (!extension || extension->id() != result.id) {
+    result.error = parse_error.empty() ? "The manifest ID does not match the signature."
+                                      : base::UTF16ToUTF8(parse_error);
+    return result;
+  }
+
+  result.name = extension->name();
+  result.version = extension->VersionString();
+  const auto& manifest = *extension->manifest()->value();
+  result.permissions = ManifestStrings(manifest, "permissions");
+  result.host_permissions = DeclaredHostPatterns(manifest);
+  result.profile_path = std::move(profile_path);
+  result.token = base::Uuid::GenerateRandomV4().AsLowercaseString();
+  result.staging_path = workspace.Take();
+  return result;
+}
+
+base::FilePath PromoteSignedImportOnFileThread(base::FilePath profile_path,
+                                               base::FilePath staging_path,
+                                               std::string token) {
+  const auto root = profile_path.AppendASCII("TrustedUnpackedExtensions");
+  const auto target = root.AppendASCII(token);
+  const bool moved = base::CreateDirectory(root) && !base::IsLink(root) &&
+                     !base::PathExists(target) &&
+                     base::Move(staging_path.AppendASCII("extension"), target);
+  base::DeletePathRecursively(staging_path);
+  return moved ? target : base::FilePath();
+}
