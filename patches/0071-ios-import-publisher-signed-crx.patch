+- (void)prepareSignedExtensionAtPath:(NSString*)path
+                          completion:(void (^)(NSDictionary<NSString*, id>*,
+                                               NSError*))completion {
+  if (!completion) {
+    return;
+  }
+  InstallCompletionCallback finish = base::BindOnce(completion);
+  base::FilePath profile;
+  extensions::ExtensionRegistry* registry = nullptr;
+  NSError* error = nil;
+  if (!ResolveSignedImportProfile(&profile, &registry, &error)) {
+    PostInstallCompletionOnMainThread(std::move(finish), nil, error);
+    return;
+  }
+  if (![path isKindOfClass:[NSString class]] || !path.isAbsolutePath ||
+      [path.pathExtension caseInsensitiveCompare:@"crx"] != NSOrderedSame) {
+    PostInstallCompletionOnMainThread(
+        std::move(finish), nil, SignedImportError(@"Choose a signed CRX file."));
+    return;
+  }
+  auto& state = SignedImportOnUIThread();
+  if (state.busy || state.prepared) {
+    PostInstallCompletionOnMainThread(
+        std::move(finish), nil,
+        SignedImportError(@"Finish or cancel the current extension review first."));
+    return;
+  }
+  state.busy = true;
+  extensions::GetExtensionFileTaskRunner()->PostTaskAndReplyWithResult(
+      FROM_HERE,
+      base::BindOnce(&PrepareSignedImportOnFileThread, profile,
+                     base::FilePath(base::SysNSStringToUTF8(path))),
+      base::BindOnce(
+          [](InstallCompletionCallback reply, PreparedSignedImport result) {
+            auto& state = SignedImportOnUIThread();
+            state.busy = false;
+            if (!result.error.empty()) {
+              std::move(reply).Run(
+                  nil, SignedImportError(base::SysUTF8ToNSString(result.error)));
+              return;
+            }
+            base::FilePath active_profile;
+            extensions::ExtensionRegistry* registry = nullptr;
+            NSError* error = nil;
+            if (!ResolveSignedImportProfile(&active_profile, &registry, &error) ||
+                active_profile != result.profile_path ||
+                registry->GetInstalledExtension(result.id)) {
+              DeleteImportDirectory(std::move(result.staging_path));
+              std::move(reply).Run(
+                  nil, error ?: SignedImportError(
+                      @"The active profile changed or this extension is already installed."));
+              return;
+            }
+            NSDictionary* receipt = @{
+              @"token" : base::SysUTF8ToNSString(result.token),
+              @"id" : base::SysUTF8ToNSString(result.id),
+              @"name" : base::SysUTF8ToNSString(result.name),
+              @"version" : base::SysUTF8ToNSString(result.version),
+              @"permissions" : BridgeStrings(result.permissions),
+              @"hostPermissions" : BridgeStrings(result.host_permissions),
+            };
+            content::GetUIThreadTaskRunner({})->PostDelayedTask(
+                FROM_HERE,
+                base::BindOnce(
+                    [](const std::string& token) {
+                      auto& prepared = SignedImportOnUIThread().prepared;
+                      if (prepared && prepared->token == token) {
+                        DeleteImportDirectory(std::move(prepared->staging_path));
+                        prepared.reset();
+                      }
+                    },
+                    result.token),
+                base::Minutes(5));
+            state.prepared.emplace(std::move(result));
+            std::move(reply).Run(receipt, nil);
+          },
+          std::move(finish)));
+}
+
+- (BOOL)cancelPreparedExtensionWithToken:(NSString*)token
+                                   error:(NSError* __autoreleasing*)error {
+  base::FilePath profile;
+  extensions::ExtensionRegistry* registry = nullptr;
+  if (!ResolveSignedImportProfile(&profile, &registry, error)) {
+    return NO;
+  }
+  auto& prepared = SignedImportOnUIThread().prepared;
+  if (![token isKindOfClass:[NSString class]] || !prepared ||
+      prepared->profile_path != profile ||
+      prepared->token != base::SysNSStringToUTF8(token)) {
+    SetBridgeError(error, kCrIOSExtensionManagerErrorNotFound,
+                   @"The extension review has expired.");
+    return NO;
+  }
+  DeleteImportDirectory(std::move(prepared->staging_path));
+  prepared.reset();
+  return YES;
+}
+
+- (void)confirmPreparedExtensionWithToken:(NSString*)token
+                               completion:(void (^)(NSDictionary<NSString*, id>*,
+                                                    NSError*))completion {
+  if (!completion) {
+    return;
+  }
+  base::FilePath profile;
+  extensions::ExtensionRegistry* registry = nullptr;
+  NSError* error = nil;
+  if (!ResolveSignedImportProfile(&profile, &registry, &error)) {
+    PostInstallCompletionOnMainThread(base::BindOnce(completion), nil, error);
+    return;
+  }
+  auto& state = SignedImportOnUIThread();
+  if (![token isKindOfClass:[NSString class]] || !state.prepared ||
+      state.prepared->profile_path != profile ||
+      state.prepared->token != base::SysNSStringToUTF8(token)) {
+    PostInstallCompletionOnMainThread(
+        base::BindOnce(completion), nil,
+        SignedImportError(@"The extension review has expired."));
+    return;
+  }
+  auto prepared = std::move(*state.prepared);
+  state.prepared.reset();
+  state.busy = true;
+  extensions::GetExtensionFileTaskRunner()->PostTaskAndReplyWithResult(
+      FROM_HERE,
+      base::BindOnce(&PromoteSignedImportOnFileThread, profile,
+                     std::move(prepared.staging_path), std::move(prepared.token)),
+      base::BindOnce(
+          [](CrIOSExtensionManagerV1* manager,
+             base::FilePath original_profile, std::string verified_id,
+             void (^reply)(NSDictionary<NSString*, id>*, NSError*),
+             base::FilePath target) {
+            base::FilePath active_profile;
+            extensions::ExtensionRegistry* registry = nullptr;
+            NSError* error = nil;
+            if (target.empty() ||
+                !ResolveSignedImportProfile(&active_profile, &registry, &error) ||
+                active_profile != original_profile ||
+                registry->GetInstalledExtension(verified_id)) {
+              SignedImportOnUIThread().busy = false;
+              DeleteImportDirectory(std::move(target));
+              reply(nil, error ?: SignedImportError(
+                  @"Could not install the prepared extension in this profile."));
+              return;
+            }
+            [manager installExtensionFromTrustedDirectory:
+                         base::SysUTF8ToNSString(target.value())
+                                             requiringID:
+                         base::SysUTF8ToNSString(verified_id)
+                                              completion:
+                         ^(NSDictionary<NSString*, id>* entry, NSError* failure) {
+                           SignedImportOnUIThread().busy = false;
+                           if (failure || !entry) {
+                             DeleteImportDirectory(target);
+                           }
+                           reply(entry, failure);
+                         }];
+          },
+          self, profile, std::move(prepared.id), [completion copy]));
 }
 
