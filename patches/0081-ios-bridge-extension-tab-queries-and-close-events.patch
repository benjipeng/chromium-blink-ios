+#include "extensions/browser/extension_event_histogram_value.h"
+#include "extensions/common/constants.h"
+#include "extensions/common/event_args.h"
+#include "extensions/common/extension.h"
+#include "extensions/common/permissions/permissions_data.h"
+#include "ios/chrome/browser/extensions/model/ios_extensions_browser_client.h"
+#import "ios/chrome/browser/shared/model/browser/browser.h"
+#include "ios/chrome/browser/shared/model/browser/browser_list.h"
+#import "ios/chrome/browser/shared/model/browser/browser_list_factory.h"
+#include "ios/chrome/browser/shared/model/browser/browser_list_utils.h"
+#include "ios/chrome/browser/shared/model/web_state_list/web_state_list.h"
+#include "ios/chrome/browser/shared/model/web_state_list/web_state_list_observer.h"
+#include "ios/web/content/web_state/content_web_state.h"
+#include "ios/web/public/web_state.h"
+#include "url/gurl.h"
+
+namespace extensions {
+namespace {
+
+const char kWindowIDKey = 0;
+
+class WindowID final : public base::SupportsUserData::Data {
+ public:
+  explicit WindowID(int id) : id(id) {}
+  const int id;
+};
+
+int GetWindowID(Browser& browser) {
+  // Browser and WebStateList are both owned by the UI sequence.
+  auto* data = static_cast<WindowID*>(browser.GetUserData(&kWindowIDKey));
+  if (data) {
+    return data->id;
+  }
+  static int next_id = 1;
+  const int id = next_id++;
+  browser.SetUserData(&kWindowIDKey, std::make_unique<WindowID>(id));
+  return id;
+}
+
+BrowserList* GetBrowserList(content::BrowserContext* context) {
+  auto* profile =
+      IOSExtensionsBrowserClient::GetInstance()->GetTabProfile(context);
+  return profile ? BrowserListFactory::GetForProfileIfExists(profile) : nullptr;
+}
+
+Browser* FindSenderBrowser(const std::set<Browser*>& browsers,
+                           content::WebContents* sender) {
+  if (!sender) {
+    return nullptr;
+  }
+  const auto id = web::ContentWebState::GetUniqueIdentifierForWebContents(*sender);
+  if (!id.valid()) {
+    return nullptr;
+  }
+  for (auto* browser : browsers) {
+    auto* tabs = browser->GetWebStateList();
+    for (int i = 0; i < tabs->count(); ++i) {
+      if (tabs->GetWebStateAt(i)->GetUniqueIdentifier() == id) {
+        return browser;
+      }
+    }
+  }
+  return nullptr;
+}
+
+base::DictValue MakeTab(Browser& browser,
+                        int index,
+                        const Extension& extension) {
+  auto* tabs = browser.GetWebStateList();
+  const auto& tab = *tabs->GetWebStateAt(index);
+  const int id = tab.GetUniqueIdentifier().identifier();
+  const bool active = &tab == tabs->GetActiveWebState();
+  base::DictValue result;
+  result.Set("id", id);
+  result.Set("index", index);
+  result.Set("windowId", GetWindowID(browser));
+  result.Set("active", active);
+  result.Set("highlighted", active);
+  result.Set("pinned", index < tabs->pinned_tabs_count());
+  result.Set("incognito", false);
+  result.Set("status", tab.IsLoading() ? "loading" : "complete");
+  const GURL& url = tab.GetLastCommittedURL();
+  const auto* permissions = extension.permissions_data();
+  if (url.is_valid() &&
+      ((url.SchemeIs(kExtensionScheme) && url.host() == extension.id()) ||
+       permissions->CanAccessPage(url, id, /*error=*/nullptr))) {
+    result.Set("url", url.spec());
+    result.Set("title", base::UTF16ToUTF8(tab.GetTitle()));
+  }
+  return result;
+}
+
+}  // namespace
+
+ExtensionFunction::ResponseAction IOSTabsQueryFunction::Run() {
+  EXTENSION_FUNCTION_VALIDATE(args().size() == 1u && args()[0].is_dict());
+  const auto& query = args()[0].GetDict();
+  if (!extension()) {
+    return RespondNow(Error("No extension found."));
+  }
+  const std::optional<bool> active = query.FindBool("active");
+  const std::optional<bool> current = query.FindBool("currentWindow");
+  const std::optional<bool> focused = query.FindBool("lastFocusedWindow");
+  base::ListValue matches;
+  const auto* type = query.FindString("windowType");
+  if (type && *type != "normal") {
+    return RespondNow(WithArguments(std::move(matches)));
+  }
+  auto* list = GetBrowserList(browser_context());
+  if (!list) {
+    return RespondNow(WithArguments(std::move(matches)));
+  }
+  const auto browsers = list->BrowsersOfType(BrowserList::BrowserType::kRegular);
+  Browser* foreground = browser_list_utils::GetMostActiveSceneBrowser(list);
+  Browser* sender_browser =
+      current.has_value() ? FindSenderBrowser(browsers, GetSenderWebContents())
+                          : nullptr;
+  Browser* current_browser = sender_browser ? sender_browser : foreground;
+  for (auto* browser : browsers) {
+    if ((current && *current != (browser == current_browser)) ||
+        (focused && *focused != (browser == foreground))) {
+      continue;
+    }
+    auto* tabs = browser->GetWebStateList();
+    for (int i = 0; i < tabs->count(); ++i) {
+      if (!active ||
+          *active == (tabs->GetWebStateAt(i) == tabs->GetActiveWebState())) {
+        matches.Append(MakeTab(*browser, i, *extension()));
+      }
+    }
+  }
+  return RespondNow(WithArguments(std::move(matches)));
+}
+
+ExtensionFunction::ResponseAction IOSTabsGetFunction::Run() {
+  EXTENSION_FUNCTION_VALIDATE(args().size() == 1u && args()[0].is_int());
+  if (!extension()) {
+    return RespondNow(Error("No extension found."));
+  }
+  const int id = args()[0].GetInt();
+  auto* list = GetBrowserList(browser_context());
+  if (!list) {
+    return RespondNow(Error("No tab with that ID."));
+  }
+  for (auto* browser :
+       list->BrowsersOfType(BrowserList::BrowserType::kRegular)) {
+    auto* tabs = browser->GetWebStateList();
+    for (int i = 0; i < tabs->count(); ++i) {
+      if (tabs->GetWebStateAt(i)->GetUniqueIdentifier().identifier() == id) {
+        return RespondNow(WithArguments(MakeTab(*browser, i, *extension())));
+      }
+    }
+  }
+  return RespondNow(Error("No tab with that ID."));
+}
+
+class IOSTabEvents::Observer final : public BrowserListObserver,
+                                     public WebStateListObserver {
+ public:
+  Observer(content::BrowserContext* context, ProfileIOS* profile)
+      : context_(context) {
+    auto* browsers = BrowserListFactory::GetForProfile(profile);
+    if (!browsers) {
+      return;
+    }
+    browser_observation_.Observe(browsers);
+    for (auto* browser :
+         browsers->BrowsersOfType(BrowserList::BrowserType::kRegular)) {
+      OnBrowserAdded(browsers, browser);
+    }
+  }
+
+  void OnBrowserAdded(const BrowserList*, Browser* browser) override {
+    auto* tabs = browser->GetWebStateList();
+    if (browser->type() == Browser::Type::kRegular &&
+        !tab_observation_.IsObservingSource(tabs)) {
+      windows_.emplace(tabs, GetWindowID(*browser));
+      tab_observation_.AddObservation(tabs);
+    }
+  }
+
+  void OnBrowserRemoved(const BrowserList*, Browser* browser) override {
+    StopObserving(browser->GetWebStateList());
+  }
+
+  void OnBrowserListShutdown(BrowserList*) override {
+    tab_observation_.RemoveAllObservations();
+    windows_.clear();
+    browser_observation_.Reset();
+  }
+
+  void WebStateListDestroyed(WebStateList* list) override {
+    StopObserving(list);
+  }
+
+  void WebStateListDidChange(WebStateList* list,
+                             const WebStateListChange& change,
+                             const WebStateListStatus&) override {
+    if (change.type() != WebStateListChange::Type::kDetach) {
+      return;
+    }
+    const auto& detach = change.As<WebStateListChangeDetach>();
+    if (!detach.is_closing()) {
+      return;
+    }
+    const auto window = windows_.find(list);
+    auto* router = EventRouter::Get(context_);
+    if (!router || window == windows_.end()) {
+      return;
+    }
+    base::DictValue info;
+    info.Set("windowId", window->second);
+    info.Set("isWindowClosing", false);
+    base::ListValue args;
+    args.Append(detach.detached_web_state()->GetUniqueIdentifier().identifier());
+    args.Append(std::move(info));
+    router->BroadcastEvent(std::make_unique<Event>(
+        events::TABS_ON_REMOVED, "tabs.onRemoved",
+        base::MakeRefCounted<EventArgs>(std::move(args)), context_));
+  }
+
+ private:
+  void StopObserving(WebStateList* list) {
+    if (tab_observation_.IsObservingSource(list)) {
+      tab_observation_.RemoveObservation(list);
+      windows_.erase(list);
+    }
+  }
+
+  const raw_ptr<content::BrowserContext> context_;
+  base::flat_map<WebStateList*, int> windows_;
+  base::ScopedObservation<BrowserList, BrowserListObserver>
+      browser_observation_{this};
+  base::ScopedMultiSourceObservation<WebStateList, WebStateListObserver>
+      tab_observation_{this};
+};
+
+IOSTabEvents::IOSTabEvents(content::BrowserContext* context, ProfileIOS* profile)
+    : observer_(std::make_unique<Observer>(context, profile)) {}
+
+IOSTabEvents::~IOSTabEvents() = default;
+
+}  // namespace extensions
