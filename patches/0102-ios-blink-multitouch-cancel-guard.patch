@@ -5,6 +5,11 @@
 #ifndef COMPONENTS_INPUT_WEB_INPUT_EVENT_BUILDERS_IOS_H_
 #define COMPONENTS_INPUT_WEB_INPUT_EVENT_BUILDERS_IOS_H_
 
+#import <Foundation/Foundation.h>
+
+#include <optional>
+#include <vector>
+
 #include "base/component_export.h"
 #include "third_party/blink/public/common/input/web_gesture_event.h"
 #include "third_party/blink/public/common/input/web_input_event.h"
@@ -37,6 +42,24 @@ class COMPONENT_EXPORT(INPUT) WebTouchEventBuilder {
       UIEvent* event,
       UIView* view,
       const std::optional<gfx::Vector2dF>& view_offset);
+
+  // Builds a sequence of WebTouchEvents for a UIKit touch callback while
+  // guarding MotionEventWeb's invariants (every point in a kTouchCancel event
+  // must have kStateCancelled; stale, duplicate, or untracked touches are
+  // drained or ignored instead of trapping).
+  static std::vector<blink::WebTouchEvent> BuildTouchEvents(
+      blink::WebInputEvent::Type type,
+      NSSet<UITouch*>* touches,
+      UIEvent* event,
+      UIView* view,
+      const std::optional<gfx::Vector2dF>& view_offset);
+
+  // Clears any tracked touches associated with `view` (or with a nil view),
+  // e.g. when the RenderWidgetUIView is removed from its superview.
+  static void ClearTouchesForView(UIView* view);
+
+  // Returns true if any tracked touch is still associated with `view`.
+  static bool HasActiveTouchesForView(UIView* view);
 };
 
 }  // namespace input
