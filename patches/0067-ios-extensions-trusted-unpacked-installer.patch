+NSError* MakeBridgeError(NSInteger code, NSString* description) {
+  return [NSError
+      errorWithDomain:kCrIOSExtensionManagerErrorDomain
+                 code:code
+             userInfo:@{NSLocalizedDescriptionKey : description ?: @""}];
+}
+
 void SetBridgeError(NSError* __autoreleasing* error,
                     NSInteger code,
                     NSString* description) {
   if (error) {
-    *error = [NSError
-        errorWithDomain:kCrIOSExtensionManagerErrorDomain
-                   code:code
-               userInfo:@{NSLocalizedDescriptionKey : description ?: @""}];
+    *error = MakeBridgeError(code, description);
+  }
+}
+
+NSDictionary<NSString*, id>* MakeExtensionEntryDictionary(
+    const extensions::Extension* extension,
+    extensions::ExtensionRegistrar* registrar) {
+  NSString* ext_id = base::SysUTF8ToNSString(extension->id()) ?: @"";
+  NSString* ext_name = base::SysUTF8ToNSString(extension->name()) ?: @"";
+  NSString* ext_version =
+      base::SysUTF8ToNSString(extension->VersionString()) ?: @"";
+  const BOOL is_enabled =
+      registrar->IsExtensionEnabled(extension->id()) ? YES : NO;
+  return @{
+    @"id" : [ext_id copy],
+    @"name" : [ext_name copy],
+    @"version" : [ext_version copy],
+    @"enabled" : @(is_enabled),
+  };
+}
+
+struct TrustedDirectoryResolution {
+  base::FilePath canonical_dir;
+  extensions::ExtensionId extension_id;
+  std::string error;
+};
+
+TrustedDirectoryResolution ResolveTrustedExtensionOnFileThread(
+    const base::FilePath& trusted_root,
+    const base::FilePath& candidate_path) {
+  TrustedDirectoryResolution result;
+  if (trusted_root.empty() || candidate_path.empty() ||
+      !base::DirectoryExists(trusted_root)) {
+    result.error = "TrustedUnpackedExtensions root directory does not exist.";
+    return result;
+  }
+  const base::FilePath canonical_root =
+      base::MakeAbsoluteFilePath(trusted_root);
+  if (canonical_root.empty()) {
+    result.error =
+        "Failed to canonicalize TrustedUnpackedExtensions root directory.";
+    return result;
+  }
+  if (!base::DirectoryExists(candidate_path)) {
+    result.error = "Requested extension directory does not exist.";
+    return result;
+  }
+  const base::FilePath canonical_dir =
+      base::MakeAbsoluteFilePath(candidate_path);
+  if (canonical_dir.empty() || !canonical_root.IsParent(canonical_dir)) {
+    result.error =
+        "Extension directory must resolve strictly inside "
+        "TrustedUnpackedExtensions.";
+    return result;
+  }
+  if (!base::PathExists(canonical_dir.Append(extensions::kManifestFilename))) {
+    result.error = "Extension directory is missing manifest.json.";
+    return result;
+  }
+  std::u16string load_error;
+  scoped_refptr<const extensions::Extension> extension =
+      extensions::file_util::LoadExtension(
+          canonical_dir, extensions::mojom::ManifestLocation::kUnpacked,
+          extensions::Extension::NO_FLAGS, &load_error);
+  if (!extension) {
+    result.error = load_error.empty()
+                       ? "Failed to parse unpacked extension manifest."
+                       : base::UTF16ToUTF8(load_error);
+    return result;
   }
+  result.canonical_dir = canonical_dir;
+  result.extension_id = extension->id();
+  return result;
 }
 
 bool ResolveExtensionServices(content::BrowserContext** out_context,
@@ -396,13 +487,13 @@ void ShutdownIOSExtensionsForProfile(ProfileIOS* profile) {
     const base::FilePath& canonical_path,
     const ExtensionId& extension_id) {
   base::AutoLock lock(bundled_allowlist_lock_);
-  allowed_bundled_paths_.clear();
-  allowed_bundled_ids_.clear();
-  if (!canonical_path.empty()) {
-    allowed_bundled_paths_.insert(canonical_path);
+  if (!canonical_path.empty() && !extension_id.empty()) {
+    allowed_extensions_[canonical_path] = extension_id;
   }
-  if (!extension_id.empty()) {
-    allowed_bundled_ids_.insert(extension_id);
+  allowed_bundled_ids_.clear();
+  allowed_bundled_ids_.insert(kIOSBundledExtensionId);
+  for (const auto& [_, allowed_id] : allowed_extensions_) {
+    allowed_bundled_ids_.insert(allowed_id);
   }
 }
 
@@ -413,17 +504,13 @@ void ShutdownIOSExtensionsForProfile(ProfileIOS* profile) {
     return false;
   }
   // Legacy MV2 background pages remain unsupported on iOS. MV3 service
-  // workers are allowed only for the verified bundled fixture path and ID.
+  // workers are allowed only for explicitly verified bundled or trusted paths.
   if (BackgroundInfo::HasBackgroundPage(&extension)) {
     return false;
   }
-  if (BackgroundInfo::IsServiceWorkerBased(&extension) &&
-      extension.id() != kIOSBundledExtensionId) {
-    return false;
-  }
   base::AutoLock lock(bundled_allowlist_lock_);
-  return allowed_bundled_paths_.contains(extension.path()) &&
-         allowed_bundled_ids_.contains(extension.id());
+  auto it = allowed_extensions_.find(extension.path());
+  return it != allowed_extensions_.end() && it->second == extension.id();
 }
 
 bool IOSExtensionsBrowserClient::IsAllowedBundledExtensionId(
@@ -933,18 +1020,7 @@ + (instancetype)sharedManager {
     if (!extension) {
       continue;
     }
-    NSString* ext_id = base::SysUTF8ToNSString(extension->id()) ?: @"";
-    NSString* ext_name = base::SysUTF8ToNSString(extension->name()) ?: @"";
