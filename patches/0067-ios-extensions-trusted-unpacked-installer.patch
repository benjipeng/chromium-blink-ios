+- (NSString*)trustedUnpackedExtensionsDirectoryWithError:
+    (NSError* __autoreleasing*)error {
+  content::BrowserContext* context = nullptr;
+  extensions::ExtensionSystem* system = nullptr;
+  extensions::ExtensionRegistry* registry = nullptr;
+  extensions::ExtensionRegistrar* registrar = nullptr;
+  if (!ResolveExtensionServices(&context, &system, &registry, &registrar,
+                                error)) {
+    return nil;
+  }
+
+  const base::FilePath profile_path = context->GetPath();
+  if (profile_path.empty()) {
+    SetBridgeError(error, kCrIOSExtensionManagerErrorSystemNotReady,
+                   @"Active extension browser context has no profile path.");
+    return nil;
+  }
+
+  return base::SysUTF8ToNSString(
+      profile_path.AppendASCII("TrustedUnpackedExtensions").value());
+}
+
+- (void)installExtensionFromTrustedDirectory:(NSString*)directoryPath
+                                  completion:
+                                      (void (^)(NSDictionary<NSString*, id>*
+                                                    extension,
+                                                NSError* error))completion {
+  InstallCompletionCallback finish =
+      completion ? base::BindOnce(completion)
+                 : InstallCompletionCallback(base::DoNothing());
+
+  if (![directoryPath isKindOfClass:[NSString class]] ||
+      directoryPath.length == 0) {
+    PostInstallCompletionOnMainThread(
+        std::move(finish), nil,
+        MakeBridgeError(kCrIOSExtensionManagerErrorInvalidArgument,
+                        @"Directory path must be a non-empty string."));
+    return;
+  }
+
+  content::BrowserContext* context = nullptr;
+  extensions::ExtensionSystem* system = nullptr;
+  extensions::ExtensionRegistry* registry = nullptr;
+  extensions::ExtensionRegistrar* registrar = nullptr;
+  NSError* resolve_error = nil;
+  if (!ResolveExtensionServices(&context, &system, &registry, &registrar,
+                                &resolve_error)) {
+    PostInstallCompletionOnMainThread(std::move(finish), nil, resolve_error);
+    return;
+  }
+
+  const base::FilePath profile_path = context->GetPath();
+  const base::FilePath requested_path(base::SysNSStringToUTF8(directoryPath));
+  if (profile_path.empty()) {
+    PostInstallCompletionOnMainThread(
+        std::move(finish), nil,
+        MakeBridgeError(kCrIOSExtensionManagerErrorSystemNotReady,
+                        @"Active extension browser context has no profile path."));
+    return;
+  }
+  if (requested_path.empty()) {
+    PostInstallCompletionOnMainThread(
+        std::move(finish), nil,
+        MakeBridgeError(kCrIOSExtensionManagerErrorInvalidArgument,
+                        @"Directory path could not be decoded."));
+    return;
+  }
+
+  const base::FilePath trusted_root =
+      profile_path.AppendASCII("TrustedUnpackedExtensions");
+  const base::FilePath candidate_path =
+      requested_path.IsAbsolute() ? requested_path
+                                  : trusted_root.Append(requested_path);
+
+  extensions::GetExtensionFileTaskRunner()->PostTaskAndReplyWithResult(
+      FROM_HERE,
+      base::BindOnce(&ResolveTrustedExtensionOnFileThread, trusted_root,
+                     candidate_path),
+      base::BindOnce(
+          [](content::BrowserContext* original_context,
+             InstallCompletionCallback finish_cb,
+             TrustedDirectoryResolution resolved) {
+            DCHECK_CURRENTLY_ON(content::BrowserThread::UI);
+            content::BrowserContext* live_context = nullptr;
+            extensions::ExtensionSystem* live_system = nullptr;
+            extensions::ExtensionRegistry* live_registry = nullptr;
+            extensions::ExtensionRegistrar* live_registrar = nullptr;
+            NSError* live_error = nil;
+            if (!ResolveExtensionServices(&live_context, &live_system,
+                                          &live_registry, &live_registrar,
+                                          &live_error)) {
+              std::move(finish_cb).Run(nil, live_error);
+              return;
+            }
+            if (live_context != original_context) {
+              std::move(finish_cb).Run(
+                  nil,
+                  MakeBridgeError(
+                      kCrIOSExtensionManagerErrorNotInitializedOrShuttingDown,
+                      @"Active extension browser context changed."));
+              return;
+            }
+            if (!resolved.error.empty() || resolved.canonical_dir.empty() ||
+                resolved.extension_id.empty()) {
+              NSString* detail =
+                  resolved.error.empty()
+                      ? @"Trusted extension directory validation failed."
+                      : base::SysUTF8ToNSString(resolved.error);
+              std::move(finish_cb).Run(
+                  nil, MakeBridgeError(
+                           kCrIOSExtensionManagerErrorInvalidArgument, detail));
+              return;
+            }
+
+            if (InFlightTrustedInstalls().contains(resolved.canonical_dir)) {
+              std::move(finish_cb).Run(
+                  nil,
+                  MakeBridgeError(
+                      kCrIOSExtensionManagerErrorStateChangeFailed,
+                      @"An extension installation from this directory is "
+                      @"already in progress."));
+              return;
+            }
+            InFlightTrustedInstalls().insert(resolved.canonical_dir);
+
+            std::optional<extensions::ExtensionId> previous_id =
+                extensions::IOSExtensionsBrowserClient::GetInstance()
+                    ->RegisterTrustedExtensionCandidate(resolved.canonical_dir,
+                                                        resolved.extension_id);
+
+            auto shared_cb = std::make_shared<InstallCompletionCallback>(
+                std::move(finish_cb));
+            base::ScopedClosureRunner shutdown_guard(base::BindOnce(
+                [](base::FilePath canonical_dir,
+                   extensions::ExtensionId candidate_id,
+                   std::optional<extensions::ExtensionId> prev_id,
+                   std::shared_ptr<InstallCompletionCallback> cb) {
+                  if (content::BrowserThread::CurrentlyOn(
+                          content::BrowserThread::UI)) {
+                    InFlightTrustedInstalls().erase(canonical_dir);
+                  }
+                  extensions::IOSExtensionsBrowserClient::GetInstance()
+                      ->RestoreTrustedExtensionCandidate(canonical_dir,
+                                                         candidate_id, prev_id);
+                  if (cb && *cb) {
+                    PostInstallCompletionOnMainThread(
+                        std::move(*cb), nil,
+                        MakeBridgeError(
+                            kCrIOSExtensionManagerErrorNotInitializedOrShuttingDown,
+                            @"Extension installation canceled during "
+                            @"shutdown."));
+                  }
+                },
+                resolved.canonical_dir, resolved.extension_id, previous_id,
+                shared_cb));
+
+            scoped_refptr<extensions::UnpackedInstaller> installer =
+                extensions::UnpackedInstaller::Create(live_context);
+            installer->set_be_noisy_on_failure(false);
+            installer->set_completion_callback(base::BindOnce(
+                [](content::BrowserContext* expected_context,
+                   base::FilePath canonical_dir,
+                   extensions::ExtensionId expected_id,
+                   std::optional<extensions::ExtensionId> prev_id,
+                   std::shared_ptr<InstallCompletionCallback> cb,
+                   base::ScopedClosureRunner guard,
+                   const extensions::Extension* extension,
+                   const base::FilePath& /*path*/,
+                   const std::u16string& install_error) {
+                  DCHECK_CURRENTLY_ON(content::BrowserThread::UI);
+                  (void)guard.Release();
+                  InFlightTrustedInstalls().erase(canonical_dir);
+                  auto rollback = [&]() {
+                    extensions::IOSExtensionsBrowserClient::GetInstance()
+                        ->RestoreTrustedExtensionCandidate(canonical_dir,
+                                                           expected_id,
+                                                           prev_id);
+                  };
+                  content::BrowserContext* final_context = nullptr;
+                  extensions::ExtensionSystem* final_system = nullptr;
+                  extensions::ExtensionRegistry* final_registry = nullptr;
+                  extensions::ExtensionRegistrar* final_registrar = nullptr;
+                  NSError* final_error = nil;
+                  if (!ResolveExtensionServices(&final_context, &final_system,
+                                                &final_registry,
+                                                &final_registrar,
+                                                &final_error)) {
+                    rollback();
+                    if (cb && *cb) {
+                      std::move(*cb).Run(nil, final_error);
+                    }
+                    return;
+                  }
+                  if (final_context != expected_context) {
+                    rollback();
+                    if (cb && *cb) {
+                      std::move(*cb).Run(
+                          nil,
+                          MakeBridgeError(
+                              kCrIOSExtensionManagerErrorNotInitializedOrShuttingDown,
+                              @"Active extension browser context changed."));
+                    }
+                    return;
+                  }
+                  if (!install_error.empty() || !extension) {
+                    rollback();
+                    if (cb && *cb) {
+                      NSString* detail =
+                          install_error.empty()
+                              ? @"Unpacked extension installation failed."
+                              : base::SysUTF16ToNSString(install_error);
+                      std::move(*cb).Run(
+                          nil,
+                          MakeBridgeError(
+                              kCrIOSExtensionManagerErrorStateChangeFailed,
+                              detail));
+                    }
+                    return;
+                  }
+                  const extensions::Extension* installed =
+                      final_registry->GetInstalledExtension(expected_id);
+                  if (!installed || installed->id() != extension->id()) {
+                    rollback();
+                    if (cb && *cb) {
+                      std::move(*cb).Run(
+                          nil,
+                          MakeBridgeError(
+                              kCrIOSExtensionManagerErrorStateChangeFailed,
+                              @"Installed extension not found in registry."));
+                    }
+                    return;
+                  }
+                  if (cb && *cb) {
+                    std::move(*cb).Run(
+                        MakeExtensionEntryDictionary(installed,
+                                                     final_registrar),
+                        nil);
+                  }
+                },
+                live_context, resolved.canonical_dir, resolved.extension_id,
+                previous_id, shared_cb, std::move(shutdown_guard)));
+            installer->Load(resolved.canonical_dir);
+          },
+          context, std::move(finish)));
+}
+
 @end
