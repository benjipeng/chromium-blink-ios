+std::optional<ExtensionId>
+IOSExtensionsBrowserClient::RegisterTrustedExtensionCandidate(
+    const base::FilePath& canonical_path,
+    const ExtensionId& extension_id) {
   base::AutoLock lock(bundled_allowlist_lock_);
-  allowed_bundled_paths_.clear();
-  allowed_bundled_ids_.clear();
+  std::optional<ExtensionId> previous_id;
   if (!canonical_path.empty()) {
-    allowed_bundled_paths_.insert(canonical_path);
+    auto it = allowed_extensions_.find(canonical_path);
+    if (it != allowed_extensions_.end()) {
+      previous_id = it->second;
+    }
+    if (!extension_id.empty()) {
+      allowed_extensions_[canonical_path] = extension_id;
+    }
+  }
+  allowed_bundled_ids_.clear();
+  allowed_bundled_ids_.insert(kIOSBundledExtensionId);
+  for (const auto& [_, allowed_id] : allowed_extensions_) {
+    allowed_bundled_ids_.insert(allowed_id);
+  }
+  return previous_id;
+}
+
+void IOSExtensionsBrowserClient::RestoreTrustedExtensionCandidate(
+    const base::FilePath& canonical_path,
+    const ExtensionId& candidate_id,
+    std::optional<ExtensionId> previous_id) {
+  if (canonical_path.empty() || candidate_id.empty()) {
+    return;
+  }
+  base::AutoLock lock(bundled_allowlist_lock_);
+  auto it = allowed_extensions_.find(canonical_path);
+  if (it == allowed_extensions_.end() || it->second != candidate_id) {
+    return;
   }
-  if (!extension_id.empty()) {
-    allowed_bundled_ids_.insert(extension_id);
+  if (previous_id.has_value()) {
+    it->second = *previous_id;
+  } else {
+    allowed_extensions_.erase(it);
+  }
+  allowed_bundled_ids_.clear();
+  allowed_bundled_ids_.insert(kIOSBundledExtensionId);
+  for (const auto& [_, allowed_id] : allowed_extensions_) {
+    allowed_bundled_ids_.insert(allowed_id);
   }
 }
 
