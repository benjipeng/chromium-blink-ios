+base::flat_set<base::FilePath>& InFlightTrustedInstalls() {
+  DCHECK_CURRENTLY_ON(content::BrowserThread::UI);
+  static base::NoDestructor<base::flat_set<base::FilePath>> in_flight;
+  return *in_flight;
+}
+
+using InstallCompletionCallback =
+    base::OnceCallback<void(NSDictionary<NSString*, id>*, NSError*)>;
+
+void PostInstallCompletionOnMainThread(InstallCompletionCallback callback,
+                                       NSDictionary<NSString*, id>* extension,
+                                       NSError* error) {
+  if (!callback) {
+    return;
+  }
+  if (content::BrowserThread::IsThreadInitialized(
+          content::BrowserThread::UI)) {
+    content::GetUIThreadTaskRunner({})->PostTask(
+        FROM_HERE, base::BindOnce(std::move(callback), extension, error));
+    return;
+  }
+  __block InstallCompletionCallback block_cb = std::move(callback);
+  dispatch_async(dispatch_get_main_queue(), ^{
+    std::move(block_cb).Run(extension, error);
+  });
+}
+
+struct TrustedDirectoryResolution {
+  base::FilePath canonical_dir;
+  extensions::ExtensionId extension_id;
+  std::string error;
+};
+
+TrustedDirectoryResolution ResolveTrustedExtensionOnFileThread(
+    const base::FilePath& trusted_root,
+    const base::FilePath& candidate_path) {
+  TrustedDirectoryResolution result;
+  if (trusted_root.empty() || candidate_path.empty() ||
+      !base::DirectoryExists(trusted_root)) {
+    result.error = "TrustedUnpackedExtensions root directory does not exist.";
+    return result;
+  }
+  const base::FilePath canonical_root =
+      base::MakeAbsoluteFilePath(trusted_root);
+  if (canonical_root.empty()) {
+    result.error =
+        "Failed to canonicalize TrustedUnpackedExtensions root directory.";
+    return result;
+  }
+  if (!base::DirectoryExists(candidate_path)) {
+    result.error = "Requested extension directory does not exist.";
+    return result;
+  }
+  const base::FilePath canonical_dir =
+      base::MakeAbsoluteFilePath(candidate_path);
+  if (canonical_dir.empty() || !canonical_root.IsParent(canonical_dir)) {
+    result.error =
+        "Extension directory must resolve strictly inside "
+        "TrustedUnpackedExtensions.";
+    return result;
+  }
+  if (!base::PathExists(canonical_dir.Append(extensions::kManifestFilename))) {
+    result.error = "Extension directory is missing manifest.json.";
+    return result;
+  }
+  std::u16string load_error;
+  const int preparse_flags =
+      extensions::Extension::FOLLOW_SYMLINKS_ANYWHERE |
+      extensions::Extension::REQUIRE_MODERN_MANIFEST_VERSION;
+  scoped_refptr<const extensions::Extension> extension =
+      extensions::file_util::LoadExtension(
+          canonical_dir, extensions::mojom::ManifestLocation::kUnpacked,
+          preparse_flags, &load_error);
+  if (!extension) {
+    result.error = load_error.empty()
+                       ? "Failed to parse unpacked extension manifest."
+                       : base::UTF16ToUTF8(load_error);
+    return result;
+  }
+  result.canonical_dir = canonical_dir;
+  result.extension_id = extension->id();
+  return result;
+}
