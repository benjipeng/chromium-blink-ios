+void ResetSignedImports() {
+  auto& state = SignedImportOnUIThread();
+  ++state.generation;
+  state.profile = base::FilePath();
+  state.busy = false;
+  state.download.reset();
+  if (state.prepared) {
+    DeleteImportDirectory(std::move(state.prepared->staging_path));
+    state.prepared.reset();
+  }
+  auto* client = extensions::IOSExtensionsBrowserClient::GetInstance();
+  for (const auto& [path, id] : state.installed_paths) {
+    client->RestoreTrustedExtensionCandidate(path, id, std::nullopt);
+  }
+  state.installed_paths.clear();
+}
+
+void SweepSignedImportDirectories(base::FilePath profile) {
+  // Restoring verified installations is a separate step. Do not accumulate
+  // orphaned copies for the current session-only installer.
+  if (profile.empty() || base::IsLink(profile)) {
+    return;
+  }
+  const auto pending = profile.AppendASCII("PendingSignedExtension");
+  const auto trusted = profile.AppendASCII("TrustedUnpackedExtensions");
+  const auto signed_imports = trusted.AppendASCII("SignedImports");
+  if (!base::IsLink(pending)) {
+    base::DeletePathRecursively(pending);
+  }
+  if (!base::IsLink(trusted) && !base::IsLink(signed_imports)) {
+    base::DeletePathRecursively(signed_imports);
+  }
+}
