+char kCrIOSInstallPromptSentinelKey;
+
+UIWindow* FindActivePresentationWindow(gfx::NativeWindow preferred_window) {
+  if (UIWindow* preferred = preferred_window.Get();
+      preferred && !preferred.hidden && preferred.alpha > 0.0 &&
+      preferred.rootViewController) {
+    return preferred;
+  }
+  UIWindow* fallback = nil;
+  for (UIScene* scene in UIApplication.sharedApplication.connectedScenes) {
+    UIWindowScene* window_scene = base::apple::ObjCCast<UIWindowScene>(scene);
+    if (!window_scene) {
+      continue;
+    }
+    UIWindow* candidate = window_scene.keyWindow;
+    if (!candidate || candidate.hidden || candidate.alpha <= 0.0 ||
+        !candidate.rootViewController) {
+      candidate = nil;
+      for (UIWindow* w in window_scene.windows) {
+        if (!w.hidden && w.alpha > 0.0 && w.rootViewController) {
+          candidate = w;
+          break;
+        }
+      }
+    }
+    if (candidate &&
+        window_scene.activationState == UISceneActivationStateForegroundActive) {
+      return candidate;
+    }
+    if (candidate && !fallback) {
+      fallback = candidate;
+    }
+  }
+  return fallback;
+}
+
+UIViewController* FindTopmostViewController(UIWindow* window) {
+  UIViewController* vc = window.rootViewController;
+  while (vc.presentedViewController &&
+         !vc.presentedViewController.isBeingDismissed) {
+    vc = vc.presentedViewController;
+  }
+  return vc;
+}
