+gfx::NativeWindow IOSExtensionsBrowserClient::GetNativeWindowForFunction(
+    ExtensionFunction& function) {
+  if (content::WebContents* web_contents = function.GetSenderWebContents()) {
+    gfx::NativeWindow sender_window = web_contents->GetTopLevelNativeWindow();
+    if (UIWindow* w = sender_window.Get();
+        w && !w.hidden && w.alpha > 0.0 && w.rootViewController) {
+      return sender_window;
+    }
+  }
+  UIWindow* active_window = FindActivePresentationWindow(gfx::NativeWindow());
+  return active_window ? gfx::NativeWindow(active_window) : gfx::NativeWindow();
+}
+
+std::unique_ptr<ExtensionInstallPromptClient>
+IOSExtensionsBrowserClient::CreateInstallPromptForNativeWindow(
+    gfx::NativeWindow native_window,
+    content::BrowserContext& browser_context,
+    std::unique_ptr<InstallPromptData> prompt) {
+  return std::make_unique<IOSExtensionInstallPromptClient>(native_window,
+                                                           std::move(prompt));
+}
