+@interface CrIOSExtensionInstallPromptSentinel : NSObject
+- (instancetype)initWithOnDealloc:(base::OnceClosure)onDealloc;
+- (void)disarm;
+@end
+
+@implementation CrIOSExtensionInstallPromptSentinel {
+  base::OnceClosure _onDealloc;
+}
+
+- (instancetype)initWithOnDealloc:(base::OnceClosure)onDealloc {
+  self = [super init];
+  if (self) {
+    _onDealloc = std::move(onDealloc);
+  }
+  return self;
+}
+
+- (void)disarm {
+  _onDealloc.Reset();
+}
+
+- (void)dealloc {
+  if (_onDealloc) {
+    __block base::OnceClosure callback = std::move(_onDealloc);
+    dispatch_async(dispatch_get_main_queue(), ^{
+      std::move(callback).Run();
+    });
+  }
+}
+
+@end
