+class IOSExtensionInstallPromptClient final
+    : public extensions::ExtensionInstallPromptClient {
+ public:
+  IOSExtensionInstallPromptClient(
+      gfx::NativeWindow native_window,
+      std::unique_ptr<extensions::InstallPromptData> prompt)
+      : native_window_(native_window), prompt_(std::move(prompt)) {}
+
+  IOSExtensionInstallPromptClient(const IOSExtensionInstallPromptClient&) =
+      delete;
+  IOSExtensionInstallPromptClient& operator=(
+      const IOSExtensionInstallPromptClient&) = delete;
+
+  ~IOSExtensionInstallPromptClient() override {
+    weak_ptr_factory_.InvalidateWeakPtrs();
+    if (sentinel_) {
+      [sentinel_ disarm];
+      sentinel_ = nil;
+    }
+    if (UIAlertController* alert = presented_alert_;
+        alert && alert.presentingViewController) {
+      [alert dismissViewControllerAnimated:NO completion:nil];
+    }
+    presented_alert_ = nil;
+  }
+
+  void OnInstallSuccess(scoped_refptr<const extensions::Extension> extension,
+                        SkBitmap* icon) override {}
+  void OnInstallFailure(const extensions::CrxInstallError& error) override {}
+  void SetUseAppInstalledBubble(bool use_bubble) override {}
+  void SetSkipPostInstallUI(bool skip_ui) override {}
+
+  void ConfirmInstall(DoneCallback install_callback,
+                      const extensions::Extension* extension) override {
+    std::unique_ptr<const extensions::PermissionSet> perms;
+    if (extension && extension->permissions_data()) {
+      perms = extension->permissions_data()->active_permissions().Clone();
+    }
+    ShowDialogInternal(std::move(install_callback), extension,
+                       std::move(perms));
+  }
+
+  void ConfirmReEnable(DoneCallback install_callback,
+                       const extensions::Extension* extension,
+                       content::BrowserContext* browser_context) override {
+    ConfirmInstall(std::move(install_callback), extension);
+  }
+
+  void ConfirmPermissions(
+      DoneCallback done_callback,
+      const extensions::Extension* extension,
+      std::unique_ptr<const extensions::PermissionSet> custom_permissions)
+      override {
+    ShowDialogInternal(std::move(done_callback), extension,
+                       std::move(custom_permissions));
+  }
+
+  void ShowInstallDialog(DoneCallback install_callback,
+                         const extensions::Extension* extension,
+                         const SkBitmap* icon) override {
+    ConfirmInstall(std::move(install_callback), extension);
+  }
+
+ private:
+  void ShowDialogInternal(
+      DoneCallback done_callback,
+      const extensions::Extension* extension,
+      std::unique_ptr<const extensions::PermissionSet> permissions) {
+    DCHECK_CURRENTLY_ON(content::BrowserThread::UI);
+    done_callback_ = std::move(done_callback);
+
+    if (!prompt_) {
+      prompt_ = std::make_unique<extensions::InstallPromptData>(
+          extensions::InstallPromptData::PERMISSIONS_PROMPT);
+    }
+    if (extension) {
+      prompt_->set_extension(extension);
+    }
+    if (permissions && !permissions->IsEmpty()) {
+      prompt_->AddPermissionSet(*permissions);
+    }
+
+    NSString* ext_name =
+        (extension && !extension->name().empty())
+            ? base::SysUTF8ToNSString(extension->name())
+            : @"This extension";
+
+    std::u16string title_16 =
+        extension ? prompt_->GetDialogTitle() : std::u16string();
+    NSString* title =
+        !title_16.empty()
+            ? base::SysUTF16ToNSString(title_16)
+            : [NSString stringWithFormat:
+                            @"Allow “%@” to access additional site data?",
+                            ext_name];
+
+    NSMutableArray<NSString*>* lines = [NSMutableArray array];
+    const size_t perm_count = prompt_->GetPermissionCount();
+    if (perm_count > 0) {
+      std::u16string heading_16 = prompt_->GetPermissionsHeading();
+      if (!heading_16.empty()) {
+        [lines addObject:base::SysUTF16ToNSString(heading_16)];
+      }
+      for (size_t i = 0; i < perm_count; ++i) {
+        std::u16string perm_16 = prompt_->GetPermission(i);
+        if (!perm_16.empty()) {
+          [lines addObject:[NSString stringWithFormat:@"• %@",
+                                                      base::SysUTF16ToNSString(
+                                                          perm_16)]];
+        }
+      }
+    }
+    if (permissions && !permissions->IsEmpty()) {
+      constexpr size_t kMaxListedHosts = 5;
+      size_t host_count = 0;
+      size_t total_hosts = 0;
+      bool matches_all_urls = false;
+      for (const URLPattern& pattern : permissions->effective_hosts()) {
+        ++total_hosts;
+        if (pattern.match_all_urls()) {
+          matches_all_urls = true;
+          break;
+        }
+        if (host_count < kMaxListedHosts) {
+          [lines addObject:[NSString stringWithFormat:@"• %@",
+                                                      base::SysUTF8ToNSString(
+                                                          pattern.GetAsString())]];
+          ++host_count;
+        }
+      }
+      if (matches_all_urls) {
+        [lines addObject:@"• All websites"];
+      } else if (total_hosts > kMaxListedHosts) {
+        [lines addObject:[NSString
+                             stringWithFormat:@"• …and %zu more sites",
+                                              total_hosts - kMaxListedHosts]];
+      }
+      for (const extensions::APIPermission* api_perm : permissions->apis()) {
+        if (api_perm && api_perm->name() && api_perm->name()[0] != '\0') {
+          [lines addObject:[NSString stringWithFormat:@"• API: %s",
+                                                      api_perm->name()]];
+        }
+      }
+    }
+    NSString* message =
+        lines.count > 0
+            ? [lines componentsJoinedByString:@"\n"]
+            : @"This extension is requesting optional permissions to read and "
+              @"change data on websites.";
+
+    std::u16string accept_16 = prompt_->GetAcceptButtonLabel();
+    NSString* accept_title =
+        !accept_16.empty() ? base::SysUTF16ToNSString(accept_16) : @"Allow";
+    std::u16string abort_16 = prompt_->GetAbortButtonLabel();
+    NSString* cancel_title =
+        !abort_16.empty() ? base::SysUTF16ToNSString(abort_16) : @"Deny";
+
+    UIAlertController* alert =
+        [UIAlertController alertControllerWithTitle:title
+                                            message:message
+                                     preferredStyle:UIAlertControllerStyleAlert];
+
+    base::WeakPtr<IOSExtensionInstallPromptClient> weak_self =
+        weak_ptr_factory_.GetWeakPtr();
+
+    // Guarantees `done_callback_` settles with USER_CANCELED if UIKit drops
+    // presentation or dismisses the alert externally (e.g. parent popup sheet
+    // closes on backgrounding) so PermissionsRequestFunction never hangs.
+    CrIOSExtensionInstallPromptSentinel* sentinel =
+        [[CrIOSExtensionInstallPromptSentinel alloc]
+            initWithOnDealloc:base::BindOnce(
+                                  &IOSExtensionInstallPromptClient::Complete,
+                                  weak_self, Result::USER_CANCELED)];
+    sentinel_ = sentinel;
+    objc_setAssociatedObject(alert, &kCrIOSInstallPromptSentinelKey, sentinel,
+                             OBJC_ASSOCIATION_RETAIN_NONATOMIC);
+
+    [alert addAction:[UIAlertAction
+                         actionWithTitle:cancel_title
+                                   style:UIAlertActionStyleCancel
+                                 handler:^(UIAlertAction*) {
+                                   if (weak_self) {
+                                     weak_self->Complete(Result::USER_CANCELED);
+                                   }
+                                 }]];
+    [alert addAction:[UIAlertAction
+                         actionWithTitle:accept_title
+                                   style:UIAlertActionStyleDefault
+                                 handler:^(UIAlertAction*) {
+                                   if (weak_self) {
+                                     weak_self->Complete(Result::ACCEPTED);
+                                   }
+                                 }]];
+
+    presented_alert_ = alert;
+    PresentAlertWithRetry(alert, /*remaining_attempts=*/3);
+  }
+
+  void PresentAlertWithRetry(UIAlertController* alert, int remaining_attempts) {
+    if (!done_callback_) {
+      return;
+    }
+    UIWindow* window = FindActivePresentationWindow(native_window_);
+    UIViewController* presenter =
+        window ? FindTopmostViewController(window) : nil;
+    if (!presenter) {
+      CancelAsync();
+      return;
+    }
+
+    // Wait out an active dismissal (for example, an extension popup sheet
+    // closing right as it triggers chrome.permissions.request) so UIKit does
+    // not silently drop presentViewController:.
+    UIViewController* dismissing_child = presenter.presentedViewController;
+    if (dismissing_child || presenter.isBeingDismissed) {
+      if (remaining_attempts <= 0) {
+        CancelAsync();
+        return;
+      }
+      base::WeakPtr<IOSExtensionInstallPromptClient> weak_self =
+          weak_ptr_factory_.GetWeakPtr();
+      id<UIViewControllerTransitionCoordinator> coordinator =
+          dismissing_child.transitionCoordinator
+              ?: presenter.transitionCoordinator;
+      if (coordinator) {
+        [coordinator
+            animateAlongsideTransition:nil
+                            completion:^(
+                                id<UIViewControllerTransitionCoordinatorContext>) {
+                              dispatch_async(dispatch_get_main_queue(), ^{
+                                if (weak_self) {
+                                  weak_self->PresentAlertWithRetry(
+                                      alert, remaining_attempts - 1);
+                                }
+                              });
+                            }];
+      } else {
+        dispatch_after(
+            dispatch_time(DISPATCH_TIME_NOW,
+                          static_cast<int64_t>(0.15 * NSEC_PER_SEC)),
+            dispatch_get_main_queue(), ^{
+              if (weak_self) {
+                weak_self->PresentAlertWithRetry(alert, remaining_attempts - 1);
+              }
+            });
+      }
+      return;
+    }
+
+    if (prompt_) {
+      prompt_->OnDialogOpened();
+    }
+    [presenter presentViewController:alert animated:YES completion:nil];
+  }
+
+  void CancelAsync() {
+    base::WeakPtr<IOSExtensionInstallPromptClient> weak_self =
+        weak_ptr_factory_.GetWeakPtr();
+    dispatch_async(dispatch_get_main_queue(), ^{
+      if (weak_self) {
+        weak_self->Complete(Result::USER_CANCELED);
+      }
+    });
+  }
+
+  void Complete(Result result) {
+    if (!done_callback_) {
+      return;
+    }
+    if (sentinel_) {
+      [sentinel_ disarm];
+      sentinel_ = nil;
+    }
+    presented_alert_ = nil;
+    if (prompt_) {
+      if (result == Result::ACCEPTED) {
+        prompt_->OnDialogAccepted();
+      } else {
+        prompt_->OnDialogCanceled();
+      }
+    }
+    DoneCallback callback = std::move(done_callback_);
+    std::move(callback).Run(DoneCallbackPayload(result));
+  }
+
+  gfx::NativeWindow native_window_;
+  std::unique_ptr<extensions::InstallPromptData> prompt_;
+  DoneCallback done_callback_;
+  __weak UIAlertController* presented_alert_ = nil;
+  __weak CrIOSExtensionInstallPromptSentinel* sentinel_ = nil;
+  base::WeakPtrFactory<IOSExtensionInstallPromptClient> weak_ptr_factory_{this};
+};
