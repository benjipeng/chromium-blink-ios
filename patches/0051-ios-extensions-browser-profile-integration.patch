+bool IOSExtensionsBrowserClient::IsExtensionEnabled(
+    const ExtensionId& extension_id,
+    content::BrowserContext* context) const {
+  if (!context) {
+    return false;
+  }
+  if (auto* registrar = ExtensionRegistrar::Get(context);
+      registrar && registrar->IsInitialized()) {
+    return registrar->IsExtensionEnabled(extension_id);
+  }
+  if (auto* registry = ExtensionRegistry::Get(context)) {
+    return registry->enabled_extensions().Contains(extension_id);
+  }
+  return false;
+}
