+bool IOSExtensionsBrowserClient::DidVersionUpdate(
+    content::BrowserContext* context) {
+  ExtensionPrefs* extension_prefs = ExtensionPrefs::Get(context);
+  if (!extension_prefs) {
+    return false;
+  }
+  PrefService* pref_service = extension_prefs->pref_service();
+  base::Version last_version;
+  if (pref_service->HasPrefPath(pref_names::kLastChromeVersion)) {
+    last_version =
+        base::Version(pref_service->GetString(pref_names::kLastChromeVersion));
+  }
+  const std::string current_version_str(version_info::GetVersionNumber());
+  const base::Version& current_version = version_info::GetVersion();
+  pref_service->SetString(pref_names::kLastChromeVersion, current_version_str);
+  if (!last_version.IsValid()) {
+    return true;
+  }
+  if (!current_version.IsValid()) {
+    return false;
+  }
+  return last_version < current_version;
+}
