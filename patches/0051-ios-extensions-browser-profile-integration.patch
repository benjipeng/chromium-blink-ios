+void IOSExtensionsBrowserClient::SetAllowedBundledExtension(
+    const base::FilePath& canonical_path,
+    const ExtensionId& extension_id) {
+  base::AutoLock lock(bundled_allowlist_lock_);
+  if (!canonical_path.empty()) {
+    allowed_bundled_paths_.insert(canonical_path);
+  }
+  if (!extension_id.empty()) {
+    allowed_bundled_ids_.insert(extension_id);
+  }
+}
+
+bool IOSExtensionsBrowserClient::IsAllowedBundledExtension(
+    const Extension& extension) const {
+  if (extension.location() != mojom::ManifestLocation::kUnpacked ||
+      !extension.is_extension()) {
+    return false;
+  }
+  // MV3 service workers and background hosts require context-aware ProcessMap
+  // adaptation under single-process Blink; restrict the initial bundled
+  // fixture strictly to content scripts.
+  if (BackgroundInfo::HasBackgroundPage(&extension) ||
+      BackgroundInfo::IsServiceWorkerBased(&extension)) {
+    return false;
+  }
+  base::AutoLock lock(bundled_allowlist_lock_);
+  return allowed_bundled_paths_.contains(extension.path()) &&
+         allowed_bundled_ids_.contains(extension.id());
+}
+
+bool IOSExtensionsBrowserClient::IsAllowedBundledExtensionId(
+    const ExtensionId& extension_id) const {
+  base::AutoLock lock(bundled_allowlist_lock_);
+  return allowed_bundled_ids_.contains(extension_id);
+}
