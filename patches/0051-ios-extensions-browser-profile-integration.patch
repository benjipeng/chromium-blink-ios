+std::vector<content::BrowserContext*>
+IOSExtensionsBrowserClient::GetRegisteredContextsSnapshot() const {
+  base::AutoLock lock(context_lock_);
+  std::vector<content::BrowserContext*> contexts;
+  contexts.reserve(registered_contexts_.size());
+  for (const auto& [context, _] : registered_contexts_) {
+    contexts.push_back(context);
+  }
+  return contexts;
+}
