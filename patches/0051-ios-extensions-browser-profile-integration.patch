+void IOSExtensionsBrowserClient::CanInstallExtensionByPolicy(
+    content::BrowserContext* context,
+    const ExtensionId& extension_id,
+    const base::Version& extension_version,
+    base::OnceCallback<void(bool, std::u16string)> callback) {
+  const bool allowed = IsAllowedBundledExtensionId(extension_id);
+  std::move(callback).Run(
+      allowed, allowed ? std::u16string()
+                       : u"Only the bundled iOS probe extension is permitted.");
+}
