+struct ResolvedBundledExtension {
+  base::FilePath canonical_path;
+  ExtensionId extension_id;
+};
+
+std::optional<ResolvedBundledExtension> ResolveBundledExtensionOnFileThread(
+    const base::FilePath& bundled_dir) {
+  if (bundled_dir.empty() || !base::DirectoryExists(bundled_dir)) {
+    return std::nullopt;
+  }
+  const base::FilePath canonical_path = base::MakeAbsoluteFilePath(bundled_dir);
+  if (canonical_path.empty() ||
+      !base::PathExists(canonical_path.Append(kManifestFilename))) {
+    return std::nullopt;
+  }
+
+  ExtensionId extension_id =
+      crx_file::id_util::GenerateIdForPath(canonical_path);
+  std::string error;
+  std::optional<base::DictValue> manifest =
+      file_util::LoadManifest(canonical_path, &error);
+  if (manifest) {
+    if (const std::string* manifest_key =
+            manifest->FindString(manifest_keys::kPublicKey)) {
+      std::string public_key_bytes;
+      if (Extension::ParsePEMKeyBytes(*manifest_key, &public_key_bytes)) {
+        extension_id = crx_file::id_util::GenerateId(public_key_bytes);
+      }
+    }
+  }
+  return ResolvedBundledExtension{canonical_path, extension_id};
+}
+
+}  // namespace
+
+class IOSExtensionSystem::BundledExtensionPolicyProvider final
+    : public ManagementPolicy::Provider {
+ public:
+  BundledExtensionPolicyProvider() = default;
+  ~BundledExtensionPolicyProvider() override = default;
+
+  std::string GetDebugPolicyProviderName() const override {
+#if DCHECK_IS_ON()
+    return "IOSBundledExtensionPolicyProvider";
+#else
+    return std::string();
+#endif
+  }
+
+  bool UserMayLoad(const Extension* extension,
+                   std::u16string* error) const override {
+    if (extension &&
+        IOSExtensionsBrowserClient::GetInstance()->IsAllowedBundledExtension(
+            *extension)) {
+      return true;
+    }
+    if (error) {
+      *error = u"Only the bundled unpacked content-script probe extension is "
+               u"permitted on iOS.";
+    }
+    return false;
+  }
+};
+
+class IOSExtensionSystem::RegistrarDelegate final
+    : public ExtensionRegistrar::Delegate {
+ public:
+  explicit RegistrarDelegate(content::BrowserContext* browser_context)
+      : browser_context_(browser_context) {}
