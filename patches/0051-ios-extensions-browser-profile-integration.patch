+bool IOSExtensionsBrowserClient::IsMinBrowserVersionSupported(
+    const std::string& min_version) {
+  const base::Version& browser_version = version_info::GetVersion();
+  const base::Version min_parsed(min_version);
+  return !browser_version.IsValid() || !min_parsed.IsValid() ||
+         min_parsed.CompareTo(browser_version) <= 0;
