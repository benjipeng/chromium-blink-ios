+void IOSExtensionSystem::Shutdown() {
+  weak_factory_.InvalidateWeakPtrs();
+  if (management_policy_ && policy_provider_) {
+    management_policy_->UnregisterProvider(policy_provider_.get());
+  }
+  user_script_manager_.reset();
+  service_worker_manager_.reset();
+  dynamic_user_scripts_store_.reset();
+  rules_store_.reset();
+  state_store_.reset();
+  quota_service_.reset();
+  management_policy_.reset();
+  policy_provider_.reset();
+  app_sorting_.reset();
+  registrar_delegate_.reset();
+  store_factory_.reset();
+}
+
+void IOSExtensionSystem::InitForRegularProfile(bool extensions_enabled) {
+  DCHECK_CURRENTLY_ON(content::BrowserThread::UI);
+  if (initialized_) {
+    return;
+  }
+  initialized_ = true;
+
+  store_factory_ = base::MakeRefCounted<value_store::ValueStoreFactoryImpl>(
+      browser_context_->GetPath());
+  state_store_ = std::make_unique<StateStore>(
+      browser_context_, store_factory_, StateStore::BackendType::STATE,
+      /*deferred_load=*/false);
+  rules_store_ = std::make_unique<StateStore>(
+      browser_context_, store_factory_, StateStore::BackendType::RULES,
+      /*deferred_load=*/false);
+  dynamic_user_scripts_store_ = std::make_unique<StateStore>(
+      browser_context_, store_factory_, StateStore::BackendType::SCRIPTS,
+      /*deferred_load=*/false);
+
+  quota_service_ = std::make_unique<QuotaService>();
+  app_sorting_ = std::make_unique<NullAppSorting>();
+  policy_provider_ = std::make_unique<BundledExtensionPolicyProvider>();
+  management_policy_ = std::make_unique<ManagementPolicy>();
+  management_policy_->RegisterProvider(policy_provider_.get());
+
+  service_worker_manager_ =
+      std::make_unique<ServiceWorkerManager>(browser_context_);
+  user_script_manager_ = std::make_unique<UserScriptManager>(browser_context_);
+
+  registrar_delegate_ = std::make_unique<RegistrarDelegate>(browser_context_);
+  const base::FilePath install_dir =
+      browser_context_->GetPath().Append(kInstallDirectoryName);
+  const base::FilePath unpacked_install_dir =
+      browser_context_->GetPath().Append(kUnpackedInstallDirectoryName);
+  ExtensionRegistrar::Get(browser_context_)
+      ->Init(registrar_delegate_.get(), extensions_enabled,
+             base::CommandLine::ForCurrentProcess(), install_dir,
+             unpacked_install_dir);
+
+  ready_.Signal();
+
+  if (!extensions_enabled) {
+    return;
+  }
+
+  const base::FilePath bundled_dir = GetIOSBundledExtensionDirectory();
+  if (bundled_dir.empty()) {
+    return;
+  }
+
+  GetExtensionFileTaskRunner()->PostTaskAndReplyWithResult(
+      FROM_HERE,
+      base::BindOnce(&ResolveBundledExtensionOnFileThread, bundled_dir),
+      base::BindOnce(
+          [](base::WeakPtr<IOSExtensionSystem> self,
+             std::optional<ResolvedBundledExtension> resolved) {
+            if (self && resolved) {
+              self->OnBundledExtensionPathResolved(resolved->canonical_path,
+                                                   resolved->extension_id);
+            }
+          },
+          weak_factory_.GetWeakPtr()));
+}
+
+void IOSExtensionSystem::OnBundledExtensionPathResolved(
+    const base::FilePath& canonical_path,
+    const ExtensionId& expected_id) {
+  DCHECK_CURRENTLY_ON(content::BrowserThread::UI);
+  if (!browser_context_ ||
+      ExtensionsBrowserClient::Get()->IsShuttingDown()) {
+    return;
+  }
+  IOSExtensionsBrowserClient::GetInstance()->SetAllowedBundledExtension(
+      canonical_path, expected_id);
+
+  scoped_refptr<UnpackedInstaller> installer =
+      UnpackedInstaller::Create(browser_context_);
+  installer->set_be_noisy_on_failure(false);
+  installer->Load(canonical_path);
+}
