+base::FilePath GetIOSBundledExtensionDirectory() {
+  base::FilePath assets_dir;
+  if (!base::PathService::Get(base::DIR_ASSETS, &assets_dir)) {
+    return base::FilePath();
+  }
+  return assets_dir.AppendASCII("Extensions").AppendASCII("iOSProbe");
+}
+
+void InitializeIOSExtensionsBrowserClient() {
+  auto* client = extensions::IOSExtensionsBrowserClient::GetInstance();
+  if (extensions::ExtensionsBrowserClient::Get() != client) {
+    extensions::ExtensionsBrowserClient::Set(client);
+  }
+  client->Init();
+  EnsureIOSExtensionFactoriesBuilt();
+}
+
+void StartTearDownIOSExtensionsBrowserClient() {
+  if (auto* client = extensions::ExtensionsBrowserClient::Get()) {
+    client->StartTearDown();
+  }
+}
+
+void RegisterIOSExtensionPrefs(user_prefs::PrefRegistrySyncable* registry) {
+  CHECK(registry);
+  EnsureIOSExtensionFactoriesBuilt();
+  extensions::ExtensionPrefs::RegisterProfilePrefs(registry);
+  BrowserContextDependencyManager::GetInstance()
+      ->RegisterProfilePrefsForServices(registry);
+}
+
+void InitializeIOSExtensionsForProfile(ProfileIOS* profile) {
+  CHECK(profile);
+  if (profile->IsOffTheRecord()) {
+    return;
+  }
+  InitializeIOSExtensionsBrowserClient();
+
+  content::BrowserContext* browser_context =
+      web::ContentBrowserContext::FromBrowserState(profile);
+  CHECK(browser_context);
+
+  auto* client = extensions::IOSExtensionsBrowserClient::GetInstance();
+  client->RegisterBrowserContext(browser_context, profile);
+
+  BrowserContextDependencyManager::GetInstance()->MarkBrowserContextLive(
+      browser_context);
+  if (!user_prefs::UserPrefs::Get(browser_context)) {
+    user_prefs::UserPrefs::Set(browser_context, profile->GetPrefs());
+  }
+  BrowserContextDependencyManager::GetInstance()->CreateBrowserContextServices(
+      browser_context);
+  extensions::ExtensionSystem::Get(browser_context)
+      ->InitForRegularProfile(/*extensions_enabled=*/true);
+}
+
+void ShutdownIOSExtensionsForProfile(ProfileIOS* profile) {
+  if (!profile || profile->IsOffTheRecord()) {
+    return;
+  }
+  auto* client = extensions::IOSExtensionsBrowserClient::GetInstance();
+  content::BrowserContext* browser_context =
+      web::ContentBrowserContext::FromBrowserState(profile);
+  if (!client->IsValidContext(browser_context)) {
+    return;
+  }
+  BrowserContextDependencyManager::GetInstance()->DestroyBrowserContextServices(
+      browser_context);
+  client->UnregisterBrowserContext(browser_context);
+}
