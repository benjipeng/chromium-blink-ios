+#include <memory>
+#include <string>
+
+#include "base/no_destructor.h"
+#include "extensions/common/core_extensions_api_provider.h"
+#include "extensions/common/extension_urls.h"
+#include "extensions/common/extensions_client.h"
+#include "extensions/common/permissions/manifest_permission.h"
+#include "extensions/common/permissions/permission_message_provider.h"
+#include "extensions/common/permissions/permission_set.h"
+#include "extensions/common/url_pattern_set.h"
+#include "url/gurl.h"
+
+namespace web {
+namespace {
+
+class IOSPermissionMessageProvider final
+    : public extensions::PermissionMessageProvider {
+ public:
+  extensions::PermissionMessages GetPermissionMessages(
+      const extensions::PermissionIDSet& permissions) const override {
+    if (permissions.empty()) {
+      return {};
+    }
+    return {extensions::PermissionMessage(
+        u"Access the websites and browser capabilities requested by this extension.",
+        permissions)};
+  }
+
+  bool IsPrivilegeIncrease(
+      const extensions::PermissionSet& granted,
+      const extensions::PermissionSet& requested,
+      extensions::Manifest::Type extension_type) const override {
+    return !granted.Contains(requested);
+  }
+
+  extensions::PermissionIDSet GetAllPermissionIDs(
+      const extensions::PermissionSet& permissions,
+      extensions::Manifest::Type extension_type) const override {
+    extensions::PermissionIDSet ids;
+    for (const auto* permission : permissions.apis()) {
+      ids.InsertAll(permission->GetPermissions());
+    }
+    for (const auto* permission : permissions.manifest_permissions()) {
+      ids.InsertAll(permission->GetPermissions());
+    }
+    if (!permissions.effective_hosts().is_empty()) {
+      ids.insert(extensions::mojom::APIPermissionID::kHostReadWrite);
+    }
+    return ids;
+  }
+};
+
+class IOSExtensionsClient final : public extensions::ExtensionsClient {
+ public:
+  IOSExtensionsClient()
+      : webstore_url_(extension_urls::kChromeWebstoreBaseURL),
+        new_webstore_url_(extension_urls::kNewChromeWebstoreBaseURL),
+        update_url_(extension_urls::kChromeWebstoreUpdateURL) {
+    AddAPIProvider(std::make_unique<extensions::CoreExtensionsAPIProvider>());
+  }
+
+  void Initialize() override {}
+  void InitializeWebStoreUrls(base::CommandLine* command_line) override {}
+
+  const extensions::PermissionMessageProvider& GetPermissionMessageProvider()
+      const override {
+    return permission_messages_;
+  }
+
+  const std::string GetProductName() override { return "Chromium Blink iOS"; }
+
+  void FilterHostPermissions(const extensions::URLPatternSet& hosts,
+                             extensions::URLPatternSet* new_hosts,
+                             extensions::PermissionIDSet* permissions) const override {
+    *new_hosts = hosts.Clone();
+  }
+
+  void SetScriptingAllowlist(const ScriptingAllowlist& allowlist) override {
+    scripting_allowlist_ = allowlist;
+  }
+
+  const ScriptingAllowlist& GetScriptingAllowlist() const override {
+    return scripting_allowlist_;
+  }
+
+  extensions::URLPatternSet GetPermittedChromeSchemeHosts(
+      const extensions::Extension* extension,
+      const extensions::APIPermissionSet& api_permissions) const override {
+    return {};
+  }
+
+  bool IsScriptableURL(const GURL& url, std::string* error) const override {
+    if (url.SchemeIsHTTPOrHTTPS() &&
+        !url.DomainIs("chromewebstore.google.com") &&
+        !(url.DomainIs("chrome.google.com") &&
+          url.path().starts_with("/webstore"))) {
+      return true;
+    }
+    if (error) {
+      *error = "Extensions cannot script this URL.";
+    }
+    return false;
+  }
+
+  const GURL& GetWebstoreBaseURL() const override { return webstore_url_; }
+  const GURL& GetNewWebstoreBaseURL() const override { return new_webstore_url_; }
+  const GURL& GetWebstoreUpdateURL() const override { return update_url_; }
+  bool IsBlocklistUpdateURL(const GURL& url) const override { return false; }
+
+ private:
+  IOSPermissionMessageProvider permission_messages_;
+  ScriptingAllowlist scripting_allowlist_;
+  const GURL webstore_url_;
+  const GURL new_webstore_url_;
+  const GURL update_url_;
+};
+
+}  // namespace
+
+void InitializeIOSExtensionsClient() {
+  static base::NoDestructor<IOSExtensionsClient> client;
+  static const bool initialized = [] {
+    extensions::ExtensionsClient::Set(client.get());
+    return true;
+  }();
+  (void)initialized;
+}
+
+}  // namespace web
diff --git a/ios/web/content/init/extensions/ios_extensions_renderer_client.cc b/ios/web/content/init/extensions/ios_extensions_renderer_client.cc
--- /dev/null
+++ b/ios/web/content/init/extensions/ios_extensions_renderer_client.cc
@@ -0,0 +1,94 @@
+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "ios/web/content/init/extensions/ios_extensions_client.h"
+
+#include <memory>
+#include <string>
+
+#include "base/memory/weak_ptr.h"
+#include "base/no_destructor.h"
+#include "content/public/common/isolated_world_ids.h"
+#include "content/public/renderer/render_frame_observer.h"
+#include "content/public/renderer/render_frame_observer_tracker.h"
+#include "extensions/renderer/api/core_extensions_renderer_api_provider.h"
+#include "extensions/renderer/extensions_renderer_client.h"
+#include "services/service_manager/public/cpp/binder_registry.h"
+
+namespace web {
+namespace {
+
+class IOSExtensionsRendererClient final
+    : public extensions::ExtensionsRendererClient {
+ public:
+  IOSExtensionsRendererClient() {
+    AddAPIProvider(
+        std::make_unique<extensions::CoreExtensionsRendererAPIProvider>());
+  }
+
+  bool IsIncognitoProcess() const override { return false; }
+
+  int GetLowestIsolatedWorldId() const override {
+    // Keep Content's public injection world IDs separate from extension worlds.
+    return content::ISOLATED_WORLD_ID_MAX + 1;
+  }
+};
+
+class IOSExtensionsRenderFrame final
+    : public content::RenderFrameObserver,
+      public content::RenderFrameObserverTracker<IOSExtensionsRenderFrame> {
+ public:
+  explicit IOSExtensionsRenderFrame(content::RenderFrame* frame)
+      : content::RenderFrameObserver(frame),
+        content::RenderFrameObserverTracker<IOSExtensionsRenderFrame>(frame) {
+    GetIOSExtensionsRendererClient()->RenderFrameCreated(frame, &registry_);
+  }
+
+  void OnInterfaceRequestForFrame(
+      const std::string& interface_name,
+      mojo::ScopedMessagePipeHandle* interface_pipe) override {
+    registry_.TryBindInterface(interface_name, interface_pipe);
+  }
+
+  base::WeakPtr<IOSExtensionsRenderFrame> GetWeakPtr() {
+    return weak_factory_.GetWeakPtr();
+  }
+
+  void OnDestruct() override { delete this; }
+
+ private:
+  service_manager::BinderRegistry registry_;
+  base::WeakPtrFactory<IOSExtensionsRenderFrame> weak_factory_{this};
+};
+
+}  // namespace
+
+extensions::ExtensionsRendererClient* GetIOSExtensionsRendererClient() {
+  InitializeIOSExtensionsClient();
+  static base::NoDestructor<IOSExtensionsRendererClient> client;
+  static const bool initialized = [] {
+    extensions::ExtensionsRendererClient::Set(client.get());
+    return true;
+  }();
+  (void)initialized;
+  return client.get();
+}
+
+void InitializeIOSExtensionsRenderFrame(content::RenderFrame* frame) {
+  new IOSExtensionsRenderFrame(frame);
+}
+
+bool RunIOSExtensionScriptsAtDocumentStart(content::RenderFrame* frame) {
+  auto weak_frame = IOSExtensionsRenderFrame::Get(frame)->GetWeakPtr();
+  GetIOSExtensionsRendererClient()->RunScriptsAtDocumentStart(frame);
+  return !!weak_frame;
+}
+
+bool RunIOSExtensionScriptsAtDocumentEnd(content::RenderFrame* frame) {
+  auto weak_frame = IOSExtensionsRenderFrame::Get(frame)->GetWeakPtr();
+  GetIOSExtensionsRendererClient()->RunScriptsAtDocumentEnd(frame);
+  return !!weak_frame;
+}
+
+}  // namespace web
