@@ -46,30 +49,73 @@
 };
 
 std::optional<ResolvedBundledExtension> ResolveBundledExtensionOnFileThread(
-    const base::FilePath& bundled_dir) {
-  if (bundled_dir.empty() || !base::DirectoryExists(bundled_dir)) {
+    const base::FilePath& bundled_dir,
+    const base::FilePath& profile_path) {
+  if (bundled_dir.empty() || profile_path.empty() ||
+      !base::DirectoryExists(bundled_dir)) {
     return std::nullopt;
   }
-  const base::FilePath canonical_path = base::MakeAbsoluteFilePath(bundled_dir);
-  if (canonical_path.empty() ||
-      !base::PathExists(canonical_path.Append(kManifestFilename))) {
+  const base::FilePath source_path = base::MakeAbsoluteFilePath(bundled_dir);
+  if (source_path.empty() ||
+      !base::PathExists(source_path.Append(kManifestFilename))) {
     return std::nullopt;
   }
 
-  ExtensionId extension_id =
-      crx_file::id_util::GenerateIdForPath(canonical_path);
   std::string error;
   std::optional<base::DictValue> manifest =
-      file_util::LoadManifest(canonical_path, &error);
-  if (manifest) {
-    if (const std::string* manifest_key =
-            manifest->FindString(manifest_keys::kPublicKey)) {
-      std::string public_key_bytes;
-      if (Extension::ParsePEMKeyBytes(*manifest_key, &public_key_bytes)) {
-        extension_id = crx_file::id_util::GenerateId(public_key_bytes);
-      }
+      file_util::LoadManifest(source_path, &error);
+  if (!manifest) {
+    return std::nullopt;
+  }
+  const std::string* manifest_key =
+      manifest->FindString(manifest_keys::kPublicKey);
+  CHECK(manifest_key);
+  std::string public_key_bytes;
+  CHECK(Extension::ParsePEMKeyBytes(*manifest_key, &public_key_bytes));
+  const ExtensionId extension_id =
+      crx_file::id_util::GenerateId(public_key_bytes);
+  CHECK_EQ(extension_id, kIOSBundledExtensionId);
+
+  const base::FilePath staging_parent =
+      profile_path.AppendASCII("bundled_extensions");
+  const base::FilePath temp_dir = staging_parent.AppendASCII(".ios_probe.tmp");
+  const base::FilePath staged_dir = staging_parent.AppendASCII("ios_probe");
+
+  if (!base::CreateDirectory(staging_parent) ||
+      !base::DeletePathRecursively(temp_dir) ||
+      !base::CopyDirectoryNoFollow(source_path, temp_dir,
+                                   /*recursive=*/true)) {
+    base::DeletePathRecursively(temp_dir);
+    return std::nullopt;
+  }
+
+  if (!base::SetPosixFilePermissions(temp_dir, 0755)) {
+    base::DeletePathRecursively(temp_dir);
+    return std::nullopt;
+  }
+  base::FileEnumerator enumerator(
+      temp_dir, /*recursive=*/true,
+      base::FileEnumerator::FILES | base::FileEnumerator::DIRECTORIES);
+  for (base::FilePath entry = enumerator.Next(); !entry.empty();
+       entry = enumerator.Next()) {
+    const int mode = enumerator.GetInfo().IsDirectory() ? 0755 : 0644;
+    if (!base::SetPosixFilePermissions(entry, mode)) {
+      base::DeletePathRecursively(temp_dir);
+      return std::nullopt;
     }
   }
+
+  if (!base::DeletePathRecursively(staged_dir) ||
+      !base::Move(temp_dir, staged_dir)) {
+    base::DeletePathRecursively(temp_dir);
+    return std::nullopt;
+  }
+
+  const base::FilePath canonical_path = base::MakeAbsoluteFilePath(staged_dir);
+  if (canonical_path.empty() ||
+      !base::PathExists(canonical_path.Append(kManifestFilename))) {
+    return std::nullopt;
+  }
   return ResolvedBundledExtension{canonical_path, extension_id};
 }
 
