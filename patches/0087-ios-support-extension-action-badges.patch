+ExtensionAction* GetAction(content::BrowserContext* context,
+                           const Extension& extension) {
+  auto* manager = ExtensionActionManager::Get(context);
+  return manager ? manager->GetExtensionAction(extension) : nullptr;
+}
+
+bool ReadBadgeColor(const base::Value& value, SkColor* color) {
+  if (value.is_string()) {
+    return content::ParseCssColorString(value.GetString(), color);
+  }
+  if (!value.is_list() || value.GetList().size() != 4u) {
+    return false;
+  }
+  const auto& components = value.GetList();
+  for (const auto& component : components) {
+    if (!component.is_int() || component.GetInt() < 0 ||
+        component.GetInt() > 255) {
+      return false;
+    }
+  }
+  *color = SkColorSetARGB(components[3].GetInt(), components[0].GetInt(),
+                         components[1].GetInt(), components[2].GetInt());
+  return true;
+}
+
