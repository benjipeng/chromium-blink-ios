+ExtensionFunction::ResponseAction IOSActionSetBadgeTextFunction::Run() {
+  EXTENSION_FUNCTION_VALIDATE(args().size() == 1u && args()[0].is_dict());
+  const auto& details = args()[0].GetDict();
+  const int tab_id =
+      details.FindInt("tabId").value_or(ExtensionAction::kDefaultTabId);
+  if (!extension() || !IsLiveTab(browser_context(), tab_id)) {
+    return RespondNow(Error("The extension or tab is unavailable."));
+  }
+  auto* action = GetAction(browser_context(), *extension());
+  if (!action) {
+    return RespondNow(Error("The extension has no action."));
+  }
+  if (const auto* text = details.FindString("text")) {
+    if (text->size() > 100u) {
+      return RespondNow(Error("Badge text cannot exceed 100 bytes."));
+    }
+    action->SetBadgeText(tab_id, *text);
+  } else {
+    action->ClearBadgeText(tab_id);
+  }
+  return RespondNow(NoArguments());
+}
+
+ExtensionFunction::ResponseAction
+IOSActionSetBadgeBackgroundColorFunction::Run() {
+  EXTENSION_FUNCTION_VALIDATE(args().size() == 1u && args()[0].is_dict());
+  const auto& details = args()[0].GetDict();
+  const auto* value = details.Find("color");
+  SkColor color = SK_ColorTRANSPARENT;
+  if (!value || !ReadBadgeColor(*value, &color)) {
+    return RespondNow(Error("The badge color is invalid."));
+  }
+  const int tab_id =
+      details.FindInt("tabId").value_or(ExtensionAction::kDefaultTabId);
+  if (!extension() || !IsLiveTab(browser_context(), tab_id)) {
+    return RespondNow(Error("The extension or tab is unavailable."));
+  }
+  auto* action = GetAction(browser_context(), *extension());
+  if (!action) {
+    return RespondNow(Error("The extension has no action."));
+  }
+  action->SetBadgeBackgroundColor(tab_id, color);
+  return RespondNow(NoArguments());
+}
+
 }  // namespace extensions
