+#if BUILDFLAG(ENABLE_EXTENSIONS_CORE)
+bool ApplyExtensionWebPreferences(content::WebContents* web_contents,
+                                  content::SiteInstance& main_frame_site,
+                                  blink::web_pref::WebPreferences* prefs) {
+  if (!web_contents || !prefs) {
+    return false;
+  }
+  content::BrowserContext* browser_context = web_contents->GetBrowserContext();
+  auto* client = extensions::ExtensionsBrowserClient::Get();
+  if (!client || !browser_context || !client->IsValidContext(browser_context)) {
+    return false;
+  }
+  extensions::ExtensionRegistry* registry =
+      extensions::ExtensionRegistry::Get(browser_context);
+  if (!registry) {
+    return false;
+  }
+  const content::SecurityPrincipal& principal =
+      main_frame_site.GetSecurityPrincipal();
+  if (!principal.SchemeIs(extensions::kExtensionScheme) ||
+      principal.IsGuest() || principal.IsSandboxed()) {
+    return false;
+  }
+  const extensions::Extension* extension =
+      registry->enabled_extensions().GetByID(
+          extensions::ExtensionId(principal.GetHost()));
+  if (!extension) {
+    return false;
+  }
+  extension_webkit_preferences::SetPreferences(extension, prefs);
+  return true;
+}
+#endif
+
 }  // namespace
 
 bool IOSContentBrowserClient::IsHandledURL(const GURL& url) {
@@ -226,6 +267,9 @@ void IOSContentBrowserClient::OverrideWebPreferences(
   // mode). They were always light.
   prefs->preferred_color_scheme = GetWebColorScheme();
   prefs->preferred_root_scrollbar_color_scheme = prefs->preferred_color_scheme;
+#if BUILDFLAG(ENABLE_EXTENSIONS_CORE)
+  ApplyExtensionWebPreferences(web_contents, main_frame_site, prefs);
+#endif
 }
 
 bool IOSContentBrowserClient::
@@ -308,6 +352,64 @@ void IOSContentBrowserClient::RegisterNonNetworkSubresourceURLLoaderFactories(
 }
 
 #if BUILDFLAG(ENABLE_EXTENSIONS_CORE)
+std::optional<GURL> IOSContentBrowserClient::GetEffectiveURL(
+    content::BrowserContext* browser_context,
+    const GURL& url) {
+  auto* client = extensions::ExtensionsBrowserClient::Get();
+  if (!client || !browser_context || !client->IsValidContext(browser_context)) {
+    return std::nullopt;
+  }
+  extensions::ExtensionRegistry* registry =
+      extensions::ExtensionRegistry::Get(browser_context);
+  if (!registry) {
+    return std::nullopt;
+  }
+  if (url.SchemeIs(extensions::kExtensionScheme) &&
+      !registry->enabled_extensions().GetExtensionOrAppByURL(url)) {
+    return GURL(extensions::kExtensionInvalidRequestURL);
+  }
+  return std::nullopt;
+}
+
+bool IOSContentBrowserClient::DoesSiteRequireDedicatedProcess(
+    content::BrowserContext* browser_context,
+    const GURL& effective_site_url) {
+  auto* client = extensions::ExtensionsBrowserClient::Get();
+  if (!client || !browser_context || !client->IsValidContext(browser_context)) {
+    return false;
+  }
+  extensions::ExtensionRegistry* registry =
+      extensions::ExtensionRegistry::Get(browser_context);
+  if (!registry) {
+    return false;
+  }
+  return registry->enabled_extensions().GetExtensionOrAppByURL(
+             effective_site_url) != nullptr;
+}
+
+bool IOSContentBrowserClient::OverrideWebPreferencesAfterNavigation(
+    content::WebContents* web_contents,
+    content::SiteInstance& main_frame_site,
+    blink::web_pref::WebPreferences* prefs) {
+  return ApplyExtensionWebPreferences(web_contents, main_frame_site, prefs);
+}
+
+void IOSContentBrowserClient::CreateThrottlesForNavigation(
+    content::NavigationThrottleRegistry& registry) {
+  content::NavigationHandle& navigation_handle = registry.GetNavigationHandle();
+  content::WebContents* web_contents = navigation_handle.GetWebContents();
+  if (!web_contents) {
+    return;
+  }
+  content::BrowserContext* browser_context = web_contents->GetBrowserContext();
+  auto* client = extensions::ExtensionsBrowserClient::Get();
+  if (client && browser_context && client->IsValidContext(browser_context) &&
+      extensions::ExtensionRegistry::Get(browser_context)) {
+    registry.AddThrottle(
+        std::make_unique<extensions::ExtensionNavigationThrottle>(registry));
+  }
+}
+
