@@ -145,12 +147,26 @@ void SetBridgeError(NSError* __autoreleasing* error,
       base::SysUTF8ToNSString(extension->VersionString()) ?: @"";
   const BOOL is_enabled =
       registrar->IsExtensionEnabled(extension->id()) ? YES : NO;
-  return @{
-    @"id" : [ext_id copy],
-    @"name" : [ext_name copy],
-    @"version" : [ext_version copy],
-    @"enabled" : @(is_enabled),
-  };
+  NSMutableDictionary<NSString*, id>* entry =
+      [NSMutableDictionary dictionaryWithDictionary:@{
+        @"id" : [ext_id copy],
+        @"name" : [ext_name copy],
+        @"version" : [ext_version copy],
+        @"enabled" : @(is_enabled),
+      }];
+  if (is_enabled) {
+    const GURL& options_url =
+        extensions::OptionsPageInfo::GetOptionsPage(extension);
+    if (options_url.is_valid() &&
+        options_url.SchemeIs(extensions::kExtensionScheme)) {
+      NSString* options_page_url =
+          base::SysUTF8ToNSString(options_url.spec());
+      if (options_page_url.length > 0) {
+        entry[@"optionsPageURL"] = [options_page_url copy];
+      }
+    }
+  }
+  return [entry copy];
 }
 
