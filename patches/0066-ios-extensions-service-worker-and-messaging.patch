From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: chromium-blink-ios <noreply@github.com>
Subject: [PATCH] iOS extensions: wire MV3 service worker hooks and MessagingDelegate

---
diff --git a/ios/chrome/browser/extensions/model/BUILD.gn b/ios/chrome/browser/extensions/model/BUILD.gn
index 3a21971..08a5d21 100644
--- a/ios/chrome/browser/extensions/model/BUILD.gn
+++ b/ios/chrome/browser/extensions/model/BUILD.gn
@@ -35,6 +35,8 @@ source_set("model") {
     "//components/version_info",
     "//content/public/browser",
     "//content/public/common",
+    "//extensions/browser/api:extensions_api_client",
+    "//extensions/browser/api/messaging",
     "//extensions/browser/updater",
     "//extensions/buildflags",
     "//extensions/common",
diff --git a/ios/chrome/browser/extensions/model/ios_extensions_browser_client.mm b/ios/chrome/browser/extensions/model/ios_extensions_browser_client.mm
index a4e0cb6..67230ae 100644
--- a/ios/chrome/browser/extensions/model/ios_extensions_browser_client.mm
+++ b/ios/chrome/browser/extensions/model/ios_extensions_browser_client.mm
@@ -34,6 +34,7 @@
 #include "content/public/browser/web_contents_delegate.h"
 #include "extensions/browser/api/core_extensions_browser_api_provider.h"
 #include "extensions/browser/api/extensions_api_client.h"
+#include "extensions/browser/api/messaging/messaging_delegate.h"
 #include "extensions/browser/api/runtime/runtime_api.h"
 #include "extensions/browser/api/runtime/runtime_api_delegate.h"
 #include "extensions/browser/browser_context_keyed_service_factories.h"
@@ -264,6 +265,21 @@ bool RestartDevice(std::string* error_message) override {
   raw_ptr<content::BrowserContext> browser_context_;
 };
 
+class IOSExtensionsAPIClient final : public extensions::ExtensionsAPIClient {
+ public:
+  IOSExtensionsAPIClient()
+      : messaging_delegate_(
+            std::make_unique<extensions::MessagingDelegate>()) {}
+  ~IOSExtensionsAPIClient() override = default;
+
+  extensions::MessagingDelegate* GetMessagingDelegate() override {
+    return messaging_delegate_.get();
+  }
+
+ private:
+  std::unique_ptr<extensions::MessagingDelegate> messaging_delegate_;
+};
+
 }  // namespace
 
 base::FilePath GetIOSBundledExtensionDirectory() {
@@ -349,7 +365,7 @@ void ShutdownIOSExtensionsForProfile(ProfileIOS* profile) {
 }
 
 IOSExtensionsBrowserClient::IOSExtensionsBrowserClient()
-    : api_client_(std::make_unique<ExtensionsAPIClient>()) {
+    : api_client_(std::make_unique<IOSExtensionsAPIClient>()) {
   AddAPIProvider(std::make_unique<CoreExtensionsBrowserAPIProvider>());
   SetCurrentChannel(::GetChannel());
 
@@ -396,11 +412,13 @@ void ShutdownIOSExtensionsForProfile(ProfileIOS* profile) {
       !extension.is_extension()) {
     return false;
   }
-  // MV3 service workers and background hosts require context-aware ProcessMap
-  // adaptation under single-process Blink; restrict the initial bundled
-  // fixture strictly to content scripts.
-  if (BackgroundInfo::HasBackgroundPage(&extension) ||
-      BackgroundInfo::IsServiceWorkerBased(&extension)) {
+  // Legacy MV2 background pages remain unsupported on iOS. MV3 service
+  // workers are allowed only for the verified bundled fixture path and ID.
+  if (BackgroundInfo::HasBackgroundPage(&extension)) {
+    return false;
+  }
+  if (BackgroundInfo::IsServiceWorkerBased(&extension) &&
+      extension.id() != kIOSBundledExtensionId) {
     return false;
   }
   base::AutoLock lock(bundled_allowlist_lock_);
diff --git a/ios/web/content/init/ios_content_browser_client.cc b/ios/web/content/init/ios_content_browser_client.cc
index 53d81e7..4802f82 100644
--- a/ios/web/content/init/ios_content_browser_client.cc
+++ b/ios/web/content/init/ios_content_browser_client.cc
@@ -23,6 +23,7 @@
 #include "extensions/browser/extensions_browser_client.h"
 #include "extensions/browser/process_map.h"
 #include "extensions/browser/renderer_startup_helper.h"
+#include "extensions/browser/url_loader_factory_manager.h"
 #include "extensions/browser/service_worker/service_worker_host.h"
 #include "extensions/common/constants.h"
 #include "extensions/common/mojom/event_router.mojom.h"
@@ -456,6 +457,54 @@ void IOSContentBrowserClient::WillCreateURLLoaderFactory(
     }
   }
 }
+
+void IOSContentBrowserClient::
+    RegisterNonNetworkWorkerMainResourceURLLoaderFactories(
+        content::BrowserContext* browser_context,
+        const std::optional<url::Origin>& request_initiator,
+        network::mojom::RequestDestination request_destination,
+        NonNetworkURLLoaderFactoryMap* factories) {
+  auto* client = extensions::ExtensionsBrowserClient::Get();
+  if (!client || !browser_context || !factories ||
+      !client->IsValidContext(browser_context)) {
+    return;
+  }
+  factories->emplace(
+      extensions::kExtensionScheme,
+      extensions::CreateExtensionWorkerMainResourceURLLoaderFactory(
+          browser_context, request_initiator));
+}
+
+void IOSContentBrowserClient::
+    RegisterNonNetworkServiceWorkerUpdateURLLoaderFactories(
+        content::BrowserContext* browser_context,
+        NonNetworkURLLoaderFactoryMap* factories) {
+  auto* client = extensions::ExtensionsBrowserClient::Get();
+  if (!client || !browser_context || !factories ||
+      !client->IsValidContext(browser_context)) {
+    return;
+  }
+  factories->emplace(
+      extensions::kExtensionScheme,
+      extensions::CreateExtensionServiceWorkerScriptURLLoaderFactory(
+          browser_context));
+}
+
+void IOSContentBrowserClient::OverrideURLLoaderFactoryParams(
+    content::BrowserContext* browser_context,
+    const url::Origin& origin,
+    bool is_for_isolated_world,
+    bool is_for_service_worker,
+    network::mojom::URLLoaderFactoryParams* factory_params) {
+  auto* client = extensions::ExtensionsBrowserClient::Get();
+  if (!client || !browser_context || !factory_params ||
+      !client->IsValidContext(browser_context)) {
+    return;
+  }
+  extensions::URLLoaderFactoryManager::OverrideURLLoaderFactoryParams(
+      browser_context, origin, is_for_isolated_world, is_for_service_worker,
+      factory_params);
+}
 #endif
 
 }  // namespace web
diff --git a/ios/web/content/init/ios_content_browser_client.h b/ios/web/content/init/ios_content_browser_client.h
index d55931f..f04d1fb 100644
--- a/ios/web/content/init/ios_content_browser_client.h
+++ b/ios/web/content/init/ios_content_browser_client.h
@@ -89,6 +89,20 @@ class IOSContentBrowserClient : public content::ContentBrowserClient {
       network::mojom::URLLoaderFactoryOverridePtr* factory_override,
       scoped_refptr<base::SequencedTaskRunner> navigation_response_task_runner,
       bool is_for_network_service) override;
+  void RegisterNonNetworkWorkerMainResourceURLLoaderFactories(
+      content::BrowserContext* browser_context,
+      const std::optional<url::Origin>& request_initiator,
+      network::mojom::RequestDestination request_destination,
+      NonNetworkURLLoaderFactoryMap* factories) override;
+  void RegisterNonNetworkServiceWorkerUpdateURLLoaderFactories(
+      content::BrowserContext* browser_context,
+      NonNetworkURLLoaderFactoryMap* factories) override;
+  void OverrideURLLoaderFactoryParams(
+      content::BrowserContext* browser_context,
+      const url::Origin& origin,
+      bool is_for_isolated_world,
+      bool is_for_service_worker,
+      network::mojom::URLLoaderFactoryParams* factory_params) override;
 #endif
 };
 
diff --git a/ios/web/content/init/ios_content_renderer_client.cc b/ios/web/content/init/ios_content_renderer_client.cc
index 4ef73b8..806ff32 100644
--- a/ios/web/content/init/ios_content_renderer_client.cc
+++ b/ios/web/content/init/ios_content_renderer_client.cc
@@ -6,6 +6,7 @@
 
 #import "extensions/buildflags/buildflags.h"
 #if BUILDFLAG(ENABLE_EXTENSIONS_CORE)
+#import "extensions/renderer/dispatcher.h"
 #import "extensions/renderer/extensions_renderer_client.h"
 #import "ios/web/content/init/extensions/ios_extensions_client.h"
 #endif
@@ -119,6 +120,58 @@ void IOSContentRendererClient::RunScriptsAtDocumentIdle(
 #endif
 }
 
+#if BUILDFLAG(ENABLE_EXTENSIONS_CORE)
+void IOSContentRendererClient::
+    DidInitializeServiceWorkerContextOnWorkerThread(
+        blink::WebServiceWorkerContextProxy* context_proxy,
+        const GURL& service_worker_scope,
+        const GURL& script_url) {
+  if (auto* dispatcher = GetIOSExtensionsRendererClient()->dispatcher()) {
+    dispatcher->DidInitializeServiceWorkerContextOnWorkerThread(
+        context_proxy, service_worker_scope, script_url);
+  }
+}
+
+void IOSContentRendererClient::WillEvaluateServiceWorkerOnWorkerThread(
+    blink::WebServiceWorkerContextProxy* context_proxy,
+    v8::Local<v8::Context> v8_context,
+    int64_t service_worker_version_id,
+    const GURL& service_worker_scope,
+    const GURL& script_url,
+    const blink::ServiceWorkerToken& service_worker_token) {
+  if (auto* dispatcher = GetIOSExtensionsRendererClient()->dispatcher()) {
+    dispatcher->WillEvaluateServiceWorkerOnWorkerThread(
+        context_proxy, v8_context, service_worker_version_id,
+        service_worker_scope, script_url, service_worker_token);
+  }
+}
+
+void IOSContentRendererClient::DidStartServiceWorkerContextOnWorkerThread(
+    int64_t service_worker_version_id,
+    const GURL& service_worker_scope,
+    const GURL& script_url,
+    const blink::ServiceWorkerToken& service_worker_token) {
+  if (auto* dispatcher = GetIOSExtensionsRendererClient()->dispatcher()) {
+    dispatcher->DidStartServiceWorkerContextOnWorkerThread(
+        service_worker_version_id, service_worker_scope, script_url,
+        service_worker_token);
+  }
+}
+
+void IOSContentRendererClient::WillDestroyServiceWorkerContextOnWorkerThread(
+    v8::Local<v8::Context> context,
+    int64_t service_worker_version_id,
+    const GURL& service_worker_scope,
+    const GURL& script_url,
+    const blink::ServiceWorkerToken& service_worker_token) {
+  if (auto* dispatcher = GetIOSExtensionsRendererClient()->dispatcher()) {
+    dispatcher->WillDestroyServiceWorkerContextOnWorkerThread(
+        context, service_worker_version_id, service_worker_scope, script_url,
+        service_worker_token);
+  }
+}
+#endif
+
 void IOSContentRendererClient::PrepareErrorPage(
     content::RenderFrame* render_frame,
     const blink::WebURLError& error,
diff --git a/ios/web/content/init/ios_content_renderer_client.h b/ios/web/content/init/ios_content_renderer_client.h
index 2421550..991de8a 100644
