+bool IOSExtensionSystem::IsSignedImport(const base::FilePath& path) const {
+  return signed_imports_.contains(path);
+}
+
+void IOSExtensionSystem::TrackSignedImport(const Extension& extension) {
+  signed_imports_.insert_or_assign(extension.path(), extension.id());
+}
+
+void IOSExtensionSystem::ForgetSignedImport(const Extension& extension) {
+  signed_imports_.erase(extension.path());
+}
+
+void IOSExtensionSystem::RestoreSignedImports() {
+  const auto profile = browser_context_->GetPath();
+  auto* prefs = ExtensionPrefs::Get(browser_context_);
+  if (profile.empty() || !prefs) {
+    return;
+  }
+  std::vector<SignedImportRecord> records;
+  for (const auto& record : prefs->GetInstalledExtensionsInfo()) {
+    const auto path = record.extension_path.StripTrailingSeparators();
+    const auto leaf = path.BaseName();
+    const auto parent = path.DirName();
+    // Rebase verified imports when the app container changes. No absolute
+    // recorded path is opened directly.
+    if (record.extension_location != mojom::ManifestLocation::kUnpacked ||
+        record.extension_id == kIOSBundledExtensionId ||
+        parent.BaseName().value() != "SignedImports" ||
+        parent.DirName().BaseName().value() != "TrustedUnpackedExtensions" ||
+        parent.DirName().DirName().BaseName() != profile.BaseName() ||
+        !base::Uuid::ParseLowercase(leaf.value()).is_valid()) {
+      continue;
+    }
+    const int flags = Extension::REQUIRE_KEY |
+                      Extension::REQUIRE_MODERN_MANIFEST_VERSION |
+                      (prefs->GetCreationFlags(record.extension_id) &
+                       Extension::WITHHOLD_PERMISSIONS);
+    records.push_back({record.extension_id, leaf, flags});
+  }
+  if (records.empty()) {
+    return;
+  }
+  restoring_signed_imports_ = true;
+  GetExtensionFileTaskRunner()->PostTaskAndReplyWithResult(
+      FROM_HERE,
+      base::BindOnce(&LoadSignedImportsOnFileThread, profile, std::move(records)),
+      base::BindOnce(&IOSExtensionSystem::FinishRestoringSignedImports,
+                     weak_factory_.GetWeakPtr()));
+}
+
+void IOSExtensionSystem::FinishRestoringSignedImports(
+    std::vector<scoped_refptr<const Extension>> restored) {
+  auto* registry = ExtensionRegistry::Get(browser_context_);
+  auto* registrar = ExtensionRegistrar::Get(browser_context_);
+  auto* client = IOSExtensionsBrowserClient::GetInstance();
+  for (const auto& extension : restored) {
+    if (registry->GetInstalledExtension(extension->id())) {
+      continue;
+    }
+    auto previous = client->RegisterTrustedExtensionCandidate(extension->path(),
+                                                              extension->id());
+    if (!management_policy_->UserMayLoad(extension.get(), nullptr)) {
+      client->RestoreTrustedExtensionCandidate(extension->path(),
+                                               extension->id(), previous);
+      continue;
+    }
+    extension->permissions_data()->BindToCurrentThread();
+    PermissionsUpdater(browser_context_).InitializePermissions(extension.get());
+    registrar->AddExtension(extension);
+    if (registry->GetInstalledExtension(extension->id()) == extension.get()) {
+      TrackSignedImport(*extension);
+    } else {
+      client->RestoreTrustedExtensionCandidate(extension->path(),
+                                               extension->id(), previous);
+    }
+  }
+  restoring_signed_imports_ = false;
+}
