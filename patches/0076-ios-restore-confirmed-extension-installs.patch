+struct SignedImportRecord {
+  ExtensionId id;
+  base::FilePath leaf;
+  int flags;
+};
+
+std::vector<scoped_refptr<const Extension>> LoadSignedImportsOnFileThread(
+    const base::FilePath& profile,
+    std::vector<SignedImportRecord> records) {
+  std::vector<scoped_refptr<const Extension>> restored;
+  const auto trusted = profile.AppendASCII("TrustedUnpackedExtensions");
+  const auto root = trusted.AppendASCII("SignedImports");
+  if (base::IsLink(trusted) || base::IsLink(root)) {
+    return restored;
+  }
+  const auto canonical = base::MakeAbsoluteFilePath(root);
+  if (canonical.empty()) {
+    return restored;
+  }
+  for (const auto& record : records) {
+    const auto path = canonical.Append(record.leaf);
+    if (base::IsLink(path) || base::IsLink(path.Append(kManifestFilename)) ||
+        !base::DirectoryExists(path)) {
+      continue;
+    }
+    std::u16string error;
+    auto extension = file_util::LoadExtension(
+        path, mojom::ManifestLocation::kUnpacked, record.flags, &error);
+    // Preserve the prefs and files for any record that could not be read.
+    if (extension && extension->is_extension() && extension->id() == record.id) {
+      restored.push_back(std::move(extension));
+    }
+  }
+  return restored;
+}

