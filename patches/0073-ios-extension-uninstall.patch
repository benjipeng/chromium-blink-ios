+bool DeleteInstalledSignedImport(const base::FilePath& profile_path,
+                                 const base::FilePath& directory) {
+  const auto trusted = profile_path.AppendASCII("TrustedUnpackedExtensions");
+  const auto root = trusted.AppendASCII("SignedImports");
+  if (base::IsLink(trusted) || base::IsLink(root) || base::IsLink(directory)) {
+    return false;
+  }
+  const auto canonical = base::MakeAbsoluteFilePath(root);
+  return !canonical.empty() && directory.DirName() == canonical &&
+         base::DeletePathRecursively(directory);
