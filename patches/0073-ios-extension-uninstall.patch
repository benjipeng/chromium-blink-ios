+- (void)uninstallExtensionWithID:(NSString*)extensionID
+                      completion:(void (^)(BOOL, NSError*))completion {
+  if (!completion) {
+    return;
+  }
+  content::BrowserContext* context = nullptr;
+  extensions::ExtensionSystem* system = nullptr;
+  extensions::ExtensionRegistry* registry = nullptr;
+  extensions::ExtensionRegistrar* registrar = nullptr;
+  NSError* error = nil;
+  if (!ResolveExtensionServices(&context, &system, &registry, &registrar,
+                                &error)) {
+    completion(NO, error);
+    return;
+  }
+  const std::string id = [extensionID isKindOfClass:NSString.class]
+                             ? base::SysNSStringToUTF8(extensionID)
+                             : std::string();
+  scoped_refptr<const extensions::Extension> extension =
+      registry->GetInstalledExtension(id);
+  auto& state = SignedImportOnUIThread();
+  if (!extension || id == extensions::kIOSBundledExtensionId ||
+      !state.installed_paths.contains(extension->path())) {
+    completion(NO, SignedImportError(@"This extension cannot be removed."));
+    return;
+  }
+  if (state.busy) {
+    completion(NO, SignedImportError(@"An extension change is already in progress."));
+    return;
+  }
+  state.busy = true;
+  std::u16string policy_error;
+  if (!registrar->UninstallExtension(
+          id, extensions::UNINSTALL_REASON_USER_INITIATED, &policy_error,
+          base::DoNothing())) {
+    state.busy = false;
+    completion(NO, MakeBridgeError(
+                       kCrIOSExtensionManagerErrorPolicyDenied,
+                       policy_error.empty()
+                           ? @"Extension removal is not allowed."
+                           : base::SysUTF16ToNSString(policy_error)));
+    return;
+  }
+  state.installed_paths.erase(extension->path());
+  extensions::IOSExtensionsBrowserClient::GetInstance()
+      ->RestoreTrustedExtensionCandidate(extension->path(), id, std::nullopt);
+  extensions::ServiceWorkerTaskQueue::Get(context)
+      ->RemoveRegisteredServiceWorkerInfo(id);
+
+  // Verified imports are ordinary MV3 extensions in the default partition.
+  // Clear their exact origin before allowing the same ID to be installed again.
+  using content::StoragePartition;
+  constexpr uint32_t kExtensionOriginData =
+      StoragePartition::REMOVE_DATA_MASK_SERVICE_WORKERS |
+      StoragePartition::REMOVE_DATA_MASK_CACHE_STORAGE |
+      StoragePartition::REMOVE_DATA_MASK_LOCAL_STORAGE |
+      StoragePartition::REMOVE_DATA_MASK_INDEXEDDB |
+      StoragePartition::REMOVE_DATA_MASK_FILE_SYSTEMS;
+  context->GetDefaultStoragePartition()->ClearDataForOrigin(
+      kExtensionOriginData, extension->url(),
+      base::BindOnce(
+          [](base::FilePath profile, base::FilePath installed,
+             void (^reply)(BOOL, NSError*)) {
+            extensions::GetExtensionFileTaskRunner()->PostTaskAndReplyWithResult(
+                FROM_HERE,
+                base::BindOnce(&DeleteInstalledSignedImport, std::move(profile),
+                               std::move(installed)),
+                base::BindOnce([](void (^reply)(BOOL, NSError*), bool deleted) {
+                  SignedImportOnUIThread().busy = false;
+                  reply(YES, deleted ? nil : SignedImportError(
+                      @"The extension was removed, but its files could not be deleted."));
+                }, std::move(reply)));
+          },
+          context->GetPath(), extension->path(), [completion copy]));
+}
