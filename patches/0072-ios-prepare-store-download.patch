+- (void)prepareStoreExtensionWithID:(NSString*)storeID
+                          completion:(void (^)(NSDictionary<NSString*, id>*,
+                                               NSError*))completion {
+  if (!completion) return;
+
+  InstallCompletionCallback finish = base::BindOnce(completion);
+  base::FilePath profile;
+  extensions::ExtensionRegistry* registry = nullptr;
+  NSError* error = nil;
+  if (!ResolveSignedImportProfile(&profile, &registry, &error)) {
+    PostInstallCompletionOnMainThread(std::move(finish), nil, error);
+    return;
+  }
+  const std::string id = [storeID isKindOfClass:[NSString class]]
+      ? base::SysNSStringToUTF8(storeID) : std::string();
+  if (!crx_file::id_util::IdIsValid(id) || registry->GetInstalledExtension(id)) {
+    PostInstallCompletionOnMainThread(
+        std::move(finish), nil,
+        SignedImportError(@"Choose a valid Store listing that is not installed."));
+    return;
+  }
+  auto& state = SignedImportOnUIThread();
+  if (state.busy || state.prepared) {
+    PostInstallCompletionOnMainThread(
+        std::move(finish), nil,
+        SignedImportError(@"Finish or cancel the current extension review first."));
+    return;
+  }
+  state.busy = true;
+  state.download = std::make_unique<extensions::IOSStoreCrxDownload>();
+  state.download->Start(id, base::BindOnce(
+      [](base::FilePath original_profile, std::string expected_id,
+         InstallCompletionCallback finish, base::FilePath downloaded,
+         const char* download_error) {
+        auto& state = SignedImportOnUIThread();
+        state.download.reset();
+        base::FilePath profile;
+        extensions::ExtensionRegistry* registry = nullptr;
+        NSError* error = nil;
+        if (download_error ||
+            !ResolveSignedImportProfile(&profile, &registry, &error) ||
+            profile != original_profile) {
+          state.busy = false;
+          DeleteImportDirectory(std::move(downloaded));
+          PostInstallCompletionOnMainThread(
+              std::move(finish), nil,
+              error ?: SignedImportError(download_error
+                  ? base::SysUTF8ToNSString(download_error)
+                  : @"The active profile changed."));
+          return;
+        }
+        QueueSignedImport(std::move(profile), std::move(downloaded),
+                          std::move(expected_id), std::move(finish));
+      }, profile, id, std::move(finish)));
+}
