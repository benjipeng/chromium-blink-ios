+// A non-empty expected ID denotes an owned Store download. Clean up the
+// temporary file after staging and bind the package to the selected listing.
+void QueueSignedImport(base::FilePath profile,
+                       base::FilePath source,
+                       std::string expected_id,
+                       InstallCompletionCallback finish) {
+  SignedImportOnUIThread().busy = true;
+  extensions::GetExtensionFileTaskRunner()->PostTaskAndReplyWithResult(
+      FROM_HERE,
+      base::BindOnce(
+          [](base::FilePath profile, base::FilePath source, std::string expected_id) {
+            PreparedSignedImport result = PrepareSignedImportOnFileThread(
+                std::move(profile), source);
+            if (!expected_id.empty()) {
+              base::DeleteFile(source);
+              if (result.error.empty() && result.id != expected_id) {
+                base::DeletePathRecursively(result.staging_path);
+                result.error = "The signed CRX did not match the Store listing.";
+              }
+            }
+            return result;
+          },
+          std::move(profile), std::move(source), std::move(expected_id)),
+      base::BindOnce(
+          [](InstallCompletionCallback reply, PreparedSignedImport result) {
+            auto& state = SignedImportOnUIThread();
+            state.busy = false;
+            if (!result.error.empty()) {
+              std::move(reply).Run(
+                  nil, SignedImportError(base::SysUTF8ToNSString(result.error)));
+              return;
+            }
+            base::FilePath active_profile;
+            extensions::ExtensionRegistry* registry = nullptr;
+            NSError* error = nil;
+            if (!ResolveSignedImportProfile(&active_profile, &registry, &error) ||
+                active_profile != result.profile_path ||
+                registry->GetInstalledExtension(result.id)) {
+              DeleteImportDirectory(std::move(result.staging_path));
+              std::move(reply).Run(
+                  nil, error ?: SignedImportError(
+                      @"The active profile changed or this extension is already installed."));
+              return;
+            }
+            NSDictionary* receipt = @{
+              @"token" : base::SysUTF8ToNSString(result.token),
+              @"id" : base::SysUTF8ToNSString(result.id),
+              @"name" : base::SysUTF8ToNSString(result.name),
+              @"version" : base::SysUTF8ToNSString(result.version),
+              @"permissions" : BridgeStrings(result.permissions),
+              @"hostPermissions" : BridgeStrings(result.host_permissions),
+            };
+            content::GetUIThreadTaskRunner({})->PostDelayedTask(
+                FROM_HERE,
+                base::BindOnce(
+                    [](const std::string& token) {
+                      auto& prepared = SignedImportOnUIThread().prepared;
+                      if (prepared && prepared->token == token) {
+                        DeleteImportDirectory(std::move(prepared->staging_path));
+                        prepared.reset();
+                      }
+                    },
+                    result.token),
+                base::Minutes(5));
+            state.prepared.emplace(std::move(result));
+            std::move(reply).Run(receipt, nil);
+          },
+          std::move(finish)));
+}
