+#ifndef IOS_CHROME_BROWSER_EXTENSIONS_MODEL_IOS_STORE_CRX_DOWNLOAD_H_
+#define IOS_CHROME_BROWSER_EXTENSIONS_MODEL_IOS_STORE_CRX_DOWNLOAD_H_
+
+#include <memory>
+#include <string_view>
+
+#include "base/files/file_path.h"
+#include "base/functional/callback.h"
+#include "base/memory/weak_ptr.h"
+
+namespace net {
+struct RedirectInfo;
+}
+namespace network {
+class SimpleURLLoader;
+}
+
+namespace extensions {
+
+// One user-initiated, UI-sequence request. Destroy the owner to cancel it.
+// A successful callback takes ownership of the temporary CRX. It must verify
+// the package and bind its ID to the request before presenting permissions.
+class IOSStoreCrxDownload {
+ public:
+  using Completion = base::OnceCallback<void(base::FilePath, const char*)>;
+
+  IOSStoreCrxDownload();
+  ~IOSStoreCrxDownload();
+  void Start(std::string_view id, Completion callback);
+
+ private:
+  void Redirected(const net::RedirectInfo& redirect);
+  void Completed(base::FilePath path);
+  void Finish(base::FilePath path, const char* error);
+
+  Completion completion_;
+  std::unique_ptr<network::SimpleURLLoader> loader_;
+  int redirects_ = 0;
+  base::WeakPtrFactory<IOSStoreCrxDownload> weak_factory_{this};
+};
+
+}  // namespace extensions
+
+#endif  // IOS_CHROME_BROWSER_EXTENSIONS_MODEL_IOS_STORE_CRX_DOWNLOAD_H_
diff --git a/ios/chrome/browser/extensions/model/ios_store_crx_download.mm b/ios/chrome/browser/extensions/model/ios_store_crx_download.mm
new file mode 100644
index 0000000..963f96f
--- /dev/null
+++ b/ios/chrome/browser/extensions/model/ios_store_crx_download.mm
@@ -0,0 +1,137 @@
+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "ios/chrome/browser/extensions/model/ios_store_crx_download.h"
+
+#include <string>
+#include <utility>
+#include <vector>
+
+#include "base/check.h"
+#include "base/functional/bind.h"
+#include "base/time/time.h"
+#include "components/crx_file/id_util.h"
+#include "components/version_info/version_info.h"
+#include "ios/chrome/browser/shared/model/application_context/application_context.h"
+#include "net/base/net_errors.h"
+#include "net/base/url_util.h"
+#include "net/http/http_response_headers.h"
+#include "net/http/http_status_code.h"
+#include "net/traffic_annotation/network_traffic_annotation.h"
+#include "net/url_request/redirect_info.h"
+#include "services/network/public/cpp/resource_request.h"
+#include "services/network/public/cpp/shared_url_loader_factory.h"
+#include "services/network/public/cpp/simple_url_loader.h"
+#include "services/network/public/mojom/fetch_api.mojom.h"
+#include "services/network/public/mojom/url_response_head.mojom.h"
+#include "url/gurl.h"
+
+namespace extensions {
+namespace {
+
+bool IsStoreDownloadURL(const GURL& url) {
+  return url.SchemeIs("https") && !url.has_username() && !url.has_password() &&
+         url.EffectiveIntPort() == 443 &&
+         (url.host() == "clients2.google.com" ||
+          url.host() == "clients2.googleusercontent.com" ||
+          url.host() == "dl.google.com");
+}
+
+const char* DownloadError(int http_status, int net_error) {
+  if (http_status == net::HTTP_NO_CONTENT ||
+      http_status == net::HTTP_NOT_FOUND || http_status == net::HTTP_GONE) {
+    return "The Store did not provide a package for this version of Chromium.";
+  }
+  if (net_error == net::ERR_TIMED_OUT)
+    return "The Store download timed out.";
+  if (net_error == net::ERR_INTERNET_DISCONNECTED)
+    return "Chromium is offline.";
+  if (net_error == net::ERR_INSUFFICIENT_RESOURCES)
+    return "The CRX exceeds 64 MiB.";
+  return "The Store package could not be downloaded.";
+}
+
+}  // namespace
+
+IOSStoreCrxDownload::IOSStoreCrxDownload() = default;
+IOSStoreCrxDownload::~IOSStoreCrxDownload() = default;
+
+void IOSStoreCrxDownload::Start(std::string_view id, Completion callback) {
+  CHECK(!completion_);
+  completion_ = std::move(callback);
+  if (!crx_file::id_util::IdIsValid(id)) {
+    Finish({}, "Choose a valid Chrome Web Store listing.");
+    return;
+  }
+  auto factory = GetApplicationContext()->GetSharedURLLoaderFactory();
+  if (!factory) {
+    Finish({}, "Chromium could not start the Store request.");
+    return;
+  }
+  auto request = std::make_unique<network::ResourceRequest>();
+  GURL url("https://clients2.google.com/service/update2/crx");
+  url = net::AppendQueryParameter(url, "response", "redirect");
+  url = net::AppendQueryParameter(url, "prodversion",
+                                  version_info::GetVersionNumber());
+  url = net::AppendQueryParameter(url, "acceptformat", "crx3");
+  request->url = net::AppendQueryParameter(
+      url, "x", "id=" + std::string(id) + "&installsource=ondemand&uc");
+  request->credentials_mode = network::mojom::CredentialsMode::kOmit;
+  loader_ = network::SimpleURLLoader::Create(
+      std::move(request),
+      net::DefineNetworkTrafficAnnotation("ios_user_store_crx", R"(
+        semantics {
+          sender: "iOS extension installer"
+          description: "Downloads the signed package for a user-selected Chrome Web Store extension."
+          trigger: "The user asks to review an extension for installation."
+          data: "The public extension ID and Chromium version. No user data."
+          destination: GOOGLE_OWNED_SERVICE
+        }
+        policy {
+          cookies_allowed: NO
+          setting: "Only sent when the user requests installation."
+          policy_exception_justification: "No policy controls this user-initiated request."
+        })"));
+  loader_->SetTimeoutDuration(base::Seconds(30));
+  loader_->SetOnRedirectCallback(base::BindRepeating(
+      [](base::WeakPtr<IOSStoreCrxDownload> self, const GURL&,
+         const net::RedirectInfo& redirect,
+         const network::mojom::URLResponseHead&, std::vector<std::string>*) {
+        if (self)
+          self->Redirected(redirect);
+      },
+      weak_factory_.GetWeakPtr()));
+  loader_->DownloadToTempFile(factory.get(),
+                              base::BindOnce(&IOSStoreCrxDownload::Completed,
+                                             weak_factory_.GetWeakPtr()),
+                              64 * 1024 * 1024);
+}
+
+void IOSStoreCrxDownload::Redirected(const net::RedirectInfo& redirect) {
+  if (++redirects_ > 3 || redirect.new_method != "GET" ||
+      !IsStoreDownloadURL(redirect.new_url)) {
+    Finish({}, "The Store returned an unexpected download redirect.");
+  }
+}
+
+void IOSStoreCrxDownload::Completed(base::FilePath path) {
+  const auto* response = loader_->ResponseInfo();
+  const int status =
+      response && response->headers ? response->headers->response_code() : 0;
+  // The verifier still owns the trust decision. Hand off any returned path so
+  // the caller can remove it even on a rejected response.
+  const char* error = path.empty() || status != net::HTTP_OK ||
+                              !IsStoreDownloadURL(loader_->GetFinalURL())
+                          ? DownloadError(status, loader_->NetError())
+                          : nullptr;
+  Finish(std::move(path), error);
+}
+
+void IOSStoreCrxDownload::Finish(base::FilePath path, const char* error) {
+  loader_.reset();
+  auto callback = std::move(completion_);
+  std::move(callback).Run(std::move(path), error);
+}
+
+}  // namespace extensions
