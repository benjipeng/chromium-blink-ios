@@ -93,6 +95,9 @@ - (void)installExtensionFromTrustedDirectory:(NSString*)directoryPath
                                       (void (^)(NSDictionary<NSString*, id>*
                                                     extension,
                                                 NSError* error))completion;
+- (BOOL)dispatchCommandNamed:(NSString*)commandName
+           toExtensionWithID:(NSString*)extensionId
+                       error:(NSError* __autoreleasing*)error;
 @end
 
 @interface CrIOSExtensionManagerV1 : NSObject <CrIOSExtensionManagingV1>
@@ -490,6 +495,7 @@ void ShutdownIOSExtensionsForProfile(ProfileIOS* profile) {
 IOSExtensionsBrowserClient::IOSExtensionsBrowserClient()
     : api_client_(std::make_unique<IOSExtensionsAPIClient>()) {
   AddAPIProvider(std::make_unique<CoreExtensionsBrowserAPIProvider>());
+  AddAPIProvider(std::make_unique<IOSExtensionsBrowserAPIProvider>());
   SetCurrentChannel(::GetChannel());
 
   {
@@ -1410,4 +1416,64 @@ - (void)installExtensionFromTrustedDirectory:(NSString*)directoryPath
           context, std::move(finish)));
 }
 
+- (BOOL)dispatchCommandNamed:(NSString*)commandName
+           toExtensionWithID:(NSString*)extensionId
+                       error:(NSError* __autoreleasing*)error {
+  if (![commandName isKindOfClass:[NSString class]] ||
+      commandName.length == 0) {
+    SetBridgeError(error, kCrIOSExtensionManagerErrorInvalidArgument,
+                   @"Command name must be a non-empty string.");
+    return NO;
+  }
+  if (![extensionId isKindOfClass:[NSString class]] ||
+      extensionId.length == 0) {
+    SetBridgeError(error, kCrIOSExtensionManagerErrorInvalidArgument,
+                   @"Extension ID must be a non-empty string.");
+    return NO;
+  }
+
+  content::BrowserContext* context = nullptr;
+  extensions::ExtensionSystem* system = nullptr;
+  extensions::ExtensionRegistry* registry = nullptr;
+  extensions::ExtensionRegistrar* registrar = nullptr;
+  if (!ResolveExtensionServices(&context, &system, &registry, &registrar,
+                                error)) {
+    return NO;
+  }
+
+  const std::string ext_id = base::SysNSStringToUTF8(extensionId);
+  const std::string cmd_name = base::SysNSStringToUTF8(commandName);
+  const extensions::Extension* installed =
+      registry->GetInstalledExtension(ext_id);
+  if (!installed) {
+    SetBridgeError(error, kCrIOSExtensionManagerErrorNotFound,
+                   @"Extension is not installed in the active context.");
+    return NO;
+  }
+  if (!registrar->IsExtensionEnabled(ext_id) ||
+      !registry->enabled_extensions().GetByID(ext_id)) {
+    SetBridgeError(error, kCrIOSExtensionManagerErrorStateChangeFailed,
+                   @"Extension must be enabled to dispatch a command.");
+    return NO;
+  }
+  if (!extensions::EventRouter::Get(context)) {
+    SetBridgeError(error, kCrIOSExtensionManagerErrorSystemNotReady,
+                   @"EventRouter is not available.");
+    return NO;
+  }
+
+  std::string dispatch_error;
+  if (!extensions::DispatchExtensionCommandEvent(
+          context, ext_id, cmd_name, std::nullopt, &dispatch_error)) {
+    NSString* detail =
+        dispatch_error.empty()
+            ? @"Command could not be dispatched."
+            : base::SysUTF8ToNSString(dispatch_error);
+    SetBridgeError(error, kCrIOSExtensionManagerErrorInvalidArgument, detail);
+    return NO;
+  }
+
+  return YES;
+}
+
 @end
