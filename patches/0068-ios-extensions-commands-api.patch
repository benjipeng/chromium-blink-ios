+// Tracks extension command keybinding preferences on iOS and dispatches
+// commands.onCommand events through EventRouter.
+class IOSCommandService : public BrowserContextKeyedAPI,
+                          public ExtensionRegistryObserver {
+ public:
+  enum QueryType {
+    ALL,
+    ACTIVE,
+    ACTIVE_OR_USER_MODIFIED,
+  };
+
+  enum CommandScope {
+    REGULAR,
+    GLOBAL,
+    ANY_SCOPE,
+  };
+
+  class Observer {
+   public:
+    virtual void OnExtensionCommandAdded(const ExtensionId& extension_id,
+                                         const std::string& command_name) {}
+    virtual void OnExtensionCommandRemoved(const ExtensionId& extension_id,
+                                           const std::string& command_name) {}
+    virtual void OnCommandServiceDestroying() {}
+
+   protected:
+    virtual ~Observer() = default;
+  };
+
+  static void RegisterProfilePrefs(user_prefs::PrefRegistrySyncable* registry);
+
+  explicit IOSCommandService(content::BrowserContext* context);
+  IOSCommandService(const IOSCommandService&) = delete;
+  IOSCommandService& operator=(const IOSCommandService&) = delete;
+  ~IOSCommandService() override;
+
+  static BrowserContextKeyedAPIFactory<IOSCommandService>* GetFactoryInstance();
+  static IOSCommandService* Get(content::BrowserContext* context);
+
+  bool GetExtensionActionCommand(const ExtensionId& extension_id,
+                                 ActionInfo::Type action_type,
+                                 QueryType type,
+                                 Command* command,
+                                 bool* active) const;
+
+  bool GetNamedCommands(const ExtensionId& extension_id,
+                        QueryType type,
+                        CommandScope scope,
+                        ui::CommandMap* command_map) const;
+
+  bool AddKeybindingPref(const ui::Accelerator& accelerator,
+                         const ExtensionId& extension_id,
+                         const std::string& command_name,
+                         bool allow_overrides,
+                         bool global);
+
+  void RemoveKeybindingPrefs(const ExtensionId& extension_id,
+                             const std::string& command_name);
+
+  void UpdateKeybindingPrefs(const ExtensionId& extension_id,
+                             const std::string& command_name,
+                             const std::string& keystroke);
+
+  bool SetScope(const ExtensionId& extension_id,
+                const std::string& command_name,
+                bool global);
+
+  Command FindCommandByName(const ExtensionId& extension_id,
+                            const std::string& command) const;
+
+  void AddObserver(Observer* observer);
+  void RemoveObserver(Observer* observer);
+
+  const Extension* GetExtensionInEnabledOrDisabledExtensions(
+      const ExtensionId& extension_id) const;
+
+  bool IsUpgradeFromMV2ToMV3(const Extension* extension,
+                             const std::string& existing_command_name) const;
+
+ private:
+  friend class BrowserContextKeyedAPIFactory<IOSCommandService>;
+
+  static const char* service_name() { return "IOSCommandService"; }
+  static const bool kServiceRedirectedInIncognito = true;
+
