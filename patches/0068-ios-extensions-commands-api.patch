diff --git a/ios/chrome/browser/extensions/model/ios_commands_api.cc b/ios/chrome/browser/extensions/model/ios_commands_api.cc
new file mode 100644
index 0000000..804a717
--- /dev/null
+++ b/ios/chrome/browser/extensions/model/ios_commands_api.cc
@@ -0,0 +1,142 @@
+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "ios/chrome/browser/extensions/model/ios_commands_api.h"
+
+#include <memory>
+#include <string_view>
+#include <utility>
+
+#include "base/memory/scoped_refptr.h"
+#include "base/values.h"
+#include "content/public/browser/browser_context.h"
+#include "extensions/browser/event_router.h"
+#include "extensions/browser/extension_event_histogram_value.h"
+#include "extensions/browser/extension_registry.h"
+#include "extensions/browser/extensions_browser_client.h"
+#include "extensions/common/api/commands/commands_handler.h"
+#include "extensions/common/command.h"
+#include "extensions/common/event_args.h"
+#include "extensions/common/extension.h"
+#include "ui/base/accelerators/command.h"
+
+namespace extensions {
+
+namespace {
+
+base::DictValue CreateCommandValue(const ui::Command& command) {
+  base::DictValue result;
+  result.Set("name", command.command_name());
+  result.Set("description", command.description());
+  // UIKit does not register extension keyboard shortcuts on iOS.
+  result.Set("shortcut", "");
+  return result;
+}
+
+void SetDispatchError(std::string* error_message, std::string_view detail) {
+  if (error_message) {
+    *error_message = std::string(detail);
+  }
+}
+
+}  // namespace
+
+ExtensionFunction::ResponseAction CommandsGetAllFunction::Run() {
+  const Extension* target_extension = extension();
+  if (!target_extension) {
+    return RespondNow(Error("No extension found."));
+  }
+
+  base::ListValue command_list;
+  if (const Command* browser_action =
+          CommandsInfo::GetBrowserActionCommand(target_extension)) {
+    command_list.Append(CreateCommandValue(*browser_action));
+  }
+  if (const Command* action =
+          CommandsInfo::GetActionCommand(target_extension)) {
+    command_list.Append(CreateCommandValue(*action));
+  }
+  if (const Command* page_action =
+          CommandsInfo::GetPageActionCommand(target_extension)) {
+    command_list.Append(CreateCommandValue(*page_action));
+  }
+  if (const ui::CommandMap* named_commands =
+          CommandsInfo::GetNamedCommands(target_extension)) {
+    for (const auto& [_, command] : *named_commands) {
+      command_list.Append(CreateCommandValue(command));
+    }
+  }
+
+  return RespondNow(WithArguments(std::move(command_list)));
+}
+
+bool DispatchExtensionCommandEvent(content::BrowserContext* browser_context,
+                                   const ExtensionId& extension_id,
+                                   const std::string& command_name,
+                                   std::optional<base::DictValue> tab_dict,
+                                   std::string* error_message) {
+  auto* client = ExtensionsBrowserClient::Get();
+  if (!client || !browser_context || !client->IsValidContext(browser_context)) {
+    SetDispatchError(error_message, "Extension browser context is not valid.");
+    return false;
+  }
+  if (extension_id.empty()) {
+    SetDispatchError(error_message, "Extension ID must not be empty.");
+    return false;
+  }
+  if (command_name.empty()) {
+    SetDispatchError(error_message, "Command name must not be empty.");
+    return false;
+  }
+  if (Command::IsActionRelatedCommand(command_name) ||
+      command_name.front() == '_') {
+    SetDispatchError(
+        error_message,
+        "Reserved action or underscore-prefixed commands cannot be dispatched "
+        "via commands.onCommand.");
+    return false;
+  }
+
+  ExtensionRegistry* registry = ExtensionRegistry::Get(browser_context);
+  if (!registry) {
+    SetDispatchError(error_message, "ExtensionRegistry is not available.");
+    return false;
+  }
+  const Extension* extension =
+      registry->enabled_extensions().GetByID(extension_id);
+  if (!extension) {
+    SetDispatchError(error_message,
+                     "Extension is not installed or is disabled.");
+    return false;
+  }
+
+  const ui::CommandMap* named_commands =
+      CommandsInfo::GetNamedCommands(extension);
+  if (!named_commands || !named_commands->contains(command_name)) {
+    SetDispatchError(error_message,
+                     "Command is not declared in extension manifest.");
+    return false;
+  }
+
+  EventRouter* event_router = EventRouter::Get(browser_context);
+  if (!event_router) {
+    SetDispatchError(error_message, "EventRouter is not available.");
+    return false;
+  }
+
+  base::ListValue args;
+  args.Append(command_name);
+  if (tab_dict.has_value()) {
+    args.Append(std::move(*tab_dict));
+  }
+
+  auto event = std::make_unique<Event>(
+      events::COMMANDS_ON_COMMAND, "commands.onCommand",
+      base::MakeRefCounted<EventArgs>(std::move(args)), browser_context);
+  event->user_gesture = EventRouter::UserGestureState::kEnabled;
+  event_router->DispatchEventToExtension(extension_id, std::move(event));
+  return true;
+}
+
+}  // namespace extensions
