+  return extensions::api::IOSGeneratedSchemas::Get(name);
+}
+
+void IOSExtensionsAPIProvider::RegisterPermissions(
+    extensions::PermissionsInfo* permissions_info) {}
+
+void IOSExtensionsAPIProvider::RegisterManifestHandlers(
+    extensions::ManifestHandlerRegistry* registry) {}
+
+}  // namespace web
