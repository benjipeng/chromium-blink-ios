+
+void IOSExtensionsBrowserClient::GetTabAndWindowIdForWebContents(
+    content::WebContents* web_contents,
+    int* tab_id,
+    int* window_id) {
+  *tab_id = -1;
+  *window_id = -1;
+  if (!web_contents || IsShuttingDown() ||
+      !IsValidContext(web_contents->GetBrowserContext())) {
+    return;
+  }
+  const auto id =
+      web::ContentWebState::GetUniqueIdentifierForWebContents(*web_contents);
+  if (id.valid()) {
+    *tab_id = id.identifier();
+  }
