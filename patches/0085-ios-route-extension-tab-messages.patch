+class IOSTabMessagingDelegate final : public MessagingDelegate {
+ public:
+  std::optional<base::DictValue> MaybeGetTabInfo(
+      content::WebContents* contents) override {
+    if (!contents || contents->IsBeingDestroyed()) {
+      return std::nullopt;
+    }
+    auto* list = GetBrowserList(contents->GetBrowserContext());
+    if (!list) {
+      return std::nullopt;
+    }
+    const auto browsers =
+        list->BrowsersOfType(BrowserList::BrowserType::kRegular);
+    auto* browser = FindSenderBrowser(browsers, contents);
+    if (!browser) {
+      return std::nullopt;
+    }
+    auto* tabs = browser->GetWebStateList();
+    const auto id =
+        web::ContentWebState::GetUniqueIdentifierForWebContents(*contents);
+    for (int i = 0; i < tabs->count(); ++i) {
+      if (tabs->GetWebStateAt(i)->GetUniqueIdentifier() == id) {
+        // The message already supplies the source URL and origin separately.
+        return MakeTab(*browser, i, /*extension=*/nullptr);
+      }
+    }
+    return std::nullopt;
+  }
+
+  content::WebContents* GetWebContentsByTabId(
+      content::BrowserContext* context,
+      int tab_id) override {
+    content::WebContents* contents = nullptr;
+    return IOSExtensionsBrowserClient::GetInstance()->IsValidTabId(
+               context, tab_id, /*include_incognito=*/false, &contents)
+               ? contents
+               : nullptr;
+  }
+};
+
 }  // namespace

+std::unique_ptr<MessagingDelegate> CreateIOSTabMessagingDelegate() {
+  return std::make_unique<IOSTabMessagingDelegate>();
+}
