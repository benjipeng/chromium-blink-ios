 namespace web {
 
+namespace {
+
+constexpr size_t kMaxPersistedClientHintOrigins = 1024;
+
+}  // namespace
+
+// [ios-blink-sideload] Lightweight in-memory ClientHintsControllerDelegate so
+// content's NavigationRequest sends Sec-CH-UA* low-entropy headers on HTTPS
+// navigations and persists Accept-CH / Critical-CH high-entropy opt-ins per
+// trustworthy origin.
+class ContentClientHintsControllerDelegate final
+    : public content::ClientHintsControllerDelegate {
+ public:
+  ContentClientHintsControllerDelegate() = default;
+  ~ContentClientHintsControllerDelegate() override = default;
+
+  network::NetworkQualityTracker* GetNetworkQualityTracker() override {
+    return nullptr;
+  }
+
+  void GetAllowedClientHintsFromSource(
+      const url::Origin& origin,
+      blink::EnabledClientHints* client_hints) override {
+    if (!client_hints) {
+      return;
+    }
+    if (network::IsOriginPotentiallyTrustworthy(origin)) {
+      if (auto it = origin_hints_.find(origin); it != origin_hints_.end()) {
+        for (const auto hint : it->second.GetEnabledHints()) {
+          client_hints->SetIsEnabled(hint, true);
+        }
+      }
+    }
+    for (const auto hint : additional_hints_) {
+      client_hints->SetIsEnabled(hint, true);
+    }
+  }
+
+  bool IsJavaScriptAllowed(const GURL& url,
+                           content::RenderFrameHost* parent_rfh) override {
+    return true;
+  }
+
+  blink::UserAgentMetadata GetUserAgentMetadata() override {
+    return embedder_support::GetUserAgentMetadata();
+  }
+
+  void PersistClientHints(
+      const url::Origin& primary_origin,
+      content::RenderFrameHost* parent_rfh,
+      const std::vector<network::mojom::WebClientHintsType>& client_hints)
+      override {
+    if (!network::IsOriginPotentiallyTrustworthy(primary_origin)) {
+      return;
+    }
+    if (client_hints.empty()) {
+      origin_hints_.erase(primary_origin);
+      return;
+    }
+    if (origin_hints_.size() >= kMaxPersistedClientHintOrigins &&
+        !origin_hints_.contains(primary_origin)) {
+      origin_hints_.clear();
+    }
+    blink::EnabledClientHints enabled;
+    for (const auto hint : client_hints) {
+      enabled.SetIsEnabled(hint, true);
+    }
+    origin_hints_[primary_origin] = std::move(enabled);
+  }
+
+  void ResetForTesting() override {
+    origin_hints_.clear();
+    additional_hints_.clear();
+  }
+
+  void SetAdditionalClientHints(
+      const std::vector<network::mojom::WebClientHintsType>& hints) override {
+    additional_hints_ = hints;
+  }
+
+  void ClearAdditionalClientHints() override { additional_hints_.clear(); }
+
+  void SetMostRecentMainFrameViewportSize(
+      const gfx::Size& viewport_size) override {
+    viewport_size_ = viewport_size;
+  }
+
+  gfx::Size GetMostRecentMainFrameViewportSize() override {
+    return viewport_size_;
+  }
+
+ private:
+  std::map<url::Origin, blink::EnabledClientHints> origin_hints_;
+  std::vector<network::mojom::WebClientHintsType> additional_hints_;
+  gfx::Size viewport_size_;
+};
