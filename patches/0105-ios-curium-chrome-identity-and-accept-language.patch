+bool IsValidClientHintToken(const std::string& value) {
+  return !value.empty() && net::HttpUtil::IsValidHeaderValue(value) &&
+         value.find('"') == std::string::npos &&
+         value.find('\\') == std::string::npos &&
+         value.find(';') == std::string::npos;
+}
+
+const base::CommandLine* CurrentCommandLine() {
+  return base::CommandLine::InitializedForCurrentProcess()
+             ? base::CommandLine::ForCurrentProcess()
+             : nullptr;
+}
+
+// [ios-blink-sideload] Default mobile identity on Blink-for-iOS is Android
+// Chrome so UA, Client Hints, BoringSSL TLS, V8, touch, and plugin signals stay
+// self-consistent. Pass --curium-mobile-ua=ios to restore the iOS 18_7 UA.
+bool UseAndroidMobileIdentity() {
+  const base::CommandLine* cmd = CurrentCommandLine();
+  if (cmd && cmd->HasSwitch("curium-mobile-ua")) {
+    const std::string mode =
+        base::ToLowerASCII(cmd->GetSwitchValueASCII("curium-mobile-ua"));
+    if (mode == "ios") {
+      return false;
+    }
+  }
+  return true;
+}
+
+// [ios-blink-sideload] Emit the standard 3-brand Chrome Client Hints list
+// ("Google Chrome", "Chromium", GREASE) unless overridden via
+// --curium-ua-brand=chromium (or another valid brand token).
+std::optional<std::string> GetCuriumBrand() {
+  const base::CommandLine* cmd = CurrentCommandLine();
+  if (cmd && cmd->HasSwitch("curium-ua-brand")) {
+    const std::string raw = cmd->GetSwitchValueASCII("curium-ua-brand");
+    const std::string lowered = base::ToLowerASCII(raw);
+    if (lowered.empty() || lowered == "chromium" || lowered == "none") {
+      return std::nullopt;
+    }
+    if (lowered == "chrome" || lowered == "google chrome") {
+      return std::string("Google Chrome");
+    }
+    if (IsValidClientHintToken(raw)) {
+      return raw;
+    }
+  }
+  return std::string("Google Chrome");
+}
+
+std::string GetCuriumMobilePlatformVersion() {
+  const base::CommandLine* cmd = CurrentCommandLine();
+  if (cmd && cmd->HasSwitch("curium-mobile-platform-version")) {
+    const std::string ver =
+        cmd->GetSwitchValueASCII("curium-mobile-platform-version");
+    if (IsValidClientHintToken(ver)) {
+      return ver;
+    }
+  }
+  return "15.0.0";
+}
+
+std::string GetCuriumMobileModel() {
+  const base::CommandLine* cmd = CurrentCommandLine();
+  if (cmd && cmd->HasSwitch("curium-mobile-model")) {
+    const std::string model = cmd->GetSwitchValueASCII("curium-mobile-model");
+    if (IsValidClientHintToken(model)) {
+      return model;
+    }
+  }
+  return std::string();
+}
+#endif  // BUILDFLAG(IS_IOS)
+
