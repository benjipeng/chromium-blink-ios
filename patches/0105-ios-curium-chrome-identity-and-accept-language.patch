 #endif
 
   return std::string();
@@ -915,4 +1011,53 @@ bool IsWoW64() {
 #endif
 }
 
+#if BUILDFLAG(IS_IOS)
+void EnsureCuriumMobileUserAgentSwitch() {
+  if (!base::CommandLine::InitializedForCurrentProcess()) {
+    return;
+  }
+  base::CommandLine* cmd = base::CommandLine::ForCurrentProcess();
+  if (cmd->HasSwitch(kUseMobileUserAgent)) {
+    return;
+  }
+  if (UseAndroidMobileIdentity() ||
+      ui::GetDeviceFormFactor() != ui::DEVICE_FORM_FACTOR_TABLET) {
+    cmd->AppendSwitch(kUseMobileUserAgent);
+  }
+}
+
+std::string GetCuriumAcceptLanguages() {
+  const base::CommandLine* cmd = CurrentCommandLine();
+  if (cmd && cmd->HasSwitch("curium-accept-lang")) {
+    const std::string raw = cmd->GetSwitchValueASCII("curium-accept-lang");
+    if (!raw.empty() && net::HttpUtil::IsValidHeaderValue(raw)) {
+      std::vector<std::string> sanitized;
+      for (std::string_view part :
+           base::SplitStringPiece(raw, ",", base::TRIM_WHITESPACE,
+                                  base::SPLIT_WANT_NONEMPTY)) {
+        // Strip any ";q=..." quality weight so ExpandLanguageList /
+        // GenerateAcceptLanguageHeader and navigator.languages never get
+        // duplicate or malformed quality parameters.
+        if (const size_t semi = part.find(';'); semi != std::string_view::npos) {
+          part = base::TrimWhitespaceASCII(part.substr(0, semi),
+                                           base::TRIM_ALL);
+        }
+        if (part.empty()) {
+          continue;
+        }
+        std::string token(part);
+        base::ReplaceChars(token, "_", "-", &token);
+        if (net::HttpUtil::IsValidHeaderValue(token)) {
+          sanitized.push_back(std::move(token));
+        }
+      }
+      if (!sanitized.empty()) {
+        return base::JoinString(sanitized, ",");
+      }
+    }
+  }
+  return "en-US,en";
+}
+#endif  // BUILDFLAG(IS_IOS)
+
 }  // namespace embedder_support
