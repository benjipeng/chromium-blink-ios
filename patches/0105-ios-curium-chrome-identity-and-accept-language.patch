+std::string DesktopMacPlatformVersion() {
+  if (base::CommandLine::InitializedForCurrentProcess()) {
+    const base::CommandLine* cmd = base::CommandLine::ForCurrentProcess();
+    if (cmd->HasSwitch("curium-desktop-platform-version")) {
+      const std::string ver =
+          cmd->GetSwitchValueASCII("curium-desktop-platform-version");
+      if (!ver.empty() && net::HttpUtil::IsValidHeaderValue(ver) &&
+          ver.find('"') == std::string::npos &&
+          ver.find('\\') == std::string::npos &&
+          ver.find(';') == std::string::npos) {
+        return ver;
+      }
+    }
+  }
+  int32_t major = 0, minor = 0, bugfix = 0;
+  base::SysInfo::OperatingSystemVersionNumbers(&major, &minor, &bugfix);
+  if (major >= 26) {
+    return base::StringPrintf("%d.%d.%d", major, minor, bugfix);
+  }
+  return "15.5.0";
+}
