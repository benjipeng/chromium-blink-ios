From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: chromium-blink-ios <noreply@github.com>
Subject: [PATCH] iOS extensions: create value stores in IOSExtensionSystem constructor

---
diff --git a/ios/chrome/browser/extensions/model/ios_extension_system.mm b/ios/chrome/browser/extensions/model/ios_extension_system.mm
--- a/ios/chrome/browser/extensions/model/ios_extension_system.mm
+++ b/ios/chrome/browser/extensions/model/ios_extension_system.mm
@@ -174,6 +174,17 @@
 IOSExtensionSystem::IOSExtensionSystem(content::BrowserContext* browser_context)
     : browser_context_(browser_context) {
   CHECK(browser_context_);
+  store_factory_ = base::MakeRefCounted<value_store::ValueStoreFactoryImpl>(
+      browser_context_->GetPath());
+  state_store_ = std::make_unique<StateStore>(
+      browser_context_, store_factory_, StateStore::BackendType::STATE,
+      /*deferred_load=*/false);
+  rules_store_ = std::make_unique<StateStore>(
+      browser_context_, store_factory_, StateStore::BackendType::RULES,
+      /*deferred_load=*/false);
+  dynamic_user_scripts_store_ = std::make_unique<StateStore>(
+      browser_context_, store_factory_, StateStore::BackendType::SCRIPTS,
+      /*deferred_load=*/false);
 }
 
 IOSExtensionSystem::~IOSExtensionSystem() = default;
@@ -203,18 +214,6 @@
   }
   initialized_ = true;
 
-  store_factory_ = base::MakeRefCounted<value_store::ValueStoreFactoryImpl>(
-      browser_context_->GetPath());
-  state_store_ = std::make_unique<StateStore>(
-      browser_context_, store_factory_, StateStore::BackendType::STATE,
-      /*deferred_load=*/false);
-  rules_store_ = std::make_unique<StateStore>(
-      browser_context_, store_factory_, StateStore::BackendType::RULES,
-      /*deferred_load=*/false);
-  dynamic_user_scripts_store_ = std::make_unique<StateStore>(
-      browser_context_, store_factory_, StateStore::BackendType::SCRIPTS,
-      /*deferred_load=*/false);
-
   quota_service_ = std::make_unique<QuotaService>();
   app_sorting_ = std::make_unique<NullAppSorting>();
   policy_provider_ = std::make_unique<BundledExtensionPolicyProvider>();
