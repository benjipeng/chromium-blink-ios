 #import "services/device/public/cpp/geolocation/system_geolocation_source_apple.h"
 
 namespace web {
+namespace {
+
+class TCPServerSocketFactory final : public content::DevToolsSocketFactory {
+ public:
+  explicit TCPServerSocketFactory(uint16_t port) : port_(port) {}
+
+ private:
+  std::unique_ptr<net::ServerSocket> CreateForHttpServer() override {
+    constexpr int kBacklog = 10;
+    auto socket =
+        std::make_unique<net::TCPServerSocket>(nullptr, net::NetLogSource());
+    if (socket->Listen(net::IPEndPoint(net::IPAddress::IPv4Localhost(), port_),
+                       kBacklog, /*ipv6_only=*/std::nullopt) != net::OK) {
+      return nullptr;
+    }
+    return socket;
+  }
+
+  std::unique_ptr<net::ServerSocket> CreateForTethering(
+      std::string* out_name) override {
+    return nullptr;
+  }
+
+  const uint16_t port_;
+};
+
+}  // namespace
 
 IOSBrowserMainParts::IOSBrowserMainParts() {
   parts_ = web::GetWebClient()->CreateWebMainParts();
@@ -43,9 +86,31 @@
 
 int IOSBrowserMainParts::PreMainMessageLoopRun() {
   parts_->PreMainMessageLoopRun();
+
+  const auto& command_line = *base::CommandLine::ForCurrentProcess();
+  if (command_line.HasSwitch(switches::kRemoteDebuggingPort)) {
+    int port;
+    if (base::StringToInt(
+            command_line.GetSwitchValueASCII(switches::kRemoteDebuggingPort),
+            &port) &&
+        port >= 0 && port <= 65535) {
+      content::DevToolsAgentHost::StartRemoteDebuggingServer(
+          std::make_unique<TCPServerSocketFactory>(static_cast<uint16_t>(port)),
+          /*active_port_output_directory=*/base::FilePath(),
+          /*debug_frontend_dir=*/base::FilePath());
+      started_devtools_server_ = true;
+    }
+  }
   return 0;
 }
 
+void IOSBrowserMainParts::PostMainMessageLoopRun() {
+  if (started_devtools_server_) {
+    content::DevToolsAgentHost::StopRemoteDebuggingServer();
+    started_devtools_server_ = false;
+  }
+}
