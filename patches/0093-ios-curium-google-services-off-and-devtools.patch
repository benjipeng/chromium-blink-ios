 namespace {
 
+bool ShouldCheckUrl(SafeBrowsingClient* client, const GURL& url) {
+  const PrefService* prefs = client->GetPrefs();
+  // Consumer real-time lookups can otherwise use the URL-keyed metrics opt-in
+  // even when Safe Browsing is off. Preserve explicit enterprise filtering.
+  if (prefs && prefs->FindPreference(prefs::kSafeBrowsingEnabled) &&
+      !safe_browsing::IsSafeBrowsingEnabled(*prefs) &&
+      !client->ShouldForceSyncRealTimeUrlChecks()) {
+    return false;
+  }
+  return client->GetSafeBrowsingService()->CanCheckUrl(url);
+}
