-NSData* GetDataWithTypeFromPasteboard(UIPasteboard* pasteboard,
-                                      NSString* type) {
+bool ItemsHaveAnyEntries(NSArray<NSDictionary<NSString*, id>*>* items) {
+  for (NSDictionary<NSString*, id>* item in items) {
+    if ([item isKindOfClass:[NSDictionary class]] && item.count > 0) {
+      return true;
+    }
+  }
+  return false;
+}
+
+bool ItemsHaveRasterImage(NSArray<NSDictionary<NSString*, id>*>* items) {
+  for (NSDictionary<NSString*, id>* item in items) {
+    if (![item isKindOfClass:[NSDictionary class]]) {
+      continue;
+    }
+    for (id raw_key in item) {
+      NSString* key = base::apple::ObjCCast<NSString>(raw_key);
+      if (!key) {
+        continue;
+      }
+      UTType* ut = [UTType typeWithIdentifier:key];
+      if (ut && [ut conformsToType:UTTypeImage] &&
+          ![ut conformsToType:UTTypeSVG]) {
+        return true;
+      }
+    }
+  }
+  return false;
+}
+
+NSString* DecodePlainTextValue(id value, NSString* source_key) {
+  if ([value isKindOfClass:[NSString class]]) {
+    return static_cast<NSString*>(value);
+  }
+  if ([value isKindOfClass:[NSURL class]]) {
+    NSString* abs = [static_cast<NSURL*>(value) absoluteString];
+    return abs.length > 0 ? abs : nil;
+  }
+  if ([value isKindOfClass:[NSData class]]) {
+    NSData* data = static_cast<NSData*>(value);
+    if (data.length == 0) {
+      return @"";
+    }
+    base::span<const uint8_t> bytes = base::apple::NSDataToSpan(data);
+    const bool has_utf16_bom =
+        bytes.size() >= 2 && ((bytes[0] == 0xFF && bytes[1] == 0xFE) ||
+                              (bytes[0] == 0xFE && bytes[1] == 0xFF));
+    const bool is_utf16_type =
+        [source_key isEqualToString:UTTypeUTF16PlainText.identifier] ||
+        [source_key isEqualToString:UTTypeUTF16ExternalPlainText.identifier];
+    if (has_utf16_bom) {
+      return [[NSString alloc] initWithData:data encoding:NSUTF16StringEncoding];
+    }
+    if (is_utf16_type) {
+      return [[NSString alloc] initWithData:data
+                                   encoding:NSUTF16LittleEndianStringEncoding];
+    }
+    if (bytes.size() >= 6 &&
+        base::as_string_view(bytes.first(6)) == "bplist") {
+      return nil;
+    }
+    return [[NSString alloc] initWithData:data encoding:NSUTF8StringEncoding];
+  }
+  return nil;
+}
+
+NSData* DataFromPasteboardValue(id value,
+                                NSString* source_key,
+                                NSString* requested_type) {
+  if ([value isKindOfClass:[NSString class]]) {
+    return [static_cast<NSString*>(value)
+        dataUsingEncoding:NSUTF8StringEncoding];
+  }
+  if ([value isKindOfClass:[NSURL class]]) {
+    NSString* abs = [static_cast<NSURL*>(value) absoluteString];
+    return abs.length > 0 ? [abs dataUsingEncoding:NSUTF8StringEncoding] : nil;
+  }
+  if ([value isKindOfClass:[NSData class]]) {
+    NSData* data = static_cast<NSData*>(value);
+    if ([requested_type isEqualToString:UTTypePlainText.identifier] ||
+        [requested_type isEqualToString:UTTypeUTF8PlainText.identifier]) {
+      base::span<const uint8_t> bytes = base::apple::NSDataToSpan(data);
+      const bool has_utf16_bom =
+          bytes.size() >= 2 && ((bytes[0] == 0xFF && bytes[1] == 0xFE) ||
+                                (bytes[0] == 0xFE && bytes[1] == 0xFF));
+      const bool is_utf16_type =
+          [source_key isEqualToString:UTTypeUTF16PlainText.identifier] ||
+          [source_key isEqualToString:UTTypeUTF16ExternalPlainText.identifier];
+      if (has_utf16_bom || is_utf16_type) {
+        if (NSString* decoded = DecodePlainTextValue(data, source_key)) {
+          return [decoded dataUsingEncoding:NSUTF8StringEncoding];
+        }
+      }
+    }
+    return data;
+  }
+  return nil;
+}
+
+NSArray<NSData*>* ExtractDataForTypeFromItems(
+    NSArray<NSDictionary<NSString*, id>*>* items,
+    NSString* requested_type) {
+  if (items.count == 0 || requested_type.length == 0) {
+    return nil;
+  }
+  UTType* requested_ut = [UTType typeWithIdentifier:requested_type];
+  const bool wants_plain_text =
+      requested_ut && [requested_ut isEqual:UTTypePlainText];
+  NSMutableArray<NSData*>* results = nil;
+
+  for (NSDictionary<NSString*, id>* item in items) {
+    if (![item isKindOfClass:[NSDictionary class]]) {
+      continue;
+    }
+    NSString* matched_key = nil;
+    id matched_val = item[requested_type];
+    if (matched_val) {
+      matched_key = requested_type;
+    } else if (requested_ut) {
+      if (wants_plain_text && item[UTTypeUTF8PlainText.identifier]) {
+        matched_key = UTTypeUTF8PlainText.identifier;
+        matched_val = item[matched_key];
+      } else {
+        NSString* url_fallback_key = nil;
+        id url_fallback_val = nil;
+        for (id raw_key in item) {
+          NSString* key = base::apple::ObjCCast<NSString>(raw_key);
+          if (!key) {
+            continue;
+          }
+          UTType* ut = [UTType typeWithIdentifier:key];
+          if (!ut) {
+            continue;
+          }
+          if ([ut conformsToType:requested_ut]) {
+            matched_key = key;
+            matched_val = item[key];
+            break;
+          }
+          if (wants_plain_text && !url_fallback_key &&
+              [ut conformsToType:UTTypeURL] &&
+              ![ut conformsToType:UTTypeFileURL]) {
+            url_fallback_key = key;
+            url_fallback_val = item[key];
+          }
+        }
+        if (!matched_key && url_fallback_key && url_fallback_val) {
+          matched_key = url_fallback_key;
+          matched_val = url_fallback_val;
+        }
+      }
+    }
+    if (!matched_key || !matched_val) {
+      continue;
+    }
+    if (NSData* data =
+            DataFromPasteboardValue(matched_val, matched_key, requested_type)) {
+      if (!results) {
+        results = [NSMutableArray arrayWithCapacity:items.count];
+      }
+      [results addObject:data];
+    }
+  }
+  return results.count > 0 ? [results copy] : nil;
+}
+
+}  // namespace
+
+struct ClipboardIOS::PasteSnapshot {
+  NSInteger change_count = NSNotFound;
+  base::TimeTicks expires_at;
+  NSArray<NSDictionary<NSString*, id>*>* items = nil;
+  UIImage* image = nil;
+};
+
+namespace {
+
+NSArray<NSDictionary<NSString*, id>*>* GetItemsForRead(
+    UIPasteboard* pasteboard,
+    const ClipboardIOS::PasteSnapshot* snapshot) {
   CHECK(pasteboard, base::NotFatalUntil::M163);
-  auto items = [pasteboard dataForPasteboardType:type inItemSet:nil];
-  if (!items) {
-    return nullptr;
+  if (snapshot) {
+    return snapshot->items;
+  }
+  NSArray<NSDictionary<NSString*, id>*>* items = pasteboard.items;
+  if (items.count > 0 && !ItemsHaveAnyEntries(items)) {
+    if (NSString* str = pasteboard.string; str.length > 0) {
+      return @[ @{UTTypeUTF8PlainText.identifier : [str copy]} ];
+    }
+    if (NSURL* url = pasteboard.URL; url.absoluteString.length > 0) {
+      return @[ @{UTTypeURL.identifier : [url.absoluteString copy]} ];
+    }
   }
-  return [items firstObject];
+  return items;
+}
+
+NSArray<NSData*>* GetAllDataForType(
+    UIPasteboard* pasteboard,
+    const ClipboardIOS::PasteSnapshot* snapshot,
+    NSString* requested_type) {
+  CHECK(pasteboard, base::NotFatalUntil::M163);
+  if (requested_type.length == 0) {
+    return nil;
+  }
+  if (snapshot) {
+    return ExtractDataForTypeFromItems(snapshot->items, requested_type);
+  }
+  NSArray<NSDictionary<NSString*, id>*>* items =
+      GetItemsForRead(pasteboard, nullptr);
+  if (NSArray<NSData*>* extracted =
+          ExtractDataForTypeFromItems(items, requested_type)) {
+    return extracted;
+  }
+  return [pasteboard dataForPasteboardType:requested_type inItemSet:nil];
+}
+
+NSData* GetDataForType(UIPasteboard* pasteboard,
+                       const ClipboardIOS::PasteSnapshot* snapshot,
+                       NSString* requested_type) {
+  NSArray<NSData*>* items =
+      GetAllDataForType(pasteboard, snapshot, requested_type);
+  return items.count > 0 ? items.firstObject : nil;
 }
 
 }  // namespace
@@ -56,7 +274,58 @@
   CHECK(CalledOnValidThread(), base::NotFatalUntil::M163);
 }
 
-void ClipboardIOS::OnPreShutdown() {}
+void ClipboardIOS::OnPreShutdown() {
+  InvalidatePasteSnapshot();
+}
+
+void ClipboardIOS::InvalidatePasteSnapshot() const {
+  paste_snapshot_.reset();
+}
+
+const ClipboardIOS::PasteSnapshot* ClipboardIOS::GetActivePasteSnapshot(
+    UIPasteboard* pasteboard) const {
+  if (!paste_snapshot_ || !pasteboard) {
+    return nullptr;
+  }
+  if (paste_snapshot_->change_count != pasteboard.changeCount ||
+      base::TimeTicks::Now() >= paste_snapshot_->expires_at) {
+    paste_snapshot_.reset();
+    return nullptr;
+  }
+  return paste_snapshot_.get();
+}
+
+void ClipboardIOS::PrepareForPaste() {
+  CHECK(CalledOnValidThread(), base::NotFatalUntil::M163);
+  UIPasteboard* pasteboard = GetPasteboard();
+  if (!pasteboard) {
+    InvalidatePasteSnapshot();
+    return;
+  }
+  const NSInteger change_count = pasteboard.changeCount;
+  NSArray<NSDictionary<NSString*, id>*>* raw_items = pasteboard.items;
+  NSMutableArray<NSDictionary<NSString*, id>*>* items =
+      raw_items.count > 0 ? [raw_items mutableCopy] : [NSMutableArray array];
+  if (!ItemsHaveAnyEntries(items)) {
+    if (NSString* str = pasteboard.string; str.length > 0) {
+      items = [NSMutableArray arrayWithObject:@{
+        UTTypeUTF8PlainText.identifier : [str copy],
+      }];
+    } else if (NSURL* url = pasteboard.URL; url.absoluteString.length > 0) {
+      items = [NSMutableArray arrayWithObject:@{
+        UTTypeURL.identifier : [url.absoluteString copy],
+      }];
+    }
+  }
+  UIImage* image = ItemsHaveRasterImage(items) ? pasteboard.image : nil;
+
+  auto snapshot = std::make_unique<PasteSnapshot>();
+  snapshot->change_count = change_count;
+  snapshot->expires_at = base::TimeTicks::Now() + kPasteSnapshotTTL;
+  snapshot->items = [items copy];
+  snapshot->image = image;
+  paste_snapshot_ = std::move(snapshot);
+}
 
