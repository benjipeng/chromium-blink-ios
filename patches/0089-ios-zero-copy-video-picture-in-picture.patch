+
+void IOSVideoOverlayWindow::PrepareSystemPictureInPicture(
+    const base::UnguessableToken& session_token) {
+  UnregisterCurrentSessionSink();
+  ++generation_;
+  session_token_ = session_token;
+  const uint64_t gen = generation_;
+
+  UIWindow* targetWindow = FindTargetWindow(controller_);
+  [impl_->bridge prepareHostInWindow:targetWindow
+                         naturalSize:natural_size_
+                          generation:gen];
+
+  CuriumPiPBridge* bridge = impl_->bridge;
+  media::RegisterIOSPiPSessionSink(
+      session_token,
+      base::BindRepeating(
+          [](CuriumPiPBridge* bridge_ref, uint64_t expected_gen,
+             scoped_refptr<media::VideoFrame> frame,
+             base::apple::ScopedCFTypeRef<CVPixelBufferRef> hw_buffer) {
+            [bridge_ref enqueueLatestFrame:std::move(frame)
+                                  hwBuffer:std::move(hw_buffer)
+                                generation:expected_gen];
+          },
+          bridge, gen));
+}
+
+void IOSVideoOverlayWindow::StartSystemPictureInPicture(
+    const base::UnguessableToken& session_token,
+    base::OnceCallback<void(bool success, const gfx::Size& window_size)>
+        callback) {
+  if (!session_token_.has_value() || *session_token_ != session_token) {
+    std::move(callback).Run(false, gfx::Size());
+    return;
+  }
+  pending_start_callback_ = std::move(callback);
+  is_starting_ = true;
+  [impl_->bridge startPiPForGeneration:generation_];
+}
+
+void IOSVideoOverlayWindow::SetSystemPiPBackgroundCallback(
+    base::RepeatingCallback<void(bool backgrounded)> callback) {
+  background_callback_ = std::move(callback);
+}
+
+void IOSVideoOverlayWindow::CancelPendingStart() {
+  if (!is_starting_ && !pending_start_callback_ && !session_token_.has_value()) {
+    return;
+  }
+  ++generation_;
+  is_starting_ = false;
+  UnregisterCurrentSessionSink();
+  CompletePendingStart(/*success=*/false, gfx::Size());
+  [impl_->bridge stopPiPAndDetach:YES];
+}
+
+void IOSVideoOverlayWindow::OnAVKitDidStart(uint64_t generation,
+                                            const gfx::Size& render_size) {
+  if (generation != generation_) {
+    return;
+  }
+  is_starting_ = false;
+  is_visible_ = true;
+  if (!render_size.IsEmpty()) {
+    render_size_ = render_size;
+  }
+  CompletePendingStart(/*success=*/true, GetBounds().size());
+}
+
+void IOSVideoOverlayWindow::OnAVKitFailedToStart(uint64_t generation) {
+  if (generation != generation_) {
+    return;
+  }
+  is_starting_ = false;
+  is_visible_ = false;
+  UnregisterCurrentSessionSink();
+  CompletePendingStart(/*success=*/false, gfx::Size());
+}
+
+void IOSVideoOverlayWindow::OnAVKitDidStop(uint64_t generation,
+                                           bool should_pause_video) {
+  if (generation != generation_) {
+    return;
+  }
+  is_starting_ = false;
+  is_visible_ = false;
+  UnregisterCurrentSessionSink();
+  if (pending_start_callback_) {
+    CompletePendingStart(/*success=*/false, gfx::Size());
+    return;
+  }
+  if (controller_) {
+    controller_->OnWindowDestroyed(should_pause_video);
+  }
+}
+
+void IOSVideoOverlayWindow::OnAVKitSetPlaying(bool playing) {
+  if (!controller_) {
+    return;
+  }
+  if (playing) {
+    controller_->Play();
+  } else {
+    controller_->Pause();
+  }
+}
+
+void IOSVideoOverlayWindow::OnAVKitRenderSizeChanged(
+    const gfx::Size& render_size) {
+  if (render_size.IsEmpty()) {
+    return;
+  }
+  render_size_ = render_size;
+  if (controller_) {
+    controller_->UpdateLayerBounds();
+  }
+}
+
+void IOSVideoOverlayWindow::OnAVKitRestoreUI(
+    base::OnceCallback<void(bool)> completion) {
+  if (controller_) {
+    controller_->FocusInitiator();
+  }
+  std::move(completion).Run(true);
+}
+
+void IOSVideoOverlayWindow::OnSceneBackgroundChanged(bool backgrounded) {
+  if (background_callback_) {
+    background_callback_.Run(backgrounded);
+  }
+}
+
+void IOSVideoOverlayWindow::CompletePendingStart(bool success,
+                                                 const gfx::Size& size) {
+  if (pending_start_callback_) {
+    std::move(pending_start_callback_).Run(success, size);
+  }
+}
+
+void IOSVideoOverlayWindow::UnregisterCurrentSessionSink() {
+  if (session_token_.has_value()) {
+    media::UnregisterIOSPiPSessionSink(*session_token_);
+    session_token_.reset();
+  }
+}
