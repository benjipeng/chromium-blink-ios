+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#ifndef MEDIA_BASE_MAC_IOS_PIP_FRAME_HUB_H_
+#define MEDIA_BASE_MAC_IOS_PIP_FRAME_HUB_H_
+
+#include <CoreVideo/CoreVideo.h>
+
+#include "base/apple/scoped_cftyperef.h"
+#include "base/functional/callback.h"
+#include "base/memory/scoped_refptr.h"
+#include "base/unguessable_token.h"
+#include "media/base/media_export.h"
+
+namespace media {
+
+class VideoFrame;
+
+// Invoked on the VideoFrameCompositor sequence when a frame is produced for an
+// active in-process iOS Picture-in-Picture session. |hw_pixel_buffer| is
+// populated (with an owning retain) when the frame was backed by a registered
+// VideoToolbox CVPixelBuffer; otherwise software consumers may inspect |frame|.
+using IOSPiPFrameCallback = base::RepeatingCallback<void(
+    scoped_refptr<VideoFrame> frame,
+    base::apple::ScopedCFTypeRef<CVPixelBufferRef> hw_pixel_buffer)>;
+
+MEDIA_EXPORT void RegisterIOSPiPSessionSink(
+    const base::UnguessableToken& session_token,
+    IOSPiPFrameCallback callback);
+
+MEDIA_EXPORT void UnregisterIOSPiPSessionSink(
+    const base::UnguessableToken& session_token);
+
+MEDIA_EXPORT void DeliverIOSPiPFrame(
+    const base::UnguessableToken& session_token,
+    scoped_refptr<VideoFrame> frame);
+
+}  // namespace media
+
+#endif  // MEDIA_BASE_MAC_IOS_PIP_FRAME_HUB_H_
diff --git a/media/base/mac/ios_pip_frame_hub.mm b/media/base/mac/ios_pip_frame_hub.mm
new file mode 100644
index 0000000..eac9428
--- /dev/null
+++ b/media/base/mac/ios_pip_frame_hub.mm
@@ -0,0 +1,103 @@
+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "media/base/mac/ios_pip_frame_hub.h"
+
+#include <unordered_map>
+#include <utility>
+
+#include "base/no_destructor.h"
+#include "base/synchronization/lock.h"
+#include "gpu/command_buffer/client/client_shared_image.h"
+#include "media/base/mac/ios_pip_buffer_registry.h"
+#include "media/base/video_frame.h"
+
+namespace media {
+
+namespace {
+
+class IOSPiPFrameHub {
+ public:
+  void Register(const base::UnguessableToken& session_token,
+                IOSPiPFrameCallback callback) {
+    if (session_token.is_empty() || !callback) {
+      return;
+    }
+    base::AutoLock auto_lock(lock_);
+    sinks_[session_token] = std::move(callback);
+  }
+
+  void Unregister(const base::UnguessableToken& session_token) {
+    if (session_token.is_empty()) {
+      return;
+    }
+    IOSPiPFrameCallback removed;
+    {
+      base::AutoLock auto_lock(lock_);
+      auto it = sinks_.find(session_token);
+      if (it != sinks_.end()) {
+        removed = std::move(it->second);
+        sinks_.erase(it);
+      }
+    }
+  }
+
+  void Deliver(const base::UnguessableToken& session_token,
+               scoped_refptr<VideoFrame> frame) {
+    if (session_token.is_empty() || !frame) {
+      return;
+    }
+    IOSPiPFrameCallback callback;
+    {
+      base::AutoLock auto_lock(lock_);
+      auto it = sinks_.find(session_token);
+      if (it == sinks_.end()) {
+        return;
+      }
+      callback = it->second;
+    }
+
+    // Resolve the VideoToolbox CVPixelBuffer while holding a reference to the
+    // renderer |frame| so the producer VideoFrame cannot be recycled mid-lookup.
+    base::apple::ScopedCFTypeRef<CVPixelBufferRef> hw_pixel_buffer;
+    if (frame->metadata().ios_pip_buffer_token.has_value() &&
+        frame->HasSharedImage() && frame->shared_image()) {
+      hw_pixel_buffer = CopyIOSPiPPixelBuffer(
+          *frame->metadata().ios_pip_buffer_token,
+          frame->shared_image()->mailbox());
+    }
+
+    callback.Run(std::move(frame), std::move(hw_pixel_buffer));
+  }
+
+ private:
+  base::Lock lock_;
+  std::unordered_map<base::UnguessableToken,
+                     IOSPiPFrameCallback,
+                     base::UnguessableTokenHash>
+      sinks_ GUARDED_BY(lock_);
+};
+
+IOSPiPFrameHub& GetHub() {
+  static base::NoDestructor<IOSPiPFrameHub> instance;
+  return *instance;
+}
+
+}  // namespace
+
+void RegisterIOSPiPSessionSink(const base::UnguessableToken& session_token,
+                               IOSPiPFrameCallback callback) {
+  GetHub().Register(session_token, std::move(callback));
+}
+
+void UnregisterIOSPiPSessionSink(const base::UnguessableToken& session_token) {
+  GetHub().Unregister(session_token);
+}
+
+void DeliverIOSPiPFrame(const base::UnguessableToken& session_token,
+                        scoped_refptr<VideoFrame> frame) {
+  GetHub().Deliver(session_token, std::move(frame));
+}
+
+}  // namespace media
