+- (instancetype)initWithOwner:(base::WeakPtr<web::IOSVideoOverlayWindow>)owner
+                     uiRunner:
+                         (scoped_refptr<base::SequencedTaskRunner>)uiRunner {
+  self = [super init];
+  if (self) {
+    _owner = std::move(owner);
+    _uiRunner = std::move(uiRunner);
+    _renderQueue = dispatch_queue_create("com.curium.ios.pip.renderer",
+                                         DISPATCH_QUEUE_SERIAL);
+    _atomicGeneration.store(0, std::memory_order_release);
+    _mainPlaybackRate = 1.0;
+    _mainDurationSeconds = NAN;
+    _renderPlaybackRate = 1.0;
+  }
+  return self;
+}
+
+// The owner tears down on the UI sequence before releasing the bridge, but render
+// queue blocks may hold the last reference, so dealloc can run on that queue. It
+// must not touch UIKit or capture self in a block: a block retaining a
+// deallocating object releases freed memory when it is disposed.
+- (void)dealloc {
+  [self detachObservers];
+  if (UIView* hostView = _hostView) {
+    dispatch_async(dispatch_get_main_queue(), ^{
+      [hostView removeFromSuperview];
+    });
+  }
+}
+
+// Unregisters observers. Removal may run on any thread; it does not make a
+// callback already in flight safe against concurrent teardown.
+- (void)detachObservers {
+  NSNotificationCenter* nc = [NSNotificationCenter defaultCenter];
+  if (_didEnterBgObserver) {
+    [nc removeObserver:_didEnterBgObserver];
+    _didEnterBgObserver = nil;
+  }
+  if (_willEnterFgObserver) {
+    [nc removeObserver:_willEnterFgObserver];
+    _willEnterFgObserver = nil;
+  }
+  if (_failedToDecodeObserver) {
+    [nc removeObserver:_failedToDecodeObserver];
+    _failedToDecodeObserver = nil;
+  }
+  if (_requiresFlushObserver) {
+    [nc removeObserver:_requiresFlushObserver];
+    _requiresFlushObserver = nil;
+  }
+  if (_observingPossible && _pipController) {
+    [_pipController removeObserver:self forKeyPath:@"pictureInPicturePossible"];
+    _observingPossible = NO;
+  }
+}
+
+// UI sequence only, and never from dealloc: the render-state reset retains self.
+- (void)teardownObserversAndViews {
+  [self detachObservers];
+  _waitingForPossible = NO;
+  _startAttemptActive = NO;
+  _pipController.delegate = nil;
+  _pipController = nil;
+  _displayLayer = nil;
+  [_hostView removeFromSuperview];
+  _hostView = nil;
+  dispatch_queue_t q = _renderQueue;
+  if (q) {
+    dispatch_async(q, ^{
+      self->_renderRenderer = nil;
+      self->_renderTimebase.reset();
+      self->_renderTimebasePrimed = NO;
+      self->_isFlushing = NO;
+      self->_swPool.Reset();
+    });
+  }
+}
+
+- (void)prepareHostInWindow:(UIWindow*)window
+                naturalSize:(gfx::Size)naturalSize
+                 generation:(uint64_t)generation {
+  _activeGeneration = generation;
+  _atomicGeneration.store(generation, std::memory_order_release);
+  _startAttemptActive = NO;
+
+  if (!window || !window.rootViewController.view) {
+    return;
+  }
+
+  UIView* rootView = window.rootViewController.view;
+  if (!_hostView || _hostView.superview != rootView) {
+    [self teardownObserversAndViews];
+
+    const CGFloat w = naturalSize.width() > 0 ? 160.0 : 160.0;
+    const CGFloat aspect =
+        (naturalSize.width() > 0 && naturalSize.height() > 0)
+            ? static_cast<CGFloat>(naturalSize.height()) /
+                  static_cast<CGFloat>(naturalSize.width())
+            : (9.0 / 16.0);
+    const CGFloat h = std::clamp(w * aspect, 48.0, 240.0);
+
+    _hostView = [[CuriumPiPHostView alloc] initWithFrame:CGRectMake(0, 0, w, h)];
+    _hostView.userInteractionEnabled = NO;
+    _hostView.backgroundColor = UIColor.clearColor;
+    _hostView.opaque = NO;
+    _hostView.accessibilityElementsHidden = YES;
+    // Place beneath opaque browser chrome, outside per-tab view subtrees.
+    [rootView insertSubview:_hostView atIndex:0];
+
+    _displayLayer = _hostView.displayLayer;
+    _displayLayer.videoGravity = AVLayerVideoGravityResizeAspect;
+    AVSampleBufferVideoRenderer* newRenderer =
+        _displayLayer.sampleBufferRenderer;
+
+    base::apple::ScopedCFTypeRef<CMTimebaseRef> newTimebase;
+    CMTimebaseRef raw_tb = nullptr;
+    if (CMTimebaseCreateWithSourceClock(kCFAllocatorDefault,
+                                        CMClockGetHostTimeClock(),
+                                        &raw_tb) == noErr &&
+        raw_tb) {
+      newTimebase.reset(raw_tb);
+      CMTimebaseSetTime(newTimebase.get(), kCMTimeZero);
+      CMTimebaseSetRate(newTimebase.get(), _mainPlaybackPaused ? 0.0 : 1.0);
+      _displayLayer.controlTimebase = newTimebase.get();
+    }
+    const BOOL initialPaused = _mainPlaybackPaused;
+    const double initialRate = _mainPlaybackRate;
+    __block base::apple::ScopedCFTypeRef<CMTimebaseRef> tbForQueue =
+        std::move(newTimebase);
+    dispatch_async(_renderQueue, ^{
+      self->_renderRenderer = newRenderer;
+      self->_renderTimebase = std::move(tbForQueue);
+      self->_renderPlaybackPaused = initialPaused;
+      self->_renderPlaybackRate = initialRate;
+      self->_renderTimebasePrimed = NO;
+      self->_isFlushing = NO;
+      self->_consecutiveFailures = 0;
+    });
+
+    AVPictureInPictureControllerContentSource* source =
+        [[AVPictureInPictureControllerContentSource alloc]
+            initWithSampleBufferDisplayLayer:_displayLayer
+                            playbackDelegate:self];
+    _pipController =
+        [[AVPictureInPictureController alloc] initWithContentSource:source];
+    _pipController.delegate = self;
+    _pipController.canStartPictureInPictureAutomaticallyFromInline = NO;
+    _pipController.requiresLinearPlayback = YES;
+
+    [_pipController addObserver:self
+                     forKeyPath:@"pictureInPicturePossible"
+                        options:NSKeyValueObservingOptionNew
+                        context:nil];
+    _observingPossible = YES;
+
+    _windowScene = window.windowScene;
+    NSNotificationCenter* nc = [NSNotificationCenter defaultCenter];
+    __weak CuriumPiPBridge* weakSelf = self;
+    _didEnterBgObserver =
+        [nc addObserverForName:UISceneDidEnterBackgroundNotification
+                        object:_windowScene
+                         queue:NSOperationQueue.mainQueue
+                    usingBlock:^(NSNotification*) {
+                      [weakSelf notifySceneBackgrounded:YES];
+                    }];
+    _willEnterFgObserver =
+        [nc addObserverForName:UISceneWillEnterForegroundNotification
+                        object:_windowScene
+                         queue:NSOperationQueue.mainQueue
+                    usingBlock:^(NSNotification*) {
+                      [weakSelf notifySceneBackgrounded:NO];
+                    }];
+    _failedToDecodeObserver =
+        [nc addObserverForName:AVSampleBufferVideoRendererDidFailToDecodeNotification
+                        object:newRenderer
+                         queue:nil
+                    usingBlock:^(NSNotification* note) {
+                      NSError* err = note.userInfo
+                          [AVSampleBufferVideoRendererDidFailToDecodeNotificationErrorKey];
+                      LOG(WARNING) << "iOS PiP renderer decode failure: "
+                                   << (err ? err.localizedDescription.UTF8String
+                                           : "unknown");
+                      [weakSelf scheduleRendererRecoveryForGeneration:generation];
+                    }];
+#pragma clang diagnostic push
+#pragma clang diagnostic ignored "-Wdeprecated-declarations"
+    _requiresFlushObserver = [nc
+        addObserverForName:
+            AVSampleBufferVideoRendererRequiresFlushToResumeDecodingDidChangeNotification
+                    object:newRenderer
+                     queue:nil
+                usingBlock:^(NSNotification*) {
+                  [weakSelf scheduleRendererRecoveryForGeneration:generation];
+                }];
+#pragma clang diagnostic pop
+  } else {
+    dispatch_async(_renderQueue, ^{
+      [self flushRendererLockedWithRemoval:YES generation:generation];
+    });
+  }
+}
+
+- (void)startPiPForGeneration:(uint64_t)generation {
+  if (_activeGeneration != generation || !_pipController) {
+    [self notifyFailedToStartForGeneration:generation];
+    return;
+  }
+  if (![AVPictureInPictureController isPictureInPictureSupported]) {
+    [self notifyFailedToStartForGeneration:generation];
+    return;
+  }
+
+  _startAttemptGeneration = generation;
+  _startAttemptActive = YES;
+  [_pipController invalidatePlaybackState];
+
+  if (_pipController.isPictureInPictureActive) {
+    [self notifyDidStartForGeneration:generation];
+    return;
+  }
+
+  if (_pipController.isPictureInPicturePossible) {
+    _waitingForPossible = NO;
+    [_pipController startPictureInPicture];
+  } else {
+    _waitingForPossible = YES;
+  }
+
+  __weak CuriumPiPBridge* weakSelf = self;
+  dispatch_after(
+      dispatch_time(DISPATCH_TIME_NOW,
+                    static_cast<int64_t>(kStartTimeoutSeconds * NSEC_PER_SEC)),
+      dispatch_get_main_queue(), ^{
+        CuriumPiPBridge* strongSelf = weakSelf;
+        if (!strongSelf || strongSelf->_activeGeneration != generation) {
+          return;
+        }
+        if (!strongSelf->_pipActive) {
+          strongSelf->_waitingForPossible = NO;
+          [strongSelf notifyFailedToStartForGeneration:generation];
+        }
+      });
+}
+
+- (void)stopPiPAndDetach:(BOOL)removeImage {
+  const uint64_t nextGen = _activeGeneration + 1;
+  _activeGeneration = nextGen;
+  _atomicGeneration.store(nextGen, std::memory_order_release);
+  _waitingForPossible = NO;
+  _startAttemptActive = NO;
+  _pipActive = NO;
+
+  {
+    base::AutoLock lock(_slotLock);
+    _latestSlot.reset();
+  }
+
+  if (_pipController && _pipController.isPictureInPictureActive) {
+    [_pipController stopPictureInPicture];
+  }
+
+  dispatch_async(_renderQueue, ^{
+    self->_renderTimebasePrimed = NO;
+    self->_swPool.Reset();
+    if (self->_renderRenderer) {
+#pragma clang diagnostic push
+#pragma clang diagnostic ignored "-Wdeprecated-declarations"
+      [self->_renderRenderer flushWithRemovalOfDisplayedImage:removeImage
+                                            completionHandler:nil];
+#pragma clang diagnostic pop
+    }
+  });
+}
+
+- (void)updatePlaybackPaused:(BOOL)paused
+                    position:
+                        (std::optional<media_session::MediaPosition>)position {
+  _mainPlaybackPaused = paused;
+  const bool hasPos = position.has_value();
+  double posSec = _mainPositionSeconds;
+  double rate = paused ? 0.0 : 1.0;
+  if (hasPos) {
+    const base::TimeDelta dur = position->duration();
+    _mainDurationSeconds = dur.is_max() ? INFINITY : dur.InSecondsF();
+    rate = paused ? 0.0 : position->playback_rate();
+    _mainPlaybackRate = rate;
+    posSec = position->GetPosition().InSecondsF();
+    _mainPositionSeconds = posSec;
+    _mainPositionTimestamp = base::TimeTicks::Now();
+  }
+  dispatch_async(_renderQueue, ^{
+    self->_renderPlaybackPaused = paused;
+    self->_renderPlaybackRate = rate;
+    if (self->_renderTimebase && self->_renderTimebasePrimed) {
+      if (hasPos) {
+        CMTime anchor = CMTimeMakeWithSeconds(posSec, 1000000);
+        CMTimebaseSetRateAndAnchorTime(
+            self->_renderTimebase.get(), rate, anchor,
+            CMClockGetTime(CMClockGetHostTimeClock()));
+      } else {
+        CMTimebaseSetRate(self->_renderTimebase.get(), rate);
+      }
+    }
+  });
+  [_pipController invalidatePlaybackState];
+}
+
+- (void)enqueueLatestFrame:(scoped_refptr<media::VideoFrame>)frame
+                  hwBuffer:
+                      (base::apple::ScopedCFTypeRef<CVPixelBufferRef>)hwBuffer
+                generation:(uint64_t)generation {
+  if (!frame ||
+      _atomicGeneration.load(std::memory_order_acquire) != generation) {
+    return;
+  }
+  if (frame->timestamp() == media::kNoTimestamp) {
+    return;
+  }
+
+  bool shouldSchedule = false;
+  {
+    base::AutoLock lock(_slotLock);
+    _latestSlot = PendingFrameSlot{std::move(frame), std::move(hwBuffer),
+                                   generation};
+    if (!_drainScheduled) {
+      _drainScheduled = true;
+      shouldSchedule = true;
+    }
+  }
+  if (shouldSchedule) {
+    __weak CuriumPiPBridge* weakSelf = self;
+    dispatch_async(_renderQueue, ^{
+      [weakSelf drainLatestFrameOnRenderQueue];
+    });
+  }
+}
+
+- (void)drainLatestFrameOnRenderQueue {
+  std::optional<PendingFrameSlot> slot;
+  {
+    base::AutoLock lock(_slotLock);
+    slot = std::move(_latestSlot);
+    _latestSlot.reset();
+    _drainScheduled = false;
+  }
+  if (!slot.has_value() || !slot->frame) {
+    return;
+  }
+  if (_atomicGeneration.load(std::memory_order_acquire) != slot->generation) {
+    return;
+  }
+  AVSampleBufferVideoRenderer* renderer = _renderRenderer;
+  if (!renderer || _isFlushing) {
+    return;
+  }
+
+#pragma clang diagnostic push
+#pragma clang diagnostic ignored "-Wdeprecated-declarations"
+  const BOOL needsFlush =
+      renderer.status == AVQueuedSampleBufferRenderingStatusFailed ||
+      renderer.requiresFlushToResumeDecoding;
+#pragma clang diagnostic pop
+  if (needsFlush) {
+    [self flushRendererLockedWithRemoval:NO generation:slot->generation];
+    return;
+  }
+  if (!renderer.isReadyForMoreMediaData) {
+    return;
+  }
+
+  base::apple::ScopedCFTypeRef<CVPixelBufferRef> pixelBuffer =
+      std::move(slot->hw_buffer);
+  if (!pixelBuffer) {
+    if (slot->frame->HasDirectCpuAccess()) {
+      pixelBuffer = _swPool.Convert(*slot->frame);
+    }
+  }
+  if (!pixelBuffer) {
+    return;
+  }
+
+  CMVideoFormatDescriptionRef rawDesc = nullptr;
+  if (CMVideoFormatDescriptionCreateForImageBuffer(
+          kCFAllocatorDefault, pixelBuffer.get(), &rawDesc) != noErr ||
+      !rawDesc) {
+    return;
+  }
+  base::apple::ScopedCFTypeRef<CMVideoFormatDescriptionRef> formatDesc(rawDesc);
+
+  const CMTime pts = CMTimeMake(slot->frame->timestamp().InMicroseconds(), 1000000);
+  CMTime duration = kCMTimeInvalid;
+  if (slot->frame->metadata().frame_duration.has_value() &&
+      slot->frame->metadata().frame_duration->is_positive()) {
+    duration = CMTimeMake(
+        slot->frame->metadata().frame_duration->InMicroseconds(), 1000000);
+  }
+  CMSampleTimingInfo timing = {duration, pts, kCMTimeInvalid};
+
+  CMSampleBufferRef rawSample = nullptr;
+  if (CMSampleBufferCreateReadyWithImageBuffer(
+          kCFAllocatorDefault, pixelBuffer.get(), formatDesc.get(), &timing,
+          &rawSample) != noErr ||
+      !rawSample) {
+    return;
+  }
+  base::apple::ScopedCFTypeRef<CMSampleBufferRef> sample(rawSample);
+
+  if (_renderTimebase) {
+    const double effRate = _renderPlaybackPaused ? 0.0 : _renderPlaybackRate;
+    if (!_renderTimebasePrimed) {
+      CMTimebaseSetRateAndAnchorTime(_renderTimebase.get(), effRate, pts,
+                                     CMClockGetTime(CMClockGetHostTimeClock()));
+      _renderTimebasePrimed = YES;
+    } else {
+      const CMTime currentTb = CMTimebaseGetTime(_renderTimebase.get());
+      const double drift =
+          std::fabs(CMTimeGetSeconds(CMTimeSubtract(pts, currentTb)));
+      if (drift > 0.35) {
+        CMTimebaseSetRateAndAnchorTime(
+            _renderTimebase.get(), effRate, pts,
+            CMClockGetTime(CMClockGetHostTimeClock()));
+      }
+    }
+  }
+
+  [renderer enqueueSampleBuffer:sample.get()];
+  _consecutiveFailures = 0;
+}
+
+- (void)scheduleRendererRecoveryForGeneration:(uint64_t)generation {
+  __weak CuriumPiPBridge* weakSelf = self;
+  dispatch_async(_renderQueue, ^{
+    [weakSelf flushRendererLockedWithRemoval:NO generation:generation];
+  });
+}
+
+- (void)flushRendererLockedWithRemoval:(BOOL)removeImage
+                            generation:(uint64_t)generation {
+  if (_atomicGeneration.load(std::memory_order_acquire) != generation ||
+      !_renderRenderer || _isFlushing) {
+    return;
+  }
+  if (++_consecutiveFailures > kMaxConsecutiveDecodeFailures) {
+    dispatch_async(dispatch_get_main_queue(), ^{
+      if (self->_activeGeneration == generation && self->_pipActive) {
+        [self->_pipController stopPictureInPicture];
+      }
+    });
+    return;
+  }
+  _isFlushing = YES;
+  _renderTimebasePrimed = NO;
+  __weak CuriumPiPBridge* weakSelf = self;
+  dispatch_queue_t renderQueue = _renderQueue;
+#pragma clang diagnostic push
+#pragma clang diagnostic ignored "-Wdeprecated-declarations"
+  [_renderRenderer flushWithRemovalOfDisplayedImage:removeImage
+                            completionHandler:^{
+                              dispatch_async(renderQueue, ^{
+                                CuriumPiPBridge* strongSelf = weakSelf;
+                                if (!strongSelf ||
+                                    strongSelf->_atomicGeneration.load(
+                                        std::memory_order_acquire) !=
+                                        generation) {
+                                  return;
+                                }
+                                strongSelf->_isFlushing = NO;
+                              });
+                            }];
+#pragma clang diagnostic pop
+}
+
+- (void)observeValueForKeyPath:(NSString*)keyPath
+                      ofObject:(id)object
+                        change:(NSDictionary<NSKeyValueChangeKey, id>*)change
+                       context:(void*)context {
+  if (object == _pipController &&
+      [keyPath isEqualToString:@"pictureInPicturePossible"]) {
+    if (_waitingForPossible && _pipController.isPictureInPicturePossible) {
+      _waitingForPossible = NO;
+      [_pipController startPictureInPicture];
+    }
+    return;
+  }
+  [super observeValueForKeyPath:keyPath
+                       ofObject:object
+                         change:change
+                        context:context];
+}
+
+- (void)notifyDidStartForGeneration:(uint64_t)generation {
+  _pipActive = YES;
+  _waitingForPossible = NO;
+  const gfx::Size sz(static_cast<int>(_hostView.bounds.size.width),
+                     static_cast<int>(_hostView.bounds.size.height));
+  auto owner = _owner;
+  _uiRunner->PostTask(FROM_HERE, base::BindOnce(
+                                     &web::IOSVideoOverlayWindow::OnAVKitDidStart,
+                                     owner, generation, sz));
+}
+
+- (void)notifyFailedToStartForGeneration:(uint64_t)generation {
+  _pipActive = NO;
+  _waitingForPossible = NO;
+  auto owner = _owner;
+  _uiRunner->PostTask(
+      FROM_HERE,
+      base::BindOnce(&web::IOSVideoOverlayWindow::OnAVKitFailedToStart, owner,
+                     generation));
+}
+
+- (void)notifySceneBackgrounded:(BOOL)backgrounded {
+  auto owner = _owner;
+  _uiRunner->PostTask(
+      FROM_HERE,
+      base::BindOnce(&web::IOSVideoOverlayWindow::OnSceneBackgroundChanged,
+                     owner, backgrounded));
+}
+
+#pragma mark - AVPictureInPictureControllerDelegate
+
+- (void)pictureInPictureControllerDidStartPictureInPicture:
+    (AVPictureInPictureController*)pictureInPictureController {
+  if (pictureInPictureController != _pipController || !_startAttemptActive ||
+      _activeGeneration != _startAttemptGeneration) {
+    [pictureInPictureController stopPictureInPicture];
+    return;
+  }
+  _startAttemptActive = NO;
+  [self notifyDidStartForGeneration:_startAttemptGeneration];
+}
+
+- (void)pictureInPictureController:
+            (AVPictureInPictureController*)pictureInPictureController
+    failedToStartPictureInPictureWithError:(NSError*)error {
+  LOG(WARNING) << "AVPictureInPictureController failed to start: "
+               << (error ? error.localizedDescription.UTF8String : "unknown");
+  if (pictureInPictureController != _pipController || !_startAttemptActive ||
+      _activeGeneration != _startAttemptGeneration) {
+    return;
+  }
+  _startAttemptActive = NO;
+  [self notifyFailedToStartForGeneration:_startAttemptGeneration];
+}
+
+- (void)pictureInPictureControllerDidStopPictureInPicture:
+    (AVPictureInPictureController*)pictureInPictureController {
+  if (pictureInPictureController != _pipController) {
+    return;
+  }
+  const uint64_t gen = _activeGeneration;
+  _startAttemptActive = NO;
+  _pipActive = NO;
+  auto owner = _owner;
+  _uiRunner->PostTask(
+      FROM_HERE,
+      base::BindOnce(&web::IOSVideoOverlayWindow::OnAVKitDidStop, owner, gen,
+                     /*should_pause_video=*/false));
+}
+
+- (void)pictureInPictureController:
+            (AVPictureInPictureController*)pictureInPictureController
+    restoreUserInterfaceForPictureInPictureStopWithCompletionHandler:
+        (void (^)(BOOL restored))completionHandler {
+  auto owner = _owner;
+  __block void (^completion)(BOOL) = [completionHandler copy];
+  _uiRunner->PostTask(
+      FROM_HERE,
+      base::BindOnce(&web::IOSVideoOverlayWindow::OnAVKitRestoreUI, owner,
+                     base::BindOnce(^(bool restored) {
+                       if (completion) {
+                         completion(restored);
+                       }
+                     })));
+}
+
+#pragma mark - AVPictureInPictureSampleBufferPlaybackDelegate
+
+- (void)pictureInPictureController:
+            (AVPictureInPictureController*)pictureInPictureController
+                        setPlaying:(BOOL)playing {
+  auto owner = _owner;
+  _uiRunner->PostTask(
+      FROM_HERE,
+      base::BindOnce(&web::IOSVideoOverlayWindow::OnAVKitSetPlaying, owner,
+                     playing));
+}
+
+- (CMTimeRange)pictureInPictureControllerTimeRangeForPlayback:
+    (AVPictureInPictureController*)pictureInPictureController {
+  if (std::isnan(_mainDurationSeconds) || std::isinf(_mainDurationSeconds)) {
+    return CMTimeRangeMake(kCMTimeZero, kCMTimePositiveInfinity);
+  }
+  double estPos = _mainPositionSeconds;
+  if (!_mainPlaybackPaused && !_mainPositionTimestamp.is_null()) {
+    estPos += (base::TimeTicks::Now() - _mainPositionTimestamp).InSecondsF() *
+              _mainPlaybackRate;
+  }
+  const double span = std::max(std::max(0.0, _mainDurationSeconds), estPos);
+  return CMTimeRangeMake(kCMTimeZero, CMTimeMakeWithSeconds(span, 1000));
+}
+
+- (BOOL)pictureInPictureControllerIsPlaybackPaused:
+    (AVPictureInPictureController*)pictureInPictureController {
+  return _mainPlaybackPaused;
+}
+
+- (void)pictureInPictureController:
+            (AVPictureInPictureController*)pictureInPictureController
+         didTransitionToRenderSize:(CMVideoDimensions)newRenderSize {
+  if (newRenderSize.width <= 0 || newRenderSize.height <= 0) {
+    return;
+  }
+  const CGFloat scale =
+      _windowScene ? _windowScene.screen.scale : UIScreen.mainScreen.scale;
+  const int ptsW = std::max(
+      1, static_cast<int>(std::lround(newRenderSize.width / std::max<CGFloat>(scale, 1.0))));
+  const int ptsH = std::max(
+      1, static_cast<int>(std::lround(newRenderSize.height / std::max<CGFloat>(scale, 1.0))));
+  auto owner = _owner;
+  _uiRunner->PostTask(
+      FROM_HERE,
+      base::BindOnce(&web::IOSVideoOverlayWindow::OnAVKitRenderSizeChanged,
+                     owner, gfx::Size(ptsW, ptsH)));
+}
+
+- (void)pictureInPictureController:
+            (AVPictureInPictureController*)pictureInPictureController
+                    skipByInterval:(CMTime)skipInterval
+                 completionHandler:(void (^)(void))completionHandler {
+  if (completionHandler) {
+    completionHandler();
+  }
+}
