+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#ifndef MEDIA_BASE_MAC_IOS_PIP_BUFFER_REGISTRY_H_
+#define MEDIA_BASE_MAC_IOS_PIP_BUFFER_REGISTRY_H_
+
+#include <CoreVideo/CoreVideo.h>
+
+#include "base/apple/scoped_cftyperef.h"
+#include "base/unguessable_token.h"
+#include "gpu/command_buffer/common/mailbox.h"
+#include "media/base/media_export.h"
+
+namespace media {
+
+// Registers a retained VideoToolbox CVPixelBuffer alongside its originating
+// SharedImage mailbox so an in-process iOS Picture-in-Picture consumer can
+// safely acquire its own reference after Mojo VideoFrame deserialization.
+MEDIA_EXPORT void RegisterIOSPiPPixelBuffer(
+    const base::UnguessableToken& token,
+    base::apple::ScopedCFTypeRef<CVPixelBufferRef> pixel_buffer,
+    const gpu::Mailbox& mailbox);
+
+// Returns a newly retained CVPixelBufferRef iff |token| is registered and its
+// originating mailbox matches |expected_mailbox|.
+MEDIA_EXPORT base::apple::ScopedCFTypeRef<CVPixelBufferRef>
+CopyIOSPiPPixelBuffer(const base::UnguessableToken& token,
+                      const gpu::Mailbox& expected_mailbox);
+
+// Removes |token| from the registry and releases the registry's reference
+// outside the internal lock. Safe to call on any sequence.
+MEDIA_EXPORT void UnregisterIOSPiPPixelBuffer(
+    const base::UnguessableToken& token);
+
+}  // namespace media
+
+#endif  // MEDIA_BASE_MAC_IOS_PIP_BUFFER_REGISTRY_H_
diff --git a/media/base/mac/ios_pip_buffer_registry.mm b/media/base/mac/ios_pip_buffer_registry.mm
new file mode 100644
index 0000000..63381fc
--- /dev/null
+++ b/media/base/mac/ios_pip_buffer_registry.mm
@@ -0,0 +1,108 @@
+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "media/base/mac/ios_pip_buffer_registry.h"
+
+#include <unordered_map>
+#include <utility>
+
+#include "base/no_destructor.h"
+#include "base/synchronization/lock.h"
+
+namespace media {
+
+namespace {
+
+struct BufferEntry {
+  base::apple::ScopedCFTypeRef<CVPixelBufferRef> pixel_buffer;
+  gpu::Mailbox mailbox;
+};
+
+class IOSPiPBufferRegistry {
+ public:
+  void Register(const base::UnguessableToken& token,
+                base::apple::ScopedCFTypeRef<CVPixelBufferRef> pixel_buffer,
+                const gpu::Mailbox& mailbox) {
+    if (token.is_empty() || !pixel_buffer) {
+      return;
+    }
+    base::apple::ScopedCFTypeRef<CVPixelBufferRef> evicted;
+    {
+      base::AutoLock auto_lock(lock_);
+      auto it = entries_.find(token);
+      if (it != entries_.end()) {
+        evicted = std::move(it->second.pixel_buffer);
+        it->second.pixel_buffer = std::move(pixel_buffer);
+        it->second.mailbox = mailbox;
+      } else {
+        entries_.emplace(token, BufferEntry{std::move(pixel_buffer), mailbox});
+      }
+    }
+  }
+
+  base::apple::ScopedCFTypeRef<CVPixelBufferRef> Copy(
+      const base::UnguessableToken& token,
+      const gpu::Mailbox& expected_mailbox) {
+    if (token.is_empty() || expected_mailbox.IsZero()) {
+      return base::apple::ScopedCFTypeRef<CVPixelBufferRef>();
+    }
+    base::AutoLock auto_lock(lock_);
+    auto it = entries_.find(token);
+    if (it == entries_.end() || it->second.mailbox != expected_mailbox ||
+        !it->second.pixel_buffer) {
+      return base::apple::ScopedCFTypeRef<CVPixelBufferRef>();
+    }
+    return base::apple::ScopedCFTypeRef<CVPixelBufferRef>(
+        it->second.pixel_buffer.get(), base::scoped_policy::RETAIN);
+  }
+
+  void Unregister(const base::UnguessableToken& token) {
+    if (token.is_empty()) {
+      return;
+    }
+    base::apple::ScopedCFTypeRef<CVPixelBufferRef> released;
+    {
+      base::AutoLock auto_lock(lock_);
+      auto it = entries_.find(token);
+      if (it != entries_.end()) {
+        released = std::move(it->second.pixel_buffer);
+        entries_.erase(it);
+      }
+    }
+    // |released| drops its CF reference after unlocking.
+  }
+
+ private:
+  base::Lock lock_;
+  std::unordered_map<base::UnguessableToken,
+                     BufferEntry,
+                     base::UnguessableTokenHash>
+      entries_ GUARDED_BY(lock_);
+};
+
+IOSPiPBufferRegistry& GetRegistry() {
+  static base::NoDestructor<IOSPiPBufferRegistry> instance;
+  return *instance;
+}
+
+}  // namespace
+
+void RegisterIOSPiPPixelBuffer(
+    const base::UnguessableToken& token,
+    base::apple::ScopedCFTypeRef<CVPixelBufferRef> pixel_buffer,
+    const gpu::Mailbox& mailbox) {
+  GetRegistry().Register(token, std::move(pixel_buffer), mailbox);
+}
+
+base::apple::ScopedCFTypeRef<CVPixelBufferRef> CopyIOSPiPPixelBuffer(
+    const base::UnguessableToken& token,
+    const gpu::Mailbox& expected_mailbox) {
+  return GetRegistry().Copy(token, expected_mailbox);
+}
+
+void UnregisterIOSPiPPixelBuffer(const base::UnguessableToken& token) {
+  GetRegistry().Unregister(token);
+}
+
+}  // namespace media
