+namespace web {
+
+struct IOSVideoOverlayWindow::Impl {
+  CuriumPiPBridge* bridge = nil;
+};
+
+IOSVideoOverlayWindow::IOSVideoOverlayWindow(
+    content::VideoPictureInPictureWindowController* controller)
+    : controller_(controller), impl_(std::make_unique<Impl>()) {
+  impl_->bridge = [[CuriumPiPBridge alloc]
+      initWithOwner:weak_ptr_factory_.GetWeakPtr()
+           uiRunner:base::SequencedTaskRunner::GetCurrentDefault()];
+}
+
+IOSVideoOverlayWindow::~IOSVideoOverlayWindow() {
+  UnregisterCurrentSessionSink();
+  CompletePendingStart(/*success=*/false, gfx::Size());
+  [impl_->bridge stopPiPAndDetach:YES];
+  [impl_->bridge teardownObserversAndViews];
+}
+
+bool IOSVideoOverlayWindow::IsActive() const {
+  return is_visible_;
+}
+
+void IOSVideoOverlayWindow::Close() {
+  CancelPendingStart();
+  UnregisterCurrentSessionSink();
+  is_visible_ = false;
+  [impl_->bridge stopPiPAndDetach:YES];
+}
+
+void IOSVideoOverlayWindow::ShowInactive() {
+  is_visible_ = true;
+}
+
+void IOSVideoOverlayWindow::Hide() {
+  CancelPendingStart();
+  UnregisterCurrentSessionSink();
+  is_visible_ = false;
+  [impl_->bridge stopPiPAndDetach:YES];
+}
+
+bool IOSVideoOverlayWindow::IsVisible() const {
+  return is_visible_;
+}
+
+gfx::Rect IOSVideoOverlayWindow::GetBounds() {
+  const gfx::Size sz = render_size_.IsEmpty() ? natural_size_ : render_size_;
+  return gfx::Rect(sz);
+}
+
+void IOSVideoOverlayWindow::UpdateNaturalSize(const gfx::Size& natural_size) {
+  if (!natural_size.IsEmpty()) {
+    natural_size_ = natural_size;
+  }
+}
