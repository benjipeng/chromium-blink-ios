+UIWindow* FindTargetWindow(
+    content::VideoPictureInPictureWindowController* controller) {
+  if (controller && controller->GetWebContents()) {
+    UIView* native_view = controller->GetWebContents()->GetNativeView().Get();
+    if (native_view && native_view.window) {
+      return native_view.window;
+    }
+  }
+  for (UIScene* scene in UIApplication.sharedApplication.connectedScenes) {
+    UIWindowScene* ws = base::apple::ObjCCast<UIWindowScene>(scene);
+    if (!ws) {
+      continue;
+    }
+    if (ws.activationState == UISceneActivationStateForegroundActive ||
+        ws.activationState == UISceneActivationStateForegroundInactive) {
+      for (UIWindow* w in ws.windows) {
+        if (w.isKeyWindow && w.rootViewController.view) {
+          return w;
+        }
+      }
+      for (UIWindow* w in ws.windows) {
+        if (!w.hidden && w.rootViewController.view) {
+          return w;
+        }
+      }
+    }
+  }
+  return nil;
+}
