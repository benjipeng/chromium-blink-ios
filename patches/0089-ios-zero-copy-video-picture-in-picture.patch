+#if BUILDFLAG(IS_IOS)
+bool WebMediaPlayerImpl::AttachSystemPictureInPicture(
+    const base::UnguessableToken& session) {
+  DCHECK(main_task_runner_->BelongsToCurrentThread());
+  if (!compositor_ || !vfc_task_runner_ || session.is_empty()) {
+    return false;
+  }
+  ios_pip_session_token_ = session;
+  PostCrossThreadTask(
+      *vfc_task_runner_, FROM_HERE,
+      CrossThreadBindOnce(&VideoFrameCompositor::AttachSystemPictureInPicture,
+                          CrossThreadUnretained(compositor_.get()), session));
+  return true;
+}
+
+void WebMediaPlayerImpl::SetSystemPictureInPictureBackgrounded(
+    const base::UnguessableToken& session,
+    bool backgrounded) {
+  DCHECK(main_task_runner_->BelongsToCurrentThread());
+  if (!compositor_ || !vfc_task_runner_) {
+    return;
+  }
+  PostCrossThreadTask(
+      *vfc_task_runner_, FROM_HERE,
+      CrossThreadBindOnce(
+          &VideoFrameCompositor::SetSystemPictureInPictureBackgrounded,
+          CrossThreadUnretained(compositor_.get()), session, backgrounded));
+}
+
+void WebMediaPlayerImpl::DetachSystemPictureInPicture(
+    const base::UnguessableToken& session) {
+  DCHECK(main_task_runner_->BelongsToCurrentThread());
+  if (ios_pip_session_token_.has_value() && *ios_pip_session_token_ == session) {
+    ios_pip_session_token_.reset();
+  }
+  if (!compositor_ || !vfc_task_runner_) {
+    return;
+  }
+  PostCrossThreadTask(
+      *vfc_task_runner_, FROM_HERE,
+      CrossThreadBindOnce(&VideoFrameCompositor::DetachSystemPictureInPicture,
+                          CrossThreadUnretained(compositor_.get()), session));
+}
+#endif
