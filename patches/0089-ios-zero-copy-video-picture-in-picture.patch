+void ApplyColorSpaceAttachments(CVPixelBufferRef buffer,
+                                const media::VideoFrame& frame) {
+  const gfx::ColorSpace cs = frame.ColorSpace();
+  if (!cs.IsValid()) {
+    return;
+  }
+  CFStringRef primaries = nullptr;
+  switch (cs.GetPrimaryID()) {
+    case gfx::ColorSpace::PrimaryID::BT709:
+      primaries = kCVImageBufferColorPrimaries_ITU_R_709_2;
+      break;
+    case gfx::ColorSpace::PrimaryID::BT2020:
+      primaries = kCVImageBufferColorPrimaries_ITU_R_2020;
+      break;
+    case gfx::ColorSpace::PrimaryID::P3:
+      primaries = kCVImageBufferColorPrimaries_P3_D65;
+      break;
+    default:
+      break;
+  }
+  if (primaries) {
+    CVBufferSetAttachment(buffer, kCVImageBufferColorPrimariesKey, primaries,
+                          kCVAttachmentMode_ShouldPropagate);
+  }
+
+  CFStringRef transfer = nullptr;
+  switch (cs.GetTransferID()) {
+    case gfx::ColorSpace::TransferID::BT709:
+    case gfx::ColorSpace::TransferID::SMPTE170M:
+      transfer = kCVImageBufferTransferFunction_ITU_R_709_2;
+      break;
+    case gfx::ColorSpace::TransferID::PQ:
+      transfer = kCVImageBufferTransferFunction_SMPTE_ST_2084_PQ;
+      break;
+    case gfx::ColorSpace::TransferID::HLG:
+      transfer = kCVImageBufferTransferFunction_ITU_R_2100_HLG;
+      break;
+    case gfx::ColorSpace::TransferID::SRGB:
+      transfer = kCVImageBufferTransferFunction_sRGB;
+      break;
+    default:
+      break;
+  }
+  if (transfer) {
+    CVBufferSetAttachment(buffer, kCVImageBufferTransferFunctionKey, transfer,
+                          kCVAttachmentMode_ShouldPropagate);
+  }
+
+  CFStringRef matrix = nullptr;
+  switch (cs.GetMatrixID()) {
+    case gfx::ColorSpace::MatrixID::BT709:
+      matrix = kCVImageBufferYCbCrMatrix_ITU_R_709_2;
+      break;
+    case gfx::ColorSpace::MatrixID::BT2020_NCL:
+      matrix = kCVImageBufferYCbCrMatrix_ITU_R_2020;
+      break;
+    case gfx::ColorSpace::MatrixID::SMPTE170M:
+    case gfx::ColorSpace::MatrixID::BT470BG:
+      matrix = kCVImageBufferYCbCrMatrix_ITU_R_601_4;
+      break;
+    default:
+      break;
+  }
+  if (matrix) {
+    CVBufferSetAttachment(buffer, kCVImageBufferYCbCrMatrixKey, matrix,
+                          kCVAttachmentMode_ShouldPropagate);
+  }
+}
+
+void ApplyCleanApertureAndAspect(CVPixelBufferRef buffer,
+                                 const media::VideoFrame& frame) {
+  const gfx::Rect vis = frame.visible_rect();
+  const int coded_w = static_cast<int>(CVPixelBufferGetWidth(buffer));
+  const int coded_h = static_cast<int>(CVPixelBufferGetHeight(buffer));
+  if (vis.width() > 0 && vis.height() > 0 &&
+      (vis.x() != 0 || vis.y() != 0 || vis.width() != coded_w ||
+       vis.height() != coded_h)) {
+    const double horiz_offset =
+        (vis.x() + vis.width() * 0.5) - (coded_w * 0.5);
+    const double vert_offset =
+        (vis.y() + vis.height() * 0.5) - (coded_h * 0.5);
+    NSDictionary* clean_aperture = @{
+      (__bridge NSString*)kCVImageBufferCleanApertureWidthKey : @(vis.width()),
+      (__bridge NSString*)kCVImageBufferCleanApertureHeightKey : @(vis.height()),
+      (__bridge NSString*)
+          kCVImageBufferCleanApertureHorizontalOffsetKey : @(horiz_offset),
+      (__bridge NSString*)
+          kCVImageBufferCleanApertureVerticalOffsetKey : @(vert_offset),
+    };
+    CVBufferSetAttachment(buffer, kCVImageBufferCleanApertureKey,
+                          (__bridge CFDictionaryRef)clean_aperture,
+                          kCVAttachmentMode_ShouldPropagate);
+  }
+
+  const gfx::Size nat = frame.natural_size();
+  if (vis.width() > 0 && vis.height() > 0 && nat.width() > 0 &&
+      nat.height() > 0 && (nat.width() != vis.width() ||
+                           nat.height() != vis.height())) {
+    const int64_t h_spacing =
+        static_cast<int64_t>(nat.width()) * vis.height();
+    const int64_t v_spacing =
+        static_cast<int64_t>(nat.height()) * vis.width();
+    if (h_spacing > 0 && v_spacing > 0) {
+      NSDictionary* par = @{
+        (__bridge NSString*)
+            kCVImageBufferPixelAspectRatioHorizontalSpacingKey : @(h_spacing),
+        (__bridge NSString*)
+            kCVImageBufferPixelAspectRatioVerticalSpacingKey : @(v_spacing),
+      };
+      CVBufferSetAttachment(buffer, kCVImageBufferPixelAspectRatioKey,
+                            (__bridge CFDictionaryRef)par,
+                            kCVAttachmentMode_ShouldPropagate);
+    }
+  }
+}
