+// Native iOS VideoOverlayWindow backed by AVSampleBufferDisplayLayer +
+// AVPictureInPictureController. Consumes zero-copy VideoToolbox CVPixelBuffers
+// (with bounded pooled NV12/P010 software fallback) directly in-process.
+class IOSVideoOverlayWindow final : public content::VideoOverlayWindow {
+ public:
+  explicit IOSVideoOverlayWindow(
+      content::VideoPictureInPictureWindowController* controller);
+  IOSVideoOverlayWindow(const IOSVideoOverlayWindow&) = delete;
+  IOSVideoOverlayWindow& operator=(const IOSVideoOverlayWindow&) = delete;
+  ~IOSVideoOverlayWindow() override;
+
+  // content::VideoOverlayWindow:
+  bool IsActive() const override;
+  void Close() override;
+  void ShowInactive() override;
+  void Hide() override;
+  bool IsVisible() const override;
+  gfx::Rect GetBounds() override;
+  void UpdateNaturalSize(const gfx::Size& natural_size) override;
+  void SetPlaybackState(PlaybackState playback_state) override;
+  void SetPlayPauseButtonVisibility(bool is_visible) override;
+  void SetSkipAdButtonVisibility(bool is_visible) override;
+  void SetNextTrackButtonVisibility(bool is_visible) override;
+  void SetPreviousTrackButtonVisibility(bool is_visible) override;
+  void SetHidePictureInPictureButtonVisibility(bool is_visible) override;
+  void SetMicrophoneMuted(bool muted) override;
+  void SetCameraState(bool turned_on) override;
+  void SetMediaMuted(bool muted) override;
+  void SetToggleMicrophoneButtonVisibility(bool is_visible) override;
+  void SetToggleCameraButtonVisibility(bool is_visible) override;
+  void SetHangUpButtonVisibility(bool is_visible) override;
+  void SetNextSlideButtonVisibility(bool is_visible) override;
+  void SetPreviousSlideButtonVisibility(bool is_visible) override;
+  void SetMediaPosition(const media_session::MediaPosition& position) override;
+  void SetSourceTitle(const std::u16string& source_title) override;
+  void SetFaviconImages(
+      const std::vector<media_session::MediaImage>& images) override;
+  void SetSurfaceId(const viz::SurfaceId& surface_id) override;
+  void SetPlaybackControlsVisibility(bool is_visible) override;
+  void SetImmersiveVideoOptions(
+      const content::ImmersiveOptions& options) override;
+
+  bool SupportsAsyncStart() const override;
+  void PrepareSystemPictureInPicture(
+      const base::UnguessableToken& session_token) override;
+  void StartSystemPictureInPicture(
+      const base::UnguessableToken& session_token,
+      base::OnceCallback<void(bool success, const gfx::Size& window_size)>
+          callback) override;
+  void SetSystemPiPBackgroundCallback(
+      base::RepeatingCallback<void(bool backgrounded)> callback) override;
+  void CancelPendingStart() override;
+
+  // Callbacks invoked on the main/UI thread by the Objective-C AVKit bridge.
+  void OnAVKitDidStart(uint64_t generation, const gfx::Size& render_size);
+  void OnAVKitFailedToStart(uint64_t generation);
+  void OnAVKitDidStop(uint64_t generation, bool should_pause_video);
+  void OnAVKitSetPlaying(bool playing);
+  void OnAVKitRenderSizeChanged(const gfx::Size& render_size);
+  void OnAVKitRestoreUI(base::OnceCallback<void(bool)> completion);
+  void OnSceneBackgroundChanged(bool backgrounded);
+
+ private:
+  struct Impl;
+
+  void CompletePendingStart(bool success, const gfx::Size& size);
+  void UnregisterCurrentSessionSink();
+
+  raw_ptr<content::VideoPictureInPictureWindowController> controller_;
+  std::unique_ptr<Impl> impl_;
+  std::optional<base::UnguessableToken> session_token_;
+  uint64_t generation_ = 0;
+  bool is_visible_ = false;
+  bool is_starting_ = false;
+  gfx::Size natural_size_{320, 180};
+  gfx::Size render_size_;
+  PlaybackState playback_state_ = PlaybackState::kPlaying;
+  std::optional<media_session::MediaPosition> media_position_;
+  base::OnceCallback<void(bool, const gfx::Size&)> pending_start_callback_;
+  base::RepeatingCallback<void(bool)> background_callback_;
+  base::WeakPtrFactory<IOSVideoOverlayWindow> weak_ptr_factory_{this};
+};
