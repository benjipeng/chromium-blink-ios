+class SoftwarePixelBufferPool {
+ public:
+  SoftwarePixelBufferPool() = default;
+  ~SoftwarePixelBufferPool() { Reset(); }
+
+  base::apple::ScopedCFTypeRef<CVPixelBufferRef> Convert(
+      const media::VideoFrame& frame) {
+    if (!frame.HasDirectCpuAccess()) {
+      return base::apple::ScopedCFTypeRef<CVPixelBufferRef>();
+    }
+    const media::VideoPixelFormat fmt = frame.format();
+    const bool is_10bit = (fmt == media::PIXEL_FORMAT_YUV420P10 ||
+                           fmt == media::PIXEL_FORMAT_P010LE);
+    const bool is_8bit = (fmt == media::PIXEL_FORMAT_I420 ||
+                          fmt == media::PIXEL_FORMAT_I420A ||
+                          fmt == media::PIXEL_FORMAT_NV12);
+    if (!is_8bit && !is_10bit) {
+      return base::apple::ScopedCFTypeRef<CVPixelBufferRef>();
+    }
+
+    const int width = frame.coded_size().width();
+    const int height = frame.coded_size().height();
+    if (width <= 0 || height <= 0) {
+      return base::apple::ScopedCFTypeRef<CVPixelBufferRef>();
+    }
+
+    const bool full_range =
+        frame.ColorSpace().GetRangeID() == gfx::ColorSpace::RangeID::FULL;
+    OSType cv_fmt;
+    if (is_10bit) {
+      cv_fmt = full_range ? kCVPixelFormatType_420YpCbCr10BiPlanarFullRange
+                          : kCVPixelFormatType_420YpCbCr10BiPlanarVideoRange;
+    } else {
+      cv_fmt = full_range ? kCVPixelFormatType_420YpCbCr8BiPlanarFullRange
+                          : kCVPixelFormatType_420YpCbCr8BiPlanarVideoRange;
+    }
+
+    if (!pool_ || pool_width_ != width || pool_height_ != height ||
+        pool_format_ != cv_fmt) {
+      Reset();
+      NSDictionary* attrs = @{
+        (__bridge NSString*)kCVPixelBufferPixelFormatTypeKey : @(cv_fmt),
+        (__bridge NSString*)kCVPixelBufferWidthKey : @(width),
+        (__bridge NSString*)kCVPixelBufferHeightKey : @(height),
+        (__bridge NSString*)kCVPixelBufferIOSurfacePropertiesKey : @{},
+      };
+      CVPixelBufferPoolRef raw_pool = nullptr;
+      if (CVPixelBufferPoolCreate(kCFAllocatorDefault, nullptr,
+                                  (__bridge CFDictionaryRef)attrs,
+                                  &raw_pool) != kCVReturnSuccess ||
+          !raw_pool) {
+        return base::apple::ScopedCFTypeRef<CVPixelBufferRef>();
+      }
+      pool_.reset(raw_pool);
+      pool_width_ = width;
+      pool_height_ = height;
+      pool_format_ = cv_fmt;
+    }
+
+    NSDictionary* aux = @{
+      (__bridge NSString*)
+          kCVPixelBufferPoolAllocationThresholdKey : @(kMaxSwPoolBuffers),
+    };
+    CVPixelBufferRef raw_buf = nullptr;
+    if (CVPixelBufferPoolCreatePixelBufferWithAuxAttributes(
+            kCFAllocatorDefault, pool_.get(), (__bridge CFDictionaryRef)aux,
+            &raw_buf) != kCVReturnSuccess ||
+        !raw_buf) {
+      return base::apple::ScopedCFTypeRef<CVPixelBufferRef>();
+    }
+    base::apple::ScopedCFTypeRef<CVPixelBufferRef> dst(raw_buf);
+
+    if (CVPixelBufferLockBaseAddress(dst.get(), 0) != kCVReturnSuccess) {
+      return base::apple::ScopedCFTypeRef<CVPixelBufferRef>();
+    }
+
+    uint8_t* dst_y = static_cast<uint8_t*>(
+        CVPixelBufferGetBaseAddressOfPlane(dst.get(), 0));
+    uint8_t* dst_uv = static_cast<uint8_t*>(
+        CVPixelBufferGetBaseAddressOfPlane(dst.get(), 1));
+    const int dst_stride_y =
+        static_cast<int>(CVPixelBufferGetBytesPerRowOfPlane(dst.get(), 0));
+    const int dst_stride_uv =
+        static_cast<int>(CVPixelBufferGetBytesPerRowOfPlane(dst.get(), 1));
+
+    bool ok = false;
+    if (fmt == media::PIXEL_FORMAT_I420 || fmt == media::PIXEL_FORMAT_I420A) {
+      ok = libyuv::I420ToNV12(
+               frame.data(media::VideoFrame::Plane::kY),
+               frame.stride(media::VideoFrame::Plane::kY),
+               frame.data(media::VideoFrame::Plane::kU),
+               frame.stride(media::VideoFrame::Plane::kU),
+               frame.data(media::VideoFrame::Plane::kV),
+               frame.stride(media::VideoFrame::Plane::kV), dst_y, dst_stride_y,
+               dst_uv, dst_stride_uv, width, height) == 0;
+    } else if (fmt == media::PIXEL_FORMAT_NV12) {
+      ok = libyuv::NV12Copy(
+               frame.data(media::VideoFrame::Plane::kY),
+               frame.stride(media::VideoFrame::Plane::kY),
+               frame.data(media::VideoFrame::Plane::kUV),
+               frame.stride(media::VideoFrame::Plane::kUV), dst_y, dst_stride_y,
+               dst_uv, dst_stride_uv, width, height) == 0;
+    } else if (fmt == media::PIXEL_FORMAT_YUV420P10) {
+      ok = libyuv::I010ToP010(
+               reinterpret_cast<const uint16_t*>(
+                   frame.data(media::VideoFrame::Plane::kY)),
+               frame.stride(media::VideoFrame::Plane::kY) / 2,
+               reinterpret_cast<const uint16_t*>(
+                   frame.data(media::VideoFrame::Plane::kU)),
+               frame.stride(media::VideoFrame::Plane::kU) / 2,
+               reinterpret_cast<const uint16_t*>(
+                   frame.data(media::VideoFrame::Plane::kV)),
+               frame.stride(media::VideoFrame::Plane::kV) / 2,
+               reinterpret_cast<uint16_t*>(dst_y), dst_stride_y / 2,
+               reinterpret_cast<uint16_t*>(dst_uv), dst_stride_uv / 2, width,
+               height) == 0;
+    } else if (fmt == media::PIXEL_FORMAT_P010LE) {
+      const int uv_width_elems = 2 * ((width + 1) / 2);
+      const int uv_height = (height + 1) / 2;
+      libyuv::CopyPlane_16(reinterpret_cast<const uint16_t*>(
+                               frame.data(media::VideoFrame::Plane::kY)),
+                           frame.stride(media::VideoFrame::Plane::kY) / 2,
+                           reinterpret_cast<uint16_t*>(dst_y), dst_stride_y / 2,
+                           width, height);
+      libyuv::CopyPlane_16(reinterpret_cast<const uint16_t*>(
+                               frame.data(media::VideoFrame::Plane::kUV)),
+                           frame.stride(media::VideoFrame::Plane::kUV) / 2,
+                           reinterpret_cast<uint16_t*>(dst_uv),
+                           dst_stride_uv / 2, uv_width_elems, uv_height);
+      ok = true;
+    }
+
+    CVPixelBufferUnlockBaseAddress(dst.get(), 0);
+    if (!ok) {
+      return base::apple::ScopedCFTypeRef<CVPixelBufferRef>();
+    }
+    ApplyColorSpaceAttachments(dst.get(), frame);
+    ApplyCleanApertureAndAspect(dst.get(), frame);
+    return dst;
+  }
+
+  void Reset() {
+    if (pool_) {
+      CVPixelBufferPoolFlush(pool_.get(), kCVPixelBufferPoolFlushExcessBuffers);
+      pool_.reset();
+    }
+    pool_width_ = 0;
+    pool_height_ = 0;
+    pool_format_ = 0;
+  }
+
+ private:
+  base::apple::ScopedCFTypeRef<CVPixelBufferPoolRef> pool_;
+  int pool_width_ = 0;
+  int pool_height_ = 0;
+  OSType pool_format_ = 0;
+};
