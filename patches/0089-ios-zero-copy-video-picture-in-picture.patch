+void VideoPictureInPictureWindowControllerImpl::StartSessionWithCallback(
+    PictureInPictureServiceImpl* service,
+    const MediaPlayerId& player_id,
+    mojo::PendingAssociatedRemote<media::mojom::MediaPlayer> player_remote,
+    const viz::SurfaceId& surface_id,
+    const gfx::Size& natural_size,
+    bool show_play_pause_button,
+    mojo::PendingRemote<blink::mojom::PictureInPictureSessionObserver> observer,
+    const gfx::Rect& source_bounds,
+    std::optional<content::ImmersiveOptions> immersive_options,
+    StartSessionResultCallback callback) {
+#if BUILDFLAG(IS_IOS)
+  if (!immersive_options.has_value()) {
+    WebContentsDelegate* delegate = web_contents()->GetDelegate();
+    PictureInPictureResult result = PictureInPictureResult::kNotSupported;
+    if (delegate && delegate->IsPictureInPictureEnabled()) {
+      base::WeakPtr<WebContents> weak_wc = web_contents()->GetWeakPtr();
+      result = GetWebContentsImpl()->EnterPictureInPicture();
+      if (!weak_wc) {
+        std::move(callback).Run(mojo::NullRemote(), gfx::Size());
+        return;
+      }
+    }
+    if (result != PictureInPictureResult::kSuccess) {
+      std::move(callback).Run(mojo::NullRemote(), gfx::Size());
+      return;
+    }
+
+    if (!window_) {
+      window_ =
+          GetContentClient()->browser()->CreateWindowForVideoPictureInPicture(
+              this);
+    }
+    if (!window_) {
+      std::move(callback).Run(mojo::NullRemote(), gfx::Size());
+      return;
+    }
+
+    if (window_->SupportsAsyncStart()) {
+      CancelPendingNativeStart();
+      if (active_session_) {
+        DetachActiveSystemPiPIfNeeded();
+        active_session_->Disconnect();
+        active_session_.reset();
+        pip_session_media_position_ = std::nullopt;
+      }
+
+      is_immersive_ = false;
+      source_bounds_ = source_bounds;
+      surface_id_ = surface_id;
+      const base::UnguessableToken session_token =
+          base::UnguessableToken::Create();
+      pending_native_start_ = std::make_unique<PendingNativeStart>(
+          service, player_id, std::move(player_remote), surface_id,
+          natural_size, show_play_pause_button, std::move(observer),
+          source_bounds, session_token, std::move(callback));
+
+      pending_native_start_->player_remote.set_disconnect_handler(
+          base::BindOnce(&VideoPictureInPictureWindowControllerImpl::
+                             CancelPendingNativeStart,
+                         weak_ptr_factory_.GetWeakPtr()));
+
+      window_->SetSystemPiPBackgroundCallback(base::BindRepeating(
+          &VideoPictureInPictureWindowControllerImpl::
+              OnSystemPiPBackgroundChanged,
+          weak_ptr_factory_.GetWeakPtr()));
+      window_->UpdateNaturalSize(natural_size);
+      window_->SetSurfaceId(surface_id);
+      window_->PrepareSystemPictureInPicture(session_token);
+
+      pending_native_start_->player_remote->AttachSystemPictureInPicture(
+          session_token,
+          base::BindOnce(&VideoPictureInPictureWindowControllerImpl::
+                             OnSystemPiPPlayerAttached,
+                         weak_ptr_factory_.GetWeakPtr(), session_token));
+      return;
+    }
+  }
+#endif
+
+  gfx::Size window_size;
+  mojo::PendingRemote<blink::mojom::PictureInPictureSession> session_remote;
+  auto result = StartSession(
+      service, player_id, std::move(player_remote), surface_id, natural_size,
+      show_play_pause_button, std::move(observer), source_bounds,
+      std::move(immersive_options), &session_remote, &window_size);
+  if (result == PictureInPictureResult::kSuccess) {
+    service->NotifyPictureInPictureStarted();
+  }
+  std::move(callback).Run(std::move(session_remote), window_size);
+}
+
+#if BUILDFLAG(IS_IOS)
+void VideoPictureInPictureWindowControllerImpl::CancelPendingNativeStart() {
+  if (!pending_native_start_) {
+    return;
+  }
+  auto pending = std::move(pending_native_start_);
+  if (pending->player_remote.is_bound()) {
+    pending->player_remote->DetachSystemPictureInPicture(
+        pending->session_token);
+  }
+  if (window_) {
+    window_->CancelPendingStart();
+  }
+  if (pending->callback) {
+    std::move(pending->callback).Run(mojo::NullRemote(), gfx::Size());
+  }
+}
+
+void VideoPictureInPictureWindowControllerImpl::DetachActiveSystemPiPIfNeeded() {
+  if (!active_system_pip_token_.has_value()) {
+    return;
+  }
+  const base::UnguessableToken token = *active_system_pip_token_;
+  active_system_pip_token_.reset();
+  if (active_session_ && active_session_->GetMediaPlayerRemote().is_bound()) {
+    active_session_->GetMediaPlayerRemote()->DetachSystemPictureInPicture(
+        token);
+  }
+}
+
+void VideoPictureInPictureWindowControllerImpl::OnSystemPiPPlayerAttached(
+    const base::UnguessableToken& session_token,
+    bool supported) {
+  if (!pending_native_start_ ||
+      pending_native_start_->session_token != session_token) {
+    return;
+  }
+  if (!supported || !window_) {
+    CancelPendingNativeStart();
+    return;
+  }
+  window_->StartSystemPictureInPicture(
+      session_token,
+      base::BindOnce(&VideoPictureInPictureWindowControllerImpl::
+                         OnSystemPiPStartCompleted,
+                     weak_ptr_factory_.GetWeakPtr(), session_token));
+}
+
+void VideoPictureInPictureWindowControllerImpl::OnSystemPiPStartCompleted(
+    const base::UnguessableToken& session_token,
+    bool success,
+    const gfx::Size& window_size) {
+  if (!pending_native_start_ ||
+      pending_native_start_->session_token != session_token) {
+    return;
+  }
+  if (!success || !window_ || !web_contents() ||
+      web_contents()->IsBeingDestroyed()) {
+    CancelPendingNativeStart();
+    return;
+  }
+
+  auto pending = std::move(pending_native_start_);
+  mojo::PendingRemote<blink::mojom::PictureInPictureSession> session_remote;
+  active_session_ = std::make_unique<PictureInPictureSession>(
+      pending->service, pending->player_id, pending->player_remote.Unbind(),
+      session_remote.InitWithNewPipeAndPassReceiver(),
+      std::move(pending->observer));
+  active_system_pip_token_ = session_token;
+
+  SetShowPlayPauseButton(pending->show_play_pause_button);
+  UpdatePlaybackState();
+  UpdateMediaPosition();
+  Show();
+
+  if (on_window_created_notify_observers_callback_) {
+    std::move(on_window_created_notify_observers_callback_).Run();
+  }
+  pending->service->NotifyPictureInPictureStarted();
+
+  const gfx::Size reported_size =
+      window_size.IsEmpty() ? GetSize() : window_size;
+  std::move(pending->callback).Run(std::move(session_remote), reported_size);
+}
+
+void VideoPictureInPictureWindowControllerImpl::OnSystemPiPBackgroundChanged(
+    bool backgrounded) {
+  if (active_session_ && active_system_pip_token_.has_value() &&
+      active_session_->GetMediaPlayerRemote().is_bound()) {
+    active_session_->GetMediaPlayerRemote()
+        ->SetSystemPictureInPictureBackgrounded(*active_system_pip_token_,
+                                                backgrounded);
+  } else if (pending_native_start_ &&
+             pending_native_start_->player_remote.is_bound()) {
+    pending_native_start_->player_remote->SetSystemPictureInPictureBackgrounded(
+        pending_native_start_->session_token, backgrounded);
+  }
+}
+#endif
