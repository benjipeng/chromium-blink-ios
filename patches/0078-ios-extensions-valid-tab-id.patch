+
+void IOSExtensionsBrowserClient::RegisterTabWebContents(
+    int tab_id,
+    content::WebContents* web_contents) {
+  if (tab_id <= 0 || !web_contents) {
+    return;
+  }
+  content::BrowserContext* browser_context = web_contents->GetBrowserContext();
+  if (!browser_context) {
+    return;
+  }
+  base::AutoLock lock(context_lock_);
+  registered_tabs_.insert_or_assign(
+      tab_id, RegisteredTab{web_contents, browser_context});
+}
+
+void IOSExtensionsBrowserClient::UnregisterTabWebContents(
+    int tab_id,
+    content::WebContents* web_contents) {
+  if (tab_id <= 0) {
+    return;
+  }
+  base::AutoLock lock(context_lock_);
+  auto it = registered_tabs_.find(tab_id);
+  if (it != registered_tabs_.end() &&
+      (!web_contents || it->second.web_contents == web_contents)) {
+    registered_tabs_.erase(it);
+  }
 }

