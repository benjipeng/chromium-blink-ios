+
+bool IOSExtensionsBrowserClient::IsValidTabId(
+    content::BrowserContext* browser_context,
+    int tab_id,
+    bool include_incognito,
+    content::WebContents** web_contents) const {
+  (void)include_incognito;
+  if (web_contents) {
+    *web_contents = nullptr;
+  }
+  if (!content::BrowserThread::CurrentlyOn(content::BrowserThread::UI) ||
+      is_shutting_down_.load(std::memory_order_relaxed) || !browser_context ||
+      tab_id <= 0) {
+    return false;
+  }
+  base::AutoLock lock(context_lock_);
+  if (!registered_contexts_.contains(browser_context)) {
+    return false;
+  }
+  auto it = registered_tabs_.find(tab_id);
+  if (it == registered_tabs_.end() || !it->second.web_contents ||
+      it->second.web_contents->IsBeingDestroyed()) {
+    return false;
+  }
+  if (it->second.browser_context != browser_context ||
+      it->second.web_contents->GetBrowserContext() != browser_context) {
+    return false;
+  }
+  if (web_contents) {
+    *web_contents = it->second.web_contents;
+  }
+  return true;
 }

