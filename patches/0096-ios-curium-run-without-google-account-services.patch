From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: chromium-blink-ios <noreply@github.com>
Subject: [PATCH] iOS Curium: run without Google account services

Honor --disable-sync during profile startup. Keep authentication, local
credentials, and session metrics available; skip services that require
sync. Chromium's existing switch leaves the sync transport unstarted.

Return GCM's disabled status before either iOS driver starts its worker.
Keep Optimization Guide's local hints and cached models, but deny all
remote hint and model requests, including on-demand hints and model
execution.

diff --git a/components/gcm_driver/gcm_driver_desktop.cc b/components/gcm_driver/gcm_driver_desktop.cc
index f31c49582484744363a90dcc0b3a36855be092c9..ec79cc0664fac48e04eb5dc793436a1bba8aa322 100644
--- a/components/gcm_driver/gcm_driver_desktop.cc
+++ b/components/gcm_driver/gcm_driver_desktop.cc
@@ -19,6 +19,7 @@
 #include "base/time/time.h"
 #include "base/timer/timer.h"
 #include "base/trace_event/trace_event.h"
+#include "build/build_config.h"
 #include "components/fcm/crypto/fcm_decryption_result.h"
 #include "components/fcm/engine/chrome_build_info.h"
 #include "components/fcm/engine/system_encryptor.h"
@@ -1010,6 +1011,11 @@ GCMClient::Result GCMDriverDesktop::EnsureStarted(
     GCMClient::StartMode start_mode) {
   DCHECK(ui_thread_->RunsTasksInCurrentSequence());
 
+  // [ios-blink-sideload] Keep both iOS GCM drivers offline. The rest of the
+  // body is compiled out rather than skipped, which -Wunreachable-code rejects.
+#if BUILDFLAG(IS_IOS)
+  return GCMClient::GCM_DISABLED;
+#else
   if (gcm_started_) {
     return GCMClient::SUCCESS;
   }
@@ -1032,6 +1038,7 @@ GCMClient::Result GCMDriverDesktop::EnsureStarted(
                                 /*time_task_posted=*/base::TimeTicks::Now()));
 
   return GCMClient::SUCCESS;
+#endif  // BUILDFLAG(IS_IOS)
 }
 
 void GCMDriverDesktop::RemoveCachedData() {
