 void BrowserControlsOffsetManager::SetupAnimation(
     BrowserControlsAnimation::Direction direction,
     int64_t duration_ms,
+    bool from_scroll,
     gfx::Tween::Type tween_type) {
+  using Direction = BrowserControlsAnimation::Direction;
