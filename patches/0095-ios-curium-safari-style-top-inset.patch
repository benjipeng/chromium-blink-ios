+      item->ScrollRestorationType() ==
+          mojom::blink::ScrollRestorationType::kManual) {
+    return;
+  }
+  WebLocalFrameImpl* web_frame = WebLocalFrameImpl::FromFrame(frame);
+  WebViewImpl* web_view = web_frame ? web_frame->ViewImpl() : nullptr;
+  if (!web_view) {
+    return;
+  }
+  const HistoryItem::ViewState& view_state = *item->GetViewState();
+  const bool below_top = view_state.scroll_offset_.y() > 0.f ||
+                         view_state.visual_viewport_scroll_offset_.y() > 0.f;
+  web_view->ResetBrowserControlsShownRatio(below_top ? 0.f : 1.f);
+}
