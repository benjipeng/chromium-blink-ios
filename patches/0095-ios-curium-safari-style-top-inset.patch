+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#ifndef COMPONENTS_VIZ_COMMON_FRAME_SINKS_PRESENTED_TOP_CONTROLS_OFFSET_IOS_H_
+#define COMPONENTS_VIZ_COMMON_FRAME_SINKS_PRESENTED_TOP_CONTROLS_OFFSET_IOS_H_
+
+#include <cstdint>
+
+#include "components/viz/common/surfaces/frame_sink_id.h"
+#include "components/viz/common/viz_common_export.h"
+
+namespace viz {
+
+// [ios-blink-sideload] Curium draws the page below its floating top controls
+// at the offset carried by each compositor frame. Viz records that offset when
+// the frame is presented; the browser reads it on the UI thread so a touch or
+// a selection handle maps to the content the user can actually see.
+struct PresentedTopControlsOffset {
+  uint32_t frame_token = 0;
+  float offset_dips = 0.f;
+};
+
+VIZ_COMMON_EXPORT void SetPresentedTopControlsOffset(
+    const FrameSinkId& frame_sink_id,
+    const PresentedTopControlsOffset& offset);
+
+// Returns a zero offset until a frame from `frame_sink_id` is presented.
+VIZ_COMMON_EXPORT PresentedTopControlsOffset
+GetPresentedTopControlsOffset(const FrameSinkId& frame_sink_id);
+
+VIZ_COMMON_EXPORT void ClearPresentedTopControlsOffset(
+    const FrameSinkId& frame_sink_id);
+
+}  // namespace viz
+
+#endif  // COMPONENTS_VIZ_COMMON_FRAME_SINKS_PRESENTED_TOP_CONTROLS_OFFSET_IOS_H_
