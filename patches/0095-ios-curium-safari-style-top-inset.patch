+void ContentWebState::UpdateTopControlsConstraints() {
+  if (GetTopControlsHeight() > 0) {
+    // Reapply the unlocked state to new renderers without disturbing the
+    // current offset of a restored page.
+    web_contents_->UpdateBrowserControlsState(cc::BrowserControlsState::kBoth,
+                                              cc::BrowserControlsState::kBoth,
+                                              /*animate=*/false, std::nullopt);
+  }
+}
+
+void ContentWebState::SynchronizeTopControlsVisualProperties() {
+  if (auto* frame = web_contents_->GetPrimaryMainFrame()) {
+    frame->GetRenderWidgetHost()->SynchronizeVisualProperties();
+  }
+}
+
+void ContentWebState::EnterFullscreenModeForTab(
+    content::RenderFrameHost* requesting_frame,
+    const blink::mojom::FullscreenOptions& options) {
+  dom_fullscreen_ = true;
+  SynchronizeTopControlsVisualProperties();
+}
+
+void ContentWebState::ExitFullscreenModeForTab(
+    content::WebContents* web_contents) {
+  dom_fullscreen_ = false;
+  SynchronizeTopControlsVisualProperties();
+}
+
+bool ContentWebState::IsFullscreenForTabOrPending(
+    const content::WebContents* web_contents) {
+  return dom_fullscreen_;
+}
+
+int ContentWebState::GetTopControlsHeight() {
+  if (dom_fullscreen_ || !top_controls_height_points_) {
+    return 0;
+  }
+  // Resolve the scale when visual properties are collected so a display
+  // change also refreshes the pixel height without a new shell layout.
+  if (auto* frame = web_contents_->GetPrimaryMainFrame()) {
+    const auto scale = frame->GetRenderWidgetHost()->GetDeviceScaleFactor();
+    return base::ClampRound(top_controls_height_points_ * scale);
+  }
+  return 0;
+}
+
+bool ContentWebState::DoBrowserControlsShrinkRendererSize(
+    content::WebContents* web_contents) {
+  // The widget is already full size. Blink keeps the smaller initial
+  // containing block and adjusts the visual viewport as the controls scroll.
+  return false;
+}
+
+bool ContentWebState::ShouldAnimateBrowserControlsHeightChanges() {
+  // Scene layout supplies a new band height along with the viewport size.
+  // Only scrolling animates the controls' visible fraction.
+  return false;
+}
+
+bool ContentWebState::OnlyExpandTopControlsAtPageTop() {
+  return GetTopControlsHeight() > 0;
+}
+
+void ContentWebState::SetTopControlsShownRatio(
+    content::WebContents* web_contents,
+    float ratio) {
+  if (!std::isfinite(ratio)) {
+    return;
+  }
+  ratio = std::clamp(ratio, 0.f, 1.f);
+  if (top_controls_shown_ratio_ == ratio) {
+    return;
+  }
+  top_controls_shown_ratio_ = ratio;
+  if (top_controls_shown_ratio_observer_) {
+    top_controls_shown_ratio_observer_(ratio);
+  }
+}
