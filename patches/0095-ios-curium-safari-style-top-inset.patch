+// only if Blink goes on to restore the scroll.
+void SeedBrowserControlsForHistoryRestore(LocalFrame& frame,
+                                          DocumentLoader* loader) {
+  if (!frame.GetPage() || !frame.IsOutermostMainFrame() || !loader ||
+      !loader->NavigationScrollAllowed() ||
+      !FrameLoader::NeedsHistoryItemRestore(loader->LoadType()) ||
+      frame.GetDocument()->IsInitialEmptyDocument()) {
