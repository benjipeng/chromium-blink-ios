+
+void ContentWebState::SetTopControlsHeightInPoints(CGFloat height) {
+  if (!std::isfinite(height)) {
+    return;
+  }
+  height = std::max<CGFloat>(height, 0);
+  if (height == top_controls_height_points_) {
+    return;
+  }
+
+  const int old_height = GetTopControlsHeight();
+  top_controls_height_points_ = height;
+  const int new_height = GetTopControlsHeight();
+  if (old_height == new_height) {
+    return;
+  }
+
+  if (old_height == 0) {
+    UpdateTopControlsConstraints();
+  }
+  SynchronizeTopControlsVisualProperties();
+}
+
+CGFloat ContentWebState::GetTopControlsShownRatio() const {
+  return top_controls_shown_ratio_;
+}
+
+void ContentWebState::SetTopControlsShownRatioObserver(
+    void (^observer)(CGFloat)) {
