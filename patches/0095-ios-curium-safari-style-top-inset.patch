+TEST_F(BrowserControlsOffsetManagerTest, SettleCannotRevealBelowPageTop) {
+  MockBrowserControlsOffsetManagerClient client(100.f, 0.5f, 0.5f);
+  client.SetBrowserControlsParams(
+      {100.f, 0, 0, 0, false, false,
+       /*only_expand_top_controls_at_page_top=*/true});
+  auto* manager = client.manager();
+
+  manager->ScrollBegin();
+  client.SetViewportScrollOffset(0.f, 20.f);
+  client.SetCurrentBrowserControlsShownRatio(0.f, 0.f);
+  manager->ScrollEnd(gfx::Vector2dF(0.f, -90.f));
+  EXPECT_FALSE(manager->HasAnimation());
+
+  // A partially visible band ordinarily would settle fully shown.
+  client.SetCurrentBrowserControlsShownRatio(0.75f, 0.75f);
+  manager->ScrollEnd(gfx::Vector2dF());
+  const base::TimeTicks start = base::TimeTicks::Now();
+  manager->Animate(start);
+  manager->Animate(start + base::Seconds(1));
+  EXPECT_FLOAT_EQ(0.f, manager->TopControlsShownRatio());
+}
+
+TEST_F(BrowserControlsOffsetManagerTest, RevealStopsIfPageLeavesTop) {
+  MockBrowserControlsOffsetManagerClient client(100.f, 0.5f, 0.5f);
+  client.SetBrowserControlsParams(
+      {100.f, 0, 0, 0, false, false,
+       /*only_expand_top_controls_at_page_top=*/true});
+  auto* manager = client.manager();
+  manager->ScrollBegin();
+  client.SetCurrentBrowserControlsShownRatio(0.75f, 0.75f);
+  manager->ScrollEnd(gfx::Vector2dF());
+  ASSERT_TRUE(manager->HasAnimation());
+
+  const base::TimeTicks start = base::TimeTicks::Now();
+  manager->Animate(start);
+  manager->Animate(start + base::Milliseconds(5));
+  EXPECT_GT(manager->TopControlsShownRatio(), 0.75f);
+
+  client.SetViewportScrollOffset(0.f, 20.f);
+  EXPECT_TRUE(manager->Animate(start + base::Milliseconds(10)).IsZero());
+  EXPECT_FALSE(manager->HasAnimation());
+  EXPECT_FLOAT_EQ(0.f, manager->TopControlsShownRatio());
+}
