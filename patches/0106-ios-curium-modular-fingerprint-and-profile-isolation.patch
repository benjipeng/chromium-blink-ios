+inline constexpr int kLaunchConfigSchemaVersion = 1;
+inline constexpr size_t kMaxLaunchConfigBytes = 65536;
+
+enum class ErrorCode : int {
+  kNone = 0,
+  kInvalidJSON = 1,
+  kUnsupportedSchema = 2,
+  kPayloadTooLarge = 3,
+  kInvalidField = 4,
+  kInvalidProfileID = 5,
