+NSError* MakeFingerprintError(NSInteger code, const std::string& message) {
+  NSString* description =
+      message.empty() ? @"Fingerprint configuration rejected."
+                      : base::SysUTF8ToNSString(message);
+  return [NSError errorWithDomain:CrIOSFingerprintErrorDomain
+                             code:code
+                         userInfo:@{NSLocalizedDescriptionKey : description}];
+}
+
+#if BUILDFLAG(USE_BLINK)
+blink::curium::ErrorCode MapPathErrorCode(std::string_view code) {
+  if (code == "invalid_profile_id") {
+    return blink::curium::ErrorCode::kInvalidProfileID;
+  }
+  if (code == "profile_locked") {
+    return blink::curium::ErrorCode::kProfileLocked;
+  }
+  if (code == "already_opened") {
+    return blink::curium::ErrorCode::kAlreadyFrozen;
+  }
+  return blink::curium::ErrorCode::kProfileUnavailable;
+}
+
+NSString* ConfigStateName(blink::curium::ConfigState state) {
+  switch (state) {
+    case blink::curium::ConfigState::kUnconfigured:
+      return @"unconfigured";
+    case blink::curium::ConfigState::kDefault0105:
+      return @"default_0105";
+    case blink::curium::ConfigState::kConfigured:
+      return @"configured";
+    case blink::curium::ConfigState::kRejected:
+      return @"rejected";
+  }
+}
+
+NSString* ProxyModeName(blink::curium::ProxyMode mode) {
+  switch (mode) {
+    case blink::curium::ProxyMode::kSystem:
+      return @"system";
+    case blink::curium::ProxyMode::kDirect:
+      return @"direct";
+    case blink::curium::ProxyMode::kFixed:
+      return @"fixed";
+  }
+}
+#endif
 }  // namespace
 
