+  std::string message;
+};
+
+struct BLINK_COMMON_EXPORT IdentitySlotConfig {
+  IdentitySlotConfig();
+  IdentitySlotConfig(const IdentitySlotConfig&);
+  IdentitySlotConfig(IdentitySlotConfig&&) noexcept;
+  IdentitySlotConfig& operator=(const IdentitySlotConfig&);
+  IdentitySlotConfig& operator=(IdentitySlotConfig&&) noexcept;
+  ~IdentitySlotConfig();
+
+  std::optional<std::string> ua_string;
+  std::optional<std::string> os_cpu;
+  std::optional<std::string> product_version;
+  std::optional<bool> append_mobile_token;
+
