+    if (S_ISLNK(st.st_mode) || !S_ISDIR(st.st_mode)) {
+      return false;
+    }
+  } else if (errno != ENOENT) {
+    return false;
+  } else if (!base::CreateDirectory(dir)) {
+    return false;
+  }
+  if (lstat(dir.value().c_str(), &st) != 0 || S_ISLNK(st.st_mode) ||
+      !S_ISDIR(st.st_mode)) {
+    return false;
+  }
+  return access(dir.value().c_str(), R_OK | W_OK | X_OK) == 0;
+}
+
+bool AcquireProfileLock(const base::FilePath& dir,
+                        int* fd_out,
+                        std::string* code_out,
+                        std::string* msg_out) {
+  const base::FilePath lock_path =
+      dir.Append(FILE_PATH_LITERAL(".curium_profile.lock"));
+  int fd = open(lock_path.value().c_str(),
+                O_CREAT | O_RDWR | O_CLOEXEC | O_NOFOLLOW, 0600);
+  if (fd < 0) {
+    return SetProfileError(code_out, msg_out, "profile_unavailable",
+                           "Unable to open profile lock file");
+  }
+  // Prevent RunningBoard 0xdead10cc termination if iOS suspends the process
+  // while this advisory profile lock is held.
+  const uint8_t can_suspend = 1;
+  (void)fsetxattr(fd, "com.apple.runningboard.can-suspend-locked", &can_suspend,
+                  sizeof(can_suspend), 0, 0);
+  if (flock(fd, LOCK_EX | LOCK_NB) != 0) {
+    const int lock_errno = errno;
+    close(fd);
+    if (lock_errno == EWOULDBLOCK || lock_errno == EAGAIN) {
+      return SetProfileError(code_out, msg_out, "profile_locked",
+                             "Profile directory is already open by another instance");
+    }
+    return SetProfileError(code_out, msg_out, "profile_unavailable",
+                           "Unable to lock profile directory");
+  }
+  *fd_out = fd;
+  return true;
