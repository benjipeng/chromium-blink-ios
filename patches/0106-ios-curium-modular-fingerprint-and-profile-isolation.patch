+
+std::string DefaultDesktopMacPlatformVersion() {
+  int32_t major = 0, minor = 0, bugfix = 0;
+  base::SysInfo::OperatingSystemVersionNumbers(&major, &minor, &bugfix);
+  if (major >= 26) {
+    return base::StringPrintf("%d.%d.%d", major, minor, bugfix);
+  }
+  return "15.5.0";
+}
+
+std::string GetCuriumLegacyDesktopPlatformVersion() {
+  const base::CommandLine* cmd = CurrentCommandLine();
+  if (cmd && cmd->HasSwitch("curium-desktop-platform-version")) {
+    const std::string ver =
+        cmd->GetSwitchValueASCII("curium-desktop-platform-version");
+    if (IsValidClientHintToken(ver)) {
+      return ver;
+    }
+  }
+  return DefaultDesktopMacPlatformVersion();
+}
+
+struct CuriumSlotVersions {
+  std::string major_version;
+  std::string full_version;
+};
+
+CuriumSlotVersions ResolveCuriumSlotVersions(
+    const blink::curium::IdentitySlotConfig& slot) {
+  const std::string default_major = version_info::GetMajorVersionNumber();
+  const std::string default_full(version_info::GetVersionNumber());
+
+  std::string major;
+  if (slot.major_version.has_value() && !slot.major_version->empty()) {
+    major = *slot.major_version;
+  } else if (slot.full_version.has_value() && !slot.full_version->empty()) {
+    const size_t dot = slot.full_version->find('.');
+    std::string_view prefix = dot == std::string::npos
+                                  ? std::string_view(*slot.full_version)
+                                  : std::string_view(*slot.full_version).substr(0, dot);
+    int parsed = 0;
+    const bool all_digits =
+        !prefix.empty() && prefix.size() <= 4 &&
+        std::all_of(prefix.begin(), prefix.end(), [](unsigned char c) {
+          return base::IsAsciiDigit(c);
+        });
+    if (all_digits && base::StringToInt(prefix, &parsed) && parsed >= 1) {
+      major = std::string(prefix);
+    } else {
+      major = default_major;
+    }
+  } else {
+    major = default_major;
+  }
+
+  std::string full;
+  if (slot.full_version.has_value() && !slot.full_version->empty()) {
+    full = *slot.full_version;
+  } else if (slot.major_version.has_value() && major != default_major) {
+    full = base::StrCat({major, ".0.0.0"});
+  } else {
+    full = default_full;
+  }
+
+  return {std::move(major), std::move(full)};
+}
+
+std::string DefaultPlatformVersionForCuriumPlatform(std::string_view platform) {
+  if (platform == "macOS") {
+    return DefaultDesktopMacPlatformVersion();
+  }
+  if (platform == "iOS") {
+    int32_t major = 0, minor = 0, bugfix = 0;
+    base::SysInfo::OperatingSystemVersionNumbers(&major, &minor, &bugfix);
+    return base::StringPrintf("%d.%d.%d", major, minor, bugfix);
+  }
+  if (platform == "Linux" || platform == "Chrome OS" ||
+      platform == "Chromium OS") {
+    return std::string();
+  }
+  return "15.0.0";
+}
+
+std::string BuildUserAgentForCuriumSlot(
+    const blink::curium::IdentitySlotConfig& slot,
+    bool is_desktop_fallback) {
+  if (slot.ua_string.has_value() && !slot.ua_string->empty()) {
+    return *slot.ua_string;
+  }
+  std::string product;
+  if (slot.product_version.has_value()) {
+    product = *slot.product_version;
+  } else if (slot.major_version.has_value() || slot.full_version.has_value()) {
+    const CuriumSlotVersions versions = ResolveCuriumSlotVersions(slot);
+    product = base::StrCat({"Chrome/", versions.major_version, ".0.0.0"});
+  } else {
+    product = GetProductAndVersion();
+  }
+  const bool is_mobile = slot.mobile.value_or(!is_desktop_fallback);
+  if (slot.append_mobile_token.value_or(is_mobile)) {
+    product += " Mobile";
+  }
+  const std::string os_cpu =
+      slot.os_cpu.has_value()
+          ? *slot.os_cpu
+          : (is_desktop_fallback ? std::string("Macintosh; Intel Mac OS X 10_15_7")
+                                 : std::string("Linux; Android 10; K"));
+  return BuildUserAgentFromOSAndProduct(os_cpu, product);
+}
+
+blink::UserAgentMetadata BuildMetadataForCuriumSlot(
+    const blink::curium::IdentitySlotConfig& slot,
+    bool is_desktop_fallback,
+    bool only_low_entropy_ch) {
+  blink::UserAgentMetadata metadata;
+  const CuriumSlotVersions versions = ResolveCuriumSlotVersions(slot);
+  const std::string& major_version = versions.major_version;
+  const std::string& full_version = versions.full_version;
+  int major_seed = 0;
+  if (!base::StringToInt(major_version, &major_seed) || major_seed < 0) {
+    base::StringToInt(version_info::GetMajorVersionNumber(), &major_seed);
+  }
+  const std::optional<std::string> brand =
+      slot.has_primary_brand ? slot.primary_brand
+                             : std::optional<std::string>("Google Chrome");
+
+  if (slot.brands.has_value()) {
+    metadata.brand_version_list = *slot.brands;
+  } else {
+    metadata.brand_version_list = GenerateBrandVersionList(
+        major_seed, brand, major_version,
+        blink::UserAgentBrandVersionType::kMajorVersion, std::nullopt);
+  }
+  metadata.mobile = slot.mobile.value_or(!is_desktop_fallback);
+  metadata.platform =
+      slot.platform.value_or(is_desktop_fallback ? "macOS" : "Android");
+
+  if (only_low_entropy_ch) {
+    return metadata;
+  }
+
+  if (slot.full_version_brands.has_value()) {
+    metadata.brand_full_version_list = *slot.full_version_brands;
+  } else if (slot.brands.has_value()) {
+    metadata.brand_full_version_list = *slot.brands;
+    for (auto& bv : metadata.brand_full_version_list) {
+      if (bv.version == major_version) {
+        bv.version = full_version;
+      } else if (bv.version.find('.') == std::string::npos) {
+        bv.version += ".0.0.0";
+      }
+    }
+  } else {
+    metadata.brand_full_version_list = GenerateBrandVersionList(
+        major_seed, brand, full_version,
+        blink::UserAgentBrandVersionType::kFullVersion, std::nullopt);
+  }
+
+  metadata.full_version = full_version;
+  metadata.platform_version = slot.platform_version.value_or(
+      DefaultPlatformVersionForCuriumPlatform(metadata.platform));
+  metadata.architecture =
+      slot.architecture.value_or(is_desktop_fallback ? "arm" : "");
+  metadata.bitness = slot.bitness.value_or(is_desktop_fallback ? "64" : "");
+  metadata.model = slot.model.value_or("");
+  metadata.wow64 = slot.wow64.value_or(false);
+  metadata.form_factors =
+      slot.form_factors.value_or(GetFormFactorsClientHint(metadata, metadata.mobile));
+  return metadata;
+}
 #endif  // BUILDFLAG(IS_IOS)
 
