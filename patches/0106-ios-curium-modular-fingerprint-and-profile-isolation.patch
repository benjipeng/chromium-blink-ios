diff --git a/content/renderer/render_frame_impl.cc b/content/renderer/render_frame_impl.cc
index bdbf391..0a36454 100644
--- a/content/renderer/render_frame_impl.cc
+++ b/content/renderer/render_frame_impl.cc
@@ -4878,20 +4878,87 @@ RenderFrameImpl::UserAgentMetadataOverride() {
 
 bool RenderFrameImpl::ShouldUseUserAgentOverride() const {
   auto* web_view = GetWebView();
-  // TODO(nasko): When the top-level frame is remote, there is no
-  // WebDocumentLoader associated with it, so the checks below are not valid.
-  // Temporarily return early and fix properly as part of
-  // https://crbug.com/426555.
-  if (web_view->MainFrame()->IsWebRemoteFrame()) {
+  if (!web_view || !web_view->MainFrame()) {
     return false;
   }
-  const WebLocalFrame* main_frame = web_view->MainFrame()->ToWebLocalFrame();
-
-  WebDocumentLoader* document_loader = main_frame->GetDocumentLoader();
-  DocumentState* document_state =
-      document_loader ? DocumentState::FromDocumentLoader(document_loader)
-                      : nullptr;
-  return document_state && document_state->is_overriding_user_agent();
+  const auto is_overriding = [](const WebLocalFrame* frame) -> bool {
+    if (!frame) {
+      return false;
+    }
+    WebDocumentLoader* loader = frame->GetDocumentLoader();
+    DocumentState* state =
+        loader ? DocumentState::FromDocumentLoader(loader) : nullptr;
+    return state && state->is_overriding_user_agent();
+  };
+  if (web_view->MainFrame()->IsWebLocalFrame()) {
+    const WebLocalFrame* main_frame = web_view->MainFrame()->ToWebLocalFrame();
+    if (is_overriding(main_frame)) {
+      return true;
+    }
+    // Synchronous initial empty documents (e.g. `window.open('')` observed
+    // before its first navigation commits) use parameterless
+    // BuildDocumentState(), leaving is_overriding_user_agent() false so
+    // DidCommitProvisionalLoadParams invariants stay intact. Walk local
+    // openers while still on a synchronous initial document.
+    const WebLocalFrame* cursor = main_frame;
+    for (int hops = 0; hops < 4; ++hops) {
+      WebDocumentLoader* loader = cursor->GetDocumentLoader();
+      DocumentState* state =
+          loader ? DocumentState::FromDocumentLoader(loader) : nullptr;
+      const bool is_sync_empty_doc =
+          state &&
+          (state->navigation_state()
+               ? state->navigation_state()->IsForSynchronousCommit()
+               : (state->request_id() == -1 &&
+                  WebDocumentLoader::WillLoadUrlAsEmpty(loader->GetUrl())));
+      if (!is_sync_empty_doc) {
+        break;
+      }
+      blink::WebFrame* opener = cursor->Opener();
+      if (!opener || !opener->IsWebLocalFrame()) {
+        break;
+      }
+      const WebLocalFrame* opener_local = opener->ToWebLocalFrame();
+      if (opener_local == cursor) {
+        break;
+      }
+      if (is_overriding(opener_local)) {
+        return true;
+      }
+      const WebLocalFrame* opener_root = opener_local->LocalRoot();
+      if (opener_root && opener_root != opener_local &&
+          is_overriding(opener_root)) {
+        return true;
+      }
+      if (WebView* opener_view = opener_local->View();
+          opener_view && opener_view->MainFrame() &&
+          opener_view->MainFrame()->IsWebLocalFrame()) {
+        const WebLocalFrame* opener_main =
+            opener_view->MainFrame()->ToWebLocalFrame();
+        if (is_overriding(opener_main)) {
+          return true;
+        }
+        cursor = opener_main;
+      } else {
+        break;
+      }
+    }
+    return false;
+  }
+  // When the top-level frame is remote (OOPIF), the browser already propagated
+  // the tab's override decision via CommitNavigationParams onto this frame
+  // and/or its local root (covering nested about:blank / srcdoc subframes)
+  // without altering subframe DidCommitProvisionalLoadParams.
+  if (is_overriding(frame_)) {
+    return true;
+  }
+  if (frame_) {
+    const WebLocalFrame* local_root = frame_->LocalRoot();
+    if (local_root && local_root != frame_ && is_overriding(local_root)) {
+      return true;
+    }
+  }
+  return false;
 }
 
