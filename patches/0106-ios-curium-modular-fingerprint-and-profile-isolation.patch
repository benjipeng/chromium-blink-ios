+BLINK_COMMON_EXPORT std::optional<std::string> ResolveWebGLVendor(
+    const blink::UserAgentMetadata& metadata);
+BLINK_COMMON_EXPORT std::optional<std::string> ResolveWebGLRenderer(
+    const blink::UserAgentMetadata& metadata);
+
+}  // namespace blink::curium
