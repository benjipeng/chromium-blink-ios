+  bool has_primary_brand = false;
+  std::optional<std::string> primary_brand;
+  std::optional<std::string> major_version;
+  std::optional<std::string> full_version;
+  std::optional<blink::UserAgentBrandList> brands;
+  std::optional<blink::UserAgentBrandList> full_version_brands;
+
+  std::optional<std::string> platform;
+  std::optional<std::string> platform_version;
+  std::optional<std::string> architecture;
+  std::optional<std::string> bitness;
+  std::optional<std::string> model;
+  std::optional<bool> mobile;
+  std::optional<bool> wow64;
+  std::optional<std::vector<std::string>> form_factors;
+  std::optional<std::string> navigator_platform;
+
+  // Optional per-slot input capability overrides. When nullopt, Blink keeps
+  // native device touch/pointer capabilities.
+  std::optional<int> max_touch_points;
+  std::optional<PointerTypeOverride> pointer_type;
+  std::optional<HoverTypeOverride> hover_type;
+
+  // Optional per-slot WebGL debug strings. When nullopt, WebGL returns native
+  // Apple Metal GPU vendor/renderer strings.
