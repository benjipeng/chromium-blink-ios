++ (BOOL)configureLaunchFingerprintConfigJSON:(nullable NSData*)jsonData
+                                       error:(NSError* _Nullable* _Nullable)error {
+  CHECK([NSThread isMainThread]);
+#if BUILDFLAG(USE_BLINK)
+  const blink::curium::ConfigState state =
+      blink::curium::GetLaunchConfigState();
+  if (state == blink::curium::ConfigState::kConfigured ||
+      state == blink::curium::ConfigState::kDefault0105 ||
+      ios::IsCuriumProfileDirectoryOpened()) {
+    const std::string msg =
+        "Launch fingerprint config is already frozen for this process";
+    if (error) {
+      *error = MakeFingerprintError(CrIOSFingerprintErrorAlreadyFrozen, msg);
+    }
+    return NO;
+  }
+  if (!jsonData || jsonData.length == 0) {
+    return YES;
+  }
+
+  std::string_view json_view =
+      base::as_string_view(base::apple::NSDataToSpan(jsonData));
+  blink::curium::LaunchConfig parsed_config;
+  blink::curium::ConfigError cfg_error;
+  if (!blink::curium::ParseAndValidateLaunchConfigJSON(
+          json_view, &parsed_config, &cfg_error)) {
+    blink::curium::RecordLaunchConfigRejection(cfg_error.code,
+                                               cfg_error.message);
+    if (error) {
+      *error = MakeFingerprintError(static_cast<NSInteger>(cfg_error.code),
+                                    cfg_error.message);
+    }
+    return NO;
+  }
+
+  std::string path_err_code;
+  std::string path_err_message;
+  if (!ios::ConfigureCuriumProfileDirectory(parsed_config.profile_id,
+                                            &path_err_code,
+                                            &path_err_message)) {
+    const blink::curium::ErrorCode mapped = MapPathErrorCode(path_err_code);
+    blink::curium::RecordLaunchConfigRejection(mapped, path_err_message);
+    if (error) {
+      *error = MakeFingerprintError(static_cast<NSInteger>(mapped),
+                                    path_err_message);
+    }
+    return NO;
+  }
+
+  if (!blink::curium::FreezeLaunchConfig(std::move(parsed_config),
+                                         &cfg_error)) {
+    if (error) {
+      *error = MakeFingerprintError(static_cast<NSInteger>(cfg_error.code),
+                                    cfg_error.message);
+    }
+    return NO;
+  }
+  return YES;
+#else
+  if (error) {
+    *error = MakeFingerprintError(CrIOSFingerprintErrorUnsupportedSchema,
+                                  "Blink fingerprint engine is unavailable");
+  }
+  return NO;
+#endif
+}
+
++ (NSDictionary<NSString*, id>*)activeFingerprintStatus {
+  CHECK([NSThread isMainThread]);
+#if BUILDFLAG(USE_BLINK)
+  const blink::curium::ConfigState state =
+      blink::curium::GetLaunchConfigState();
+  const blink::curium::LaunchConfig* cfg = blink::curium::GetLaunchConfig();
+  NSMutableDictionary<NSString*, id>* status = [NSMutableDictionary dictionary];
+  status[@"contractVersion"] = @(blink::curium::kLaunchConfigSchemaVersion);
+  status[@"state"] = ConfigStateName(state);
+  status[@"appliedProfileId"] =
+      base::SysUTF8ToNSString(ios::GetAppliedCuriumProfileId());
+  status[@"profileDirectoryOpened"] =
+      @(ios::IsCuriumProfileDirectoryOpened());
+  status[@"appliedConfigRevision"] = cfg ? @(cfg->revision) : @0ULL;
+  status[@"defaultSlot"] =
+      (cfg && cfg->default_slot == blink::curium::DefaultSlot::kDesktop)
+          ? @"desktop"
+          : @"mobile";
+  status[@"proxyMode"] =
+      cfg ? ProxyModeName(cfg->proxy_mode) : @"system";
+  status[@"hardwareOverridesActive"] =
+      @(cfg ? cfg->HasHardwareOverrides() : NO);
+  if (state == blink::curium::ConfigState::kRejected) {
+    const blink::curium::ConfigError err =
+        blink::curium::GetLastLaunchConfigError();
+    status[@"rejectionCode"] = @(static_cast<NSInteger>(err.code));
+    status[@"rejectionReason"] = base::SysUTF8ToNSString(err.message);
+  }
+  return [status copy];
+#else
+  return @{
+    @"contractVersion" : @0,
+    @"state" : @"unsupported",
+    @"appliedProfileId" : @"default",
+    @"profileDirectoryOpened" : @NO,
+    @"appliedConfigRevision" : @0ULL,
+  };
+#endif
+}
