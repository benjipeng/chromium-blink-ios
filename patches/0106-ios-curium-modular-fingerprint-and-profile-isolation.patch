+
+// Seals the unconfigured state as Build 39 (0105) default behavior once
+// ChromeMain begins early initialization.
+BLINK_COMMON_EXPORT void FreezeDefault0105IfUnconfigured();
+
+// Lock-free read of the frozen launch config. Returns nullptr when running in
+// default Build 39 (0105) mode or before configuration is frozen.
+BLINK_COMMON_EXPORT const LaunchConfig* GetLaunchConfig();
+
+BLINK_COMMON_EXPORT ConfigState GetLaunchConfigState();
+BLINK_COMMON_EXPORT ConfigError GetLastLaunchConfigError();
+
+// Resolves navigator.platform for both Window and Worker contexts.
+BLINK_COMMON_EXPORT std::string ResolveNavigatorPlatform(
+    const blink::UserAgentMetadata& metadata);
+
+// Resolves optional per-slot WebGL UNMASKED_VENDOR_WEBGL /
