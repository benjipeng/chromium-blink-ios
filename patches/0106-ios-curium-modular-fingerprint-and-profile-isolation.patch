+
+enum class ProxyMode : int {
+  kSystem = 0,
+  kDirect = 1,
+  kFixed = 2,
+};
+
+enum class PointerTypeOverride : int {
+  kNone = 0,
+  kCoarse = 1,
+  kFine = 2,
+};
+
+enum class HoverTypeOverride : int {
