+BLINK_COMMON_EXPORT bool IsValidClientHintToken(std::string_view value);
+
+// Parses and validates bounded UTF-8 JSON without mutating process state.
+BLINK_COMMON_EXPORT bool ParseAndValidateLaunchConfigJSON(
+    std::string_view json,
+    LaunchConfig* out_config,
+    ConfigError* out_error);
+
+// Freezes a validated launch config once before ChromeMain spawns threads.
+// Subsequent calls fail closed with ErrorCode::kAlreadyFrozen.
