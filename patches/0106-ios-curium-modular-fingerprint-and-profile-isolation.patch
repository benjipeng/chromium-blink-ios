+struct BLINK_COMMON_EXPORT ConfigError {
+  ConfigError();
+  ConfigError(ErrorCode code, std::string message);
+  ConfigError(const ConfigError&);
+  ConfigError(ConfigError&&) noexcept;
+  ConfigError& operator=(const ConfigError&);
+  ConfigError& operator=(ConfigError&&) noexcept;
+  ~ConfigError();
+
