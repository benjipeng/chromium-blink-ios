+bool ConfigureCuriumProfileDirectory(std::string_view profile_id,
+                                     std::string* error_code_out,
+                                     std::string* error_message_out) {
+  CuriumProfileState& state = GetCuriumProfileState();
+  base::AutoLock locker(state.lock);
+  if (state.opened || state.configured) {
+    return SetProfileError(error_code_out, error_message_out, "already_opened",
+                           "Profile directory is already locked for this launch");
+  }
+  if (profile_id.empty() || profile_id == "default") {
+    state.profile_id = "default";
+    state.use_custom_profile = false;
+    state.configured = true;
+    return true;
+  }
+  if (!IsValidProfileSlug(profile_id)) {
+    return SetProfileError(
+        error_code_out, error_message_out, "invalid_profile_id",
+        "Profile ID must be \"default\" or [A-Za-z0-9][A-Za-z0-9_-]{0,31}");
+  }
+  base::FilePath app_data_dir;
+  if (!base::apple::GetUserDirectory(NSApplicationSupportDirectory,
+                                     &app_data_dir) ||
+      app_data_dir.empty()) {
+    return SetProfileError(error_code_out, error_message_out,
+                           "profile_unavailable",
+                           "Application Support directory is unavailable");
+  }
+  if (!EnsureSafeDirectory(app_data_dir)) {
+    return SetProfileError(error_code_out, error_message_out,
+                           "profile_unavailable",
+                           "Application Support directory is not writable");
+  }
+  const base::FilePath profiles_root = app_data_dir.Append(kProfilesRootDirName);
+  const base::FilePath profile_dir = profiles_root.Append(profile_id);
+  if (!EnsureSafeDirectory(profiles_root) || !EnsureSafeDirectory(profile_dir)) {
+    return SetProfileError(error_code_out, error_message_out,
+                           "profile_unavailable",
+                           "Unable to prepare isolated profile directory");
+  }
+  int lock_fd = -1;
+  if (!AcquireProfileLock(profile_dir, &lock_fd, error_code_out,
+                          error_message_out)) {
+    return false;
+  }
+  state.profile_id = std::string(profile_id);
+  state.use_custom_profile = true;
+  state.configured = true;
+  state.lock_fd = lock_fd;
+  return true;
+}
+
+std::string GetAppliedCuriumProfileId() {
+  CuriumProfileState& state = GetCuriumProfileState();
+  base::AutoLock locker(state.lock);
+  return state.profile_id;
+}
+
+bool IsCuriumProfileDirectoryOpened() {
+  CuriumProfileState& state = GetCuriumProfileState();
+  base::AutoLock locker(state.lock);
