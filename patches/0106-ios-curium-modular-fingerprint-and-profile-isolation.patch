+
+std::string GetCuriumDesktopUserAgent() {
+  if (const blink::curium::LaunchConfig* cfg =
+          blink::curium::GetLaunchConfig()) {
+    return BuildUserAgentForCuriumSlot(cfg->desktop,
+                                       /*is_desktop_fallback=*/true);
+  }
+  return BuildUserAgentFromOSAndProduct("Macintosh; Intel Mac OS X 10_15_7",
+                                        GetProductAndVersion());
+}
+
+blink::UserAgentOverride GetCuriumDesktopUserAgentOverride() {
+  if (const blink::curium::LaunchConfig* cfg =
+          blink::curium::GetLaunchConfig()) {
+    blink::UserAgentOverride ua_override;
+    ua_override.ua_string_override =
+        BuildUserAgentForCuriumSlot(cfg->desktop, /*is_desktop_fallback=*/true);
+    ua_override.ua_metadata_override = BuildMetadataForCuriumSlot(
+        cfg->desktop, /*is_desktop_fallback=*/true,
+        /*only_low_entropy_ch=*/false);
+    return ua_override;
+  }
+  const blink::UserAgentMetadata metadata = GetUserAgentMetadata();
+  blink::UserAgentOverride ua_override;
+  ua_override.ua_string_override = BuildUserAgentFromOSAndProduct(
+      "Macintosh; Intel Mac OS X 10_15_7", GetProductAndVersion());
+  ua_override.ua_metadata_override = metadata;
+  ua_override.ua_metadata_override->platform = "macOS";
+  ua_override.ua_metadata_override->platform_version =
+      GetCuriumLegacyDesktopPlatformVersion();
+  ua_override.ua_metadata_override->model = std::string();
+  ua_override.ua_metadata_override->mobile = false;
+  ua_override.ua_metadata_override->form_factors =
+      GetFormFactorsClientHint(metadata, /*is_mobile=*/false);
+  ua_override.ua_metadata_override->architecture = "arm";
+  ua_override.ua_metadata_override->bitness = "64";
+  ua_override.ua_metadata_override->wow64 = false;
+  return ua_override;
+}
