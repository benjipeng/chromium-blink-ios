+// found in the LICENSE file.
+
+#include "third_party/blink/public/common/curium/curium_fingerprint_config.h"
+
+#include <algorithm>
+#include <array>
+#include <atomic>
+#include <cmath>
+#include <set>
+#include <utility>
+
+#include "base/json/json_reader.h"
+#include "base/no_destructor.h"
+#include "base/strings/string_number_conversions.h"
+#include "base/strings/string_split.h"
+#include "base/strings/string_util.h"
+#include "base/values.h"
+#include "net/http/http_util.h"
+#include "net/proxy_resolution/proxy_config.h"
+
+namespace blink::curium {
+
+namespace {
+
+constexpr size_t kMaxUAStringLength = 1024;
+constexpr size_t kMaxTokenLength = 128;
+constexpr size_t kMaxWebGLStringLength = 256;
+constexpr size_t kMaxProxyRulesLength = 1024;
+constexpr size_t kMaxProxyBypassLength = 2048;
+constexpr size_t kMaxTimezoneLength = 64;
+constexpr size_t kMaxLanguages = 8;
+constexpr size_t kMaxBrands = 8;
+constexpr size_t kMaxFormFactors = 4;
+
+bool IsPrintableASCII(std::string_view value) {
+  for (unsigned char c : value) {
+    if (c < 0x20 || c > 0x7E) {
+      return false;
+    }
+  }
+  return true;
+}
+
+bool HasNoControlChars(std::string_view value) {
+  for (unsigned char c : value) {
+    if (c < 0x20 || c == 0x7F) {
+      return false;
+    }
+  }
+  return true;
+}
+
+bool IsValidTimezoneId(std::string_view tz) {
+  if (tz.empty() || tz.size() > kMaxTimezoneLength) {
+    return false;
+  }
+  if (tz.front() == '/' || tz.back() == '/' ||
+      tz.find("..") != std::string_view::npos) {
+    return false;
+  }
+  for (unsigned char c : tz) {
+    const bool ok = base::IsAsciiAlpha(c) || base::IsAsciiDigit(c) ||
+                    c == '/' || c == '_' || c == '-' || c == '+' || c == '.';
+    if (!ok) {
+      return false;
+    }
+  }
+  return true;
+}
+
+std::optional<std::string> CanonicalizeBCP47Tag(std::string_view raw) {
+  std::string cleaned(base::TrimWhitespaceASCII(raw, base::TRIM_ALL));
+  base::ReplaceChars(cleaned, "_", "-", &cleaned);
+  if (cleaned.empty() || cleaned.size() > 35) {
+    return std::nullopt;
+  }
+  std::vector<std::string_view> parts = base::SplitStringPiece(
+      cleaned, "-", base::KEEP_WHITESPACE, base::SPLIT_WANT_ALL);
+  if (parts.empty() || parts.size() > 6) {
+    return std::nullopt;
+  }
+  std::vector<std::string> canonical;
+  canonical.reserve(parts.size());
+  bool seen_singleton = false;
+  for (size_t i = 0; i < parts.size(); ++i) {
+    std::string_view subtag = parts[i];
+    if (subtag.empty() || subtag.size() > 8) {
+      return std::nullopt;
+    }
+    bool all_letters = true;
+    for (unsigned char c : subtag) {
+      const bool is_letter = base::IsAsciiAlpha(c);
+      const bool is_digit = base::IsAsciiDigit(c);
+      if (!is_letter && !is_digit) {
+        return std::nullopt;
+      }
+      if (!is_letter) {
+        all_letters = false;
+      }
+    }
+    if (i == 0) {
+      if (!all_letters || subtag.size() < 2) {
+        return std::nullopt;
+      }
+      canonical.push_back(base::ToLowerASCII(subtag));
+      continue;
+    }
+    if (seen_singleton) {
+      canonical.push_back(base::ToLowerASCII(subtag));
+    } else if (subtag.size() == 1) {
+      if (i + 1 == parts.size()) {
+        return std::nullopt;
+      }
+      seen_singleton = true;
+      canonical.push_back(base::ToLowerASCII(subtag));
+    } else if (subtag.size() == 4 && all_letters) {
+      std::string titled = base::ToLowerASCII(subtag);
+      titled[0] = base::ToUpperASCII(titled[0]);
+      canonical.push_back(std::move(titled));
+    } else if (subtag.size() == 2 && all_letters) {
+      canonical.push_back(base::ToUpperASCII(subtag));
+    } else {
+      canonical.push_back(base::ToLowerASCII(subtag));
+    }
+  }
+  return base::JoinString(canonical, "-");
+}
+
+bool HasNonDirectProxy(const net::ProxyList& list) {
+  for (const net::ProxyChain& chain : list.AllChains()) {
+    if (chain.IsValid() && !chain.is_direct()) {
+      return true;
+    }
+  }
+  return false;
+}
+
+bool HasConfiguredProxy(const net::ProxyConfig::ProxyRules& rules) {
+  switch (rules.type) {
+    case net::ProxyConfig::ProxyRules::Type::EMPTY:
+      return false;
+    case net::ProxyConfig::ProxyRules::Type::PROXY_LIST:
+      return HasNonDirectProxy(rules.single_proxies);
+    case net::ProxyConfig::ProxyRules::Type::PROXY_LIST_PER_SCHEME:
+      return HasNonDirectProxy(rules.proxies_for_http) ||
+             HasNonDirectProxy(rules.proxies_for_https) ||
+             HasNonDirectProxy(rules.proxies_for_ftp) ||
+             HasNonDirectProxy(rules.fallback_proxies);
+  }
+}
+
+bool Fail(ConfigError* out_error, ErrorCode code, std::string message) {
+  if (out_error) {
+    out_error->code = code;
+    out_error->message = std::move(message);
+  }
+  return false;
+}
+
+bool ParseBrandList(const base::ListValue& list,
+                    std::string_view field_name,
+                    blink::UserAgentBrandList* out_brands,
+                    ConfigError* out_error) {
+  if (list.empty() || list.size() > kMaxBrands) {
+    return Fail(out_error, ErrorCode::kInvalidField,
+                std::string(field_name) + " must contain 1..8 entries");
+  }
+  blink::UserAgentBrandList result;
+  result.reserve(list.size());
+  for (const base::Value& entry : list) {
+    const base::DictValue* dict = entry.GetIfDict();
+    if (!dict) {
+      return Fail(out_error, ErrorCode::kInvalidField,
+                  std::string(field_name) + " entries must be objects");
+    }
+    for (const auto [k, v] : *dict) {
+      if (k != "brand" && k != "version") {
+        return Fail(out_error, ErrorCode::kInvalidField,
+                    "Unknown key in " + std::string(field_name) + ": " + k);
+      }
+    }
+    const std::string* brand = dict->FindString("brand");
+    const std::string* version = dict->FindString("version");
+    if (!brand || !version || brand->size() > kMaxTokenLength ||
+        version->size() > kMaxTokenLength || !IsValidClientHintToken(*brand) ||
+        !IsValidClientHintToken(*version)) {
+      return Fail(out_error, ErrorCode::kInvalidField,
+                  std::string(field_name) +
+                      " entries require valid brand and version tokens");
+    }
+    result.emplace_back(*brand, *version);
+  }
+  *out_brands = std::move(result);
+  return true;
+}
+
+bool ParseIdentitySlot(const base::DictValue& dict,
+                       std::string_view slot_name,
+                       IdentitySlotConfig* out_slot,
+                       ConfigError* out_error) {
+  static constexpr std::array<std::string_view, 23> kAllowedKeys = {
+      "uaString",        "osCpu",
+      "productVersion",  "appendMobileToken",
+      "primaryBrand",    "majorVersion",
+      "fullVersion",     "brands",
+      "fullVersionBrands", "platform",
+      "platformVersion", "architecture",
+      "bitness",         "model",
+      "mobile",          "wow64",
+      "formFactors",     "navigatorPlatform",
+      "maxTouchPoints",  "pointerType",
+      "hoverType",       "webglVendor",
+      "webglRenderer",
+  };
+  for (const auto [key, value] : dict) {
+    if (std::find(kAllowedKeys.begin(), kAllowedKeys.end(), key) ==
+        kAllowedKeys.end()) {
+      return Fail(out_error, ErrorCode::kInvalidField,
+                  "Unknown key in " + std::string(slot_name) + ": " + key);
+    }
+  }
+
+  IdentitySlotConfig slot;
+
+  if (const base::Value* v = dict.Find("uaString"); v && !v->is_none()) {
+    const std::string* s = v->GetIfString();
+    if (!s || s->empty() || s->size() > kMaxUAStringLength ||
+        !HasNoControlChars(*s) || !net::HttpUtil::IsValidHeaderValue(*s)) {
+      return Fail(out_error, ErrorCode::kInvalidField,
+                  std::string(slot_name) + ".uaString is invalid");
+    }
+    slot.ua_string = *s;
+  }
+
+  if (const base::Value* v = dict.Find("osCpu"); v && !v->is_none()) {
+    const std::string* s = v->GetIfString();
+    if (!s || s->empty() || s->size() > 256 || !IsPrintableASCII(*s) ||
+        s->find('(') != std::string::npos ||
+        s->find(')') != std::string::npos ||
+        !net::HttpUtil::IsValidHeaderValue(*s)) {
+      return Fail(out_error, ErrorCode::kInvalidField,
+                  std::string(slot_name) + ".osCpu is invalid");
+    }
+    slot.os_cpu = *s;
+  }
+
+  if (const base::Value* v = dict.Find("productVersion"); v && !v->is_none()) {
+    const std::string* s = v->GetIfString();
+    if (!s || s->empty() || s->size() > kMaxTokenLength ||
+        !IsPrintableASCII(*s) || !net::HttpUtil::IsValidHeaderValue(*s)) {
+      return Fail(out_error, ErrorCode::kInvalidField,
+                  std::string(slot_name) + ".productVersion is invalid");
+    }
+    slot.product_version = *s;
+  }
+
+  if (const base::Value* v = dict.Find("appendMobileToken");
+      v && !v->is_none()) {
+    if (!v->is_bool()) {
+      return Fail(out_error, ErrorCode::kInvalidField,
+                  std::string(slot_name) + ".appendMobileToken must be bool");
+    }
+    slot.append_mobile_token = v->GetBool();
+  }
+
+  if (const base::Value* v = dict.Find("primaryBrand")) {
+    slot.has_primary_brand = true;
+    if (v->is_none()) {
+      slot.primary_brand = std::nullopt;
+    } else if (const std::string* s = v->GetIfString()) {
+      if (s->empty()) {
+        slot.primary_brand = std::nullopt;
+      } else if (s->size() <= kMaxTokenLength && IsValidClientHintToken(*s)) {
+        slot.primary_brand = *s;
+      } else {
+        return Fail(out_error, ErrorCode::kInvalidField,
+                    std::string(slot_name) + ".primaryBrand is invalid");
+      }
+    } else {
+      return Fail(out_error, ErrorCode::kInvalidField,
+                  std::string(slot_name) + ".primaryBrand must be string/null");
+    }
+  }
+
+  if (const base::Value* v = dict.Find("majorVersion"); v && !v->is_none()) {
+    const std::string* s = v->GetIfString();
+    int parsed = 0;
+    const bool all_digits =
+        s && !s->empty() &&
+        std::all_of(s->begin(), s->end(), [](unsigned char c) {
+          return base::IsAsciiDigit(c);
+        });
+    if (!all_digits || s->size() > 4 || !base::StringToInt(*s, &parsed) ||
+        parsed < 1) {
+      return Fail(out_error, ErrorCode::kInvalidField,
+                  std::string(slot_name) + ".majorVersion must be positive int");
+    }
+    slot.major_version = *s;
+  }
+
+  if (const base::Value* v = dict.Find("fullVersion"); v && !v->is_none()) {
+    const std::string* s = v->GetIfString();
+    if (!s || s->empty() || s->size() > 32 || !IsValidClientHintToken(*s)) {
+      return Fail(out_error, ErrorCode::kInvalidField,
+                  std::string(slot_name) + ".fullVersion is invalid");
+    }
+    slot.full_version = *s;
+  }
+
+  if (const base::Value* v = dict.Find("brands"); v && !v->is_none()) {
+    const base::ListValue* list = v->GetIfList();
+    if (!list) {
+      return Fail(out_error, ErrorCode::kInvalidField,
+                  std::string(slot_name) + ".brands must be an array");
+    }
+    blink::UserAgentBrandList parsed_brands;
+    if (!ParseBrandList(*list, std::string(slot_name) + ".brands",
+                        &parsed_brands, out_error)) {
+      return false;
+    }
+    slot.brands = std::move(parsed_brands);
+  }
+
+  if (const base::Value* v = dict.Find("fullVersionBrands");
+      v && !v->is_none()) {
+    const base::ListValue* list = v->GetIfList();
+    if (!list) {
+      return Fail(out_error, ErrorCode::kInvalidField,
+                  std::string(slot_name) +
+                      ".fullVersionBrands must be an array");
+    }
+    blink::UserAgentBrandList parsed_brands;
+    if (!ParseBrandList(*list, std::string(slot_name) + ".fullVersionBrands",
+                        &parsed_brands, out_error)) {
+      return false;
+    }
+    slot.full_version_brands = std::move(parsed_brands);
+  }
+
+  if (const base::Value* v = dict.Find("platform"); v && !v->is_none()) {
+    const std::string* s = v->GetIfString();
+    if (!s || s->empty() || s->size() > 64 || !IsValidClientHintToken(*s)) {
+      return Fail(out_error, ErrorCode::kInvalidField,
+                  std::string(slot_name) + ".platform is invalid");
+    }
+    slot.platform = *s;
+  }
+
+  if (const base::Value* v = dict.Find("platformVersion"); v && !v->is_none()) {
+    const std::string* s = v->GetIfString();
+    if (!s || s->size() > 64 || (!s->empty() && !IsValidClientHintToken(*s))) {
+      return Fail(out_error, ErrorCode::kInvalidField,
+                  std::string(slot_name) + ".platformVersion is invalid");
+    }
+    slot.platform_version = *s;
+  }
+
+  if (const base::Value* v = dict.Find("architecture"); v && !v->is_none()) {
+    const std::string* s = v->GetIfString();
+    if (!s || s->size() > 32 || (!s->empty() && !IsValidClientHintToken(*s))) {
+      return Fail(out_error, ErrorCode::kInvalidField,
+                  std::string(slot_name) + ".architecture is invalid");
+    }
+    slot.architecture = *s;
+  }
+
+  if (const base::Value* v = dict.Find("bitness"); v && !v->is_none()) {
+    const std::string* s = v->GetIfString();
+    if (!s || (*s != "" && *s != "32" && *s != "64")) {
+      return Fail(out_error, ErrorCode::kInvalidField,
+                  std::string(slot_name) +
+                      ".bitness must be \"\", \"32\", or \"64\"");
+    }
+    slot.bitness = *s;
+  }
+
+  if (const base::Value* v = dict.Find("model"); v && !v->is_none()) {
+    const std::string* s = v->GetIfString();
+    if (!s || s->size() > kMaxTokenLength ||
+        (!s->empty() && !IsValidClientHintToken(*s))) {
+      return Fail(out_error, ErrorCode::kInvalidField,
+                  std::string(slot_name) + ".model is invalid");
+    }
+    slot.model = *s;
+  }
+
+  if (const base::Value* v = dict.Find("mobile"); v && !v->is_none()) {
+    if (!v->is_bool()) {
+      return Fail(out_error, ErrorCode::kInvalidField,
+                  std::string(slot_name) + ".mobile must be bool");
+    }
+    slot.mobile = v->GetBool();
+  }
+
+  if (const base::Value* v = dict.Find("wow64"); v && !v->is_none()) {
+    if (!v->is_bool()) {
+      return Fail(out_error, ErrorCode::kInvalidField,
+                  std::string(slot_name) + ".wow64 must be bool");
+    }
+    slot.wow64 = v->GetBool();
+  }
+
+  if (const base::Value* v = dict.Find("formFactors"); v && !v->is_none()) {
+    const base::ListValue* list = v->GetIfList();
+    if (!list || list->empty() || list->size() > kMaxFormFactors) {
+      return Fail(out_error, ErrorCode::kInvalidField,
+                  std::string(slot_name) +
+                      ".formFactors must be a non-empty array");
+    }
+    std::vector<std::string> factors;
+    factors.reserve(list->size());
+    for (const base::Value& item : *list) {
+      const std::string* s = item.GetIfString();
+      if (!s || !blink::UserAgentMetadata::IsValidFormFactor(*s)) {
+        return Fail(out_error, ErrorCode::kInvalidField,
+                    std::string(slot_name) + ".formFactors has invalid entry");
+      }
+      factors.push_back(*s);
+    }
+    slot.form_factors = std::move(factors);
+  }
+
+  if (const base::Value* v = dict.Find("navigatorPlatform");
+      v && !v->is_none()) {
+    const std::string* s = v->GetIfString();
+    if (!s || s->empty() || s->size() > 64 || !IsPrintableASCII(*s)) {
+      return Fail(out_error, ErrorCode::kInvalidField,
+                  std::string(slot_name) + ".navigatorPlatform is invalid");
+    }
+    slot.navigator_platform = *s;
+  }
+
+  if (const base::Value* v = dict.Find("maxTouchPoints"); v && !v->is_none()) {
+    if (!v->is_int()) {
+      return Fail(out_error, ErrorCode::kInvalidField,
+                  std::string(slot_name) + ".maxTouchPoints must be integer");
+    }
+    const int n = v->GetInt();
+    if (n < 0 || n > 32) {
+      return Fail(out_error, ErrorCode::kInvalidField,
+                  std::string(slot_name) +
+                      ".maxTouchPoints must be in [0, 32]");
+    }
+    slot.max_touch_points = n;
+  }
+
+  if (const base::Value* v = dict.Find("pointerType"); v && !v->is_none()) {
+    const std::string* s = v->GetIfString();
+    if (!s) {
+      return Fail(out_error, ErrorCode::kInvalidField,
+                  std::string(slot_name) + ".pointerType must be string");
+    }
+    if (*s == "none") {
+      slot.pointer_type = PointerTypeOverride::kNone;
+    } else if (*s == "coarse") {
+      slot.pointer_type = PointerTypeOverride::kCoarse;
+    } else if (*s == "fine") {
+      slot.pointer_type = PointerTypeOverride::kFine;
+    } else {
+      return Fail(out_error, ErrorCode::kInvalidField,
+                  std::string(slot_name) + ".pointerType is invalid");
+    }
+  }
+
+  if (const base::Value* v = dict.Find("hoverType"); v && !v->is_none()) {
+    const std::string* s = v->GetIfString();
+    if (!s) {
+      return Fail(out_error, ErrorCode::kInvalidField,
+                  std::string(slot_name) + ".hoverType must be string");
+    }
+    if (*s == "none") {
+      slot.hover_type = HoverTypeOverride::kNone;
+    } else if (*s == "hover") {
+      slot.hover_type = HoverTypeOverride::kHover;
+    } else {
+      return Fail(out_error, ErrorCode::kInvalidField,
+                  std::string(slot_name) + ".hoverType is invalid");
+    }
+  }
+
+  if (const base::Value* v = dict.Find("webglVendor"); v && !v->is_none()) {
+    const std::string* s = v->GetIfString();
+    if (!s || s->empty() || s->size() > kMaxWebGLStringLength ||
+        !IsPrintableASCII(*s)) {
+      return Fail(out_error, ErrorCode::kInvalidField,
+                  std::string(slot_name) + ".webglVendor is invalid");
+    }
+    slot.webgl_vendor = *s;
+  }
+
+  if (const base::Value* v = dict.Find("webglRenderer"); v && !v->is_none()) {
+    const std::string* s = v->GetIfString();
+    if (!s || s->empty() || s->size() > kMaxWebGLStringLength ||
+        !IsPrintableASCII(*s)) {
+      return Fail(out_error, ErrorCode::kInvalidField,
+                  std::string(slot_name) + ".webglRenderer is invalid");
+    }
+    slot.webgl_renderer = *s;
+  }
+
+  *out_slot = std::move(slot);
+  return true;
+}
+
+std::string DefaultNavigatorPlatformForUAPlatform(std::string_view platform) {
+  if (platform == "macOS") {
+    return "MacIntel";
+  }
+  if (platform == "Windows") {
+    return "Win32";
+  }
+  if (platform == "Android") {
+    return "Linux armv81";
+  }
+  if (platform == "Linux" || platform == "Chrome OS" ||
+      platform == "Chromium OS") {
+    return "Linux x86_64";
+  }
+  if (platform == "iOS") {
+    return "iPhone";
+  }
+  return std::string();
+}
