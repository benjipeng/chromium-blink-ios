+  std::optional<std::string> webgl_renderer;
+};
+
+struct BLINK_COMMON_EXPORT LaunchConfig {
+  LaunchConfig();
+  LaunchConfig(const LaunchConfig&);
+  LaunchConfig(LaunchConfig&&) noexcept;
+  LaunchConfig& operator=(const LaunchConfig&);
+  LaunchConfig& operator=(LaunchConfig&&) noexcept;
+  ~LaunchConfig();
+
+  int schema_version = kLaunchConfigSchemaVersion;
+  uint64_t revision = 0;
+  std::string profile_id = "default";
+  DefaultSlot default_slot = DefaultSlot::kMobile;
+  IdentitySlotConfig mobile;
+  IdentitySlotConfig desktop;
+  std::vector<std::string> languages;
+
+  ProxyMode proxy_mode = ProxyMode::kSystem;
+  std::string proxy_rules;
+  std::string proxy_bypass_rules;
+
+  blink::mojom::WebRtcIpHandlingPolicy webrtc_ip_handling_policy =
+      blink::mojom::WebRtcIpHandlingPolicy::kDefault;
+  bool enable_do_not_track = false;
+  bool enable_global_privacy_control = false;
+
+  // Optional launch-scoped hardware/environment overrides. When nullopt,
+  // Blink reports authentic native hardware & timezone with zero overhead.
+  std::optional<uint32_t> hardware_concurrency;
+  std::optional<float> device_memory_gb;
+  std::optional<std::string> timezone;
+
+  bool HasHardwareOverrides() const;
+  std::string AcceptLanguagesCSV() const;
+  const IdentitySlotConfig& DefaultIdentity() const;
+  const IdentitySlotConfig& SelectSlotForMetadata(
+      const blink::UserAgentMetadata& metadata) const;
+};
