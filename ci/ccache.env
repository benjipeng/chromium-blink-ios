# ccache settings for every Linux compile (sourced by scripts/stage.sh).
# These govern cache reuse only; they never enter build keys.
CCACHE_BASEDIR=/tmp/cb_work
CCACHE_NOHASHDIR=true
CCACHE_CPP2=true
CCACHE_COMPILERCHECK=content
CCACHE_SLOPPINESS=include_file_mtime,include_file_ctime,time_macros
CCACHE_COMPRESS=true
CCACHE_MAXSIZE=0
